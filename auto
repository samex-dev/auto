-- 🧤 ONE DIVE PATH (v2.44). The five dive sites each repeated the same six steps
-- (re-arm cooldown, recover stamp, save watch, impact tint, auto-jump, fire) —
-- and they did NOT repeat them identically: the GK-tackle branch never tinted the
-- impact marker, and every site built its own pcall closure per dive. One helper
-- owns the sequence now, so a dive can never half-register.
-- 🪤 v2.67 ONE COUNTER FOR EVERY REFUSAL: every ball the keeper declines to
-- fly at — a held shape (bait net), a betrayed dive (dead-ball regret) —
-- feeds the same episode marker. BAITER_LOCK episodes of ANY bait flavor on
-- one man inside BAITER_WINDOW flag him: net and memory are one machine.
-- Module scope so the early regret probe and the bait block share it.
-- v2.79: the commit-distance tax lives in CONFIG.BAITER_TAX — priced by the
-- habit. First flag is 6 studs-lighter than the old flat cut (one spiky
-- touch should not brand a man); a farmer pays 28% later and the baiterUntil
-- clock keeps re-arming. Lookup is clamp-by-index so mainStep adds no
-- upvalues.
local function baitTaxN(n)
	return CONFIG.BAITER_TAX[math.min(math.max(n or 2, 2), 4)]
end

local function baitEpisode(k, now)
	if not k then return end
	if ST.baitMark and ST.baitMark.key == k and (now - ST.baitMark.t) < CONFIG.BAITER_WINDOW then
		ST.baitMark = { key = k, t = now, n = (ST.baitMark.n or 1) + 1 }
		if ST.baitMark.n >= CONFIG.BAITER_LOCK
			and (ST.baiterKey ~= k or now >= (ST.baiterUntil or 0)) then
			local reoffense = ST.baiterKey == k
			ST.baiterKey, ST.baiterUntil = k, now + CONFIG.BAITER_HUNT
			ST.baiterFlags, ST.baiterFlagsT = (ST.baiterFlags or 0) + 1, now
			local grudge = ((ST.baiterFlags or 0) >= 2 and (now - (ST.baiterFlagsT or 0)) < CONFIG.BAITER_REPEAT_WINDOW)
				and CONFIG.BAITER_REPEAT_BONUS or 0
			log(string.format("[AI-Dive] 🪤 BAITER %s — %d bait episodes on this man — suspect bar %d studs/s for %.0fs — met %.0f%% later",
				reoffense and "RE-ARMED (repeat offense — the grudge adds +4 more)" or "FLAGGED",
				ST.baitMark.n, CONFIG.BAIT_ROLL_MAX + CONFIG.BAITER_BAR_BONUS + grudge,
				CONFIG.BAITER_HUNT, (1 - baitTaxN(ST.baitMark.n)) * 100), true)
		end
	else
		ST.baitMark = { key = k, t = now, n = 1 }
	end
end

local function fireDive(direction, tFrame, ballSpeed, approach, cooldown, jumpImpact, jumpGoal)
	ST.cooldownUntil = tFrame + cooldown
	ST.diveStartT    = tFrame -- 🔮 v2.84: when this dive began (keeper-state read)
	CHARGE.lastDive  = tFrame
	diveWatch = { time = tFrame, speed = ballSpeed, approach = approach, resolved = false }
	if impactPart then impactPart.Color = Color3.fromRGB(255, 60, 60) end
	-- 🔌 v2.49: NEVER fire into a stale handle — validate (and if needed, re-find)
	-- at the exact moment of use, and if the FireServer itself errors the remote
	-- died under us: drop it so the next decision re-acquires.
	local ev = ensureDiveRemote()
	if ev then
		local ok = pcall(function() ev:FireServer(direction) end)
		if not ok then
			DiveEvent = nil
			log("[AI-Dive] 🔌 dive remote died mid-fire — re-acquiring on the next decision", true)
		end
	elseif not diveBlockedWarned then
		diveBlockedWarned = true
		warn("[Auto-Dive] ⚠️ a dive was decided (" .. tostring(direction)
			.. ") but there is no dive RemoteEvent to fire — see DIVE_EVENT_NAMES at the top.")
	end
	-- v2.58: the jump is DECORATION on the dive — it now runs AFTER the fire and
	-- inside its own pcall, so no state-machine hiccup on any client can ever
	-- swallow the commit again (see the enum-safety note in tryAutoJump).
	pcall(tryAutoJump, jumpImpact, jumpGoal, ballSpeed)
end

-- 🧱 v2.52: the welder itself. One part per character, named so our OWN
-- save-detector can skip it (the expander is for the GAME's catch math; our
-- internal "did the ball touch the keeper" truth must stay body-honest or a
-- fake overlap would resolve diveWatch as saved and stop the re-react).
local function weldHitboxExpansion(char)
	local r = CONFIG.HITBOX_EXPAND
	if not char or not r or r <= 0 then return nil end
	local size = math.min(r, CONFIG.HITBOX_EXPAND_MAX)
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	local made
	pcall(function()
		local old = root:FindFirstChild("GKHitbox")
		if old then
			made = old
			return
		end
		local p = Instance.new("Part")
		p.Name = "GKHitbox"
		p.Size = Vector3.new(size, size, size)
		p.Transparency = 1
		p.CanCollide = false
		p.CanTouch = true
		p.CastShadow = false
		p.Massless = true
		p.Anchored = false
		p.Parent = root
		local w = Instance.new("Weld")
		w.Part0 = root
		w.Part1 = p
		w.C0 = CFrame.new()
		w.C1 = CFrame.new()
		w.Parent = p
		made = p
	end)
	return made
end

