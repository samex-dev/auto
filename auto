-- ==========================================
-- BALL TRACKER (event-driven, no re-scans)
-- ==========================================
local cachedBall   = nil
local lastBallScan = 0

-- Every built-in ball name contains "ball" (Ball, GK_Ball, soccer-ball,
-- matchball…), so the DescendantAdded firehose can reject almost every name
-- with ONE plain substring test instead of lower+gsub-ing it. If you add a
-- BALL_NAMES key that does not contain "ball", the fast path turns itself off.
local BALL_FILTER = "ball"
for configured in pairs(CONFIG.BALL_NAMES) do
	if not string.lower(configured):find("ball", 1, true) then
		BALL_FILTER = nil
		break
	end
end

local function ballNameMatch(name)
	local lower = string.lower(name or "")
	if BALL_FILTER and not lower:find(BALL_FILTER, 1, true) then
		return nil
	end
	return CONFIG.BALL_NAMES[lower:gsub("[^%a%d]", "")]
end

local function resolveBallPart(inst)
	if inst:IsA("BasePart") then return inst end
	if inst:IsA("Model") then
		if inst.PrimaryPart then return inst.PrimaryPart end
		-- Fallback: first solid child part (some balls have no PrimaryPart)
		for _, d in ipairs(inst:GetChildren()) do
			if d:IsA("BasePart") then return d end
		end
	end
	return nil
end

local function findBall()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if ballNameMatch(obj.Name) then
			local part = resolveBallPart(obj)
			if part then return part end
		end
	end
	return nil
end

local function refreshBall()
	if cachedBall and cachedBall.Parent then
		return cachedBall
	end
	-- Ball vanished: fast path is the DescendantAdded hook below;
	-- this is the throttled fallback (at most one full scan per 0.5s).
	local now = os.clock()
	if now - lastBallScan >= 0.5 then
		lastBallScan = now
		cachedBall = findBall()
	end
	return cachedBall
end

local function scanBall()
	cachedBall = findBall()
	lastBallScan = os.clock()
end

