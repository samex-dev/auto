	end

local function mainStep(deltaTime)
	-- ⏸ 0a) PAUSED: keep the loop alive (so re-arming is instant) but park
	-- everything exactly once — running the idle path every frame would mean
	-- ~9 property writes per frame for a keeper that is deliberately doing nothing.
	if not aiEnabled then
		if not ST.pausedParked then
			ST.pausedParked = true
			markIdle()
		end
		return
	end
	-- 0) LIVENESS GATES
	Camera = workspace.CurrentCamera or Camera -- the game can recreate it mid-match
	local character = LocalPlayer.Character
	local rootPart  = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid  = character and character:FindFirstChildOfClass("Humanoid")

	if not rootPart or not humanoid or humanoid.Health <= 0 then
		posHistory = {}
		GK.history = {}
		ST.commitDir, ST.commitFrames = nil, 0
		prevRealDepth = nil
		markIdle()
		return
	end

	local ballPart = refreshBall()
	if not ballPart then
		markIdle()
		return
	end

	-- ⏱ ONE CLOCK (v2.44): this used to be tick(), the deprecated epoch
	-- wall-clock — ~0.015s steps and it JUMPS when the client clock is corrected,
	-- mixed with os.clock() everywhere else. The controlled-ball gate divides a
	-- gap delta by a dt taken from it, so that coarse step fed straight into the
	-- released/controlled decision. One monotonic source now, read ONCE a frame.
	local ballPos = ballPart.Position
	local rootPos = rootPart.Position
	local now     = os.clock()

	-- 🚀 v2.83 TRAJECTORY 3.0 (1/5) RESET GUARD: a single frame that moves the
	-- ball further than physics allows is not a shot — it is a respawn, a
	-- kickoff reposition, or a server correction. Every downstream reader
	-- (the trajectory cache, the closest-approach history, the pop detector)
	-- inherits that jump as a fake 1300/s strike and the keeper dives at
	-- nothing. Catching it HERE, before any reader runs, keeps the pipeline
	-- honest: the cached arc is dropped and the teleport is counted so the
	-- heartbeat can show it. Shot-speed frames are exempt by construction
	-- (a real 100/s strike covers 1.7 studs per frame, nowhere near the bar).
	--
	-- 🐛 v2.83c: the fixed 22-stud bar was WRONG on a laggy link. A frame on
	-- a ~400 ms connection can be 0.3 s long, and a 200/s strike legitimately
	-- covers 60 studs in it — the live console showed 18 "resets" in one
	-- match, every one of them a real ball on a hitch. The bar is now the
	-- ball's OWN speed × the frame time (plus a floor), so only a jump the
	-- ball could not actually have made counts as a teleport.
	if ST.lastBallPos and ST.lastBallT then
		local dt = now - ST.lastBallT
		local jumped = (ballPos - ST.lastBallPos).Magnitude
		-- ST.smoothedSpeed still holds LAST frame's read here (it is updated
		-- further down), which is exactly the reference we want.
		local vPrev = ST.smoothedSpeed or 0
		local bar = CONFIG.BALL_TELEPORT_DIST + vPrev * dt * 2.0
		if dt > 0 and dt < 0.5 and jumped > bar then
			ST.simT, ST.simReset = nil, nil       -- drop the cached arc
			-- ...and only a jump too large to be ANY kind of play also drops the
			-- position history, so estimateMotion() re-derives from clean samples
			-- instead of reporting the teleport itself as a 3000/s strike. The
			-- price is real — it returns nil for 4 frames and the keeper idles
			-- through them — so the bar for that is deliberately far higher than
			-- the bar for merely dropping the cache (S139 teleports the ball 45
			-- studs on purpose to step its striker deep, and that must stay a
			-- soft reset, not four blind frames).
			if jumped > CONFIG.BALL_TELEPORT_HARD then
				for i = #posHistory, 1, -1 do posHistory[i] = nil end
			end
			ST.teleportN = (ST.teleportN or 0) + 1
			if (now - ST.grazeLogged) > 3 then
				ST.grazeLogged = now
				log(string.format("[AI-Dive] 🚀 RESET GUARD — ball jumped %.0f studs in %.2fs (bar %.0f): real reset, arc + history dropped",
					jumped, dt, bar), true)
			end
		end
	end
	ST.lastBallPos, ST.lastBallT = ballPos, now

	-- 🧹 HOUSEKEEPING FIRST (v2.44). Teams, character styles, style tags and the
	-- goal geometry are all throttled internally (0.5-2s) and they used to sit
	-- BELOW the "ball is idle / far away" early-returns — so while the ball was
	-- resting (every kickoff, every restart, the whole time between plays)
	-- NOTHING refreshed. Concretely: on the exact frame the ball left a
	-- teammate's foot the team cache could still be empty, the shot was credited
	-- to "opp", and the keeper dove at our own kick with the middle of the net
	-- empty. Refresh first, then judge possession.
	refreshTeams()
	scanCharacters()
	updateStyleTags()

	-- 🦘🦘 v2.50 DOUBLE-JUMP APEX HOP: one armed follow-up hop fires here, in the
	-- always-on section, because by its apex the ball may already be under the
	-- interest gates (or the dive resolved) — the hop must not depend on the
	-- prediction pipeline still running. Airborne-only: on the ground it would
	-- just be a second normal jump.
	if ST.djArmed then
		local djNow = os.clock()
		if djNow >= ST.djAt then
			ST.djArmed = false
			local djChar = LocalPlayer.Character
			local djHum = djChar and djChar:FindFirstChildOfClass("Humanoid")
			if djHum then
				local djState
				pcall(function() djState = djHum:GetState() end)
				local djLanded = false
				-- v2.58: by NAME, never by member (some clients lack .Falling/.Landed)
				pcall(function() djLanded = tostring(djState):find(".Landed", 1, true) ~= nil end)
				if djState ~= nil and not djLanded then
					pcall(function() djHum:ChangeState(Enum.HumanoidStateType.Jumping) end)
					pcall(function() djHum:Jump() end)
					log("[AI-Dive] 🦘 DOUBLE JUMP — apex hop for the crossbar ball")
				end
			end
		end
	end

	-- 🧱 v2.52: hitbox-expansion cube. Welded once per CHARACTER (a respawn
	-- kills the old one WITH the old root automatically — it is a child of it),
	-- re-checked every 4 s in case a server sweep scrubs it while we still live.
	do
		local rbChar = LocalPlayer.Character
		if rbChar and rbChar ~= ST.rbChar then
			ST.rbChar = rbChar
			if weldHitboxExpansion(rbChar) and not ST.rbLogged then
				ST.rbLogged = true
				log(string.format("[AI-Dive] 🧱 HITBOX EXPANDED — %d-stud invisible catch-cube welded to the root", math.min(CONFIG.HITBOX_EXPAND, CONFIG.HITBOX_EXPAND_MAX)))
			end
		elseif rbChar then
			local rbNow = os.clock()
			if rbNow - (ST.rbT or 0) >= 4 then
				ST.rbT = rbNow
				local root = rbChar:FindFirstChild("HumanoidRootPart")
				if root and not root:FindFirstChild("GKHitbox") and (ST.rbLogged or CONFIG.HITBOX_EXPAND > 0) then
					if weldHitboxExpansion(rbChar) then
						log("[AI-Dive] 🧱 hitbox cube re-welded (something scrubbed it)")
					end
				end
			end
		end
	end

	-- 🎥 CAMERA BASIS, resolved once per frame (v2.44). Every "which side is the
	-- ball on" read used to index Camera.CFrame directly: when
	-- workspace.CurrentCamera is nil (a tick after a respawn, or a script that
	-- booted before the camera existed) the loop threw on the SAME line forever —
	-- and the pcall guard throttles error printing to 1 line / 5s, so a
	-- permanently blind keeper was easy to miss. Fall back to the keeper's own
	-- facing, which is what a dive direction means anyway.
	local camCF      = (Camera and Camera.CFrame) or rootPart.CFrame
	local camRight   = camCF.RightVector
	local camForward = camCF.LookVector

	-- 1) SENSOR MEMORY (noise filtering + hiccup/teleport guards)
	if deltaTime > 0.35 then
		return -- frame hiccup: skip so we don't poison the history
	end
	addHistorySample(ballPos, now)
	-- 🧮 pitch level bookkeeping (v2.44): a fixed 300-slot ring of ball heights,
	-- refreshed in place. The old version also re-scanned all 300 entries EVERY
	-- frame (and paid an O(n) table.remove shift) to produce one number.
	local ySlot = sampleSlot(yHistory, 300)
	ySlot[1] = ballPos.Y

	local velocity, accel
	if CONFIG.USE_ASSEMBLY_VELOCITY then
		velocity = ballPart.AssemblyLinearVelocity
		accel    = Vector3.zero -- no curve estimate when using the direct sensor
	else
		velocity, accel = estimateMotion() -- nil until fresh samples exist
	end

	if not velocity then
		markIdle()
		return
	end

	local speed = velocity.Magnitude
	ST.smoothedSpeed = ST.smoothedSpeed + (speed - ST.smoothedSpeed) * 0.6
	ST.prof:feed(now) -- 📈 v2.80 the man-ledger breathes with the ball
	ST.swing:check(now, abilityAlert, baitEpisode) -- 🎭 v2.81 the swing read rides the same breath

	-- 🪤 v2.76 DANCE READ: while the ball is dead, watch the nearest FIELD
	-- player (refreshPlayerRoots excludes the keeper and is 0.5s-cached). A
	-- man inside BAIT_DANCE_RANGE whose root MOVES at BAIT_DANCE_STEP or more
	-- is prowling the placement; the run accumulates, half-decays on any
	-- break, and is convicted at the STRIKE charge below — never by a speed
	-- read, because the kick legitimately starts at zero. The scan only runs
	-- while the ball rests: seconds of cheap arithmetic, not a forever tax.
	do
		-- 🪤 THE DANCE (v2.76): while the ball rests, the nearest FIELD player
		-- at it (same cached roots table the strike scan uses, ~14 reads) gets
		-- a live root fingerprint. Two CADENCE-PROOF tallies run while the
		-- spell holds: TIME the ball is dead with a man on it, and his TOTAL
		-- TRAVEL inside the ring. A prowler covers studs; a stander banks time
		-- and zero distance — and no tick-rate in the world changes how far a
		-- body actually walked, which is why neither tally divides by frames.
		local dtD = (deltaTime > 0 and deltaTime < 0.25) and deltaTime or 0
		if speed <= CONFIG.BAIT_DANCE_STILL and dtD > 0 then
			local man, manRoot, md = nil, nil, CONFIG.BAIT_DANCE_RANGE
			for _, e in ipairs(refreshPlayerRoots()) do
				local d = (e.root.Position - ballPos).Magnitude
				if d < md then md, man, manRoot = d, e.player, e.root end
			end
			if man and manRoot then
				if ST.danceMan ~= man then
					-- first frame (or a hand-off at the ball): start a clean run
					ST.danceMan, ST.danceRun, ST.danceDist = man, 0, 0
					ST.danceRootP = manRoot.Position
				else
					ST.danceRun  = ST.danceRun + dtD
					ST.danceDist = ST.danceDist + (manRoot.Position - ST.danceRootP).Magnitude
					ST.danceRootP = manRoot.Position
					ST.danceEnd   = now
				end
			else
				ST.danceMan, ST.danceRootP = nil, nil
			end
		else
			ST.danceMan, ST.danceRootP = nil, nil
		end
	end

	-- 🎯 STRIKE RESET: charged shots start from a still ball.
	-- When a still spell just ended, discard the mixed still/moving samples so
	-- the sensor re-locks on the fresh shot from the very first frame.
	if speed < 5 then
		ST.stillFrames = ST.stillFrames + 1
	elseif ST.stillFrames > 6 then
		posHistory   = {}
		ST.stillFrames  = 0
		ST.commitDir    = nil -- fresh ball: read it fresh
		ST.commitFrames = 0
		-- 🎯 WHO JUST KICKED IT? The nearest other player at the ball is the
		-- shooter — remember their team for the whole flight (own shot = no saves)
		-- and start sampling this shot's power to learn their style.
		local shooterPlayer, shooterKey, sd = nil, nil, math.huge
		for _, e in ipairs(refreshPlayerRoots()) do
			local d = (ballPos - e.root.Position).Magnitude
			if d < sd then
				sd, shooterPlayer, shooterKey = d, e.player, teamKeyOf(e.player)
			end
		end
		-- v2.34: if the server says who controlled the ball (NetworkOwner),
		-- that is the shooter — more reliable than "nearest player".
		local netShooter = networkOwnerPlayer(ballPart)
		if sd <= CONFIG.SHOOTER_TOUCH_RADIUS then
			local who = netShooter or shooterPlayer
			lastShooterKey    = who and teamKeyOf(who) or nil
			lastShooterPlayer = who or shooterPlayer
			lastShooterTime   = now
			-- 🎛️ v2.82: the alert→motion gap IS the link the keeper lives in
			if abilityAlert and (now - abilityAlert.t) < 1.0 then ST.clock:sampleLag(now - abilityAlert.t) end
			ST.prof:arm(lastShooterPlayer and lastShooterPlayer.Name, speed, (ballPos - rootPos).Magnitude, now) -- 📈 v2.80
			-- ⚗️ v2.68: the man we were watching RECEIVE just kicked it — the
			-- chemistry shot is here. ONE free strike off the bait tiers (the
			-- promise is consumed whether or not the bypass ends up used — a
			-- feigned one-two can farm it exactly once, then the net is back).
			if ST.reactPlayer and lastShooterPlayer == ST.reactPlayer then
				ST.reactStrikeT = now
			end
			ST.reactPlayer = nil
			ST.lastShotReset     = now
			-- 🪤 v2.76 REPOSITION charge: the kick that ends a dance is the
			-- dance's second half. Guilty AT CREDIT, so the tax is loaded
			-- before any commit frame runs — the read never has to trust a
			-- velocity spike for this one; the BODY already confessed.
			local dRun, dDist = ST.danceRun or 0, ST.danceDist or 0
			local danceKey = lastShooterKey or (ST.danceMan and teamKeyOf(ST.danceMan))
			if danceKey and dRun >= CONFIG.BAIT_DANCE_TIME
				and dDist >= CONFIG.BAIT_DANCE_DIST
				and (now - (ST.danceEnd or 0)) <= CONFIG.BAIT_DANCE_WINDOW then
				ST.danceRun, ST.danceDist, ST.danceMan = 0, 0, nil
				baitEpisode(danceKey, now)
				if (not ST.danceLogT) or (now - ST.danceLogT) > 3 then
					ST.danceLogT = now
					log(string.format("[AI-Dive] 🪤 REPOSITION — %.1fs and %.1f studs of dancing over a dead ball before that kick — charged as a bait episode (a placement, not a wind-up)", dRun, dDist), true)
				end
			end
			ST.peakSinceShot     = 0 -- fresh credit: the fake test starts clean
			ST.leadSide = nil     -- v2.72: a new strike is a new geometry
			pendingShotRecord = { player = lastShooterPlayer, t = now, maxSpeed = 0 }
			-- 🪤 v2.71 FEINT PAIR bookkeeping: every credit leaves a fingerprint
			-- (when, who, how far from the goalmouth it started). If the SAME man
			-- credits again inside BAIT_FEINT_PAIR and the ball gained less than
			-- BAIT_FEINT_GAIN studs of ground, those were not two shots — that is
			-- one wobble. Charged as an episode on the spot; shots gain ground,
			-- feints don't. (Raw travel beats any speed read for this: the pair
			-- can even be all-speed and no-progress, which no single-frame gate
			-- can see.)
			local dNow = (ballPos - rootPos).Magnitude
			-- Compare the PLAYER OBJECT, not the key: the roster cache can lag
			-- the first credit after a spawn (S118 caught it — key nil on tap
			-- one). The charge still rides the key; fall back to a live lookup.
			local pairKey = lastShooterKey or (lastShooterPlayer and teamKeyOf(lastShooterPlayer))
			if ST.spikeT and ST.spikePlayer and lastShooterPlayer == ST.spikePlayer
				and (now - ST.spikeT) < CONFIG.BAIT_FEINT_PAIR
				and (ST.spikeD - dNow) < CONFIG.BAIT_FEINT_GAIN then
				ST.feintPairT = now
				if pairKey then baitEpisode(pairKey, now) end
				if (not ST.feintLogged) or (now - ST.feintLogged > 2.5) then
					ST.feintLogged = now
					log(string.format("[AI-Dive] 🪤 FEINT PAIR — two taps in %.2fs, %.0f studs gained — footwork, not a shot", now - ST.spikeT, ST.spikeD - dNow))
				end
			end
			ST.spikeT, ST.spikePlayer, ST.spikeD = now, lastShooterPlayer, dNow
		else
			lastShooterKey, lastShooterPlayer = nil, nil -- nobody at the ball: clear
		end
	end

	-- 🎭 v2.47: the READ (roles, teams, possession, goal geometry, handler) runs
	-- on EVERY frame now. The two interest gates below used to return first, so
	-- the armed counter only updated when the ball moved faster than
	-- MIN_INTEREST_SPEED — a slow dribble, a walk-in, or a role swap at rest left
	-- it stale (looked like "it checks the player roles once"). The gates stay:
	-- they skip the PREDICTION for quiet balls, never the read.
	-- myKey is read AFTER refreshTeams() above, so a team assigned between two
	-- frames (join, halftime, respawn) is honoured on the very next dive
	-- decision instead of one frame late.
	local myKey = teamKeyOf(LocalPlayer)

	-- 🩹 The shooter's team, re-resolved every frame from the player object
	-- instead of trusting the strike-frame snapshot (v2.44): a teammate's kick
	-- can no longer be mis-read as an opponent's shot because the team cache
	-- updated a frame too late, and a mid-flight team change self-heals.
	local shooterKey = (lastShooterPlayer and teamKeyOf(lastShooterPlayer)) or lastShooterKey

	-- 🥅 goal geometry (throttled inside; hoisted above the idle gates, v2.44)
	local goal = scanGoal(rootPos)

	-- 2) DYNAMIC THREAT DETECTION + 🎯 POSSESSION
	-- 👁 ONE ROSTER PASS (v2.44). Nearest player, opponent carrier, the carry
	-- correlation, the controlled-ball gap, the nearest-opponent distance and the
	-- "is a player under the ball" juggle test were SIX separate loops over the
	-- same refreshPlayerRoots() list — each recomputing the same distance and the
	-- same team lookup (and one allocating an oppRoots table every frame). With
	-- 20 players that was ~120 distance solves per frame for six numbers.
	local carrierKey    = nil
	local carrierPlayer = nil
	local carrierPos    = nil
	local carrierDist   = math.huge
	local nearDist      = math.huge
	local nearPlayer    = nil
	local nearRoot      = nil -- v2.65: the closest player's ROOT (pass-to-mate vector)
	local isCarried     = false
	local carryPlayer   = nil
	local bestD         = nil      -- nearest opponent gap (controlled-ball gate)
	local oppNear       = math.huge -- nearest OPPONENT distance (dribble / tap / striker)
	local playerUnderBall = false
	local carryRel2   = CONFIG.CARRY_REL_SPEED * CONFIG.CARRY_REL_SPEED
	local carrierR    = CONFIG.BALL_CARRIER_RADIUS
	-- 🧠 v2.83 MATCH SENSE input: how many opponents are crowded around the
	-- ball (set piece / crowd reads). Reset each frame, counted in the loop.
	ST.nearOppCount = 0
	local carryR     = CONFIG.CARRY_RADIUS
	local controlledR = CONFIG.CONTROLLED_RADIUS
	local underR2     = CONFIG.JUGGLE_OVERHEAD_DIST * CONFIG.JUGGLE_OVERHEAD_DIST
	for _, e in ipairs(refreshPlayerRoots()) do
		local ePos = e.root.Position
		local dx, dy, dz = ballPos.X - ePos.X, ballPos.Y - ePos.Y, ballPos.Z - ePos.Z
		local d = sqrt(dx * dx + dy * dy + dz * dz)
		local k = teamKeyOf(e.player)
		local teammate = (myKey ~= nil and k == myKey)

		if d < nearDist then
			nearDist, nearPlayer, nearRoot = d, e.player, e.root
		end
		-- juggle drop: a player directly under an elevated ball
		if not playerUnderBall
			and (dx * dx + dz * dz) <= underR2 and (ballPos.Y - ePos.Y) > 2 then
			playerUnderBall = true
		end
		if not teammate then
			if d < oppNear then oppNear = d end
			if d <= 12 then ST.nearOppCount = (ST.nearOppCount or 0) + 1 end -- 🧠 v2.83 crowd count
			-- 🤲 CARRY CORRELATION: the ball is CARRIED (hand-carry or feet
			-- dribble, ANY speed) when it is close to an opponent AND moving WITH
			-- them. A carried ball is not a shot — no dive. This is also what kills
			-- shot FEINTS: the attacker plays the shot animation without releasing
			-- and the ball stays glued to their feet.
			if not isCarried and d <= carryR and e.vel then
				local rvx, rvy, rvz = velocity.X - e.vel.X, velocity.Y - e.vel.Y, velocity.Z - e.vel.Z
				if (rvx * rvx + rvy * rvy + rvz * rvz) < carryRel2 then
					isCarried, carryPlayer = true, e.player
				end
			end
			-- controlled-ball gate input: nearest opponent gap
			if d <= controlledR and (not bestD or d < bestD) then
				bestD = d
			end
		end
		-- Carrier = the closest player at a (slow) ball
		if speed < CONFIG.DRIBBLE_MAX_SPEED and d < carrierDist
			and d <= carrierR then
			carrierDist, carrierKey, carrierPlayer, carrierPos = d, k, e.player, ePos
		end
	end
	

	ST.prof:carrier(carrierPlayer and carrierPlayer.Name, (ballPos - rootPos).Magnitude, now) -- 📈 v2.80

	-- 🎯 Who owns the ball right now?
	--   1) NETWORK OWNERSHIP (v2.34, authoritative): the server sets the
	--      ball's NetworkOwner to the controlling player's root. Teammate
	--      owns it => NEVER dive. Opponent owns it => full threat, even
	--      if a teammate is standing right next to the ball (the old
	--      nearest-player heuristic used to flip on that and we'd either
	--      dive on our own ball or freeze on theirs).
	--   2) Heuristic fallback (NetworkOwner nil): a carrier (player at a
	--      slow ball) or a carry (any speed) wins; otherwise the last
	--      shooter keeps "owning" the flight for SHOT_OWNER_MEMORY.
	local netOwner = networkOwnerPlayer(ballPart)
	local poss
	if netOwner then
		local own = (netOwner == LocalPlayer)
			or (myKey ~= nil and teamKeyOf(netOwner) == myKey)
		poss = own and "own" or "opp"
	elseif carrierKey or carrierPlayer or carryPlayer then
		-- v2.46: also check carrierPlayer itself — carrierKey is the team key and
		-- is nil for teamless players (lobbies, style tests), which used to skip
		-- this branch entirely even though a carrier had been found.
		local cKey = carrierKey or teamKeyOf(carrierPlayer or carryPlayer)
		poss = (myKey and cKey == myKey) and "own" or "opp"
	elseif shooterKey and (now - lastShooterTime) < CONFIG.SHOT_OWNER_MEMORY then
		poss = (myKey and shooterKey == myKey) and "own" or "opp"
	end
	-- 🔄 v2.65: possession FLIPPING OFF a teammate's touch re-arms the whole
	-- read fresh — a stale commit side or a stale bait mark inherited from OUR
	-- player's boot is how a keeper dives at yesterday's ball. The mate had it;
	-- now they have it; read HIM, not the ghost.
	if poss == "own" then
		ST.wasOwn = true
	elseif ST.wasOwn and poss ~= "own" then
		ST.wasOwn = nil
		-- ⏱ v2.78 FLICKER GUARD (their dev console, Sep 17): OWN→OPP fired
		-- FOUR times in 2.5s — a loose ball at a 50/50 keeps flipping
		-- own→opp→own frame to frame, and every flip zeroed commitFrames and
		-- forced the read to restart from scratch. That is not re-arming; it
		-- is self-inflicted amnesia mid-dive. A flip that lands <0.35s after
		-- the last WIPE is flicker — hold the read, mute the wipe. A real
		-- pass still re-arms: the first flip of a sequence always passes the
		-- gate, and sustained opponent possession re-triggers after 0.35s.
		local flipNow = now
		if ST.ownFlipT and (flipNow - ST.ownFlipT) < 0.35 then
			if (not ST.ownFlickLogged) or (flipNow - ST.ownFlickLogged) > 1.0 then
				ST.ownFlickLogged = flipNow
				log("[AI-Dive] 🔄 OWN→OPP flicker — read held under 0.35s, no wipe")
			end
		else
			ST.ownFlipT = flipNow
			ST.commitDir, ST.commitFrames = nil, 0
			ST.baitMark, ST.baitLogged = nil, nil
			ST.curveChaseN, ST.curveChaseSide = 0, nil
			log("[AI-Dive] 🔄 OWN→OPP — teammate's touch ended: read re-armed fresh")
		end
	end

	-- 🎭 HANDLER READ (v2.46): the dangerous man is whoever HAS the ball —
	-- NetworkOwner first (authoritative; it does not blink mid-pass), then the
	-- carrier heuristic, then the last shooter. Computed HERE, before the
	-- prediction gates, with a short hold-on: the quiet half-second of a
	-- one-two (ball in flight between two attackers — no carrier, sub-release
	-- speed, possession reads nil) must NOT wipe the read. A completed pass or
	-- steal flips the identity — the flip is logged, which doubles as console
	-- proof the counter followed the ball. Own-team touch clears it; a loose
	-- ball lets it decay after 1.2 s.
	local attackerPlayer
	if netOwner then
		if not ((netOwner == LocalPlayer) or (myKey ~= nil and teamKeyOf(netOwner) == myKey)) then
			attackerPlayer = netOwner
		end
	elseif carrierPlayer or carryPlayer then
		local h = carrierPlayer or carryPlayer
		if not (myKey ~= nil and (carrierKey == myKey or teamKeyOf(h) == myKey)) then
			attackerPlayer = h
		end
	elseif lastShooterPlayer and (now - lastShooterTime) < CONFIG.SHOT_OWNER_MEMORY then
		if not (myKey ~= nil and shooterKey == myKey) then
			attackerPlayer = lastShooterPlayer
		end
	end
	if attackerPlayer then
		local hKey = charByPlayer[attackerPlayer]
		if hKey then
			if ST.hChar ~= hKey then
				local st = styleStance(hKey)
				if ST.hChar then
					log(string.format("[AI-Dive] 🎭 HANDLER | %s → %s | counter re-armed%s",
						(CHAR_PROFILES[ST.hChar] and CHAR_PROFILES[ST.hChar].label) or ST.hChar,
						(CHAR_PROFILES[hKey] and CHAR_PROFILES[hKey].label) or hKey,
						st and (" — " .. st.name) or ""))
				else
					log(string.format("[AI-Dive] 🎭 HANDLER | %s | counter armed%s",
						(CHAR_PROFILES[hKey] and CHAR_PROFILES[hKey].label) or hKey,
						st and (" — " .. st.name) or ""))
				end
				ST.hChar = hKey
				ST.prof:handle(attackerPlayer.Name, now) -- 📈 v2.80 pass ledger
			end
			ST.hUntil = now + 1.2
			ST.hPlayer = attackerPlayer
		end
	elseif poss == "own" then
		ST.hChar = nil
		ST.hPlayer = nil
	elseif ST.hChar and now > ST.hUntil then
		ST.hChar = nil
		ST.hPlayer = nil
	end

	-- 👑 v2.53: the handler right now is the man mid-awakening? FULL reads on
	-- him until the window closes (the stance/confirm layers consume this).
	local awakeHot = false
	if awakeWatch.untilT > now and awakeWatch.plr == ST.hPlayer then
		awakeHot = true
	end

	-- 🪤💀 v2.67 DEAD-BALL REGRET — HERE, not at diveWatch expiry: a ball that
	-- QITS in front of us must register the moment it is PROVEN dead, before
	-- the keeper's own walk smother-collects it (that grab would resolve the
	-- dive-watch as a SAVE and the lesson would vanish). An open watch + a
	-- ball bled under DEAD_BALL_SPEED for 0.3s of flight past our dive = the
	-- leap was bought with a feint. The shooter's episode count climbs exactly
	-- like a held ball's — bait that FOOLS us costs the same as bait we
	-- refuse — and the second-shot watch arms like any unresolved dive.
	if not diveWatch.resolved and diveWatch.time > 0
		and (now - diveWatch.time) > 0.3
		and speed < CONFIG.DEAD_BALL_SPEED
		and (ballPos - rootPos).Magnitude > CONFIG.BAIT_SMOTHER_DIST then
		diveWatch.resolved = true
		ST.reboundUntil = now + CONFIG.REBOUND_WINDOW
		baitEpisode(lastShooterKey, now)
		if (not ST.regretLogged) or (now - ST.regretLogged > 2.5) then
			ST.regretLogged = now
			log(string.format("[AI-Dive] 🪤💀 DEAD BALL REGRET — dive fired, then the ball quit at %.0f/s @%.0f studs — that shooter's bait count climbs", speed, (ballPos - rootPos).Magnitude), true)
		end
	end

	-- ⚡ Consumption rides alongside the watchdog, above the quiet gate: a
	-- feint-er stands STILL, and below this line a still ball returns before
	-- any per-frame reading happens at all. First live frame of a SNAP-class
	-- counter alert (deduped on the alert itself) = the PROMISE; its expiry
	-- with no strike credited = the FAKE.
	if abilityAlert and abilityAlert.expiresAt > now then
		local cmW = COUNTER_MODES[abilityAlert.counterKey or abilityAlert.moveKey]
		if cmW and cmW.snap and ST.snapAlertT ~= abilityAlert.t then
			ST.snapAlertT, ST.snapT = abilityAlert.t, now
			ST.snapKey = (ST.hPlayer and teamKeyOf(ST.hPlayer)) or ST.snapKey
			ST.snapMove = tostring(abilityAlert.move or "snap move")
		end
	end
	-- ⚔️ v2.70 FAKE CHOP, PER THE BOOKS ("You can feint Predator Shot by looking
	-- down... fool the goalkeeper into diving"; the chop itself is documented as
	-- "a feint into a chop dribble"). A snap promise — any SNAP-class counter
	-- alert, King's Chop included — that rides out its grace with NOTHING above
	-- shot speed credited behind it was a swing at air and momentum. This
	-- watchdog runs ABOVE the quiet-ball return: the classic feint never
	-- launches a ball at all, so a ball-speed gate would never see it. One
	-- episode per cast on the caster's tab — a real follow-up strike credits
	-- inside the grace and clears the charge, so only the empty swing is ever
	-- punished. The raised baiter bar does the rest: his pokes die un-dived,
	-- his real ones still get met frame-one.
	if ST.snapT and ST.windupMarked ~= ST.snapT
		and (now - ST.snapT) >= CONFIG.SNAP_FAKE_GRACE
		and speed < CONFIG.MIN_SHOT_SPEED
		and ST.lastShotReset < ST.snapT + 0.02 then
		ST.windupMarked = ST.snapT
		if ST.snapKey then baitEpisode(ST.snapKey, now) end
		log(string.format("[AI-Dive] ⚔️ FAKE WIND-UP — %s rode out with no strike behind it — the swing counts against him", ST.snapMove), true)
	end

	if speed < CONFIG.MIN_INTEREST_SPEED then
		-- 🪤 v2.82: quiet is not the same as safe. The gate exists to skip
		-- PREDICTION for dead balls — but a feint-speed opponent at a dead
		-- ball's feet is exactly the shape bait-2.0 hunts (the sprint that
		-- quits, the 180° turn), and a slow drop into the mouth is stalked,
		-- not waited out. A live bait shape — or one second of its
		-- afterimage — keeps the read running; everything else idles as
		-- before, and the PREDICTION is still skipped for all of it.
		local baitish = false
		local manAtBall = false
		local nearOppAtBall = false
		for _, e in ipairs(refreshPlayerRoots()) do
			local dGate = (e.root.Position - ballPos).Magnitude
			if dGate <= 12 then manAtBall = true end
			if dGate <= 4 then nearOppAtBall = true end
			if e.vel and e.vel.Magnitude > 15 and dGate <= 20 then
				ST.baitHeatT = now
				baitish = true
			end
		end
		local dropNear = velocity and velocity.Y < -1 and ballPos.Y > 5
			and (ballPos - rootPos).Magnitude <= 12
		-- heat alone (the sprint that quit) only opens the net when the stall
		-- shape is on: dead ball in the 11–26 band with a man still at it.
		-- A real shot that dies point-blank has its shooter 30 studs away —
		-- that stays closed. (speed/distToGoalie: the gate runs before the
		-- post-gate locals, so they are read straight from the ball state.)
		local stallShape = (ST.baitHeatT and (now - ST.baitHeatT) < 1.0)
			and speed < 5 and (ballPos - rootPos).Magnitude > 11 and (ballPos - rootPos).Magnitude <= 26
			and manAtBall
		-- 🪤 v2.83 PULL SHAPE: a bomb-class man's fresh credit with the
		-- ball crawling AWAY from goal inside 30 studs is the devour pull-back
		-- in progress — the POWER PULL read needs those quiet frames too.
		local pullShape = false
		if abilityAlert and (abilityAlert.char == "barou" or abilityAlert.char == "kunigami"
				or abilityAlert.char == "ichigo" or abilityAlert.char == "dio")
			and lastShooterPlayer and (now - lastShooterTime) < 1.2
			and speed < 15 and (ballPos - rootPos).Magnitude <= 30 and goal then
			pullShape = velocity:Dot(goal.linePos - ballPos) < -3
		end
		-- 🪤 v2.83 BAIT 3.0 gate shapes: the second-generation fakes
		-- open the net on their own motion signatures, not on a sprint.
		-- A disengagement: the ball going away from the keeper at carrier
		-- pace, well past the smother line (a clearance is a pass, not a
		-- threat — but the read that follows it may be the real one).
		local walkawayShape = velocity and (rootPos - ballPos):Dot(velocity) < -8
			and speed >= 6 and speed < 30 and (ballPos - rootPos).Magnitude > CONFIG.BAIT_SMOTHER_DIST
		-- A dead cross in progress: once fast (crossPeak) now crawling, far out.
		local bleedShape = lastShooterPlayer ~= nil and (now - lastShooterTime) < 1.2
			and (ST.crossPeak or 0) >= 40 and (ST.crossPeak or 0) - speed >= 30
			and speed < 8 and (ballPos - rootPos).Magnitude > 15
			and goal ~= nil
			and math.abs((ballPos - goal.linePos):Dot(goal.axis)) > goal.halfWidth + CONFIG.BALL_RADIUS
		-- A soft class shot in flight: fresh credit, sub-roller speed, coming
		-- at the keeper from beyond the smother line (the ledger decides).
		local classSoftShape = lastShooterPlayer ~= nil and (now - lastShooterTime) < 0.6
			and speed >= CONFIG.MIN_SHOT_SPEED and speed < 45
			and (rootPos - ballPos):Dot(velocity) > 0
			and (ballPos - rootPos).Magnitude > CONFIG.BAIT_SMOTHER_DIST + 11
		-- A handoff in progress: a fresh mid-speed ball with a SECOND man at it.
		local handoffShape = lastShooterPlayer ~= nil and (now - lastShooterTime) < CONFIG.HANDOFF_WINDOW
			and speed >= 8 and speed <= CONFIG.BAIT_ROLL_MAX + 1 and nearOppAtBall
		-- 👑 v2.83 PREDATOR SHAPE: a power man (Barou first — his whole kit is
		-- announced power) PARKED on a dead ball inside range, holding the pose.
		-- This is the one quiet-ball signature the net must open for on its own:
		-- nothing is moving at all, so no other gate can see it, and it is
		-- exactly the stillness the Predator Shot is struck out of.
		local predatorShape = false
		if carrierPlayer and speed < 8 and manAtBall
			and (ballPos - rootPos).Magnitude > CONFIG.BAIT_SMOTHER_DIST
			and (ballPos - rootPos).Magnitude <= 40 then
			local cKey = charByPlayer[carrierPlayer]
			predatorShape = (cKey == "barou") or (ST.hChar == "barou")
				or (abilityAlert ~= nil and abilityAlert.char == "barou")
				or ST.prof:powerClass(carrierPlayer.Name)
		end
		-- A stander orbiting a dead ball (the circle tell itself).
		local circleShape = false
		for _, e in ipairs(refreshPlayerRoots()) do
			if e.vel and e.vel.Magnitude >= 3 then
				local gdx = e.root.Position.X - ballPos.X
				local gdz = e.root.Position.Z - ballPos.Z
				if (gdx * gdx + gdz * gdz) <= 9 then -- 3 studs at the boot, height ignored
					circleShape = true
					break
				end
			end
		end
		if not baitish and not stallShape and not pullShape and not dropNear
			and not walkawayShape and not bleedShape
			and not classSoftShape and not handoffShape
			and not circleShape and not predatorShape then
			markIdle()
			return
		end
	end

	local distToGoalie = (ballPos - rootPos).Magnitude
	if distToGoalie > CONFIG.MAX_INTEREST_DISTANCE then
		markIdle()
		return
	end


	-- 🧤 GK MOVE PREDICTION: the keeper is usually MOVING (recovering after
	-- a dive, sweeping off the line). The save check happens where the
	-- keeper WILL be, so aim the whole ball prediction at the keeper's
	-- future position — extrapolated toward the ball's ETA (teleport-guarded).
	local aimPos = rootPos
	local gkSlot = sampleSlot(GK.history, 24)
	gkSlot.pos, gkSlot.t = rootPos, now
	-- 🔮 v2.84 GK MOVE PREDICTION 2.0 (WHERE YOU ARE): feed the keeper's own
	-- motion to the predictor EVERY frame — the 0.5s player-root scan is far
	-- too coarse to see a dive recovery, and this is the one body in the
	-- stadium whose position we can read without a round trip.
	if ST.mp then ST.mp:observeKeeper(rootPos, now) end
	do
		local n = #GK.history
		local j = 1
		while j < n and (GK.history[n].t - GK.history[j].t) < 0.4 do
			j = j + 1
		end
		local dt = GK.history[n].t - GK.history[j].t
		local span = (GK.history[n].pos - GK.history[j].pos).Magnitude
		-- span < dt*80 = normal movement (a respawn teleport is ignored)
		if dt > 0.08 and span < dt * 80 then
			local gVel = (GK.history[n].pos - GK.history[j].pos) / dt
			local estTTI = math.max(0, (distToGoalie - 3) / math.max(speed, 1))
			local lead = math.min(estTTI, CONFIG.GK_PREDICT_MAX * ST.clock:scale(now))
			if lead > 0.05 then
				-- v2.84 (WHERE YOU WILL GO NEXT): the predictor carries
				-- ACCELERATION into the horizon. v2.44 flew the keeper in a
				-- straight line from a single velocity; a keeper who is
				-- ACCELERATING off his line is further along by arrival time
				-- than straight-line flight says, and a keeper DECELERATING
				-- (landing a dive, braking a sweep) is short of it. Same
				-- measured velocity, better landing point.
				local pk = ST.mp and ST.mp:keeperAt(lead)
				aimPos = pk or (rootPos + gVel * lead)
			end
		end
	end

	-- 🥅 REAL-TIME CONCEDE: a goal is counted only when the ACTUAL ball
	-- crosses the line through the mouth (never the prediction, and a recent
	-- save can't double-count as a goal). If WE last shot it, it's OUR GOAL.
	if goal then
		local realDepth = (ballPos - goal.linePos):Dot(goal.normal)
		if realDepth > 2 then
			ST.lastInFront = now
		end
		if prevRealDepth and prevRealDepth > 0 and realDepth <= 0 then
			local lateralNow = (ballPos - goal.linePos):Dot(goal.axis)
			local inMouth = (math.abs(lateralNow) <= goal.halfWidth + CONFIG.BALL_RADIUS)
				and (ballPos.Y <= goal.crossbarY + CONFIG.BALL_RADIUS)
			-- 🐛 FAKE-GOAL FIX: a goal is the RESULT of a shot — it must
			-- happen shortly after a credited kick, at shot speed. A carried
			-- ball walked behind you or a wide crossing is not a goal.
			local fromShot = (now - ST.lastShotReset) < CONFIG.CONCEDE_SHOT_WINDOW
			if inMouth and fromShot and speed > CONFIG.CONCEDE_MIN_SPEED
				and (now - ST.lastConcede) > 3 and (now - ST.lastSaveTime) > 3 then
				ST.lastConcede = now
				local ownGoal = (myKey and shooterKey == myKey)
					and (now - lastShooterTime) < CONFIG.SHOT_OWNER_MEMORY
				if ownGoal then
					ST.pendingFlash = { text = "OUR GOAL!!", color = Color3.fromRGB(80, 255, 120), t = now }
					log("[AI-Dive] ⚽ OUR GOAL!")
				else
					matchStats.conceded = matchStats.conceded + 1
					diveWatch.resolved = true
					ST.pendingFlash = { text = "GOAL...", color = Color3.fromRGB(255, 60, 60), t = now }
					log("[AI-Dive] 🥅 CONCEDED")
				end
			end
		end
		prevRealDepth = realDepth
	else
		prevRealDepth = nil
	end

	-- 📈 SAMPLE SHOT POWER: ~0.25s after a kick, record the shot's peak speed
	-- for that player. This is how the AI learns a Big Bang Drive sniper from
	-- a weak long shot.
	if pendingShotRecord then
		local age = now - pendingShotRecord.t
		if age >= 0.25 then
			local rec, pendingShotRecord = pendingShotRecord, nil
			if rec.maxSpeed >= 40 and rec.player then
				local st = playerShotStats[rec.player] or { sum = 0, n = 0 }
				st.sum, st.n = st.sum + rec.maxSpeed, st.n + 1
				playerShotStats[rec.player] = st
			end
		else
			pendingShotRecord.maxSpeed = math.max(pendingShotRecord.maxSpeed, speed)
		end
	end


	-- 🎯 CONTROLLED-BALL GATE (v2.40 — the "dives when they don't shoot" fix):
	-- a RELEASED shot moves AWAY from its shooter — the ball-to-nearest-
	-- opponent gap GROWS at shot speed. A CARRIED ball (hand-carry,
	-- dribble-in, walk-in) keeps a roughly CONSTANT gap. We track that gap
	-- across frames: growing > CONTROLLED_SEP_RATE (20 studs/s) = a real
	-- release (no block); flat/closing = CONTROLLED (never dive — the GK
	-- TACKLE path handles it). No opponent velocity needed, so it's immune
	-- to the 0.5s root-refresh staleness. The first frame next to an
	-- opponent is conservatively "controlled" — a real slow shot proves its
	-- separation within ~3 frames (~50ms), which costs nothing because a
	-- slow shot is exactly the ball that gives time.
	-- (bestD comes from the single roster pass above)
	local ballControlled = false
	if bestD and speed <= CONFIG.DRIBBLE_MAX_SPEED then
		local dtC = ST.ctrlT and (now - ST.ctrlT) or 0
		local sep = 0
		if ST.ctrlD and dtC > 0.05 then
			if math.abs(bestD - ST.ctrlD) > dtC * 80 then
				-- 🛡️ teleport / new-possession guard: a gap jump no one
				-- could walk (ball saved, re-carried, respawn) — restart
				-- the baseline and assume controlled this frame.
				sep = 0
			else
				sep = (bestD - ST.ctrlD) / dtC
			end
		end
		ballControlled = (not ST.ctrlD) or (sep <= CONFIG.CONTROLLED_SEP_RATE)
		ST.ctrlD, ST.ctrlT = bestD, now
	else
		ST.ctrlD, ST.ctrlT = nil, nil
	end

	-- 🎪 CHARGE READ (the juggle tell): research shows Shidou's Big Bang
	-- Drive, Dragon Drive AND Bicycle Kick all need the ball IN THE AIR —
	-- the shooter juggles it up first, then fires. 2 juggle cycles from an
	-- opponent in front of goal = an explosive aerial shot is being set up.
	local vySign = velocity.Y > 5 and 1 or (velocity.Y < -5 and -1 or 0)
	-- 🌈 v2.56 FLICK RESPECT: a ball rising RIGHT NEXT TO a nearby opponent
	-- at sub-strike speed is a rainbow flick / dribble pop — the ball and the
	-- chaser's gap stays small, unlike a struck shot. Stamp the memory NOW (the
	-- rise is the only moment both the proximity and the vertical sign are
	-- unambiguous); the loft lunge and the top-bin jump read it while the drop
	-- is still in the air, seconds later, when it already LOOKS like a shot.
	local flickRise = false
	if vySign == 1 and nearPlayer and nearDist <= CONFIG.FLICK_CARRY_RADIUS
		and speed < CONFIG.DRIBBLE_MAX_SPEED then
		flickRise = true
		local was = ST.flickT
		ST.flickT = now
		-- 🌈 v2.81 SCORPION DISCIPLINE bookkeeping: WHO popped it (the kit
		-- itself is read at the hold, because the style tag can land later).
		ST.flickKey = nearPlayer and nearPlayer.Name or nil
		if not was or now - was > 1.5 then
			log("[AI-Dive] 🌈 FLICK RESPECT | " .. (styleNameByPlayer[nearPlayer] or nearPlayer.Name)
				.. " popped it up at his own feet — no lunge, no leap, let it land")
		end
	end
	if vySign == 1 and CHARGE.lastVySign == -1 then
		-- the ball just rose off a player's feet (a juggle touch)
		if nearPlayer and not flickRise and nearDist <= CONFIG.CHARGE_JUGGLE_RADIUS
			and (now - CHARGE.windowStart) <= 3 then
			if CHARGE.cycles == 0 then CHARGE.windowStart = now end
			CHARGE.cycles = CHARGE.cycles + 1
			local isEnemyCarrier = not (myKey and teamKeyOf(nearPlayer) == myKey)
			if CHARGE.cycles >= 2 and isEnemyCarrier and distToGoalie < CONFIG.CHARGE_RANGE then
				CHARGE.armedUntil = now + CONFIG.CHARGE_ALERT_TIME
				CHARGE.style = styleNameByPlayer[nearPlayer] or nearPlayer.Name
				CHARGE.cycles = 0
				log("[AI-Dive] 🎪 CHARGED SHOT — " .. CHARGE.style
					.. " is juggling in front of the goal! Staying armed.")
			end
		end
	end
	CHARGE.lastVySign = vySign
	if (now - CHARGE.windowStart) > 3 then
		CHARGE.cycles = 0
	end

	-- 🧭 STRIKER MOVE PREDICTION: track the threat player, project them into
	-- the future, and read which side they're DRIVING toward — so the keeper
	-- knows where the shot will come from BEFORE it's struck.
	local striker = nil
	if poss == "opp" then
		striker = (speed < CONFIG.DRIBBLE_MAX_SPEED and carrierPlayer) or lastShooterPlayer
	end
	MOVE.pos = nil
	MOVE.side = nil
	if striker then
		if MOVE.player ~= striker then
			MOVE.player = striker
			MOVE.history = {}
		end
		local sPos = nil
		for _, e in ipairs(refreshPlayerRoots()) do
			if e.player == striker then
				sPos = e.root.Position
				break
			end
		end
		if sPos then
			local mSlot = sampleSlot(MOVE.history, 20)
			mSlot.pos, mSlot.t = sPos, now
			-- velocity over the last ~PREDICT_TIME of movement
			local n = #MOVE.history
			local j = 1
			while j < n and (MOVE.history[n].t - MOVE.history[j].t) < CONFIG.PREDICT_TIME do
				j = j + 1
			end
			local dt = MOVE.history[n].t - MOVE.history[j].t
			if dt > 0.08 then
				local sVel = (MOVE.history[n].pos - MOVE.history[j].pos) / dt
				if sVel.Magnitude > CONFIG.PREDICT_MIN_SPEED then
					MOVE.pos = MOVE.history[n].pos + sVel * CONFIG.PREDICT_TIME
					local sLat = (MOVE.pos - rootPos):Dot(camRight)
					if sLat > 3 then
						MOVE.side = "Right"
					elseif sLat < -3 then
						MOVE.side = "Left"
					end
				end
			end
		end
		-- 🎯 PRIME the direction read toward the drive side: a shot that
		-- matches the drive confirms one frame faster than a cold read.
		if MOVE.side and speed < CONFIG.DRIBBLE_MAX_SPEED then
			ST.commitDir = MOVE.side
			ST.commitFrames = 1
		end
	else
		MOVE.player = nil
		MOVE.history = {}
	end

	-- ⚔️ STYLE AWARENESS: who is attacking? Adapt the keeper's thresholds.
	-- A fresh move-effect alert (last ~2.5s) overrides the character guess.
	-- v2.46: the fallback is the HANDLER READ above the gates — unlike the old
	-- inline carrier lookup, it survives the one-two's flight, and it flips to
	-- the receiver the moment the catch makes him the live holder.
	local attackerChar, profile
	if abilityAlert and (now - abilityAlert.t) < 2.5 then
		attackerChar = abilityAlert.char
		profile = CHAR_PROFILES[attackerChar]
	else
		attackerChar = ST.hChar
		profile = attackerChar and CHAR_PROFILES[attackerChar] or nil
	end

	local effBombSpeed = CONFIG.BOMB_SPEED
	local effHeightMax = CONFIG.REACH_HEIGHT_MAX
	local effCooldown  = CONFIG.COOLDOWN_TIME
	if profile then
		effBombSpeed = math.min(effBombSpeed, profile.bombThreshold or 999)
		effHeightMax = CONFIG.REACH_HEIGHT_MAX + (profile.heightBonus or 0)
		if profile.barrage then
			effCooldown = math.min(effCooldown, 0.5)
		end
	end
	-- Ability alert (move just fired): even more aggressive for 4 seconds.
	if abilityAlert and abilityAlert.expiresAt > now then
		if abilityAlert.aerial then
			effHeightMax = math.max(effHeightMax, CONFIG.REACH_HEIGHT_MAX + 10)
		end
		if abilityAlert.speed == "extreme" then
			effBombSpeed = math.min(effBombSpeed, 120)
		end
		if abilityAlert.barrage then
			effCooldown = math.min(effCooldown, 0.5)
		end
	end

	-- 🎮 COUNTER MODE: a specific move just fired -> switch to that move's
	-- DEDICATED counter (every ability has its own response, see COUNTER_MODES).
	local activeMode = nil
	if abilityAlert and abilityAlert.expiresAt > now then
		local cm = COUNTER_MODES[abilityAlert.counterKey or abilityAlert.moveKey]
		if cm then
			activeMode = cm
			-- 🎭 v2.83 COUNTER 2.0: stamp the move's trust window onto ST
			-- (armAbility carries it on the alert — it is defined above the
			-- ST local and cannot see it). Re-stamped every frame the alert
			-- is fresh, which is idempotent (same arm time, same duration).
			if cm.trust and abilityAlert.trustDur then
				ST.moveTrustT = abilityAlert.trustT or os.clock()
				ST.moveTrustDur = abilityAlert.trustDur
			end
			-- ⚔️ v2.70 WIND-UP WATCH: the first frame this snap promise is alive,
			-- remember WHO cast it (the handler's team key) and WHEN. If the
			-- whole grace rides out with no strike credited after it, the swing
			-- was the feint the fandom documents — the episode goes on his tab.
			effBombSpeed = math.min(effBombSpeed, cm.bombThreshold or 999)
			effHeightMax = math.max(effHeightMax, CONFIG.REACH_HEIGHT_MAX + (cm.heightBonus or 0))
			if cm.suppressJump then
				ST.noLeap = now + (cm.armed or 4)
			end
			if cm.cooldownScale then
				effCooldown = math.min(effCooldown, CONFIG.COOLDOWN_TIME * cm.cooldownScale)
			end
		end
	elseif ST.hChar then
		-- 🎭 v2.46: no move tag alive — the HOLDER's style stance applies.
		activeMode = styleStance(ST.hChar)
		if activeMode and activeMode.cooldownScale then
			effCooldown = math.min(effCooldown, CONFIG.COOLDOWN_TIME * activeMode.cooldownScale)
		end
	end
	-- 👑 v2.69 AWAKENING DISCOUNT (applies to BOTH stances — a cutscene man
	-- with no move tag is still mid-promise): while a handler's awakening
	-- watch is live, whatever he does next is the AWAKENED version of his
	-- move; community lore is unanimous that awakening shots arrive harder
	-- than base (that is what the cutscene IS). The bomb bar drops
	-- AWAKE_BOMB_DISCOUNT so a 140/s awakened bomb commits at bomb urgency
	-- while the SAME speed from an un-awakened man reads routine. Proof, not
	-- panic: the discount never invents speed the ball doesn't have.
	if awakeHot then
		effBombSpeed = math.min(effBombSpeed, CONFIG.BOMB_SPEED - CONFIG.AWAKE_BOMB_DISCOUNT)
	end
	-- 🏃 v2.63 SECOND-SHOT RE-ARM: the combo is timed to the 0.5s reset, so the
	-- reset gets cut from under it while the rebound watch is live.
	if ST.reboundUntil and now < ST.reboundUntil then
		effCooldown = math.min(effCooldown, CONFIG.REBOUND_REARM)
	end

	-- 🎯 PRIME SIDE: some researched counters know which side a move favors
	-- (Sae's Curve Shot "always goes left") — prime the read before release.
	-- (v2.34: the prime now lasts the WHOLE move alert, not just 2.5s — a
	-- curve shot released late in the wind-up still curves — and it is only
	-- dropped once the ball persistently proves itself a straight shot.)
	if activeMode and activeMode.primeSide
		and abilityAlert
		and ST.curveOtherFrames < 20 then
		ST.commitDir = activeMode.primeSide
		ST.commitFrames = 1
	end

	-- 🦸 STAND USER OP MODE: the attacker is a Stand user (Dio & Co.) ->
	-- the keeper goes FULL OP: 150-stud reach, bomb threshold 110, re-arm in
	-- 0.35s, and anything moving is met at full speed.
	local standOp = false
	if abilityAlert and abilityAlert.expiresAt > now then
		local ap = CHAR_PROFILES[abilityAlert.char]
		if ap and ap.stand then standOp = true end
	end
	if not standOp and profile and profile.stand then
		standOp = true
	end
	if standOp then
		effBombSpeed = math.min(effBombSpeed, 110)
		effHeightMax = math.max(effHeightMax, CONFIG.REACH_HEIGHT_MAX + 15)
		effCooldown  = math.min(effCooldown, 0.35)
	end

	-- 🎪 CHARGED SHOT (juggle tell still live): the next shot is an explosive
	-- aerial — meet it like a bomb, from higher up.
	local charged = (now < CHARGE.armedUntil)
	if charged then
		effBombSpeed = math.min(effBombSpeed, 120)
		effHeightMax = math.max(effHeightMax, CONFIG.REACH_HEIGHT_MAX + 8)
	end

	-- 🚀 LATE-SPIKE DETECTOR (Perfect Impact & friends): a shot that suddenly
	-- explodes in speed mid-flight is met instantly, whatever else it is.
	local speedSpike = false
	while #speedHistory > 0 and (now - speedHistory[1].t) > 0.4 do
		table.remove(speedHistory, 1)
	end
	local sSlot = sampleSlot(speedHistory, 45)   -- 45 frames ≈ 0.75s, generous vs the 0.4s window
	sSlot.t, sSlot.s = now, speed
	do
		-- Ignore the strike's own launch (first 0.12s after a reset)
		local windowStart = ST.lastShotReset + 0.12
		local minS, count = math.huge, 0
		for _, h in ipairs(speedHistory) do
			if h.t > windowStart then
				count = count + 1
				if h.s < minS then minS = h.s end
			end
		end
		if count >= 3 and speed > minS + CONFIG.SPEED_SPIKE_DELTA then
			speedSpike = true
		end
	end

	-- 🎭 FAKE SHOT DETECTOR (v2.43 — the Barou fake, widened to FAST fakes):
	-- the v2.32 hold only covered pops peaking 40-69 — an in-game chop that
	-- pops at 75-95 sailed past the window and got a frame-zero dive. Now
	-- two layers cover the WHOLE pop range:
	--  (1) FRESH-POP CONFIRM: the first 0.10s of a sub-110 pop is unproven —
	--      a real strike sustains, a fake dies. No full dive in that window
	--      (the release gate already holds sub-75 pops at the feet, so the
	--      confirm mainly covers the 75-109 band where a fast fake lives).
	--      A 110+ pop is real shot speed — it dives on frame one.
	--  (2) BLEED HOLD: the pop dropped 12+ off its peak, is now under 70,
	--      AND the ball is still within 14 studs of where it was kicked —
	--      a fake DIED at the feet. A real shot (even one that bounces and
	--      bleeds) is already 14+ studs out by the time it drops that much,
	--      so it escapes the hold and still gets dived. Self-releasing: the
	--      moment the ball has traveled 14 studs the hold lifts.
	local fakeHold = false
	-- 🃏 v2.81 TRICKY TRUST (v2.83: a move's own window counts): the backheel family STRUCK the ball with a NAME
	-- on it (the effect announced at the kick) — an announced ~50/s heel flick
	-- is a shot, and neither the fresh-pop confirm nor the bleed hold may eat
	-- it. The stamp is fresh, shooter-matched, and short: theatre gets no
	-- pass, only named fire does.
	-- 🎭 v2.83: the named-move trust window is folded into trickyTrust — the
	-- soft nets stand aside for any announced strike, not only the backheel family.
	local moveTrust = ST.moveTrustT ~= nil and (now - ST.moveTrustT) < (ST.moveTrustDur or 0)
		and lastShooterPlayer ~= nil
	local trickyTrust = (ST.trickyT ~= nil and (now - ST.trickyT) < CONFIG.SWING_TRUST
		and lastShooterPlayer ~= nil and ST.trickyName == lastShooterPlayer.Name)
		or moveTrust
	-- ⚗️ v2.68 REACTION STRIKE: the ball arriving at a WATCHED opponent
	-- receiver and a fresh strike credited to that same man within
	-- REACTION_WINDOW is the documented chemical-reaction finish (fandom, Reo→
	-- Nagi: "the follow-up completes as the pass reaches" him — a trap-shot is
	-- instant by definition). Every "slow ball near the boot is a poke" rule
	-- would eat it, so the whole bait family stands aside for ONE strike,
	-- then re-arms — the concession is single-use by construction.
	local reactionStrike = ST.reactStrikeT and (now - ST.reactStrikeT) < CONFIG.REACTION_WINDOW
	-- 🪤 v2.83 BAIT 3.0 TRUSTS — the reads that EARN the keeper his
	-- convictions: a launch out of a checked run is the real one (the check
	-- WAS the feint), a cross out of a dead cross is the real one (the dead
	-- one was the setup), a named move with a trust window is a strike.
	local carryTrustActive = ST.carryTrustKey ~= nil
		and lastShooterPlayer ~= nil and lastShooterPlayer.Name == ST.carryTrustKey
		and (now - ST.carryTrustT) < (ST.carryTrustDur or CONFIG.CARRY_TRUST_TIME)
	local crossTrustActive = ST.crossTrustKey ~= nil
		and lastShooterPlayer ~= nil and lastShooterPlayer.Name == ST.crossTrustKey
		and (now - ST.crossTrustT) < CONFIG.BLEED_CROSS_TRUST
	local freshPopConfirm = false
	do
		local sinceShot = now - ST.lastShotReset
		if speed > 5 then
			-- ⚡ v2.70 the LAUNCH METER has a ceiling: above EXTREME_SPEED a
			-- "spike" is physics-lying noise — a respawn snap-back, a welded
			-- part drag, a teleport — never a strike. Reading it as launch
			-- speed would EXEMPT bait (the fixtures' own reset spikes caught
			-- exactly this). Trust the meter only within what the game can do.
			if sinceShot < 1.5 and speed > ST.peakSinceShot and speed <= CONFIG.EXTREME_SPEED then
				ST.peakSinceShot = speed
			elseif sinceShot >= 1.5 then
				ST.peakSinceShot = 0 -- stale credit: the test starts clean
			end
			-- (1) FRESH-POP CONFIRM — but NEVER on a known curve move (Rin /
			-- Sae): those are researched REAL shots that must commit early,
			-- not fakes. A fake is a generic chop with no curve prime. The
			-- confirm ends early the moment the pop PROVES itself a real
			-- shot (already 12+ studs out AND still 75+ speed) — so a real
			-- strike loses only ~0.11s, while a bleeding fake (which drops
			-- below 75 before it travels 12 studs) is held the whole window.
			local cChar = lastShooterPlayer and lastShooterPlayer.Character
			local cRoot = cChar and cChar:FindFirstChild("HumanoidRootPart")
			local cTravel = cRoot and (ballPos - cRoot.Position).Magnitude or 999
			local provenShot = (cTravel >= 12) and (speed >= 75)
			freshPopConfirm = sinceShot > 0.01
				and sinceShot < CONFIG.FAKE_CONFIRM_TIME
				and ST.peakSinceShot > 20
				and ST.peakSinceShot < CONFIG.FAKE_CONFIRM_PEAK
				and (activeMode and activeMode.primeSide) == nil
				and (not provenShot)
				and not carryTrustActive -- 🪤 v2.83: the launch out of a checked run is the real one
				and not (trickyTrust) -- 🃏 v2.81: named heel flick, confirmed by its own effect
				and not reactionStrike -- ⚗️ v2.68: a reaction finish is PROVEN by the pass
			-- (2) BLEED HOLD
			if sinceShot > 0.04
				and sinceShot < CONFIG.FAKE_WINDOW
				and ST.peakSinceShot >= CONFIG.FAKE_PEAK_MIN
				and ST.peakSinceShot <= CONFIG.FAKE_PEAK_MAX
				and speed < CONFIG.FAKE_SPEED_MAX
				and (ST.peakSinceShot - speed) > CONFIG.FAKE_DROP_ABS then
				local sChar = lastShooterPlayer and lastShooterPlayer.Character
				local sRoot = sChar and sChar:FindFirstChild("HumanoidRootPart")
				local travel = sRoot and (ballPos - sRoot.Position).Magnitude or 0
				fakeHold = ((not sRoot) or (travel <= CONFIG.FAKE_TRAVEL))
					and not trickyTrust -- 🃏 a named backheel that "bleeds" is STILL coming
			end
		end
	end

	-- 📈 SHOOT FORECAST: while the ENEMY has the ball, how likely is the shot,
	-- and which side will it come in on? Chance climbs as they close in.
	-- Rush-style counters (Demon Rush, Lightning Dribble) widen the range.
	local shootRange = CONFIG.SHOOT_RANGE + (activeMode and (activeMode.rangeBoost or 0) or 0)
	local shootChance, sideL, sideR = nil, 50, 50
	-- Forecast from the PREDICTED striker position when available (0.35s
	-- ahead of where they are), falling back to their raw position.
	local fPos = (poss == "opp" and MOVE.pos) or carrierPos
	if poss == "opp" and fPos and speed < CONFIG.DRIBBLE_MAX_SPEED then
		local sd = (fPos - rootPos).Magnitude
		if sd <= shootRange then
			shootChance = math.max(5, math.floor((1 - sd / shootRange) * 100))
			-- Side forecast: strikers usually shoot from the side they're driving to
			local lat = (fPos - rootPos):Dot(camRight)
			local nearChance = math.floor((0.55 + 0.25 * math.clamp(math.abs(lat) / 25, 0, 1)) * 100)
			if lat >= 0 then
				sideR, sideL = nearChance, 100 - nearChance
			else
				sideL, sideR = nearChance, 100 - nearChance
			end
		end
	end

	-- 📏 DYNAMIC COMMIT STUDS: slow shots commit close (~25), fast shots commit
	-- earlier (up to 48). Predicted power comes from the possessor's history;
	-- some counter modes commit even farther out (commitBonus).
	local targetPlayer = carrierPlayer or lastShooterPlayer
	local predSpeed = nil
	if targetPlayer then
		local st = playerShotStats[targetPlayer]
		if st and st.n > 0 then
			predSpeed = st.sum / st.n
		end
	end
	if not predSpeed then
		predSpeed = 100
	end
	local commitBonus = activeMode and (activeMode.commitBonus or 0) or 0
	if ST.reboundUntil and now < ST.reboundUntil then
		commitBonus = commitBonus + CONFIG.REBOUND_COMMIT -- 🏃 meet the SECOND one already moving
	end
	local commitDist = math.clamp(CONFIG.COMMIT_BASE_DIST + predSpeed * CONFIG.COMMIT_SPEED_FACTOR + commitBonus,
		CONFIG.COMMIT_BASE_DIST, CONFIG.COMMIT_MAX_DIST)

	-- Dribble = CARRY (any speed) OR an OPPONENT at a slow ball. A real
	-- struck ball clears both checks on the same frame, so point-blank
	-- volleys are never misread as a dribble.
	-- oppNear (nearest opponent, from the same pass) replaces the three helper
	-- scans it used to need: anyRootNear x2 + minRootDist, each of them another
	-- loop over the roster every single frame.
	local isDribbling = isCarried
		or ((speed < CONFIG.DRIBBLE_MAX_SPEED) and (oppNear <= CONFIG.DRIBBLE_IGNORE_RADIUS))

	-- 📸 RELEASE GATE (the official GK guide: "react to the ball's RELEASE,
	-- not the opening animation — diving during a dribble animation lets
	-- the attacker wait and finish into the empty side"): while the ball is
	-- still at an opponent's feet at sub-shot speed, it hasn't been shot —
	-- it's a dribble tap, a carry, or a shot ANIMATION (a feint). The keeper
	-- waits for the release; the dive fires the frame the ball leaves the
	-- feet at shot speed.
	local isDribbleTap = (oppNear <= CONFIG.RELEASE_FEET_RADIUS)
		and (speed < CONFIG.SHOT_RELEASE_SPEED)
	if isDribbleTap then
		isDribbling = true
	end
	local isHyperShot = ST.smoothedSpeed >= CONFIG.HYPER_SHOT_SPEED
	local strikerDist = oppNear -- nearest opponent at the ball (HUD + commit maths)

	-- Projection of ball velocity onto the "toward the keeper" axis.
	-- Positive = coming at us. Clearly negative = going away (pass/clear).
	local approachSpeed = (rootPos - ballPos):Dot(velocity) / math.max(speed, 1)
	-- 🪤 v2.82 APPROACH STALL memory: the hottest TRUE ball speed of the
	-- burst (approachSpeed is a normalized projection — a distance, not a
	-- speed — so the peak is read off `speed` while the ball still moves
	-- toward us), with its last-motion stamp. The stall test reads both
	-- after the death.
	local approaching = approachSpeed > 0
	if approaching and speed > 20 and speed > (ST.approachPeak or 0) then
		ST.approachPeak, ST.approachT = speed, now
	end
	-- the sprint itself is the heat: a ball closing at 20+/s is the shape
	-- that becomes a stall the moment it dies
	if approaching and speed > 20 then ST.baitHeatT = now end
	-- 🪤 v2.83 BAIT 3.0: the hottest speed of the CURRENT credited
	-- burst — the BLEEDING CROSS read needs to know the cross was once FAST
	-- before it died (a ball that was never fast was never a cross).
	if lastShooterPlayer and (now - lastShooterTime) < 1.2 and speed > (ST.crossPeak or 0) then
		ST.crossPeak, ST.crossPeakT = speed, now
	end
	if ST.crossPeak and (now - (ST.crossPeakT or 0)) > 1.5 then ST.crossPeak = 0 end
	if ST.approachPeak and (now - (ST.approachT or 0)) > 1.5 then ST.approachPeak = 0 end
	local movingAway    = approachSpeed < -CONFIG.AWAY_THRESHOLD

	-- 🌈 JUGGLE / RAINBOW DETECTION: a juggling ball is not a shot.
	--   (a) It's RISING — shots don't rise at goal.
	--   (b) It just rose and is drifting down slowly — mid-juggle.
	--   (c) It's falling almost straight down with a player under it — a
	--       juggle drop (the carrier radius can't see the ball overhead).
	if velocity.Y > 3 then
		lastRiseTime = now
	end
	-- (playerUnderBall comes from the single roster pass above)
	local isJuggle = false
	-- 🎯 TOP-BIN FIX (v2.37): a ball at SHOT SPEED is a shot, not a juggle —
	-- even when it's RISING. Top-bin shots rise during their initial flight
	-- (you must kick up to aim at the top corner), and the old "any rise
	-- > 2 studs/s = juggle" rule misread them as juggles and the keeper
	-- stood still ("JUGGLE — SAFE") while the ball went into the top bin.
	-- A real juggle is a controlled ball and never reaches shot speed.
	if velocity.Y > CONFIG.JUGGLE_RISE_SPEED and speed < CONFIG.MIN_DIVE_SPEED then
		isJuggle = true
	else
		local hSpeed = math.sqrt(velocity.X * velocity.X + velocity.Z * velocity.Z)
		local recentlyRose = (now - lastRiseTime) < 0.7
		-- A ball skimming along the ground is NOT a juggle — the ball must be
		-- actually elevated for the drift case to apply.
		local ballAboveFeet = (ballPos.Y - rootPos.Y) > 1
		if (recentlyRose and hSpeed < CONFIG.JUGGLE_DRIFT_SPEED and ballAboveFeet)
			or ((velocity.Y < -8) and (hSpeed < CONFIG.JUGGLE_DROP_H_SPEED) and playerUnderBall) then
			isJuggle = true
		end
	end

	-- 3) 🌍 TRUE TRAJECTORY SIMULATOR: damped horizontal curve (from the
	-- estimator) + REAL GRAVITY + PITCH BOUNCE. Lofted shots, headers, chips
	-- and bounces at the line are predicted as real arcs — the path dots show
	-- the arc too.
	local minDistance  = math.huge
	local impactX, impactY, impactZ = ballPos.X, ballPos.Y, ballPos.Z
	local timeToImpact = 0
	local crossY, crossLateral, crossWide = nil, nil, nil

	-- Ground level = the lowest the ball has been recently (its contact height).
	-- v2.44: the minimum is recomputed at 4Hz (and instantly when the ball beats
	-- it), not by a 300-entry scan on every single frame. The bounce/roll logic
	-- only needs the level to be right to within a frame or two.
	if (not ST.groundY) or ballPos.Y < ST.groundY or (now - (ST.groundT or 0)) > 0.25 then
		local minY = ballPos.Y
		for i = 1, #yHistory do
			local row = yHistory[i]
			if row and row[1] < minY then minY = row[1] end
		end
		ST.groundY, ST.groundT = minY, now
	end
	local groundY = ST.groundY
	local gravity = -196.2
	do
		local ok, g = pcall(function() return workspace.Gravity end)
		-- 🐛 CRITICAL: Roblox's workspace.Gravity is a POSITIVE magnitude
		-- (196.2) that the engine applies DOWNWARD. The simulator integrates
		-- gY directly into +Y-up velocity, so it needs the NEGATIVE value.
		-- Using it raw made every long-flight prediction FLY UP — slow shots
		-- were ruled "over the bar" and never saved. (Found by the run test.)
		if ok and type(g) == "number" and g ~= 0 then gravity = -math.abs(g) end
	end

	-- Adaptive step: the step shrinks as the ball goes faster, so a 200 studs/s
	-- bomb is integrated ~3x finer than a 60 studs/s pass — crossing and
	-- impact interpolation get much sharper on exactly the shots that matter.
	local simStep = math.clamp(2.0 / math.max(speed, 50), CONFIG.SIM_STEP_MIN, CONFIG.SIM_STEP_MAX)

	local crossPos = nil        -- where the trajectory crosses the line (prediction)
	local crossOnTarget = nil   -- true = through the mouth, false = wide/over

	-- ⚙️ SCALAR INTEGRATOR (v2.44): the loop works in x/y/z numbers instead of
	-- Vector3 objects. Per step it used to allocate one Vector3 for the velocity
	-- update, one for the position update and up to two more for the bounce/roll
	-- branches — over a thousand throwaway tables a second, to fill a path array
	-- that is only ever read as numbers. The goal vectors are unpacked to
	-- components once a frame instead of being dotted twice per step.
	local gx, gy, gz = 0, 0, 0
	local lgx, lgy, lgz = 0, 0, 0
	local lax, laz = 0, 0
	local gHalfWidth, gCrossbarY
	local krx, krz = 0, 0
	if goal then
		gx, gy, gz = goal.normal.X, goal.normal.Y, goal.normal.Z
		lgx, lgy, lgz = goal.linePos.X, goal.linePos.Y, goal.linePos.Z
		lax, laz = goal.axis.X, goal.axis.Z
		gHalfWidth, gCrossbarY = goal.halfWidth, goal.crossbarY
		-- which side of the goal the KEEPER calls right (normal x UP) — the same
		-- basis the dive direction uses, unpacked once a frame
		local kr = goal.normal:Cross(UP)
		krx, krz = kr.X, kr.Z
	end
	local bounceFriction, bounceRest = CONFIG.BOUNCE_FRICTION, CONFIG.BOUNCE_RESTITUTION
	local rollKeep = math.max(0, 1 - CONFIG.ROLL_FRICTION * simStep)
	local targetX, targetY, targetZ = aimPos.X, aimPos.Y, aimPos.Z
	local curveFullTime, curveDecay = CONFIG.CURVE_FULL_TIME, CONFIG.CURVE_DECAY
	local ballMargin = CONFIG.BALL_RADIUS * 0.5

	-- ⚙️ v2.72 TRAJECTORY CACHE — the friend's "still lags" answer. The loop
	-- below integrates 3.5 seconds of flight (up to ~210 steps) EVERY frame;
	-- for a ball in STEADY straight flight that path is the same answer 6
	-- frames in a row. Re-simulate only when something physical changed: new
	-- strike credit, raw speed moved > 8/s, a live lateral ACCEL (curve — and
	-- under CURVE_DEADZONE the estimator already returns zero, so those balls
	-- are genuinely straight and safe to reuse), or the cache's age. The
	-- time-to-impact carries a travel correction so the commit window still
	-- opens on the ball's REAL position, not the cached one. Decisions remain
	-- every-frame: only the projection is reused, and SIM_CACHE_MAX = 0 puts
	-- the old every-frame re-sim back. (pathPos rows are untouched between
	-- misses — the receiver gate reads them consistently.)
	local simHit = false
	if CONFIG.SIM_CACHE_MAX > 0 and ST.simT and ST.simReset == ST.lastShotReset
		and (now - ST.simT) < CONFIG.SIM_CACHE_MAX
		and math.abs(speed - ST.simV) <= 8
		and accel.X == 0 and accel.Z == 0 then
		simHit = true
		minDistance  = ST.simMinD
		impactX, impactY, impactZ = ST.simIX, ST.simIY, ST.simIZ
		timeToImpact = math.max(0, ST.simTTI
			- math.max(0, ST.simDist - distToGoalie) / math.max(speed, 1))
		crossY, crossLateral, crossWide = ST.simCY, ST.simCL, ST.simCW
		crossPos, crossOnTarget = ST.simCP, ST.simCOT
		pathCount = ST.simPathN
	end
	if not simHit then
	local sx, sy, sz = ballPos.X, ballPos.Y, ballPos.Z
	local vx, vy, vz = velocity.X, velocity.Y, velocity.Z
	local acx, acy, acz = accel.X, accel.Y, accel.Z
	pathCount = 0

	local prevDepth = goal and ((sx - lgx) * gx + (sy - lgy) * gy + (sz - lgz) * gz) or nil
	local psx, psy, psz = sx, sy, sz

	local t = 0
	while t < CONFIG.SIM_HORIZON and pathCount < MAX_STEPS - 1 do
		-- Magnus physics: a real curve holds (almost) full sideways force
		-- early in the flight, then decays — full curve for the first
		-- CURVE_FULL_TIME, then decay (stops over-curving on noisy estimates).
		local curveDampener = (t < curveFullTime)
			and 1.0
			or math.max(0, 1 - (t - curveFullTime) * curveDecay)
		-- Vertical: if the estimator measured free fall (accel.Y < -50) trust
		-- THAT (the game may run custom gravity); otherwise use world gravity.
		local gY = (acy < -50) and acy or gravity
		vx = vx + acx * curveDampener * simStep
		vy = vy + gY * simStep
		vz = vz + acz * curveDampener * simStep
		sx, sy, sz = sx + vx * simStep, sy + vy * simStep, sz + vz * simStep
		-- Pitch bounce. v2.41 BUG FIX: a ball RESTING on the ground used to
		-- "bounce" every step (gravity makes vy negative each step while the ball
		-- sits exactly at groundY), so BOUNCE_FRICTION hit vx/vz EVERY STEP and
		-- the predicted ball stopped dead a few studs away — rolling balls then
		-- never produced a line crossing, blinding the honest wide ruling and
		-- causing false dives at balls going wide. A bounce only fires on a real
		-- fall; a resting ball rolls with vy = 0 and only the roll friction.
		if sy <= groundY then
			sy = groundY
			local restThreshold = abs(gY) * simStep * 1.5
			if vy < -restThreshold then
				vx, vy, vz = vx * bounceFriction, -vy * bounceRest, vz * bounceFriction
			elseif vy < 0 then
				vy = 0 -- resting: kill the gravity drip
			end
		end
		-- Rolling friction: a ball on the pitch decelerates (post-bounce
		-- deflections slow down instead of skating forever).
		if sy <= groundY + 0.05 then
			vx, vz = vx * rollKeep, vz * rollKeep
		end

		-- Closest approach is measured against where the keeper WILL BE
		-- (aimPos), not where they are — a keeper mid-recover is moving.
		local ddx, ddy, ddz = sx - targetX, sy - targetY, sz - targetZ
		local d = sqrt(ddx * ddx + ddy * ddy + ddz * ddz)
		if d < minDistance then
			minDistance  = d
			impactX, impactY, impactZ = sx, sy, sz
			timeToImpact = t
		end

		pathCount = pathCount + 1
		local row = pathPos[pathCount]
		row.x, row.y, row.z = sx, sy, sz

		-- 🥅 GOAL LINE CROSSING: first +depth -> -depth transition,
		-- interpolated to the exact crossing point.
		if goal and not crossPos and prevDepth then
			local depth = (sx - lgx) * gx + (sy - lgy) * gy + (sz - lgz) * gz
			if prevDepth > 0 and depth <= 0 then
				local f = prevDepth / (prevDepth - depth)
				local cpx = psx + (sx - psx) * f
				local cpY = psy + (sy - psy) * f
				local cpz = psz + (sz - psz) * f
				local dlx, dlz = cpx - lgx, cpz - lgz
				-- axis-lateral decides on/off the mouth; the keeper-right lateral
				-- decides which way to dive (identical to the old Cross+Dot)
				local latAxis = dlx * lax + dlz * laz
				crossPos = Vector3.new(cpx, cpY, cpz)
				crossY = cpY
				crossWide = abs(latAxis)
				crossLateral = dlx * krx + dlz * krz
				crossOnTarget = (crossWide <= gHalfWidth + ballMargin)
					and (cpY <= gCrossbarY + ballMargin)
			end
			prevDepth = depth
		end
		psx, psy, psz = sx, sy, sz
		t = t + simStep
	end
		ST.simT, ST.simV, ST.simReset = now, speed, ST.lastShotReset
		ST.simMinD, ST.simIX, ST.simIY, ST.simIZ, ST.simTTI = minDistance, impactX, impactY, impactZ, timeToImpact
		ST.simCY, ST.simCL, ST.simCW, ST.simCP, ST.simCOT = crossY, crossLateral, crossWide, crossPos, crossOnTarget
		ST.simPathN, ST.simDist = pathCount, distToGoalie
		-- 📈 v2.82 PATTERN LEAD feed: the predicted crossing that reaches the
		-- line is the shot's AIM — banked per name, once per shot (the
		-- lastShotReset dedupe). A save or a goal does not erase the aim:
		-- the habit is in the aim, not the outcome.
		if crossOnTarget and lastShooterPlayer and ST.lastShotReset ~= ST.cornerShot then
			ST.cornerShot = ST.lastShotReset
			ST.prof:corner(lastShooterPlayer.Name,
				crossLateral > 1.5 and "R" or (crossLateral < -1.5 and "L" or "M"))
		end
	end

	local impactPos = Vector3.new(impactX, impactY, impactZ)

	-- 🚀 v2.83 TRAJECTORY 3.0 (2/5) APEX SETTLE: a ball that is still
	-- climbing does not yet HAVE a crossing height — the arc it is on can
	-- still clear the bar or drop under it, so its predicted height is
	-- PROVISIONAL. Once |vertical speed| falls under APEX_SETTLE_VY the
	-- ball has stopped gaining height and the crossing number is FINAL.
	-- The distinction is what makes the height-reach test below honest: a
	-- provisional height must not be trusted to commit a dive, a settled
	-- one can. (Flat drives are settled from the first frame — they never
	-- climb at all — which is exactly why they get committed rather than
	-- waited on.)
	ST.apexSettled = abs(velocity.Y) <= CONFIG.APEX_SETTLE_VY

	-- 🚀 v2.83 TRAJECTORY 3.0 (3/5) FRAME GRAZE: a crossing that reads
	-- just OUTSIDE the woodwork is not the same shot as one that reads
	-- halfway into the stand. Inside FRAME_GRAZE the ball can clip the
	-- post or the bar and come back in — the geometry is a hair off, not
	-- wrong. Consecutive graze frames are counted so the keeper holds
	-- rather than stands down: the frame is the last thing between him
	-- and a goal, and a graze is one deflection away from being on target.
	if crossWide and goal and (not crossOnTarget)
		and (crossWide <= goal.halfWidth + CONFIG.FRAME_GRAZE
			or (crossY and crossY <= goal.crossbarY + CONFIG.FRAME_GRAZE and crossY > goal.crossbarY)) then
		ST.grazeFrames = (ST.grazeFrames or 0) + 1
	else
		ST.grazeFrames = 0
	end

	if minDistance > CONFIG.MAX_IMPACT_DISTANCE then
		markIdle()
		return
	end

	-- 📥 RECEIVER GATE (v2.42): the last "dives when they don't shoot" case —
	-- a PASS to a teammate. A pass at shot speed that the simulator predicts
	-- crossing the goal mouth reads "on target" and gets a full dive. But if
	-- a non-shooter opponent is standing ON THE BALL'S PREDICTED PATH, the
	-- ball is arriving at them — a receiver who collects it before the line —
	-- not a shot at goal. The keeper WATCHES (and dives at the tap-in if the
	-- receiver actually strikes it). Path proximity (not impact proximity)
	-- is self-correcting: once the ball has PAST the receiver, no opponent
	-- is on the remaining path and the keeper commits. The first 0.15s of
	-- the path is skipped (the launch window) — that's where the KICKER
	-- stands, and a kicker is not a receiver. A real shot's path has no
	-- opponent on it, so honest saves are untouched. The GK tackle (an
	-- intentional steal of a carrier at your feet) is a separate branch and
	-- is NOT gated.
	local receiverInPath = false
	if CONFIG.USE_RECEIVER_GATE then
		local maxSteps = math.min(pathCount, math.ceil(1.2 / simStep))
		for _, e in ipairs(refreshPlayerRoots()) do
			-- v2.44: opponents only, exactly as the gate is documented. Our own
			-- defender standing in the lane suppressed the dive too, and defenders
			-- routinely let a ball go through them — that read as "receiver in
			-- path" and left the net empty for an honest shot.
			local rk = teamKeyOf(e.player)
			if e.player ~= lastShooterPlayer and not (myKey and rk == myKey) then
				local ePos = e.root.Position
				-- A RECEIVER is in FRONT of the ball (the ball is heading to
				-- them); the KICKER is behind it (the ball left them). This
				-- direction test excludes the kicker with no launch-window
				-- gap, so a receiver right up for the catch is still seen.
				local ahead = (ePos.X - ballPos.X) * velocity.X
					+ (ePos.Y - ballPos.Y) * velocity.Y
					+ (ePos.Z - ballPos.Z) * velocity.Z
				if ahead > 0 then
					-- cheap pre-filter: skip players far from the ball now
					local epx = ePos.X - ballPos.X
					local epy = ePos.Y - ballPos.Y
					local epz = ePos.Z - ballPos.Z
					if epx*epx + epy*epy + epz*epz < 35*35 then
						local r2 = CONFIG.RECEIVER_RADIUS * CONFIG.RECEIVER_RADIUS
						for i = 1, maxSteps do
							local p = pathPos[i]
							local dx = p.x - ePos.X
							local dy = p.y - ePos.Y
							local dz = p.z - ePos.Z
							if dx*dx + dy*dy + dz*dz <= r2 then
								receiverInPath = true
								ST.reactPlayer = e.player -- ⚗️ v2.68: the watched receiver
								break
							end
						end
					end
				end
				if receiverInPath then break end
			end
		end
	end

	-- 🧤 ON TARGET?
	-- First, can this ball even score? With goal geometry known, a crossing
	-- clearly wide of the posts or over the bar is a guaranteed miss —
	-- never dive at it, even in save-everything mode.
	local definitelyMiss = false
	if goal then
		-- v2.41: a ball that has ALREADY crossed the goal line can't score —
		-- don't chase it into the net. (Once past the line, crossPos
		-- disappears, which used to flip onTarget back to true and send the
		-- keeper diving at a ball 50 studs behind the goal.)
		definitelyMiss = ((ballPos.X - lgx) * gx + (ballPos.Y - lgy) * gy + (ballPos.Z - lgz) * gz) < 0
		if crossWide then
			-- crossWide is the |axis-lateral| computed once inside the integrator
			-- v2.41 honest wide ruling: a ball crossing 3.5 studs outside
			-- the post (ball radius + prediction tolerance) or 4 studs over
			-- the bar CANNOT score — the keeper stays on its feet. This is
			-- what stopped the "he passed it wide, why did you dive" false
			-- dives. True corner balls (crossing at the post) are untouched.
			definitelyMiss = definitelyMiss
				or (crossWide > goal.halfWidth + CONFIG.WIDE_POST_MARGIN)
				or (crossY > goal.crossbarY + CONFIG.BAR_OVER_MARGIN)
		end
	end

	local onTarget
	if definitelyMiss then
		onTarget = false
	elseif CONFIG.SAVE_EVERYTHING then
		onTarget = true -- commit to every scorable ball
	elseif goal then
		onTarget = (crossOnTarget == true) or (minDistance <= CONFIG.COMMIT_RADIUS)
	else
		onTarget = minDistance <= CONFIG.COMMIT_RADIUS
	end
	-- 🐌 SLOW SHOT DETECTOR (v2.29): a RELEASED shot slower than the full
	-- side-dive tier is a STEP-UP save, never a side dive. The old code only
	-- reacted when the ball was ALREADY inside a small 30/14/15 window — a
	-- slow shot from range sailed through and went in. Now the moment a slow
	-- on-target ball is read (20-59 studs/s, coming at us, not carried /
	-- dribbled / juggled / own team) it is ARMED: the HUD warns early
	-- ("SLOW SHOT INCOMING") and the keeper meets it with a Forward save from
	-- a wider window (34/18/20) — slow balls give time to move, so the
	-- sideways + height tolerances are bigger. It un-arms itself the frame
	-- the ball speeds up into full-dive territory or stops being a threat.
	-- 🎯 SLOW SHOT must be heading AT the goal line — a slow pass drifting
	-- near the keeper is not a shot (v2.40 false-dive fix).
	local slowShotAtGoal = true
	if goal then
		local toLine = goal.linePos - ballPos
		if toLine.Magnitude > 0.01 then
			slowShotAtGoal = (velocity:Dot(toLine.Unit)) >= (speed * CONFIG.SLOW_SHOT_GOAL_DOT)
		end
	end
	local slowShotArmed = onTarget
		and (speed >= CONFIG.MIN_SHOT_SPEED) and (speed < CONFIG.MIN_DIVE_SPEED)
		and not movingAway
		and (approachSpeed > 0)
		and not isCarried
		and not isJuggle
		and not ballControlled
		and slowShotAtGoal
		and (poss ~= "own")
		and not isDribbling

	-- 🧊 v2.53 FLOOR SHOT classification (see CONFIG): low over the measured pitch,
	-- live, on target. Everything below relaxes toward “center is safe, sides need
	-- proof” while it holds.
	local floorShot = false
	if CONFIG.FLOOR_SHOT_READ and (not isCarried) and (not isJuggle)
		and onTarget and (not movingAway) and speed >= CONFIG.MIN_SHOT_SPEED
		and (ballPos.Y - groundY) <= CONFIG.FLOOR_MAX_ABOVE_REST then
		floorShot = true
	end

	-- 4) CAMERA MATRIX (left/right from the keeper's view), relative to the
	-- PREDICTED keeper position (aimPos) — the side you dive to should match
	-- where you'll be when the ball gets there.
	local impactOffset   = impactPos - aimPos
	local horizontalDist = impactOffset:Dot(camRight)
	local verticalDist   = impactPos.Y - aimPos.Y

	local centerTol = floorShot and (CONFIG.CENTER_TOLERANCE * CONFIG.FLOOR_CENTER_BIAS) or CONFIG.CENTER_TOLERANCE
	local direction = CONFIG.CENTER_ACTION
	-- ⚡ The lead predicate is computed HERE (the direction read below needs it)
	-- and reused as the commit trigger at the urgency block — one evaluation,
	-- one truth.
	local leadEarly = ST.peakSinceShot >= CONFIG.BAIT_LAUNCH_EXEMPT
		and onTarget and lastShooterPlayer
		and (now - lastShooterTime) < 0.35
		and distToGoalie <= CONFIG.RELEASE_LEAD_DIST
	if horizontalDist > centerTol then
		direction = "Right"
	elseif horizontalDist < -centerTol then
		direction = "Left"
	end

	-- 🥅 If the ball crosses the line, the crossing side is the truth —
	-- immune to camera rotation and keeper-position jitter.
	if crossLateral then
		-- the crossing side is the truth (immune to camera rotation and keeper
		-- jitter); v2.44 measures it on the keeper-right basis inside the
		-- integrator, so there is no Cross + Dot left in the per-frame path
		if abs(crossLateral) > centerTol then
			local side = crossLateral > 0 and "Right" or "Left"
			if leadEarly then
				-- 🔒 v2.72: at lead range a lateral reading 4.6 studs wide is
				-- the model EXTRAPOLATING jitter for half a second, not a shot
				-- going corner-ward. Trust it only outside the LONG READ band
				-- (centerTol × LEAD_SIDE_TRUST) AND once the same side has held
				-- a full frame — one frame of agreement costs 1/60s of lead and
				-- kills the entire sideways class. Inside the band the lead
				-- commits, but it commits the MIDDLE: hold the goal's heart and
				-- make them place it.
				-- 📐 v2.81 FLAT STANCE (friend: "and also still the fats shots"):
				-- a LOW, FAST drive is the one ball that cannot fake its
				-- crossing late — it has no air to bend in. At lead range the
				-- "projection, not a promise" excuse is exactly what lets it
				-- sail past the keeper's chest, so a hard floor ball commits
				-- to its own crossing, not the middle.
				local flatCross = floorShot and speed > CONFIG.NEAR_SMOTHER_SPEED
				if flatCross
					or (abs(crossLateral) > centerTol * CONFIG.LEAD_SIDE_TRUST
						and ST.leadSide == side) then
					direction = side
					if flatCross and ((not ST.flatLogged) or (now - ST.flatLogged > 3)) then
						ST.flatLogged = now
						log(string.format("📐 FLAT STANCE — low and fast at %.0f/s: no air to fake the crossing — committing to %s, not the middle", speed, side), true)
					end
				else
					-- The override must UNDO the horizontalDist side-set above —
					-- the closest-approach offset carries the same far-range
					-- jitter, so the hold has to clear both readers, not just
					-- decline to add its own.
					direction = CONFIG.CENTER_ACTION
					if ST.leadSide ~= side and (not ST.sideHoldT or now - ST.sideHoldT > 2.5) then
						ST.sideHoldT = now
						log(string.format("[AI-Dive] 🔒 SIDE HELD — crossing %.1f at %.0f studs is a projection, not a promise — holding the middle a frame",
							abs(crossLateral), distToGoalie), true)
					end
				end
				ST.leadSide = side
			else
				ST.leadSide = nil
				direction = side
			end
		elseif leadEarly then
			ST.leadSide = nil
		end
	end

	-- 🃏 v2.75: one freshness gate for every tricky-band reader (the engine's
	-- own convention — an alert past its window must not widen anything).
	local trickyLive = abilityAlert ~= nil and (now - abilityAlert.t) < 2.5
		and abilityAlert.moveTricky or nil

	-- 📈 v2.82 PATTERN LEAD: the ledger's corner habit for the man who shot —
	-- consulted at the middle-holds below, where a fresh strike is otherwise
	-- a coin flip.
	local patSide, patShare = nil, nil
	if lastShooterPlayer then
		patSide, patShare = ST.prof:pattern(lastShooterPlayer.Name)
	end
	-- 🧠 v2.83 MATCH SENSE — THE TILT METER: a keeper who has just been
	-- beaten twice in a row does not need a better GUESS, he needs a
	-- STRICTER one. Guessing is what a frustrated keeper does; the fix is
	-- to hold the middle until the ball has properly proven its side, and
	-- to let any save reset the streak immediately (see ST.sense:onSaved).
	-- The band widens by TILT_BAND while the streak is live and fresh.
	local tiltStreak, tiltFresh = ST.sense:tilt()
	local tiltBand = (tiltStreak >= CONFIG.TILT_STREAK_N and tiltFresh) and CONFIG.TILT_BAND or 1
	if patSide and lastShooterPlayer
		and (direction == "Right" or direction == "Left")
		and ((patSide == "R" and direction == "Right") or (patSide == "L" and direction == "Left"))
		and ((not ST.patternLogged) or (now - ST.patternLogged > 3)) then
		ST.patternLogged = now
		log(string.format("📈 PATTERN LEAD — %s goes %s %.0f%% of the time — the heart is %s until the crossing proves otherwise",
			tostring(lastShooterPlayer.Name):upper():sub(1, 12),
			patSide == "R" and "RIGHT" or "LEFT", (patShare or 0) * 100,
			patSide == "R" and "right-biased" or "left-biased"), true)
	end

	-- 🎭 v2.83 COUNTER 2.0: a researched MOVE-BIAS commits a side while the
	-- live crossing is still a coin flip. The bias kind rides the counter
	-- row (COUNTER_MODES .sideBias):
	--   "Left"/"Right" = the move's documented side (Sae's curve "always
	--                     goes left" — wiki research, kept in-file);
	--   "PATTERN"      = the shooter's own ledgered corner habit (the v2.82
	--                     PATTERN LEAD, promoted from log-only to a commit);
	--   "MIRROR"       = a back-aimed finish (Shidou's formless: "aim right,
	--                     ball goes left") — flips the side the wind-up read.
	-- Honest precedence: the bias only speaks while the crossing sits inside
	-- COUNTER_BIAS_BAND studs of the centerline. The moment the ball proves
	-- itself clearly wide, the live reading outranks the research and this
	-- stands down (same doctrine as the prime-side machinery above, but it
	-- lives on the MOVE, not just the alert).
	if crossLateral and activeMode and activeMode.sideBias
		and abs(crossLateral) < CONFIG.COUNTER_BIAS_BAND then
		local wantMirror = activeMode.sideBias == "MIRROR"
		local biasOk = (wantMirror and (direction == "Left" or direction == "Right"))
			or ((not wantMirror) and direction == CONFIG.CENTER_ACTION)
		if biasOk then
			local biasSide = activeMode.sideBias
			if wantMirror then
				biasSide = (direction == "Right") and "Left" or "Right"
			elseif biasSide == "PATTERN" and lastShooterPlayer then
				local ps = ST.prof:pattern(lastShooterPlayer.Name)
				biasSide = (ps == "R") and "Right" or ((ps == "L") and "Left" or nil)
			end
			if biasSide == "Left" or biasSide == "Right" then
				direction = biasSide
				if (not ST.biasT) or (now - ST.biasT > 3) then
					ST.biasT = now
					log(string.format("🎭 COUNTER BIAS — %s: crossing %.1f is still in the band — committing %s",
						activeMode.name, abs(crossLateral), biasSide), true)
				end
			end
		end
	end

	-- 🚀 v2.83 TRAJECTORY 3.0 (5/5) STICKY SIDE: within one shot reset the
	-- committed side must not flip on a single frame of jitter. A struck
	-- ball inherits its shooter's run-up and the network's snap, and one
	-- disagreeing frame used to swing the dive from Left to Right and back
	-- inside 30ms — the keeper commits to neither. The side now sticks for
	-- the whole shot; flipping takes a frame that disagrees AND the next
	-- frame agreeing with the new reading (a sustained change of mind, not
	-- a twitch). The key is the shot reset, so a new strike starts clean.
	do
		local key = ST.lastShotReset
		if ST.dirStickyKey ~= key then
			ST.dirSticky, ST.dirStickyKey = nil, key
			ST.dirStickyPend = nil
		end
		if direction == "Left" or direction == "Right" then
			if ST.dirSticky == nil then
				ST.dirSticky = direction
			elseif direction ~= ST.dirSticky then
				if ST.dirStickyPend == direction then
					ST.dirSticky, ST.dirStickyPend = direction, nil -- sustained: flip
				else
					ST.dirStickyPend = direction                    -- first disagreeing frame: hold
					direction = ST.dirSticky
				end
			else
				ST.dirStickyPend = nil
			end
		else
			ST.dirStickyPend = nil
		end
	end

	if CONFIG.INVERT_DIVE_DIRECTION then
		if direction == "Left" then direction = "Right"
		elseif direction == "Right" then direction = "Left"
		end
	-- 🧷 v2.58 LONG READ GUARD: past LONG_GUESS_DIST a side commit whose
	-- predicted lateral still sits inside the center band (floor-widened) is a
	-- coin flip wearing a decision's clothes. Hold the middle; make them place
	-- it, not let them guess-dive us.
	elseif (direction == "Left" or direction == "Right")
		-- v2.73: the 85-stud coin-flip fence moves IN to 38 — the range where
		-- one replication snap (~2 studs of jitter × remaining flight) can
		-- still flip the side read. Live curve chases and side-PRIMED counters
		-- carry their own lateral proof and keep committing as before.
		-- 🪹 v2.74 makes the fence CONTINUOUS: inside 38 the band is not gone,
		-- it is the REACH RING (centerTol + SIDE_NO_DIVE) — a ball that ends
		-- inside it gets stepped on, not dived at. And a live TRICKY move
		-- (backheel, balloon, wobble kit) widens the far band: its lateral
		-- read lies more, so the trust bar is higher, not lower.
		-- 🎭 v2.83 COUNTER 2.0: a researched sideBias commits carry their own
		-- lateral proof (the wiki row or the ledger's two+ seen corners) —
		-- same exemption the primed counters already get.
		and not (activeMode and (activeMode.primeSide or activeMode.sideBias))
		and (not ST.gyroT or now - ST.gyroT > 0.7)
		-- 📈 v2.82 PATTERN LEAD: a proven corner habit for the man who shot
		-- breaks the middle-hold — the live read and the ledger agree on the
		-- same side, and the ledger has seen it at least twice.
		and not (patSide and ((crossLateral or horizontalDist) >= 0 and patSide == "R"
			or (crossLateral or horizontalDist) < 0 and patSide == "L"))
		-- 🧠 v2.83: the tilt meter widens the band — a beaten keeper holds
		-- the middle until the ball proves its side.
		and (math.abs((crossLateral or horizontalDist)) <= (
			distToGoalie > CONFIG.SIDE_GUESS_DIST
				and centerTol * (trickyLive and CONFIG.TRICKY_BAND or 1.8) * tiltBand
				or speed <= CONFIG.NEAR_SMOTHER_SPEED
					and centerTol + CONFIG.SIDE_NO_DIVE or -1)) then
		direction = CONFIG.CENTER_ACTION
		if (not ST.longReadT) or (now - ST.longReadT) > 3 then
			ST.longReadT = now
			local nearHold = distToGoalie <= CONFIG.SIDE_GUESS_DIST
			local trickyHold = not nearHold and trickyLive ~= nil
			-- 📐 v2.81 FLAT STANCE (friend: "and also still the fats shots"):
			-- a low hard drive is the one ball a dive LOSES to — the hands leave
			-- the ground plane and the ball arrives under the body. The wide
			-- floor band already refuses to GUESS at it; the near ring now
			-- refuses to DIVE at it: stand, spread, let the welded catch-cube do
			-- what the hands can't reach.
			local flatStance = nearHold and floorShot and speed > CONFIG.NEAR_SMOTHER_SPEED
			log(string.format("%s — holding the middle at %.0f studs (lateral %.1f is %s)",
				flatStance and "📐 FLAT STANCE" or (nearHold and "🪹 IN REACH" or (trickyHold and "🃏 TRICKY READ" or "🧷 LONG READ")),
				distToGoalie, math.abs((crossLateral or horizontalDist)),
				flatStance and "low, and UNDER the dive — the body is the save here"
					or nearHold and "inside arm's reach — step in, don't dive yourself past it"
					or trickyHold and "a frame, not a promise — his kit is built to sell it"
					or "a guess, not a save"))
		end
	end

	-- 🎈 AERIAL BIAS (deep-researched GK guide: "if shoots comes from air
	-- just jump... don't do left or right dive, try front dive"): a high,
	-- DESCENDING ball arriving near center is met with a Forward save.
	-- v2.41: range-capped — a lob from 40 studs is met by POSITIONING, not
	-- a 40-stud forward lunge (the slow-branch reach already handles the
	-- commit window up close).
	if velocity.Y < -5
		and verticalDist > CONFIG.AERIAL_BIAS_HEIGHT
		and math.abs(horizontalDist) <= CONFIG.AERIAL_BIAS_OFFSET
		and distToGoalie <= 35 then
		direction = "Forward"
	end

	-- 4b) FORWARD OVERRIDE: ball aimed straight at the body at a catchable height.
	-- Only replaces "Middle" — Left/Right decisions are never touched.
	if CONFIG.USE_FORWARD_DIVE and direction == CONFIG.CENTER_ACTION then
		if math.abs(horizontalDist) <= CONFIG.FORWARD_TOLERANCE
			and verticalDist >= CONFIG.REACH_HEIGHT_MIN
			and verticalDist <= CONFIG.FORWARD_HEIGHT_MAX then
			direction = "Forward"
		end
	end

	-- 4c) 🎯 WEAK-CENTER CATCH (v2.43): a WEAK shot (under 85) that's near
	-- the center is a CATCH, not a committed side dive — the "it dove left
	-- or right instead of forward" fix. A side dive on a central weak ball
	-- leaves the middle open (exactly how the slow shot got in). Overriding
	-- Left/Right here is deliberate: a keeper meets a weak central ball by
	-- stepping TO it (Forward), never by committing sideways. Off-center
	-- weak balls (beyond WEAK_CENTER_MAX) keep their side dive — they really
	-- are to the side.
	if speed < CONFIG.WEAK_SHOT_SPEED
		and math.abs(horizontalDist) <= CONFIG.WEAK_CENTER_MAX then
		direction = "Forward"
	end

	-- 📖 v2.73 PLAYBOOK (forward): the move is KNOWN from the effect (fresh
	-- alert, ≤2.5s), its row says shape = "forward", the crossing reads "seam"
	-- (inside PLAY_FWD_BAND × centerTol) and we are in read range. That is all
	-- the SHAPE needs; the timing gates still own WHEN. siuuuuuuuu stays under
	-- the UNSAVEABLE-HOLD policy (the G row), so the playbook never dives at
	-- the autogoal — the row has no shape, deliberately.
	local shapeFwd = false
	do
		local pb = abilityAlert and (now - abilityAlert.t) < 2.5
			and abilityAlert.moveShape or nil
		if pb == "forward" and onTarget and speed >= CONFIG.MIN_SHOT_SPEED
			and distToGoalie <= CONFIG.PLAY_FWD_MAX
			and math.abs((crossLateral or horizontalDist)) <= centerTol * CONFIG.PLAY_FWD_BAND then
			shapeFwd = true
			direction = "Forward"
			if (not ST.playbookT) or (now - ST.playbookT > 2.5) then
				ST.playbookT = now
				log(string.format("[AI-Dive] 📖 PLAYBOOK — %s: dive FORWARD for it — a seam cannon is met by coming to it, not by guessing a side",
					tostring(abilityAlert.move)), true)
			end
		end
	end

	-- 🪤 v2.61 BAIT HOLD (friend meta, verbatim: "when players shoot the ball
	-- slowly and get it back — it triggers the AI to dive"). The .onetwo counter
	-- catches the ABILITY; this is the same trick with NO ability — a soft
	-- roller (< BAIT_ROLL_MAX) still moving, with its own shooter
	-- (lastShooterPlayer, fresh) chasing within BAIT_CHASE_DIST. Diving at that
	-- ball IS the goal the bait is built to draw. So: hold home; the dive/smother
	-- window only re-opens inside BAIT_SMOTHER_DIST, where hands on the ball beat
	-- committing to a fake. The tackle rules win the collect the frame he touches
	-- it (v2.56 doctrine: let it drop, take it).
	-- 🪤 v2.66 THE WIDE NET — four tiers, then a memory with teeth:
	-- (a) TOUCH-BAIT: the friend's false-dive source. A poke spikes raw speed
	-- for frames while its OWNER IS STILL ON IT (within BAIT_ORBIT_DIST,
	-- BAIT_TOUCH_FRESH old, under BAIT_TOUCH_MAX): touches ride with him,
	-- strikes separate. Held regardless of the soft bar.
	-- (b) chasing shooter (v2.61). (c) bait memory (v2.65). (d) loose roller
	-- in the box (v2.65). — and the BAITER PROFILE: BAITER_LOCK holds on one
	-- man inside BAITER_WINDOW flags him; his suspect bar rises for
	-- BAITER_HUNT seconds. A bait farmer gets taxed, not re-seduced.
	local baitHold, baitWhy = false, ""
	-- The SHAPE gate runs even while the feint system holds (fakeHold): a
	-- soft ball the keeper declines to chase is a bait episode whether the
	-- feint or the bait net is the one keeping him home — the profile counts
	-- what the keeper SURVIVED. The decision (baitHold) re-gates on fakeHold.
	-- The SHAPE is computed every frame the guard is on; the onTarget/approach
	-- gates only decide whether it can HOLD (an edge reset between episodes must
	-- be seen by the profile, or the second hold never counts).
	local baitShape, shapeWhy = false, ""
	if CONFIG.BAIT_GUARD and not reactionStrike then
		local baiterOn = ST.baiterKey and lastShooterKey ~= nil
			and ST.baiterKey == lastShooterKey and now < (ST.baiterUntil or 0)
		local repeatGrudge = ((ST.baiterFlags or 0) >= 2 and (now - (ST.baiterFlagsT or 0)) < CONFIG.BAITER_REPEAT_WINDOW)
			and CONFIG.BAITER_REPEAT_BONUS or 0
		local baitBar = CONFIG.BAIT_ROLL_MAX + (baiterOn and (CONFIG.BAITER_BAR_BONUS + repeatGrudge) or 0)
		-- ⚡ v2.70: a launch at/above the exemption bar PROVES strike from this
		-- very credit — the soft tiers stand aside no matter how slow the ball
		-- reads at the keeper. peakSinceShot resets on every new credit and
		-- goes stale after 1.5s, so rollers with no fresh strike behind them
		-- keep getting caught by the loose net exactly as before.
		local soft = speed < baitBar
			and not (ST.peakSinceShot >= CONFIG.BAIT_LAUNCH_EXEMPT
				and lastShooterPlayer and (now - lastShooterTime) < 1.5)
			and not trickyTrust -- 🃏 v2.81: an announced heel flick is not a roller
			and not carryTrustActive and not crossTrustActive -- 🪤 v2.83: earned launches are not rollers
		local geom = onTarget and approachSpeed > 0
			and distToGoalie > CONFIG.BAIT_SMOTHER_DIST
		local live = (not isDribbling) and geom
		-- NB: gated on (not isDribbling) ON PURPOSE — a 49/s real shot also
		-- leaves a standing man's boots inside 10 studs (S32 caught the ungated
		-- version eating it). The poke we hunt is the one where the ball has
		-- CLEARED the carry flag's lag and still has its owner on it: dribble
		-- off, orbit ON, sub-cap speed. Carry flag stays out (it lags a struck
		-- ball for studs — the ORBIT is the truth).
		-- 🌈 v2.81 SCORPION DISCIPLINE (friend, verbatim: "when the ai see someone
		-- rainbow flick he auto dive and then the scorpion hits — make it not
		-- dive for gaga mains when they flick, cuz the cd is bad"). v2.56's
		-- flick memory kills the lunge and the leap; this kills the DIVE. While
		-- an AERIAL-KIT man still owns his own popped ball, nothing commits
		-- beyond smother range: the drop is his to collect, the strike is the
		-- real read — and a scorpion IS a struck ball (DRIBBLE_MAX clears the
		-- window the frame it flies, and inside smother range hands still beat
		-- pride). It must outrank the soft-ball tiers: a flick drop LOOKS
		-- exactly like a dribble-touch spike, and the whole point is that it
		-- is a strike's preface, not a poke.
		if (not baitHold) and ST.flickT
			and (now - ST.flickT) < CONFIG.FLICK_MEMORY * ST.clock:scale(now)
			and speed < CONFIG.DRIBBLE_MAX_SPEED
			and distToGoalie > CONFIG.BAIT_SMOTHER_DIST
			and ST.flickKey and nearPlayer and nearPlayer.Name == ST.flickKey then
			-- the style tag can land AFTER the pop, so read the kit here, not
			-- at flick time: an AERIAL profile (gagamaru-shidou-ichigo family)
			-- is the one that pops low to hide a backflip strike.
			local fp = charByPlayer[nearPlayer]
			if fp and CHAR_PROFILES[fp] and CHAR_PROFILES[fp].aerial then
				baitHold, baitWhy = true, "post-flick aerial kit — scorpion discipline"
				if (not ST.scorpLogged) or (now - ST.scorpLogged > 3) then
					ST.scorpLogged = now
					log("[AI-Dive] 🌈 SCORPION DISCIPLINE — the flicker owns an aerial kit: feet until the pop is STRUCK, never dive at the drop", true)
				end
			end
		end
		local touch = live and not baitHold and speed < CONFIG.BAIT_TOUCH_MAX and not trickyTrust
			and ST.peakSinceShot < CONFIG.BAIT_TOUCH_MAX -- ⚡ a cooled rocket is not a poke
			and strikerDist and strikerDist <= CONFIG.BAIT_ORBIT_DIST
			and lastShooterPlayer and ((now - lastShooterTime) < CONFIG.BAIT_TOUCH_FRESH
				-- ⚪ v2.71: a live feint pair EXTENDS the touch window — two taps
				-- inside a second are one continued handle, not two strikes.
				or (ST.feintPairT and (now - ST.feintPairT) < CONFIG.BAIT_FEINT_PAIR))
		local chaser = live and soft and lastShooterPlayer and (now - lastShooterTime) < CONFIG.SHOT_OWNER_MEMORY
			and strikerDist and strikerDist <= CONFIG.BAIT_CHASE_DIST
			and not carryTrustActive and not crossTrustActive -- 🪤 v2.83: an earned launch is not a chase
		local remembered = live and soft and ST.baitMark and lastShooterKey and ST.baitMark.key == lastShooterKey
			and (now - ST.baitMark.t) < CONFIG.BAIT_MEMORY * ST.clock:scale(now)
		local loose = live and soft and (not ballControlled)
			and not crossTrustActive and not carryTrustActive and distToGoalie <= CONFIG.BAIT_LOOSE_MAX
		-- 🪤 v2.71 RECLAIM — spike, sprint, kill it at his own feet. The touch
		-- tell survives half a second; THIS shape survives as long as it takes,
		-- and the re-set carry flag is the POINT (re-carrying IS the tell the
		-- friend reported), not a reason to look away. No ball speed, no forward
		-- drive, owner on top of it: there is nothing here to dive at, and the
		-- man who did it just spent an episode.
		local reclaim = lastShooterPlayer
			and (now - lastShooterTime) < CONFIG.BAIT_RECLAIM_FRESH
			and speed < CONFIG.BAIT_RECLAIM_SPEED
			and strikerDist and strikerDist <= CONFIG.BAIT_ORBIT_DIST + 4
			and approachSpeed <= CONFIG.BAIT_RECLAIM_STALL
			and distToGoalie > CONFIG.BAIT_SMOTHER_DIST
		if reclaim and ST.reclaimMarked ~= ST.lastShotReset then
			ST.reclaimMarked = ST.lastShotReset
			if lastShooterKey then baitEpisode(lastShooterKey, now) end
			log(string.format("[AI-Dive] 🪤 RECLAIMED — spiked at %.0f/s then killed it %.0f studs off his own boot — a move, not a shot",
				ST.peakSinceShot, strikerDist or 0), true)
		end
		-- 🪤 v2.82 BAIT 2.0 — the two fake shapes the v2.71 net still let
		-- through: the sprint that quits, and the 180° turn over a dead ball.
		-- (a) APPROACH STALL — he came at you at shot-approach pace and the
		-- forward drive just died with the ball at his feet. A real sprint
		-- ends in a KICK (the shot credit owns that); a stall ends in
		-- nothing. One episode per approach burst.
		local stall = false
		if speed < 5 and poss ~= "own"
			and distToGoalie <= 26 and distToGoalie > CONFIG.BAIT_SMOTHER_DIST
			and (ST.approachPeak or 0) > 35 and (now - (ST.approachT or 0)) < 0.8
			and (now - (ST.stallEpT or 0)) > 1.0
			and (not lastShooterPlayer or (now - lastShooterTime) > 1.0
				-- a sprint CREDITS at its first frame (still→motion) — but the
				-- ball still at his feet marks it as a run, not a strike
				or (strikerDist and strikerDist <= CONFIG.BAIT_ORBIT_DIST)) then
			local aKey = teamKeyOf(carrierPlayer or nearPlayer)
			if aKey then
				baitEpisode(aKey, now)
				stall = true
				ST.stallEpT = now
				if (not ST.stallLogged) or (now - ST.stallLogged > 3) then
					ST.stallLogged = now
					log(string.format("[AI-Dive] 🪤 APPROACH STALL — sprinted at %.0f/s and quit %.0f studs out — a fake run, not a shot",
						ST.approachPeak, distToGoalie), true)
				end
				-- consume the burst: the 1.5 s decay above recovers any
				-- remnant, but an explicit zero keeps the next sprint clean
				ST.approachPeak = 0
			end
		end
		-- (b) WHIP FEINT — the carrier's heading flipped ~180° inside the
		-- refresh cadence while the ball sat dead at his feet. Shots keep a
		-- heading; feints change it.
		if speed < 10 and (now - (ST.whipEpT or 0)) > 1.2 then
			local wWho = carrierPlayer or nearPlayer
			local wEnt = nil
			if wWho then
				for _, e in ipairs(refreshPlayerRoots()) do
					if e.player == wWho then wEnt = e break end
				end
			end
			local wVel = wEnt and wEnt.vel
			if wVel and wVel.Magnitude > 15 then
				local wd = wVel.Unit
				-- the heading must be at least one refresh old (a true reversal,
				-- not the same sample read twice) and at most two refreshes old
				if ST.whipDir and (now - (ST.whipT or 0)) >= 0.45
					and (now - (ST.whipT or 0)) <= 1.2
					and (ST.whipDir:Dot(wd)) < -0.8 then
					local wKey = teamKeyOf(wWho)
					if wKey then
						baitEpisode(wKey, now)
						whip = true
						ST.whipEpT = now
						if (not ST.whipLogged) or (now - ST.whipLogged > 3) then
							ST.whipLogged = now
							log("[AI-Dive] 🪤 WHIP FEINT — a 180° turn over a dead ball — footwork, not a shot", true)
						end
					end
					ST.whipDir = nil
				else
					ST.whipDir, ST.whipT = wd, now
				end
			else
				-- v2.83: a weak straddle sample KEEPS the last clean heading instead
				-- of forgetting it — the 0.45–1.2 s age window expires it on its own.
				-- Forgetting it on weak frames let a straddle sample between the two
				-- clean ones swallow the reversal (S152, once the circle gate shape
				-- opened the net on quiet frames).
			end
		else
			ST.whipDir = nil
		end
		-- ═══ 🪤 v2.83 BAIT 3.0 — the second-generation fake shapes ═══
		-- Each is read from the ball's own motion history and the man's own
		-- pattern (the v2.80 ledger is the memory; these are the shapes).
		-- Episodes are billed AT DETECTION (like stall/whip), never again at
		-- the shape edge below.

		-- (c1) POWER PULL — the devour signature: an announced power strike
		-- whose ball goes AWAY from goal and dies at his boot. The bomb
		-- never left his foot; the pull IS the move.
local powerPull = false
		if (not baitHold) and lastShooterPlayer and (now - lastShooterTime) < 1.2
			and approachSpeed < -4 and speed < 12
			and distToGoalie > CONFIG.BAIT_SMOTHER_DIST
			and strikerDist and strikerDist <= CONFIG.BAIT_ORBIT_DIST + 4
			and ST.lastShotReset ~= ST.powerPullCredit then
			local isPowerStyle = (abilityAlert ~= nil
					and (abilityAlert.char == "barou" or abilityAlert.char == "kunigami"
						or abilityAlert.char == "ichigo" or abilityAlert.char == "dio"))
				or ST.prof:powerClass(lastShooterPlayer.Name)
			if isPowerStyle then
				ST.powerPullCredit = ST.lastShotReset
				powerPull = true
				local epKey = lastShooterKey
				local dbl = epKey ~= nil and ST.powerPullKey == epKey
					and (now - ST.powerPullT) < CONFIG.PULL_REPEAT_WINDOW
				-- the repeat clock runs even for a teamless first read: the
				-- key can land BETWEEN the two pulls (the roster scan is 1 s
				-- slow), and the second pull must still see the first.
				ST.powerPullT = now
				if epKey then
					baitEpisode(epKey, now)
					if dbl then baitEpisode(epKey, now) end -- the double pays double
					ST.powerPullKey = epKey
				end
				-- the read is a read: it logs even for a teamless lobby player;
				-- only the shared-episode billing needs a team key.
					if dbl or (now - ST.pullLogged) > 3 then
						ST.pullLogged = now
						log((dbl and "[AI-Dive] 🪤 DOUBLE PULL — two devour pull-backs in one breath — the hook pays twice"
							or ("[AI-Dive] 🪤 POWER PULL — the " .. lastShooterPlayer.Name .. " pull-back — the bomb never left his foot"))
							.. " — stay home", true)
					end
				end
			end

		-- (c2) CARRY STALL — he checked the run: a carried ball at trot that
		-- stops dead at his boot. The launch OUT of the check is the real
		-- one (the check WAS the feint), so the check buys trust; a man who
		-- checks twice in one breath is selling the second launch as fake.
		local carryStall = false
		if isDribbling and speed < 3 and poss ~= "own"
			and carrierPlayer and strikerDist and strikerDist <= 4
			and approachSpeed >= -2
			and (now - ST.carryStallT) > CONFIG.CARRY_STALL_TIME
			and ST.carryMoveT > now - 0.4 and ST.carryMoveT > ST.carryStallT then
			carryStall = true
			local cKey = teamKeyOf(carrierPlayer)
			local name = carrierPlayer.Name
			local dbl = ST.carryStallKey == name
				and (now - ST.carryStallT) < CONFIG.CARRY_STALL_REPEAT
			if cKey and dbl then baitEpisode(cKey, now) end
			ST.carryStallT, ST.carryStallKey = now, name
			ST.carryTrustT, ST.carryTrustKey, ST.carryTrustDur = now, name, CONFIG.CARRY_TRUST_TIME
			if (now - ST.carryLogged) > 3 then
				ST.carryLogged = now
				log((dbl and "[AI-Dive] 🪤 CARRY STALL ×2 — two checked runs in one breath — the second launch is the fake"
					or ("[AI-Dive] 🪤 CARRY STALL — " .. name .. " checked the run — the launch out of it is real"))
					.. " — the read keeps its nerve", true)
			end
		end
		if isDribbling and speed >= 6 then ST.carryMoveT = now end

		-- (c3) WALKAWAY — he is disengaging: ball + carrier moving away from
		-- goal at carrier pace. No heat is owed (it is burned); the surprise
		-- that comes out of a walkaway is a REAL surprise (the ball has to
		-- travel back the whole way), so it buys a long trust.
		local walkawayNow = speed >= 6 and speed < 30 and approachSpeed < -8
			and poss ~= "own" and carrierPlayer ~= nil
			and strikerDist and strikerDist <= 5
		if walkawayNow then
			if ST.walkT == 0 or ST.walkKey ~= carrierPlayer.Name then
				ST.walkT, ST.walkKey = now, carrierPlayer.Name
			end
			if now - ST.walkT >= CONFIG.WALKAWAY_TIME and ST.walkBillT ~= ST.walkT then
				ST.walkBillT = ST.walkT
				ST.baitHeatT = -1e9 -- the disengagement burns the heat
				ST.carryTrustT, ST.carryTrustKey, ST.carryTrustDur = now, carrierPlayer.Name, CONFIG.WALKAWAY_TRUST
				if (now - ST.walkLogged) > 4 then
					ST.walkLogged = now
					log(string.format("[AI-Dive] 🪤 WALKAWAY — %s is disengaging — heat cleared, his next launch is the real one",
						carrierPlayer.Name), true)
				end
			end
		elseif ST.walkT ~= 0 then
			ST.walkT = 0
		end

		-- (c4) BLEEDING CROSS — the cross that dies before the flag: a
		-- credited strike that was once FAST (crossPeak) and now crawls
		-- wide. A real cross arrives; a dead one is the setup for the
		-- real one (the flag run), which is trusted.
		local bleedCross = false
		if lastShooterPlayer and (now - lastShooterTime) < 1.2
			and speed < 8 and (ST.crossPeak or 0) >= 40
			and (ST.crossPeak or 0) - speed >= 30 -- pushed rollers shed no speed: a cross does
			and distToGoalie > 4 and poss ~= "own"
			and ST.lastShotReset ~= ST.bleedCounted then
		end
		local diedWide = false
		if goal then
			local lateral = (ballPos - goal.linePos):Dot(goal.axis)
			local depth = (ballPos - goal.linePos):Dot(goal.normal)
			diedWide = math.abs(lateral) > goal.halfWidth + CONFIG.BALL_RADIUS and depth > 1
		end
		if lastShooterPlayer and (now - lastShooterTime) < 1.2
			and speed < 8 and (ST.crossPeak or 0) >= 40
			and (ST.crossPeak or 0) - speed >= 30
			and distToGoalie > 4 and poss ~= "own" and diedWide
			and ST.lastShotReset ~= ST.bleedCounted then
			ST.bleedCounted = ST.lastShotReset
			bleedCross = true
			local epKey = lastShooterKey
			if epKey then
				baitEpisode(epKey, now)
				ST.crossTrustT, ST.crossTrustKey = now, lastShooterPlayer.Name
				if (now - ST.bleedLogged) > 3 then
					ST.bleedLogged = now
					log(string.format("[AI-Dive] 🪤 BLEEDING CROSS — it died %.0f studs out — his next cross is the real one",
						distToGoalie), true)
				end
			end
		end

		-- (c5) CIRCLE — the stander orbits the dead ball: he stays at its
		-- boot at walking pace while it sits. A strike doesn't need three
		-- seconds of furniture; a setup does.
		local circle = false
		local ndxH = nearRoot and (nearRoot.Position.X - ballPos.X) or 99
		local ndzH = nearRoot and (nearRoot.Position.Z - ballPos.Z) or 99
		local nearH = math.sqrt(ndxH * ndxH + ndzH * ndzH)
		if speed < 3 and poss ~= "own" and nearPlayer
			and nearH <= 3.5
			and nearPlayer ~= lastShooterPlayer
			and (not lastShooterPlayer or (now - lastShooterTime) > 1.5) then
			local nearVel
			for _, e in ipairs(refreshPlayerRoots()) do
				if e.player == nearPlayer then nearVel = e.vel break end
			end
			if nearVel and nearVel.Magnitude >= 3 then
				if ST.orbitT == 0 or ST.orbitKey ~= nearPlayer.Name then
					ST.orbitT, ST.orbitKey = now, nearPlayer.Name
				end
				if now - ST.orbitT >= CONFIG.ORBIT_TIME then
					circle = true
					local epKey = teamKeyOf(nearPlayer)
					if epKey and ST.orbitBillT ~= ST.orbitT then
						ST.orbitBillT = ST.orbitT
						baitEpisode(epKey, now)
						if (now - ST.orbitLogged) > 3 then
							ST.orbitLogged = now
							log(string.format("[AI-Dive] 🪤 CIRCLE — %s is orbiting the dead ball — a setup, not a strike",
								nearPlayer.Name), true)
						end
					end
				end
			else
				ST.orbitT = 0
			end
		elseif ST.orbitT ~= 0 then
			ST.orbitT = 0
		end

		-- (c6) CLASS SOFT — a shot that leaves the foot below the speed his
		-- OWN ledger says is his. A FINISHER's true strike averages 55/s;
		-- 30/s off his foot at range is theatre. The BOMB class gets the
		-- harder floor: their real one is a bomb, so 70% of the mean is
		-- already a fake (this is the Barou rule, generalized to the class).
		if lastShooterPlayer and (now - lastShooterTime) < 0.6
			and speed >= CONFIG.MIN_SHOT_SPEED and speed < 45
			and onTarget and approachSpeed > 0 and poss ~= "own"
			and distToGoalie > 22
			and ST.lastShotReset ~= ST.classSoftCredit then
			local pr = ST.prof:rowOf(lastShooterPlayer.Name)
			if pr and pr.shots >= 2.5 and pr.spAvg >= 30 then -- 2.5: decayed-count floor
				local frac = CONFIG.CLASS_SOFT_FRACTION
				if ST.prof:powerClass(lastShooterPlayer.Name) then
					frac = CONFIG.POWER_SOFT_FRACTION
				end
				if speed < pr.spAvg * frac then
					ST.classSoftCredit = ST.lastShotReset
					classSoft = true
					local epKey = lastShooterKey
					if epKey then baitEpisode(epKey, now) end
					if (now - ST.classSoftLogged) > 3 then
						ST.classSoftLogged = now
						local cls = tostring(ST.prof:classOf(lastShooterPlayer.Name) or "class")
						log(string.format("[AI-Dive] 🪤 SOFT FOR HIS %s — %.0f/s off his foot when his real one runs %.0f/s — theatre",
							string.upper(cls), speed, pr.spAvg), true)
					end
				end
			end
		end

		-- (c7) HANDOFF — a credited "shot" that a second man picks up is a
		-- pass wearing a shot's costume. Re-attribute the ball to the man
		-- who actually has it: the chaser tier, the carry trust and the
		-- pattern ledger all track the owner, and the owner just changed.
		if lastShooterPlayer and (now - lastShooterTime) < CONFIG.HANDOFF_WINDOW
			and speed >= 8 and speed <= CONFIG.BAIT_ROLL_MAX + 1 and poss ~= "own"
			and nearPlayer and nearPlayer ~= lastShooterPlayer
			-- a keyless man is NOT our teammate (the roster scan can lag a
			-- fresh world; only a known same-team key blocks the re-attribution)
			and (teamKeyOf(nearPlayer) == nil or teamKeyOf(nearPlayer) ~= myKey)
			and nearDist and nearDist <= 4
			and ST.lastShotReset ~= ST.handoffCredit then
			ST.handoffCredit = ST.lastShotReset
			local oldName = lastShooterPlayer.Name
			lastShooterPlayer = nearPlayer
			lastShooterKey = teamKeyOf(nearPlayer) or lastShooterKey
			if (now - ST.handoffLogged) > 3 then
				ST.handoffLogged = now
				log(string.format("[AI-Dive] 🪤 HANDOFF — %s picked it up off %s — a pass wearing a shot's costume; the read follows the ball",
					nearPlayer.Name, oldName), true)
			end
		end

		-- (c8) PREDATOR WATCH — the Barou stance (user: "more detection for
		-- barou"). His kit is ANNOUNCED power: the chop, the feast and the
		-- devour all begin the same way — he stands over a dead ball inside
		-- range and holds the pose, and the fandom documents that pose as the
		-- feint of the Predator Shot itself. A power-class man parked on a
		-- DEAD ball at his own boot is not "carrying": he is WINDING UP. The
		-- read names the stance and opens a trust window around the release,
		-- so the soft nets stand aside for the strike that leaves it — the
		-- stance is the announcement, and the announcement was never the bait.
		if carrierPlayer and speed < 8
			and distToGoalie > CONFIG.BAIT_SMOTHER_DIST and distToGoalie <= 40
			and strikerDist and strikerDist <= 6
			and (now - (lastShooterTime or 0)) > 0.25 then
			local cn = carrierPlayer.Name
			local cKey = charByPlayer[carrierPlayer]
			local isPredator = (cKey == "barou") or (ST.hChar == "barou")
				or (abilityAlert ~= nil and abilityAlert.char == "barou")
				or ST.prof:powerClass(cn)
			if isPredator then
				if ST.predKey ~= cn then ST.predKey, ST.predT = cn, now end
				if (now - ST.predT) >= CONFIG.PREDATOR_STANCE
					and ST.predT ~= ST.predCounted then
					ST.predCounted = ST.predT
					-- the stance ARMS the strike that comes out of it
					ST.moveTrustT, ST.moveTrustDur = now, CONFIG.PREDATOR_TRUST
					if (now - (ST.predLogged or -1e9)) > 3 then
						ST.predLogged = now
						log(string.format("[AI-Dive] 👑 PREDATOR WATCH — %s parked on a dead ball at %.0f studs, holding the pose — the strike out of this stance is the real one",
							cn, distToGoalie), true)
					end
				end
			else
				ST.predKey = nil
			end
		else
			ST.predKey = nil
		end

		if touch then
			baitShape, shapeWhy = true, "dribble-touch spike"
		elseif powerPull then
			baitShape, shapeWhy = true, "devour pull-back"
		elseif carryStall then
			baitShape, shapeWhy = true, "checked run"
		elseif circle then
			baitShape, shapeWhy = true, "stander circling"
		elseif classSoft then
			baitShape, shapeWhy = true, "too soft for his class"
		elseif chaser then
			baitShape, shapeWhy = true, "runner chasing it"
		elseif remembered then
			baitShape, shapeWhy = true, "bait memory on this shooter"
		elseif loose then
			baitShape, shapeWhy = true, "loose roller in the box"
		elseif reclaim then
			baitShape, shapeWhy = true, "spike he reclaimed"
		elseif stall then
			baitShape, shapeWhy = true, "approach he quit"
		elseif whip then
			baitShape, shapeWhy = true, "whip feint"
		end
		-- Episode accounting rides the SHAPE-START edge, not the log cadence —
		-- a deduped toast must never hide a held ball from the baiter flag.
		-- 🪤 v2.68 QUIT-SHOT LEDGER: the fake-kick pop (fandom: Shidou's
		-- "aim down ... serves as a good fake shot", "fake-kick the ball and
		-- use Demon Drive to cover distance"). A credited strike whose ball is
		-- still CREEPING toward us under MIN_SHOT needs no hold — the speed
		-- rules refuse it anyway — but it must not die uncounted: THIS is the
		-- exact shape that bought dives before bait detection existed. One
		-- episode per strike, straight into the profile.
		if lastShooterPlayer and speed >= 3 and speed < CONFIG.MIN_SHOT_SPEED
			and onTarget and approachSpeed > 0
			and distToGoalie > CONFIG.BAIT_SMOTHER_DIST
			and (now - lastShooterTime) < CONFIG.BAIT_DYING_FRESH
			and ST.lastShotReset ~= ST.dyingCounted then
			ST.dyingCounted = ST.lastShotReset
			baitEpisode(lastShooterKey, now)
			if (not ST.dyingLogged) or (now - ST.dyingLogged > 2.5) then
				ST.dyingLogged = now
				log(string.format("[AI-Dive] 🪤 QUIT SHOT — the fake-kick bled to %.0f/s before the line — his bait count climbs", speed), true)
			end
		end
		if baitShape ~= ST.baitWas then
			ST.baitWas = baitShape
			-- An EPISODE is a refusal the keeper owes the ball: touch, chase,
			-- loose — NOT the remembered tier (a memory feeding its own memory
			-- would flag a man for being once-baited forever), and NOT anything
			-- inside the feint window (the fake-shot system holds those dives
			-- — charging the profile too would double-count every flick).
			if baitShape and not fakeHold and (touch or chaser or loose or reclaim) then
				baitEpisode(lastShooterKey, now)
			end
		end
		if baitShape and not fakeHold then
			baitHold, baitWhy = true, shapeWhy
			if (not ST.baitLogged) or (now - ST.baitLogged > 3) then
				ST.baitLogged = now
				log(string.format("[AI-Dive] 🪤 BAIT HELD (%s) — %.0f ball @%.0f studs — stay home, smother inside %d",
					baitWhy, speed, distToGoalie, CONFIG.BAIT_SMOTHER_DIST))
			end
		end
	end

	-- 🤝 v2.65 PASS TO MINE: the ball FLYING TO a teammate at collectible speed
	-- is not a shot at all — refusing it here is the proactive half of "if ur
	-- teammate gets the ball it won't dive". Vector test on the closest
	-- player: if he's ours, close, and the ball is genuinely closing on him,
	-- let it land. (The poss=="own" gates still own the back half.)
	local passToMine = false
	if nearPlayer and nearRoot and myKey and teamKeyOf(nearPlayer) == myKey
		and nearDist <= CONFIG.TEAM_PASS_DIST and speed >= CONFIG.MIN_SHOT_SPEED
		and speed <= CONFIG.TEAM_PASS_MAX and distToGoalie > CONFIG.BAIT_SMOTHER_DIST then
		local vx, vz = nearRoot.Position.X - ballPos.X, nearRoot.Position.Z - ballPos.Z
		local dd = math.sqrt(vx * vx + vz * vz)
		if dd > 0.1 and (velocity.X * vx + velocity.Z * vz) / dd > 12 then
			passToMine = true
			if (not ST.teamPassLogged) or (now - ST.teamPassLogged > 2.5) then
				ST.teamPassLogged = now
				log("[AI-Dive] 🤝 PASS TO TEAMMATE — ball is going home at collectible speed — let it land, a dive here is the whole joke")
			end
		end
	end
	-- 🧠 v2.83 MATCH SENSE — BACK PASS: OUR man struck it and it is travelling
	-- back toward our own line. That is a pass to the keeper, and the keeper
	-- diving at his own team's back-pass is the own goal every goalkeeper
	-- fears. It is not a shot and it never gets read as one.
	do
		local mineBack = ST.sense:backPass(approachSpeed, myKey and lastShooterKey == myKey)
		if mineBack and speed < CONFIG.BAIT_ROLL_MAX and distToGoalie > CONFIG.BAIT_SMOTHER_DIST then
			passToMine = true
			if (not ST.backPassLogged) or (now - ST.backPassLogged > 2.5) then
				ST.backPassLogged = now
				log("[AI-Dive] 🧠 BACK PASS — our own man played it home: let it run, a dive here is the whole own goal")
			end
		end
	end

	-- 🧊 v2.53 FLOOR PLOW — the user's rule verbatim: “if it's a floor shot or
	-- going towards you or somewhere near you — forwards.” A LOW, FAST ball inside
	-- plow range and near the (widened) center band is SMOTHERED: hands forward,
	-- body behind it, no side guessed. Skid-curves cannot beat a keeper who is
	-- already on top of the ball.
	if floorShot and (not baitHold) and direction ~= "Forward"
		and math.abs(horizontalDist) <= centerTol * 2
		and distToGoalie <= CONFIG.FLOOR_SMOTHER_DIST then
		direction = "Forward"
		if (not ST.floorLoudT) or (now - ST.floorLoudT > 2) then
			ST.floorLoudT = now
			log("[AI-Dive] 🧊 FLOOR PLOW — forward onto the skidder, no side guessed")
		end
	end

	-- (The sweeper smother lives in the slow-ball branch of section 6 —
	--  a dead low ball gets a scoop only when it's truly dead, close & on target.)

	-- 5) VISUALS (state-colored, curved trajectory trail with fade)
	local threatColor
	if isDribbling or movingAway or speed < CONFIG.MIN_SHOT_SPEED or not onTarget then
		threatColor = Color3.fromRGB(120, 120, 120) -- gray: wide / not on target — stay on feet
	elseif direction == "Forward" then
		threatColor = Color3.fromRGB(255, 60, 60)    -- red: straight-on catch/push
	elseif isHyperShot then
		threatColor = Color3.fromRGB(255, 0, 255)    -- magenta: hyper shot
	elseif direction == "Left" then
		threatColor = Color3.fromRGB(50, 150, 255)   -- blue
	elseif direction == "Right" then
		threatColor = Color3.fromRGB(255, 150, 50)   -- orange
	else
		threatColor = Color3.fromRGB(255, 255, 50)   -- yellow: middle
	end

	if impactPart and (ST.ecoTier or 0) == 0 then
		visualsHidden = false
		impactPart.CFrame = CFrame.new(impactPos)
		impactPart.Color  = threatColor
		impactPart.Transparency = 0

		-- Dots span the predicted path 0.5s PAST the impact, so you can see
		-- where the ball is going after it gets past you.
		local dotEnd = math.min(timeToImpact + 0.5, CONFIG.SIM_HORIZON)
		for i, dot in ipairs(pathDots) do
			local tDot = dotEnd * (i / (#pathDots + 1))
			local idx  = math.clamp(math.floor(tDot / simStep) + 1, 1, pathCount)
			local rowP = pathPos[idx]
			dot.CFrame       = CFrame.new(rowP.x, rowP.y, rowP.z)
			dot.Color        = threatColor
			dot.Transparency = 0.1 + 0.55 * (i / #pathDots) -- older dots fade out
		end
	end

	-- 6) ⚡ ZERO-LATENCY DIVE EXECUTION ⚡
	local hudLabel, hudColor

	-- 🦘 The top-bin jump test is identical at every dive site — solved once here.
	-- Judged at the PREDICTED LINE CROSSING (where the ball meets the net), never
	-- the ball's current height: an arc that peaks high then drops low must not
	-- make the keeper jump for a low ball (v2.41 rule, now shared by all sites).
	local jumpImpact = (crossY or math.max(impactY, ballPos.Y)) - rootPos.Y
	local jumpGoal   = goal and (goal.crossbarY - rootPos.Y) or nil

	-- 6t) 🤾 GK TACKLE (v2.40 — fan wiki mechanic): a FORWARD save on the
	-- ball CARRIER steals the ball — "as GK you can tackle your enemy by
	-- forward-saving them." An opponent controlling the ball at our feet is
	-- met with a Forward (tackle). Only while the ball is CONTROLLED (never
	-- a live shot), range-gated, cooldown-gated.
	local tackleFired = false
	-- v2.58: also fires for a LOOSE ball within 4 studs of the nearest opponent's
	-- feet at below-shot speed — the flick-drop collect (v2.56 keeps the keeper
	-- GROUNDED for exactly this moment; the tackle is what the ground is FOR) —
	-- and for short balls at their boots mid-dribble while the gap-correlation
	-- can't yet decide possession.
	-- 🛡️ v2.62 SLIDE RESPECT (friend meta: everyone gets "ankle breaked when
	-- sliding"): the tackle IS the contact a slide exists to punish — the
	-- chaser arrives feet-first and the lunger eats the trip. Inside a flagged
	-- slide/ankle-break alert window the keeper offers NO lunge: the slide dies
	-- of its own awkwardness and the ball outlives the legs. Announced once per
	-- window — silence would read as "broken".
	if CONFIG.USE_GK_TACKLE and poss == "opp" and activeMode and activeMode.slideWindow
		and (not ST.slideLogged or now - (ST.slideLogged or 0) > 2.5) then
		ST.slideLogged = now
		log("[AI-Dive] 🛡️ SLIDE RESPECT — ankle-break window live: no lunge, no tackle — let the slide die")
	end
	if CONFIG.USE_GK_TACKLE and poss == "opp"
		and (not (activeMode and activeMode.slideWindow)) -- 🛡️ v2.62: the fence itself
		-- v2.58: a JUGGLER never gets tackled (S12): each touch settles the ball at
		-- the feet for a frame and the controlled gate would take the bait. You do
		-- not dive at someone showing off; you dive when the ball leaves his foot
		-- toward something real.
		-- v2.61 EXCEPTION (friend: "improve the auto tackle to counter kurona
		-- mains"): under a handler flagged tacklePressure, the ball popping at
		-- his boots on EVERY volley touch is not showing off — it is the chandelier
		-- window, and the keeper who waits is the keeper who concedes the second
		-- ball. S12's juggler carries no such flag and stays untouchable.
		and ((not isJuggle) or (activeMode and activeMode.tacklePressure))
		and (ballControlled or (ST.flickT and (now - ST.flickT) < CONFIG.FLICK_MEMORY * ST.clock:scale(now) + 0.6
			and bestD and bestD <= 4 and speed < 8)
			or (activeMode and activeMode.tacklePressure and bestD and bestD <= 6
				and speed < 12)) -- v2.61 PRESSURE-COLLECT: rapid touches raise no flick EVENT —
		-- a flagged handler opens the same collect window 2 studs wider and 4 studs
		-- faster. The receiver fence below is NOT relaxed: passes stay passes.
		                                   -- grounded ball at the flicker's boots right at the end
		                                   -- of the flick memory. Tied to the flick on purpose —
		                                   -- S08's receiver gather and S12's juggle both pass the
		                                   -- loose-ball shape, and BOTH must stay untouched dives.
		and (not receiverInPath)
		and (speed < CONFIG.DRIBBLE_MAX_SPEED)
		and (now >= ST.tackleUntil)
		and (now >= ST.cooldownUntil)
		and (distToGoalie <= CONFIG.TACKLE_RANGE) then
		tackleFired = true
		direction = "Forward"
		hudLabel, hudColor = "GK TACKLE!", Color3.fromRGB(255, 60, 60)
		ST.tackleUntil = now + CONFIG.TACKLE_COOLDOWN
		log(string.format("[AI-Dive] 🤾 GK TACKLE | forward save steal | @%.1f studs", distToGoalie))
		fireDive("Forward", now, speed, approachSpeed, effCooldown, jumpImpact, jumpGoal)
	end

	-- 6a) 🎈 LOFT CATCH (deep-researched: the GK guide says never dive before
	-- the release, and Gagamaru's Leap/Perfect Save = lunge forward to catch):
	-- a DESCENDING lofted ball (chip, header, drop) within lunge range is met
	-- with a Forward catch at the exact moment it crosses hand height, solved
	-- ballistically. While the ball is still rising we wait — diving early
	-- leaves the opposite side open.
	local loftFired = false
	local flickLive = ST.flickT and (now - ST.flickT) < CONFIG.FLICK_MEMORY * ST.clock:scale(now)
		and speed < CONFIG.DRIBBLE_MAX_SPEED
	if speed >= CONFIG.MIN_SHOT_SPEED
		and not flickLive -- 🌈 the flick drop is the attacker's ball; catch it and
		              -- you jump through their skill instead of waiting for the strike
		and not isDribbling and not isCarried and poss ~= "own" and not isJuggle and not movingAway
		and not receiverInPath -- v2.42: a lobbed pass to a receiver, not a shot
		and not definitelyMiss -- v2.44: a ball over the bar, or already past the
		                     -- line, is NOT catchable — the lunge only burned the
		                     -- dive cooldown and left the rebound unclaimed
		and (now >= ST.cooldownUntil)
		and velocity.Y < -10 and verticalDist > 5 and distToGoalie < CONFIG.LOFT_MAX_DIST then
		-- v2.44: same gravity the trajectory simulator resolved. The game may run
		-- workspace.Gravity != 196.2; a hard-coded constant solved the catch time
		-- for a different world than the one being predicted.
		local gY = (accel.Y < -50) and accel.Y or gravity
		local y0, vy = ballPos.Y, velocity.Y
		local catchY = aimPos.Y + 1.5 -- hand height at the predicted position
		if y0 > catchY then
			local D = vy * vy - 2 * gY * (y0 - catchY)
			if D > 0 then
				local tCatch = (-vy - math.sqrt(D)) / gY -- descending root
				if tCatch > 0 and tCatch <= (CONFIG.LOFT_CATCH_WINDOW + getNetworkPing()) * ST.clock:scale(now) then
					local catchPos = ballPos + Vector3.new(velocity.X, 0, velocity.Z) * tCatch
					local catchLat = (catchPos - aimPos):Dot(camRight)
					if math.abs(catchLat) <= CONFIG.LOFT_CATCH_REACH then
						loftFired = true
						direction = "Forward"
					end
				end
			end
		end
	end
	-- 🪂 v2.82 DROP STALK — the "cooler trajectory" half: a SLOW drop inside
	-- the mouth is not a shot and not a smother — it is a ball the keeper
	-- plays under. The old LOFT CATCH only answered fast descents
	-- (vy < -10); a 2–3 studs/s drop sailed under every gate and the keeper
	-- stood in the heart while it settled on top of him. Now: descending,
	-- above hand height, dead-slow, INSIDE the mouth (the flick's own drop
	-- is still the flicker's while the flick memory breathes — scorpion
	-- discipline), and the ballistic solve says it crosses hand height in
	-- reach → the keeper commits a Forward under it BEFORE it settles.
	local dropStalk = false
	if (not loftFired) and (not tackleFired)
		and velocity and velocity.Y < -1 and velocity.Y > -12
		and ballPos.Y > 5 and speed < 25
		and not isCarried and not isJuggle and poss ~= "own" and not movingAway
		and not receiverInPath
		and distToGoalie <= 12
		and math.abs(crossLateral or 0) <= (gHalfWidth or 8) + 2
		and not (ST.flickT and (now - ST.flickT) < CONFIG.FLICK_MEMORY * ST.clock:scale(now))
		and (now >= ST.cooldownUntil) then
		local catchY3 = aimPos.Y + 1.5
		if ballPos.Y > catchY3 then
			local gY3 = (accel and accel.Y < -50) and accel.Y or gravity
			local vy3 = velocity.Y
			local D3 = vy3 * vy3 - 2 * gY3 * (ballPos.Y - catchY3)
			if D3 > 0 then
				local tC3 = (-vy3 - math.sqrt(D3)) / gY3
				if tC3 > 0 and tC3 <= (CONFIG.LOFT_CATCH_WINDOW + getNetworkPing()) * 2 then
					local cP3 = ballPos + Vector3.new(velocity.X, 0, velocity.Z) * tC3
					if math.abs((cP3 - aimPos):Dot(camRight)) <= CONFIG.LOFT_CATCH_REACH then
						dropStalk = true
						direction = "Forward"
					end
				end
			end
		end
	end
	if tackleFired then
		-- 🤾 GK TACKLE already fired above — the tackle IS the response;
		-- skip the dive cascade for this frame.
		ST.commitDir, ST.commitFrames = nil, 0
	elseif loftFired or dropStalk then
		hudLabel, hudColor = dropStalk and "DROP STALK!" or "LOFT CATCH!", Color3.fromRGB(255, 60, 60)
		if dropStalk then
			log(string.format("[AI-Dive] 🪂 DROP STALK — slow drop inside the mouth: under it before it settles (vy %.0f, %.0f studs)",
				velocity.Y, distToGoalie))
		else
			log(string.format("[AI-Dive] 🎈 LOFT CATCH | @%.1f studs | vy %.0f",
				distToGoalie, velocity.Y))
		end
		fireDive("Forward", now, speed, approachSpeed, effCooldown, jumpImpact, jumpGoal)

	-- NOTE: the MIN_SHOT_SPEED gate uses RAW speed (not the smoothed EMA) so
	-- a fresh strike is judged on the first frame, not 4 frames later.
	elseif isDribbling or poss == "own" or isJuggle or movingAway or speed < CONFIG.MIN_SHOT_SPEED then
		-- 🧤 PUNCH OUT: a dead, low ball right at your feet in the goal
		-- mouth (point-blank rainbow that dips short, soft drop, deflection
		-- at your toes) gets a last-frame Forward smother even below
		-- MIN_SHOT_SPEED. A ball at your feet in your goal is not "watching".
		-- Never fires on a ball a teammate is about to play, an opponent
		-- dribbling at your feet, a ball in the air (juggle), or a ball
		-- already rolling away.
		local punchOut = (speed < CONFIG.MIN_SHOT_SPEED)
			and (not isDribbling) and (not isCarried) and (poss ~= "own")
			and (not isJuggle) and (not movingAway) and (not ballControlled)
			and (now >= ST.cooldownUntil)
			and (distToGoalie <= CONFIG.PUNCHOUT_MAX_DIST)
			and (verticalDist >= CONFIG.REACH_HEIGHT_MIN)
			and (verticalDist <= CONFIG.PUNCHOUT_HEIGHT_MAX)
		if punchOut then
			direction = "Forward"
			hudLabel, hudColor = "PUNCH OUT!", Color3.fromRGB(255, 60, 60)
			log(string.format("[AI-Dive] 🧤 PUNCH OUT | Speed: %d | @%.1f studs",
				math.floor(speed), distToGoalie))
			fireDive("Forward", now, speed, approachSpeed, effCooldown, jumpImpact, jumpGoal)
		else
			-- No dive, but keep the HUD live (studs/speed still useful).
			if isCarried then
				hudLabel = "CARRY — SAFE (no shot yet)"
			elseif isDribbleTap then
				hudLabel = "TAP — SAFE (waiting for release)"
			elseif isDribbling then
				hudLabel = "DRIBBLE — SAFE"
			elseif poss == "own" then
				hudLabel = "OWN TEAM BALL — SAFE"
			elseif isJuggle then
				hudLabel = "JUGGLE — SAFE"
			elseif movingAway then
				hudLabel = "BALL AWAY"
			else
				hudLabel = "WATCHING"
			end
			hudColor = Color3.fromRGB(120, 120, 120)
		end
		ST.commitDir, ST.commitFrames = nil, 0 -- threat gone: clear the read
	elseif not onTarget and (ST.grazeFrames or 0) >= 2 then
		-- 🚀 v2.83 TRAJECTORY 3.0: grazing the woodwork is NOT the same shot
		-- as one heading into the stand. The crossing reads a hair outside
		-- the post/bar, which is one deflection away from being on target —
		-- so the keeper HOLDS his read instead of clearing it. Standing down
		-- here is the cheapest way to concede: it costs the shooter nothing
		-- to hit the frame and let it bounce in.
		hudLabel, hudColor = "OFF THE FRAME — HOLD", Color3.fromRGB(255, 150, 50)
		if (now - ST.grazeLogged) > 2.5 then
			ST.grazeLogged = now
			log(string.format("[AI-Dive] 🚀 OFF THE FRAME — crossing %.1f vs post %.1f: holding the read, the woodwork is one deflection away",
				crossWide or 0, goal and goal.halfWidth or 0), true)
		end
	elseif not onTarget then
		hudLabel, hudColor = "WIDE — STAYING ON FEET", Color3.fromRGB(120, 120, 120)
		ST.commitDir, ST.commitFrames = nil, 0 -- wide of the goal: no read in progress
	elseif now < ST.cooldownUntil then
		hudLabel, hudColor = "COOLDOWN", Color3.fromRGB(255, 200, 60)
	elseif ST.smoothedSpeed < CONFIG.MIN_DIVE_SPEED and speed < CONFIG.MIN_DIVE_SPEED then
		-- 🐢 SLOW BALL: never a full side dive. A keeper saves a slow
		-- on-target shot by STEPPING FORWARD to it (catch/push), not a side
		-- dive. "SMOOTHER" = a dead low ball right at the feet (scoop).
		-- "SLOW FORWARD" = a slow on-target shot the keeper steps up to.
		-- A slow shot that went in and got missed was exactly this gap: it
		-- was on target but not "low + close" enough for the old smother.
		-- v2.29: when the SLOW SHOT DETECTOR is armed, the save window is
		-- WIDER (34/18/20 vs 30/14/15) — a slow ball gives time to move —
		-- and outside the window the HUD warns "SLOW SHOT INCOMING" so the
		-- keeper steps up instead of standing and watching it roll in.
		-- v2.31: the branch now also requires the RAW speed to be slow.
		-- The smoothed EMA lags ~4-6 frames after a release, so a FAST
		-- point-blank shot used to read as "slow" for its first frames and
		-- fire a premature Forward dive — whose 0.7s cooldown then blinded
		-- the keeper to the real side dive. (Found by the run test.)
		local wReach, wLateral, wHeight, label
		if slowShotArmed then
			wReach, wLateral, wHeight = CONFIG.SLOW_SHOT_REACH, CONFIG.SLOW_SHOT_LATERAL, CONFIG.SLOW_SHOT_HEIGHT
			label = "SLOW SHOT — STEP UP!"
		else
			wReach, wLateral, wHeight = CONFIG.SLOW_FORWARD_REACH, CONFIG.SLOW_FORWARD_OFFSET, CONFIG.SLOW_FORWARD_HEIGHT
			label = (distToGoalie <= CONFIG.SMOOTHER_MAX_DIST) and "SMOOTHER!" or "SLOW FORWARD!"
		end
		local slowSaveOK = CONFIG.USE_SLOW_FORWARD_SAVE
			and (not baitHold)   -- v2.61: the STEP-UP branch is exactly what the bait baited; held
			and (not passToMine) -- v2.65: ...and the same discipline refuses a giveaway to our own man
			and (not fakeHold)
			and (not freshPopConfirm) -- v2.43: no step-dive on an unproven pop
			and (not ballControlled) -- v2.40: never step-dive at a controlled ball
			and (not receiverInPath) -- v2.42: a pass to a receiver, not a shot
			and onTarget
			and (approachSpeed > 0)
			and (ST.smoothedSpeed < CONFIG.SMOOTHER_MAX_SPEED)
			and (distToGoalie <= wReach)
			and (math.abs(horizontalDist) <= wLateral)
			and (verticalDist >= CONFIG.REACH_HEIGHT_MIN and verticalDist <= wHeight)
		if slowSaveOK then
			direction = "Forward"
			hudLabel, hudColor = label, Color3.fromRGB(255, 60, 60)
			log(string.format("[AI-Dive] 🐌 %s | Dir: Forward | Speed: %d | @%.1f studs",
				label, math.floor(speed), distToGoalie))
			fireDive("Forward", now, speed, approachSpeed, effCooldown, jumpImpact, jumpGoal)
		elseif fakeHold then
			-- 🎭 a tap that died is not a shot — hold and stay set
			hudLabel, hudColor = "FAKE — HOLD", Color3.fromRGB(255, 150, 50)
			ST.commitDir, ST.commitFrames = nil, 0
		elseif slowShotArmed then
			-- armed but not yet in save range: warn EARLY so the keeper moves
			hudLabel, hudColor = "SLOW SHOT INCOMING — MOVE!", Color3.fromRGB(255, 200, 60)
			ST.commitDir, ST.commitFrames = nil, 0
		else
			hudLabel, hudColor = "SLOW — STAY ON FEET", Color3.fromRGB(120, 120, 120)
			ST.commitDir, ST.commitFrames = nil, 0
		end
	elseif fakeHold then
		-- 🎭 FAKE HOLD (fast tier): the ball popped and died — a real strike
		-- sustains. No dive until it sustains speed again (then this flag
		-- clears on its own and the normal dive logic resumes).
		hudLabel, hudColor = "FAKE — HOLD", Color3.fromRGB(255, 150, 50)
		ST.commitDir, ST.commitFrames = nil, 0
	else
		local currentPing = getNetworkPing()
		local dynamicDiveTime = CONFIG.BASE_DIVE_TIME
			+ (currentPing * CONFIG.PING_COMPENSATION)
			+ (speed / 500)

		-- 💥 URGENCY TIERS (distance × speed = how fast the keeper commits):
		--   BOMB  = player FAR + ball insanely fast -> dive on the VERY FRAME
		--           detected, as fast as possible, exactly where it's going.
		--   QUICK = player CLOSE + ball fast -> fast dive, but with a tiny
		--           direction read first (fast, but not frame-zero).
		local pointBlank  = isHyperShot and (distToGoalie <= CONFIG.DANGER_ZONE_DISTANCE)
		local isBomb      = (speed >= effBombSpeed) and (distToGoalie >= CONFIG.BOMB_FAR_DIST)
		local isExtreme   = speed >= CONFIG.EXTREME_SPEED
		local quickThresh = activeMode and (activeMode.quickSpeed or CONFIG.QUICK_SPEED) or CONFIG.QUICK_SPEED
		local isQuickShot = (speed >= quickThresh) and (distToGoalie < CONFIG.BOMB_FAR_DIST)
		local instant     = pointBlank or isExtreme or (speed >= CONFIG.BIG_BANG_SPEED) or isBomb or speedSpike
		-- ⚖️ v2.79 SPIKE SUSTAIN: a habitual baiter's launch spike (0→110 in a
		-- frame, then "quit at 2/s") used to buy the bomb bypass and a full
		-- leap from beyond 60 studs — their console's DEAD BALL REGRET x2. Past
		-- BAITER_SPIKE_N episodes, the spike must SUSTAIN one beat: the second
		-- frame still spiked gets the instant as before; the quit loses it.
		-- point-blank, true bombs and BIG-BANG heat keep the bypass, and SNAP
		-- counters below are never gated — the gate only eats speedSpike.
		if instant and speedSpike and distToGoalie > 60
			and not (pointBlank or isExtreme or isBomb or speed >= CONFIG.BIG_BANG_SPEED)
			and ((ST.baiterKey and lastShooterKey ~= nil and ST.baiterKey == lastShooterKey
				and now < (ST.baiterUntil or 0)
				and (ST.baitMark and (ST.baitMark.n or 0) >= CONFIG.BAITER_SPIKE_N))
				or ST.prof:gated(lastShooterPlayer and lastShooterPlayer.Name)) then
			if (not ST.spikeGateT) or (now - ST.spikeGateT) > 0.05 then
				ST.spikeGateT = now
				instant = false
				log("[AI-Dive] ⚖️ SPIKE SUSTAIN — habitual baiter: one beat before the leap", true)
			end
		end
		-- SNAP counters (Timestop just ended, Big Bang, Flame Shot, King's Chop):
		-- anything moving fast is met on the very frame, no matter what.
		if activeMode and activeMode.snap and speed >= 80 then
			instant = true
		end
		-- 🦸 STAND OP: against a Stand user, everything that's moving is live.
		if standOp and speed >= 90 then
			instant = true
		end
		-- ⚡ v2.71 RELEASE LEAD — the fastest reaction is the one you don't have
		-- to derive from flight at all. A strike CREDIT — still→motion AT THE
		-- SHOOTER'S FEET — with launch at/above the exempt bar IS proof the boot
		-- connected; the flight confirmation it used to wait for only matters for
		-- what the meter does NOT vouch for, and sub-bar pops keep answering to
		-- freshPopConfirm exactly as before. Every bait tier already released
		-- anything that launched this hot (v2.70's number, same number), so this
		-- buys time on shots only — commits on the release frame up to
		-- RELEASE_LEAD_DIST instead of waiting for the ball to fly into range.
		local releaseLead = leadEarly
			and (not baitHold) and (not freshPopConfirm)
		if releaseLead then
			instant = true
		end

		local activeReach = CONFIG.SAVE_EVERYTHING and CONFIG.REACH_EVERYTHING
			or (isHyperShot and (CONFIG.REACH_LEFT_RIGHT * 2) or CONFIG.REACH_LEFT_RIGHT)
		-- ☄️ EXTREME / STAND OP: maximum horizontal reach
		if isExtreme or standOp then
			activeReach = math.max(activeReach, CONFIG.EXTREME_REACH)
		end
		-- 🚀 v2.83 TRAJECTORY 3.0 (4/5) TIME-SCALED REACH: the reach ring
		-- used to be one flat number, so a ball 40 studs out and a ball at
		-- the keeper's feet were measured against the SAME lateral limit.
		-- Physically they are not the same: lateral reach is how far the
		-- keeper can TRAVEL before the ball arrives, and travel is time.
		-- More flight time left = more studs of ground he can cover (capped,
		-- so a slow lob never promises an impossible dive). A settled
		-- trajectory earns the full allowance; a still-climbing ball keeps
		-- last frame's budget until its height is final (apex settle, above).
		if ST.apexSettled then
			ST.reachAllow = math.min(timeToImpact * CONFIG.REACH_TIME_GAIN, CONFIG.REACH_TIME_CAP)
		end
		activeReach = activeReach + (ST.reachAllow or 0)
		-- 🌀 GYRO SAVE (v2.63): the chase already picked the side — the extra
		-- inches are for what a gyro DOES AFTER the commit: it keeps breaking.
		-- The boost applies only while this script is PROVING it is chasing a
		-- live inhuman bend (fresh 2-frame chase), never to a straight shot —
		-- so the cost of being wrong is one toast, not a cheapened routine.
		local gyroLive = ST.gyroT and (now - ST.gyroT) < 0.7
		if gyroLive then
			activeReach = activeReach + CONFIG.GYRO_REACH
			if (not ST.gyroSaveLogged) or (now - ST.gyroSaveLogged > 2.5) then
				ST.gyroSaveLogged = now
				log(string.format("[AI-Dive] 🌀 INHUMANE SAVE — live-gyro window: +%d lateral reach, +%d ceiling", CONFIG.GYRO_REACH, CONFIG.GYRO_HEIGHT))
			end
		end

		local withinReach = (math.abs(horizontalDist) <= activeReach)
			and (verticalDist >= CONFIG.REACH_HEIGHT_MIN)
			and (verticalDist <= effHeightMax + (gyroLive and CONFIG.GYRO_HEIGHT or 0))

		-- 📏 Commit gate: bombs bypass it (they must be met at full speed,
		-- no waiting for the ball to fly in). Everything else commits inside
		-- the dynamic commit distance (25 for slow shots, up to 48 for Big Bang power).
		-- 🪤 v2.67 THE TAX: a flagged baiter is met 20% LATER — his taps are
		-- proven quits, so he buys no early leap; a real strike still gets
		-- met, just closer (bombs bypass everything via instant). The cost
		-- falls ONLY on the man who never strikes hard.
		if ST.baiterKey and lastShooterKey ~= nil and ST.baiterKey == lastShooterKey
			and now < (ST.baiterUntil or 0) and not reactionStrike then
			commitDist = commitDist * CONFIG.BAITER_TAX[math.min(math.max(ST.baitMark and ST.baitMark.n or 2, 2), 4)] -- ⚖️ v2.79 graduated (was flat 0.80); CONFIG-inline to spare an upvalue
		end
		-- 📈 v2.80: the man-ledger nudges this man's read distance — a known
		-- shooter is met a touch EARLIER; a feint-dribbler's long cannon and a
		-- fullback's rare launch a touch LATER. One multiplier, physics intact.
		do
			local pm = ST.prof:thrust(lastShooterPlayer and lastShooterPlayer.Name)
			if pm then commitDist = commitDist * pm end
		end
		local withinCommit = (instant or (distToGoalie <= commitDist)) and (not baitHold) and (not passToMine) -- 🪤 v2.61/65: a held bait OR an inbound giveaway commits NOTHING beyond smother range
		-- 🪤 v2.66 READ-STABILITY LOCK: raw speed far ahead of the smoothed
		-- read means the ball was TAPPED this frame — a strike SUSTAINS, a
		-- poke spikes then dies. While the two disagree past BAIT_STRIKE_GAP,
		-- far from us, and under bomb speed: wait one beat (0.05s). Real shots
		-- lose a frame; fake ones lose their entire purpose.
		if withinCommit and not instant and not reactionStrike and speed < CONFIG.BAIT_ROLL_MAX + 25
			and math.abs(speed - ST.smoothedSpeed) > CONFIG.BAIT_STRIKE_GAP
			and distToGoalie > commitDist * 0.55 then
			withinCommit = false
			if (not ST.readHoldT) or (now - ST.readHoldT > 2.5) then
				ST.readHoldT = now
				log(string.format("[AI-Dive] 🪤 READ UNSTABLE — raw %.0f vs read %.0f: touch-spike, holding one beat", speed, ST.smoothedSpeed))
			end
		end

		-- 📐 CURVE COMMIT (v2.32 — why Rin's Killer Shot STILL slipped in
		-- after v2.31): v2.31 primed the read to the curve side, but the
		-- dive still waited for the ball to "show" the break — and the dive
		-- animation takes ~0.4s while the break lands at 0.5-1.0s of
		-- flight, so the late commit to the true side always arrived AFTER
		-- the ball. Now: the moment the shot is confirmed (released, on
		-- target, coming at us), the keeper COMMITS TO THE PRIME SIDE —
		-- 0.2s BEFORE the normal window opens — and holds it. The prime is
		-- abandoned only if the ball PERSISTENTLY goes the other way (3
		-- stable frames ≥ 18 studs opposite) — that means the player isn't
		-- doing the signature curve, and the normal read resumes.
		local curveDir = nil
		if activeMode and activeMode.primeSide and onTarget and approachSpeed > 0
			and speed >= CONFIG.MIN_SHOT_SPEED and not isDribbling and not fakeHold then
			local oppositeDir = (activeMode.primeSide == "Left" and "Right")
				or (activeMode.primeSide == "Right" and "Left")
			local sinceShot = now - ST.lastShotReset
			local clearlyOther = (oppositeDir == "Right" and horizontalDist >= 20)
				or (horizontalDist <= -20)
			-- Only count "other side" frames while the ball is a live shot
			-- (not dying) and past the first tenth of a second.
			ST.curveOtherFrames = (clearlyOther and speed >= 60 and sinceShot > 0.1)
				and (ST.curveOtherFrames + 1) or 0
			--  ABANDON RULE (v2.34 — why Rin STILL slipped in): the old
			-- rule abandoned the prime after just 3 frames (50ms) on the
			-- other side — but a curve shot's FEINT spends 0.15-0.3s on the
			-- wrong side BEFORE it bends, so the prime was lost mid-feint,
			-- the read re-formed on the post-break side, and the dive
			-- arrived late. Now the prime is abandoned only when the ball
			-- PROVES itself a straight shot: 20+ frames (≈0.33s) clearly
			-- ≥ 20 studs on the other side at shot speed.
			if ST.curveOtherFrames < 20 then
				curveDir = activeMode.primeSide
			end
		end
		-- 🌀 CURVE CHASE (v2.61 — user: "add curve detection for RIN"): the prime
		-- above needs the NAMED move to have tagged. Unscripted bends, copied
		-- styles and yukimiya's late-breaking gyros never tag mid-flight — so for
		-- handlers flagged curveChase (rin/sae/yukimiya: the repo's own CURVE
		-- family rows), the LIVE estimator takes the wheel: two consecutive
		-- frames of sideways accel ≥ CURVE_CHASE_ACCEL set the same curveDir the
		-- prime would — early dive window, direction override, the whole v2.32
		-- machinery — reading where the curve ARRIVES, not where it left.
		-- v2.62: TWO TIERS. The family bar (35) needs the handler flagged
		-- curveChase — rin/sae/yukimiya, whose kits are DOCUMENTED bends. The
		-- INHUMANE bar (GYRO_ACCEL 55) needs nobody's permission: a ball bending
		-- that hard is a gyro whoever fired it — the counter to "an inhumane
		-- gyro shot" is a keeper who chases it instead of guessing at the kick.
		local lat = accel and accel:Dot(camRight) or nil
		if not curveDir and lat and accel and onTarget and approachSpeed > 0
			and speed >= CONFIG.MIN_SHOT_SPEED and not isDribbling and not fakeHold then
			local absLat = math.abs(lat)
			local famTier = (activeMode and activeMode.curveChase) and absLat >= CONFIG.CURVE_CHASE_ACCEL
			local inhTier = absLat >= CONFIG.GYRO_ACCEL
			if famTier or inhTier then
				local side = (lat > 0) and "Right" or "Left"
				if side == ST.curveChaseSide then
					ST.curveChaseN = (ST.curveChaseN or 0) + 1
				else
					ST.curveChaseSide, ST.curveChaseN = side, 1
				end
				if ST.curveChaseN >= 2 then
					curveDir = side
					if inhTier then ST.gyroT = now end -- 🌀 v2.63: marks the live-gyro SAVE window (reach boost below)
					if (not ST.curveChaseLogged) or (now - ST.curveChaseLogged > 3) then
						ST.curveChaseLogged = now
						if inhTier then
							log(string.format("[AI-Dive] 🌀 INHUMANE BEND — %.0f studs/s² live gyro to the %s — chased it, no family row required", absLat, side))
						else
							log(string.format("[AI-Dive] 🌀 CURVE CHASE — live bend to the %s (%.0f studs/s²) — diving where it ARRIVES, not where it left", side, absLat))
						end
					end
				end
			else
				ST.curveChaseN, ST.curveChaseSide = 0, nil
			end
		end
		local curveInWindow = (curveDir ~= nil)
			and (timeToImpact <= dynamicDiveTime + CONFIG.CURVE_COMMIT_LEAD)
		local inWindow = instant or (timeToImpact <= dynamicDiveTime) or curveInWindow

		if freshPopConfirm then
			-- 🎭 The pop is unproven — a real strike sustains, a fake dies.
			-- No full dive in the first 0.10s of a sub-110 pop (this is
			-- what stops the frame-zero dive on Barou's fast fake).
			hudLabel, hudColor = "POP — CONFIRM", Color3.fromRGB(255, 150, 50)
			ST.commitDir, ST.commitFrames = nil, 0
		elseif receiverInPath then
			-- 📥 A pass heading to a receiver, not a shot — watch the ball
			-- arrive at them. If they tap it in, that tap is a fresh shot
			-- and the keeper dives at the tap.
			hudLabel, hudColor = "RECEIVER IN PATH — WATCH", Color3.fromRGB(255, 150, 50)
			ST.commitDir, ST.commitFrames = nil, 0
			if (now - ST.lastReceiverPrint) > 2.5 then
				ST.lastReceiverPrint = now
				log(string.format("[AI-Dive] 📥 RECEIVER IN PATH — watching (pass, not a shot) | @%.1f studs",
					distToGoalie))
			end
		elseif not (inWindow and withinReach and withinCommit) then
			if curveDir then
				hudLabel, hudColor = "CURVE " .. curveDir .. " — ARMED", Color3.fromRGB(255, 200, 60)
			else
				hudLabel, hudColor = "READING " .. direction, threatColor
			end
		else
			-- 🧠 COMMIT DISCIPLINE by urgency + counter mode:
			--   deceiver moves (Backheel, Gear 5) -> FORCED 2-frame read,
			--     even in save-everything — their first frame lies
			--   BOMB / instant / zero-hesitate moves -> frame zero
			--   QUICK -> QUICK_READ_FRAMES of direction stability
		--   slower (Neuer) -> COMMIT_CONFIRM_FRAMES on the same side
		-- 📏 NEAR-POST BIAS (researched GK guide: "Move toward the near post
		-- when the attacker approaches from a wide position"): a wide striker
		-- shoots ACROSS to the near post far more often than at the far
		-- corner. While the threat is wide, the FAR side costs ONE extra
		-- read frame — the read can still flip either way (a genuine
		-- far-post shot is met just one frame later, ≈17ms), while the
		-- keeper's weight goes where the guide says it should.
		local nearPostSide = nil
		if fPos then
			local threatLat = (fPos - rootPos):Dot(camRight)
			if math.abs(threatLat) >= CONFIG.WIDE_STRIKER_LAT then
				nearPostSide = threatLat > 0 and "Right" or "Left"
			end
		end
		local modeConfirm = activeMode and activeMode.confirmFrames or nil
		if awakeHot and (not modeConfirm or modeConfirm < 2) then
			modeConfirm = 2
		end
		local needsConfirm, confirmFrames = false, CONFIG.COMMIT_CONFIRM_FRAMES
			if modeConfirm and modeConfirm > 1 then
				needsConfirm, confirmFrames = true, modeConfirm
			elseif (not instant) and isQuickShot and CONFIG.QUICK_READ_FRAMES > 1
				and (not modeConfirm) then
				needsConfirm, confirmFrames = true, CONFIG.QUICK_READ_FRAMES
			elseif (not instant) and (not CONFIG.SAVE_EVERYTHING)
			and (timeToImpact > CONFIG.COMMIT_CONFIRM_TTI)
			and (CONFIG.COMMIT_CONFIRM_FRAMES > 1) then
				needsConfirm, confirmFrames = true, CONFIG.COMMIT_CONFIRM_FRAMES
			end
		-- near-post bias: the FAR side vs a wide threat needs one extra frame
		if needsConfirm and nearPostSide
			and (direction == "Left" or direction == "Right")
			and direction ~= nearPostSide then
			confirmFrames = confirmFrames + 1
		end
		-- 🧊 floor balls must SURVIVE the skid: +1 agreeing frame before the
		-- body leaves the ground for a side. (Never touches the plow — Forward was
		-- already chosen, or the read simply stays open, which is the point.)
		if floorShot and needsConfirm and CONFIG.FLOOR_CONFIRM_EXTRA > 0
			and (direction == "Left" or direction == "Right") then
			confirmFrames = confirmFrames + CONFIG.FLOOR_CONFIRM_EXTRA
		end

		local confirmed = not needsConfirm
		if needsConfirm then
			if direction ~= ST.commitDir then
				ST.commitDir, ST.commitFrames = direction, 1
			else
				ST.commitFrames = ST.commitFrames + 1
				confirmed = (ST.commitFrames >= confirmFrames)
			end
		end
		-- 📐 CURVE COMMIT: the prime side confirms on the FIRST frame — the
		-- move's signature IS the side, and a bending ball's wobbling
		-- prediction is less trustworthy than the researched bend. (If the
		-- ball persistently goes the other way, curveDir was abandoned
		-- above and the normal read applies.)
		if curveDir then
			direction = curveDir
			confirmed = true
		end

		if confirmed then
				if isBomb then
					hudLabel = "BOMB DIVE " .. direction .. "!!"
				elseif isQuickShot and (not instant) then
					hudLabel = "QUICK DIVE " .. direction .. "!"
				else
					hudLabel = "DIVE " .. direction .. "!"
				end
				hudColor = threatColor

				ST.commitDir, ST.commitFrames = nil, 0

				local tag
				if isExtreme then
					tag = "☄️ EXTREME — MAX URGENCY"
				elseif speedSpike then
					tag = "🚀 LATE SPIKE — INSTANT"
				elseif isBomb then
					tag = "💥 BOMB — FULL SPEED"
				elseif pointBlank then
					tag = "⚡ INSTANT REACTION"
				elseif speed >= CONFIG.BIG_BANG_SPEED then
					tag = "💥 BIG BANG"
				elseif isHyperShot then
					tag = "🔥 HYPER"
				elseif isQuickShot then
					tag = "🔥 QUICK"
				else
					tag = "🧤 NEUER"
				end
				if standOp then
					tag = tag .. " | 🦸 STAND OP"
				end
				if releaseLead then
					tag = tag .. " | ⚡ LEAD"
				end
				if shapeFwd then
					tag = tag .. " | 📖 FORWARD"
				end
				if activeMode then
					tag = tag .. " | 🎮 " .. activeMode.name
				end
				-- ⚡ v2.70 "how fast the ball went": when the launch reads hotter
				-- than the arrival, say so — it is exactly the number the friend
				-- screenshots and the number the bait net just consulted.
				local launchStr = ST.peakSinceShot >= speed + 8
					and string.format(" | ⚡Launch: %d", math.floor(ST.peakSinceShot)) or ""
				log(string.format("[AI-Dive] %s | Dir: %s | Ping: %dms | TTI: %.2fs | Speed: %d | @%d studs%s",
					tag, direction, math.floor(currentPing * 1000), timeToImpact, math.floor(speed),
					math.floor(distToGoalie), launchStr))
				fireDive(direction, now, speed, approachSpeed, effCooldown, jumpImpact, jumpGoal)
			else
				hudLabel = (isQuickShot and (not instant) and "QUICK READ " or "READING ") .. direction
				hudColor = threatColor
			end
		end
	end

	-- 7) 🖐️ SAVE DETECTION (IN HAND / HITBOX): a save counts ONLY when the
	-- ball ends up secured by you and moving slowly. "Secured" mirrors the
	-- game's own check: ball in hand (root radius) OR overlapping any of the
	-- keeper's hitbox parts. Parries, bounces and deflections don't count.
	if not diveWatch.resolved then
		local age = now - diveWatch.time
		if age > 1.5 then
			diveWatch.resolved = true -- expired: ball was never secured
			-- 🏃 v2.63: a dive that secured NOTHING is the EXACT frame the
			-- off-ball runner lives for — Rin's combo times the second killer
			-- shot to the keeper's reset. Arm the watch: feet back at
			-- REBOUND_REARM, and the follow-up is met EARLY, not late.
			ST.reboundUntil = now + CONFIG.REBOUND_WINDOW
			if (not ST.reboundLogged) or (now - ST.reboundLogged > 2.5) then
				ST.reboundLogged = now
				log(string.format("[AI-Dive] 🏃 SECOND-SHOT WATCH — rebound live for %.1fs: fast re-arm, early commit on the follow-up", CONFIG.REBOUND_WINDOW))
			end
		else
			local secured = (ballPos - rootPos).Magnitude <= CONFIG.BALL_IN_HAND_RADIUS
				or ballOverlapsKeeper(character, ballPos)
			if secured and speed < 30 then
				diveWatch.resolved = true
				matchStats.saves = matchStats.saves + 1
				ST.lastSaveTime = now
				ST.pendingFlash = { text = "SAVE!!", color = Color3.fromRGB(80, 255, 120), t = now }
				log("[AI-Dive] 🧤 SAVE! (ball secured)")
				ST.prof:result(false, lastShooterPlayer and lastShooterPlayer.Name) -- 📈 v2.80
				ST.sense:onSaved() -- 🧠 v2.83 match sense
				ST.prof:bank(lastShooterPlayer and lastShooterPlayer.Name,
					crossLateral and (crossLateral > 1.5 and "R" or (crossLateral < -1.5 and "L" or "M")) or "M", false) -- 🚀 v2.83 bank
			end
		end
	end

	-- 🧠 v2.83 MATCH SENSE — THE SITUATION READ: the moment, named. Every
	-- alert below answers "what kind of ball is this", and each one changes
	-- something real: the one-on-one is the only situation where the keeper
	-- may narrow his own angle by stepping out, the set piece and the crowd
	-- buy an extra beat of patience (deflections have no name on them), and
	-- the second ball is the rebound nobody claimed. Alerts are rate-limited
	-- and console-only (v2.67: no HUD paint).
	do
		local oneOnOne = ST.sense:oneOnOne(oppNear, distToGoalie)
		local sp = ST.sense:setPiece(speed, ST.nearOppCount or 0)
		local ch = ST.sense:chaos(ST.nearOppCount or 0)
		stateInfo.oneOnOne = oneOnOne
		stateInfo.setPiece = sp or nil
		stateInfo.chaos = ch or nil
		if oneOnOne and (now - (ST.senseLogged or -1e9)) > 3 then
			ST.senseLogged = now
			log("[AI-Dive] 🧠 ONE-ON-ONE — him and me: narrow the angle, the hands are the last line and the dive is the second", true)
		elseif sp and (now - (ST.senseLogged or -1e9)) > 3 then
			ST.senseLogged = now
			log("[AI-Dive] 🧠 SET PIECE — dead ball behind a wall: the shot is blocked before it is struck, hold the extra beat", true)
		elseif ch and (now - (ST.senseLogged or -1e9)) > 3 then
			ST.senseLogged = now
			log("[AI-Dive] 🧠 CROWD — four men around it: whatever comes out is a deflection with no name on it, read the ball", true)
		end
		-- The SECOND BALL: a loose ball in the box inside 8s of a goal is
		-- the tap-in that decides matches. It arms the same rebound watch a
		-- failed dive does — feet back fast, commit early on the follow-up.
		if ST.sense:secondBall(now, speed, distToGoalie) then
			ST.reboundUntil = now + CONFIG.REBOUND_WINDOW
			if (now - (ST.secondBallT or -1e9)) > 3 then
				ST.secondBallT = now
				log("[AI-Dive] 🧠 SECOND BALL — loose in the box off the last goal: feet back, the tap-in is the real shot", true)
			end
		end
	end

	-- 🚀 v2.83 TRAJECTORY 3.0 — HEARTBEAT: one honest status line every
	-- HEARTBEAT_SECS while the match is otherwise quiet. A keeper script
	-- that only speaks when it dives is indistinguishable from one that
	-- has silently died; this is the proof-of-life line, and it carries the
	-- numbers that matter over a whole match (saves, conceded, resets the
	-- guard ate, and the corner the ledger says we are losing).
	if (now - ST.heartbeatT) > CONFIG.HEARTBEAT_SECS then
		ST.heartbeatT = now
		local leakSide, leakShare = nil, 0
		if lastShooterPlayer then
			leakSide, leakShare = ST.prof:leak(lastShooterPlayer.Name)
		end
		-- 🧠 v2.83 MATCH SENSE on the heartbeat: the match-level numbers a
		-- keeper cannot see from inside a single dive.
		local st, gd = ST.sense:state()
		local form = ST.sense:form()
		local late, _ = ST.sense:lateGame()
		log(string.format("[AI-Dive] 💛 heartbeat — %d saved, %d conceded, %d reset%s%s%s%s",
			matchStats.saves or 0, matchStats.conceded or 0, ST.teleportN or 0,
			leakSide and string.format(" · leaking %s (%.0f%% of his finishes)",
				leakSide == "R" and "RIGHT" or (leakSide == "L" and "LEFT" or "MIDDLE"), leakShare * 100) or "",
			(ST.grazeFrames or 0) >= 2 and " · off the frame" or "",
			string.format(" · %s%s", st, (gd or 0) ~= 0 and string.format(" %+d", gd) or ""),
			string.format(" · %.1f/min%s%s%s", ST.sense:workload(),
				form and string.format(" · form %.0f%%", form * 100) or "",
				late and " · LATE" or "",
				-- 🖥️ v2.83c: the most important line in a "why is it not diving"
				-- report. With no goal parts the script falls back to 16x8 and can
				-- only judge on-target by CLOSEST APPROACH, which turns the keeper
				-- into a point-blank smotherer. Say it every heartbeat so it can
				-- never fail silently.
				(goal == nil) and " · ⚠️ NO GOAL GEOMETRY (fallback 16x8)" or "")), true)
	end

	--  WIDE diagnostic: if the keeper is being held back by the can't-score
	-- ruling, log WHY (once every 2.5s) so it's easy to verify.
	if not onTarget and goal and crossPos and (now - ST.lastWidePrint) > 2.5 then
		ST.lastWidePrint = now
		log(string.format("[AI-Dive] ruled WIDE/MISS — lateral %.1f (post %.1f), height %.1f (bar %.1f)",
			crossWide or 0, goal.halfWidth, crossY or 0, goal.crossbarY))
	end

	-- 8) 🥅 CONCEDE DETECTION (fallback without goal geometry):
	-- ball went behind the keeper within ~1.5s of being in front of it.
	if not goal then
		local keeperFacing = camForward
		local depthK = (ballPos - rootPos):Dot(keeperFacing)
		if depthK > 2 then
			ST.lastInFront = now
		-- 🐛 FAKE-GOAL FIX: a concede needs a credited shot within the window
		-- AND the ball crossing at shot speed — post-save rebounds, wide
		-- crossings, and carried balls no longer count.
		elseif depthK < -2 and (now - ST.lastInFront) < 1.5
			and (now - ST.lastShotReset) < CONFIG.CONCEDE_SHOT_WINDOW
			and speed > CONFIG.CONCEDE_MIN_SPEED
			and (now - ST.lastConcede) > 3 and (now - ST.lastSaveTime) > 3 then
			ST.lastConcede = now
			local ownGoal = (myKey and lastShooterKey == myKey)
				and (now - lastShooterTime) < CONFIG.SHOT_OWNER_MEMORY
			if ownGoal then
				ST.pendingFlash = { text = "OUR GOAL!!", color = Color3.fromRGB(80, 255, 120), t = now }
				log("[AI-Dive] ⚽ OUR GOAL!")
			else
				matchStats.conceded = matchStats.conceded + 1
				ST.prof:result(true, lastShooterPlayer and lastShooterPlayer.Name) -- 📈 v2.80
				ST.sense:onConceded() -- 🧠 v2.83 match sense
				ST.prof:bank(lastShooterPlayer and lastShooterPlayer.Name,
					crossLateral and (crossLateral > 1.5 and "R" or (crossLateral < -1.5 and "L" or "M")) or "M", true) -- 🚀 v2.83 bank
				diveWatch.resolved = true
				ST.pendingFlash = { text = "GOAL...", color = Color3.fromRGB(255, 60, 60), t = now }
				log("[AI-Dive] 🥅 CONCEDED")
			end
		end
	end

	-- 9) 📡 PUBLISH STATE (HUD / billboard / zone)
	-- 🔄 RECOVER CUE: for 1s after a dive, remind the keeper to reposition
	-- before the rebound / second shot.
	local displayLabel = hudLabel
	if (now - CHARGE.lastDive) < 1.0 then
		displayLabel = "🔄 RECOVER"
	end
	stateInfo.active  = true
	stateInfo.dist    = distToGoalie
	stateInfo.speed   = math.floor(speed)
	stateInfo.tti     = timeToImpact
	stateInfo.dir     = direction
	stateInfo.label   = displayLabel
	stateInfo.color   = hudColor
	stateInfo.zoneOn  = (hudLabel:find("DIVE", 1, true) ~= nil) or (hudLabel:sub(1, 7) == "READING")
	stateInfo.rootPos = rootPos
	stateInfo.toLine  = goal and ((ballPos - goal.linePos):Dot(goal.normal)) or nil
	stateInfo.striker = strikerDist
	-- 🧠 v2.83 MATCH SENSE telemetry — the geometry reads, published live
	-- (console/logs only, per the v2.67 rule: no HUD paint). These are
	-- MEASURED against the goal the script resolved, never assumed: the
	-- striker's angle, which post is near to him, and where the keeper
	-- should STAND to bisect it. Positioning is the cheapest save there is
	-- and it is what makes every subsequent dive shorter.
	do
		local ang, offAxis = ST.sense:angle(ballPos, goal)
		local nearP = ST.sense:nearPost(ballPos, goal)
		local shadeLat, shadeDepth = ST.sense:shade(ballPos, goal)
		stateInfo.angle = ang -- apparent goal width (mouth / range) — trig-free
		stateInfo.offAxis = offAxis
		stateInfo.nearPost = nearP
		stateInfo.shade = shadeLat
		stateInfo.shadeDepth = shadeDepth
		ST.lastAngle, ST.lastNearPost, ST.lastShade = stateInfo.angle, nearP, shadeLat
	end
	-- 🔮 v2.84 GK MOVE PREDICTION 2.0 — WHAT HAPPENS NEXT.
	-- Every frame the predictor answers four questions from MEASURED inputs and
	-- publishes them: where the keeper IS, where the keeper is GOING, where the
	-- attacker is going, and what this possession is about to become
	-- (shot / pass / carry / cross / clear). That man's own ledger habits NUDGE
	-- the geometry — they never outvote it, because a habitual passer standing
	-- 8 studs out with an open mouth is a SHOOTER right now, and the live
	-- picture is the evidence. Every number below is measured or derived from a
	-- measurement; none of it is a guess about how the game behaves.
	do
		local distG = goal and (ballPos - goal.linePos).Magnitude or 99
		local openn = ST.mp:openness(ballPos, goal)                     -- (12)
		local cName = attackerPlayer and attackerPlayer.Name or nil
		local space = ST.mp:spaceAhead(cName, goal, ST.roots, myKey, teamKeyOf)   -- (10)
		local sup   = ST.mp:support(ballPos, ST.roots, myKey, teamKeyOf,
			goal and -goal.normal or Vector3.zero)                       -- (11)
		local clos  = cName and ST.mp:closing(cName, goal) or 0         -- (9)
		ST.mp:weigh(goal, distG, stateInfo.angle, openn, sup, space, clos)  -- (13)
		ST.mp:blend(ST.prof, cName)                                     -- (14,15)
		local top, _, conf = ST.mp:topIntent()                          -- (16)
		ST.mp.top = top
		local held, heldN = ST.mp:stable(now)                           -- (17)
		ST.mp.conf    = conf
		ST.mp.threatV  = ST.mp:threat(distG, speed, openn, conf)        -- (22)
		ST.mp.press    = ST.mp:pressure(ballPos, ST.roots, myKey, teamKeyOf) -- (23)
		ST.mp.offLineV = ST.mp:offLine(rootPos, goal)                    -- (27)
		ST.mp.state   = ST.mp:keeperState(now, ST.diveStartT, ST.cooldownUntil)  -- (5)
		-- (19) A quarter second ahead, gravity included — the ball's near future,
		-- not its impact point: this is the number the reach test needs.
		ST.mp.nextB = ST.mp:nextBall(ballPos, velocity, 0.25, 196.2)
		-- (21) Can the keeper still get there from where he WILL BE? The reach
		-- cap is his own measured speed (floored at a jog), never a constant
		-- that claims to know how fast a keeper moves.
		local kCap = math.max(ST.mp:keeperSpeed(), 16)
		ST.mp.canReach = ST.mp:reachable(ST.mp:keeperAt(timeToImpact or 0.5),
			ST.mp.nextB, timeToImpact or 0.5, kCap)
		-- (30,31) How long the keeper still has to decide, and how long until
		-- he is armed again if he has just gone. Time running out is the
		-- hardest thing to feel in goal, so it gets a number.
		ST.mp.window  = ST.mp:diveWindow(timeToImpact, 0.12)
		ST.mp.rearmIn = ST.mp:recoverIn(now, ST.cooldownUntil)
		-- (34,35) Which side of the goal this really belongs to, and which way
		-- the keeper is ALREADY leaning — a keeper moving the wrong way has to
		-- start earlier than one already travelling towards it.
		ST.mp.lateral = ST.mp:mouth(ST.mp.nextB, goal)
		ST.mp.kBias   = ST.mp:bias(goal)
		-- (37) The striker's own shoulders, not the ball's: the earliest cue
		-- there is, and it is free.
		ST.mp.shoulder = cName and ST.mp:shotSide(cName, goal) or "M"
		-- (33) Does the ball sit up or skid? One is a catch, one is a dive.
		ST.mp.bounceT, ST.mp.bounceY = ST.mp:bounce(ballPos, velocity, 196.2, ballPos.Y - 1)
		-- (18) Worth naming a receiver only when the read says he is passing
		if held == "pass" then
			ST.mp:target(ballPos, ST.roots, myKey, teamKeyOf, goal)
			-- (29,32,36) ...and then only if the lane to him is genuinely
			-- open, plus where HE would go next and how bad that gets. A
			-- receiver you cannot reach is not an option.
			if ST.mp.tgtPos then
				ST.mp.laneOpen = ST.mp:lane(ballPos, ST.mp.tgtPos, ST.roots, myKey, teamKeyOf)
				ST.mp.secondP  = ST.mp:second(ST.mp.tgtName, 1.2)
				ST.mp.follow   = ST.mp:followThreat(ST.mp.tgtName, goal)
			end
		end
		-- (38,39) Confidence discounted by how little we actually know about
		-- this man (three touches is an anecdote, not a habit), and whether
		-- the pressure on him is building or easing.
		ST.mp.belief = ST.mp:confidence(ST.prof, cName)
		ST.mp.pressV = ST.mp.press
		ST.mp.trendV = ST.mp:trend()  -- NOTE: never `ST.mp.trend` — that IS the method
		stateInfo.mpTop    = held
		stateInfo.mpConf   = conf
		stateInfo.mpThreat = ST.mp.threatV
		stateInfo.mpState  = ST.mp.state
		stateInfo.mpBelief = ST.mp.belief
		-- (28,40) Log only when the HELD read actually changes. A per-frame
		-- log would drown the console and bury the events that matter, and
		-- the two-frame hold is what makes this a READ instead of a ticker.
		if held ~= ST.mpLastHeld and heldN >= 2 then
			ST.mpLastHeld = held
			log(string.format("🔮 PREDICT — %s · threat %.2f · belief %.0f%%",
				ST.mp:verdict(), ST.mp.threatV, (ST.mp.belief or 0) * 100), true)
		end
	end
	stateInfo.team    = myTeamLabel
	stateInfo.poss    = poss
	local attackerLabel = nil
	if profile then
		local mods = {}
		if profile.aerial then mods[#mods + 1] = "AERIAL" end
		if profile.barrage then mods[#mods + 1] = "BARRAGE" end
		attackerLabel = profile.label
		if #mods > 0 then attackerLabel = attackerLabel .. " (" .. table.concat(mods, "+") .. ")" end
	elseif attackerPlayer then
		local raw = styleNameByPlayer[attackerPlayer]
		if raw then attackerLabel = string.upper(raw) end -- unknown style: show raw name
	end
	stateInfo.attacker = attackerLabel
	stateInfo.mode     = activeMode and activeMode.name or nil
	stateInfo.charged  = charged and CHARGE.style or nil
	stateInfo.side     = MOVE.side
	stateInfo.band     = distBand(distToGoalie)
	stateInfo.shoot   = shootChance
	stateInfo.sideL   = sideL
	stateInfo.sideR   = sideR
	stateInfo.commit  = math.floor(commitDist)
	stateInfo.power   = math.floor(predSpeed)

	updateBillboard()
	updateZone()
	updateStyleTags() -- self-throttled to 0.5s: new joiners + style changes
	updateHud(hudLabel ~= lastHudLabel)
	lastHudLabel = hudLabel
end

local lastErrReport = 0
local errCount = 0
RunService.Heartbeat:Connect(function(deltaTime)
	-- 🛡️ The loop is pcall-guarded: a single nil reference mid-frame can
	-- never kill the whole script. The FIRST THREE errors are always printed
	-- (so you can see what broke), then throttled to one per 5 seconds.
	local tLua = os.clock()
	local ok, err = pcall(mainStep, deltaTime)
	ST.luaEma = (ST.luaEma or 0) * 0.95 + (os.clock() - tLua) * 0.05
	if not ok then
		errCount = errCount + 1
		if errCount <= 3 or (os.clock() - lastErrReport) > 5 then
			lastErrReport = os.clock()
			print("[Auto-Dive] ❌ LOOP ERROR #" .. errCount .. ": " .. tostring(err))
			warn("[Auto-Dive] loop error: " .. tostring(err))
		end
	end
end)

