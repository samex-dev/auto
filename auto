-- ==========================================
-- 📡 NETWORK OWNERSHIP — authoritative ball possession (v2.34)
-- When the server gives a player CONTROL of the ball (dribble/hold), that
-- player's character root becomes the ball part's NetworkOwner — a property
-- that replicates to clients, so we can READ who really owns the ball
-- instead of guessing from distance. This kills the two classic heuristic
-- failures: diving while a TEAMMATE owns the ball, and refusing to dive
-- (or diving late) when an OPPONENT owns it but a teammate happens to be
-- standing next to the ball. If the game ever leaves NetworkOwner nil,
-- the distance heuristics below take over exactly as before.
-- ==========================================
local function networkOwnerPlayer(ballPart)
	if not ballPart then return nil end
	local owner = nil
	local ok, o = pcall(function() return ballPart.NetworkOwner end)
	if ok then owner = o end
	if not owner then return nil end
	for _, plr in ipairs(Players:GetPlayers()) do
		local char = plr.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root == owner then return plr end
	end
	return nil
end

-- ==========================================
-- 🦘 TOP-BIN AUTO-JUMP (v2.37)
-- Community-observed mechanic: a keeper who JUMPS and then DIVES reaches
-- higher than a flat dive — that's how top-bin (top corner) balls get
-- saved. We reproduce it: when the predicted impact is high enough, fire
-- a local jump right before the dive fires. pcall-wrapped on both known
-- local jump methods (ChangeState = the standard local trick, Jump = the
-- server API many games still allow from LocalScripts) — if the game
-- restricts both, it's a clean no-op and the dive fires as before.
-- ==========================================
-- 📏 FALLBACK NET (v2.39): when the live post scan misses, the "top bin" is
-- still defined against the REAL net — the one measured pixel-for-pixel from
-- the keeper's own in-game screenshot (≈ 8 studs tall). A standing keeper's
-- root sits ~3 studs off the ground, so the net ABOVE the root ≈
-- crossbar - 3 = 5 studs; the top bin is the top 30% of THAT.
-- ==========================================
local function fallbackGoalHeightAboveRoot()
	return math.max(2, CONFIG.NET_CROSSBAR_STUDS - 3)
end

local lastAutoJump = 0
local function tryAutoJump(impactHeightAboveRoot, goalHeightAboveRoot, diveSpeed)
	if not CONFIG.AUTO_JUMP_TOP_BIN then return false end
	-- 🌈 v2.56: never leap at a flick. While the memory window is open (and
	-- the ball is still under strike speed — a genuine shot struck off the pop
	-- clears the gate instantly), feet on the ground wait out the drop; the GK
	-- tackle/step-up paths handle the ball when the attacker collects it.
	if ST.flickT and (os.clock() - ST.flickT) < CONFIG.FLICK_MEMORY
		and (diveSpeed or 0) < CONFIG.DRIBBLE_MAX_SPEED then
		return false
	end
	-- 📏 DATA-DRIVEN TOP-BIN TEST: the fandom publishes no net dimensions,
	-- so the script measures the REAL in-game goal (crossbar height) at
	-- runtime. The "top bin" is defined against the ACTUAL measured net:
	-- jump when the predicted impact reaches a fraction of the real goal
	-- height. If the goal isn't detected, fall back to the screenshot-measured
	-- net (v2.39) instead of a blind fixed threshold.
	local goalH = (goalHeightAboveRoot and goalHeightAboveRoot > 2)
		and goalHeightAboveRoot
		or fallbackGoalHeightAboveRoot()
	local topBin = impactHeightAboveRoot >= (goalH * CONFIG.TOP_BIN_JUMP_FRACTION)
	if not topBin then return false end
	local now = os.clock()
	if now - lastAutoJump < CONFIG.AUTO_JUMP_COOLDOWN then return false end
	-- 🧱 v2.51: an awakened RONALDO near the goal turns a LEAPING keeper into a
	-- TAP-DUEL cutscene (“whoever taps more gets the goal” — fandom). Feet on the
	-- ground never start that fight: standing ground IS the counter.
	if ST.noLeap and now < ST.noLeap then return false end
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return false end
	local ok1 = pcall(function()
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	end)
	-- v2.44: ok1 only means "the call did not throw". Games that own the humanoid
	-- state machine IGNORE ChangeState silently, so the documented "both local
	-- jump methods are tried" fallback never ran (it was gated on the call
	-- ERRORING). Ask whether the state really moved, and reach for Jump() when it
	-- did not — Jump() is itself a no-op while airborne, so the pair can never
	-- double-jump.
	local moved = false
	if ok1 then
		-- 🐛 v2.58 (friend console: `Falling is not a valid member of
		-- "Enum.HumanoidStateType"`): the state MEMBERS are not a fixed set —
		-- older/embedded clients lack .Falling (they name the air state .Freefall
		-- instead). Reading a missing member THROWS, and this line threw AFTER the
		-- jump call but BEFORE the dive's FireServer downstream — on that client
		-- every top-bin attempt ATE ITS OWN DIVE (his screen, one second apart:
		-- EXTREME commit → LOOP ERROR #3 → CONCEDED). Compare states by NAME;
		-- names survive every enum shape, and nothing can throw.
		local stName
		local okState = pcall(function() stName = tostring(humanoid:GetState()) end)
		if okState and stName then
			moved = stName:find(".Jumping", 1, true) ~= nil
				or stName:find(".Falling", 1, true) ~= nil
				or stName:find(".Freefall", 1, true) ~= nil
		end
	end
	local ok2 = false
	if not moved then
		ok2 = pcall(function() humanoid:Jump() end)
	end
	if (ok1 and moved) or ok2 then
		lastAutoJump = now
		log("[AI-Dive] 🦘 TOP-BIN JUMP (impact " .. string.format("%.1f", impactHeightAboveRoot)
			.. " studs up" .. (goalHeightAboveRoot and string.format(" / net %.1f", goalHeightAboveRoot) or "") .. ")")
		-- 🦘🦘 v2.50: crossbar-clipper? Arm ONE apex hop after this jump — the
		-- keeper's answer to the game's own mario-hop (see AUTO_DOUBLE_JUMP).
		if CONFIG.AUTO_DOUBLE_JUMP and (not ST.djArmed)
			and impactHeightAboveRoot >= goalH * CONFIG.DOUBLE_JUMP_HEIGHT_FRACTION then
			ST.djArmed = true
			ST.djAt = now + CONFIG.AUTO_DOUBLE_JUMP_DELAY
		end
		return true
	elseif ok1 or ok2 then
		-- The calls were accepted but the humanoid never left the ground: this game
		-- owns its humanoid states. Say so ONCE — otherwise "no jump" is invisible
		-- and the top bin quietly stays unsavable.
		lastAutoJump = now
		if not ST.jumpBlockedWarned then
			ST.jumpBlockedWarned = true
			warn("[Auto-Dive] ⚠️ top-bin jump blocked by the game (the humanoid never enters"
				.. " Jumping) — dives still fire, just flat. AUTO_JUMP_TOP_BIN=false hides this.")
		end
	end
	return false
end

