	--      under FAKE_SPEED_MAX, and the ball is still within FAKE_TRAVEL
	--      studs of where it was kicked: a fake died at the feet. A real
	--      shot is already 14+ studs out by the time it bleeds that much,
	--      so it escapes the hold and still gets dived.
	FAKE_CONFIRM_TIME   = 0.15,   -- s after the kick a sub-110 pop is "unproven" (ends early once it proves a real shot)
	FAKE_CONFIRM_PEAK   = 110,    -- pops at/above this are real shot speed — dive now
