local function baseName(s)
	return (s:match("^[^%(]*") or s)
end

-- Match a raw style string against the roster; returns profile key or nil
local function matchCharKey(s)
	local n = normName(baseName(s))
	if n == "" then return nil end
	for key, names in pairs(CHAR_NAMES) do
		for _, t in ipairs(names) do
			if n == normName(t) then
				return key
			end
		end
	end
	return nil
end

