-- 📱 v2.55 THE FITTER. Field report #2 from the friend's phone: the lag is
-- gone, but the HUD is a 720-px desktop panel and on a 640-px screen it covers
-- half the game. Everything visual that is NOT the game itself gets one scale:
-- HUD frame + lines + save flash, the floating studs label, and every style
-- tag's font. Driven by Camera.ViewportSize.X (real pixels), re-checked at
-- 1 Hz by the governor loop and forced once at boot — so phone→tablet→desktop
-- and rotation all re-fit themselves. The floor (UI_FIT_MIN) keeps text
-- legible; the dive pipeline was never touched (it reads no GUI).
fitUi = function(force)
	local cam = workspace.CurrentCamera or Camera
	local ok, vp = pcall(function() return cam and cam.ViewportSize end)
	if not ok or not vp or not vp.X or vp.X <= 0 then return end
	local w = vp.X
	if not force and math.abs(w - uiFitW) < 8 then return end  -- rotation jitter guard
	uiFitW = w
	local sc = w / CONFIG.UI_FIT_REF
	if sc > 1 then sc = 1 elseif sc < CONFIG.UI_FIT_MIN then sc = CONFIG.UI_FIT_MIN end
	if not force and math.abs(sc - uiScaleCur) < 0.03 then return end
	uiScaleCur = sc
	local function px(v) return math.floor(v * sc + 0.5) end
	if hudRefs then
		local hf = hudRefs.frame
		if hf then
			hf.Size     = UDim2.fromOffset(px(720), px(80))
			hf.Position = UDim2.new(0.5, -px(360), 0, px(10))
			if hudRefs.corner then hudRefs.corner.CornerRadius = UDim.new(0, math.max(2, px(8))) end
		end
		hudRefs.line1.TextSize = math.max(10, px(14))
		hudRefs.line2.TextSize = math.max(10, px(15))
		hudRefs.line3.TextSize = math.max(10, px(13))
		local fl = hudRefs.flash
		if fl then
			fl.Size     = UDim2.fromOffset(px(500), px(60))
			fl.Position = UDim2.new(0.5, -px(250), 0, px(130))
			fl.TextSize = math.max(16, px(44))
		end
	end
	if bbRefs and bbRefs.label then
		bbRefs.label.TextSize = math.max(12, px(24))
	end
	for _, tag in pairs(styleTags) do
		if tag.label then tag.label.TextSize = math.max(11, px(22)) end
	end
	log(string.format("[AI-Dive] 📱 UI FIT — %.2f× on a %d px screen (reads: HUD %d px wide)",
		sc, math.floor(w + 0.5), px(720)))
end

