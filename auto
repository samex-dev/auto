local fitUi = nil  -- 📱 v2.55: defined after the UI builders; the governor polls it

-- 🐢 v2.54 THE GOVERNOR (see CONFIG.LOW_SPEC_GUARDIAN). It owns the tag-follow
-- loop too (folded in from its own connection: one Heartbeat, one cadence, and
-- the follow is the exact paint a weak phone cannot afford 60 times a second).
local zoneFolderRef = nil   -- set by createZone at boot; hidden in tier 2
local emaDt = 0
local uiFitPoll = 0
RunService.Heartbeat:Connect(function(dt)
	-- 📱 0) viewport watch (v2.55): one property read per second, and the
	-- actual re-fit only runs when the screen width really moved (≥8 px).
	-- Independent of the paint guardian below — UI fit is about SIZE, not fps.
	if CONFIG.UI_AUTO_FIT and fitUi then
		local tv = os.clock()
		if tv - (uiFitPoll or 0) > 1 then
			uiFitPoll = tv
			fitUi(false)
		end
	end
	-- 1) paint governor (guarded: with LOW_SPEC_GUARDIAN off nothing below runs
	--    and ST.ecoTier simply stays 0 = full paint forever)
	if CONFIG.LOW_SPEC_GUARDIAN and aiEnabled then
		emaDt = emaDt * 0.94 + (dt or 0.016) * 0.06
		local tier = ST.ecoTier or 0
		local want = tier
		if emaDt > 0.045 then want = 2
		elseif emaDt > 0.030 then
			if want < 1 then want = 1 end
		elseif emaDt < 0.026 then want = 0
		elseif emaDt < 0.036 and want == 2 then want = 1
		end
		if want ~= tier then
			ST.ecoTier = want
			-- log EVERY tier change: the hysteresis itself is the anti-spam (a tier
			-- flip needs seconds of sustained frame-time in the other direction, and
			-- the EMA at 0.06 cannot oscillate across two thresholds per second)
			if want > 0 then
				log(want == 2 and "[AI-Dive] 🐢 LOW-SPEC GUARDIAN: deep — dots, tags and zones OFF (dives untouched)"
					or "[AI-Dive] 🐢 LOW-SPEC GUARDIAN: easing paint (dives untouched)")
			else
				log("[AI-Dive] 🐢 LOW-SPEC GUARDIAN: full paint (device recovered)")
			end
			local show = want < 2
			for i = 1, #tagAnchors do
				local bb = tagAnchors[i].bb
				if bb then pcall(function() bb.Enabled = show end) end
			end
			if zoneFolderRef then pcall(function() zoneFolderRef.Visible = show end) end
			if want > 0 then hideVisuals() end
		end
	end
	-- 2) tag follow (v2.44: root found ONCE, re-found when it dies; v2.48: also
	--    re-bound on CHARACTER identity change; v2.54: tiered cadence)
	local n = #tagAnchors
	if n == 0 or not CONFIG.SHOW_STYLE_TAGS then return end
	if (ST.ecoTier or 0) >= 2 then return end
	if (ST.ecoTier or 0) == 1 then
		local tn = os.clock()
		if tn - (ST.tagFollowT or 0) < 0.05 then return end
		ST.tagFollowT = tn
	end
	local lift = CONFIG.TAG_HEIGHT
	for i = 1, n do
		local t = tagAnchors[i]
		local root = t.root
		if not root or not root.Parent or t.char ~= t.player.Character then
			local char = t.player.Character
			t.char = char
			root = char and char:FindFirstChild("HumanoidRootPart")
			t.root = root
		end
		if root then
			local rp = root.Position
			t.anchor.CFrame = CFrame.new(rp.X, rp.Y + lift, rp.Z)
		end
	end
end)

local function updateHud(force)
	if not hudRefs then return end
	local t = os.clock()
	-- 🐢 v2.54: every Text write re-lays the label — on a weak phone that is
	-- often the single most expensive line in the script. 10 Hz normally, 3.5x/7x
	-- eased under the guardian, and every write below is now gated on CHANGE.
	local every = 0.1
	if ST.ecoTier == 1 then every = 0.35 elseif ST.ecoTier == 2 then every = 0.7 end
	if not force and (t - lastHudUpdate) < every then return end
	lastHudUpdate = t

	local statsStr = string.format("🧤 SAVES %d   🥅 CONC %d   (%s)",
		matchStats.saves, matchStats.conceded, statsRateStr())

	local teamStr = stateInfo.team and (string.format("   🏟️ %s", stateInfo.team)) or ""
	local attackStr = stateInfo.attacker and (string.format("   ⚔️ %s", stateInfo.attacker)) or ""

