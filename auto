				end)
			end
			if status and not skip then status.Text = string.format("script loads in %.1fs…", math.max(0, remain)) end
			task.wait(0.1)
		end
		if status then status.Text = skip and "⚡ LOADED NOW — keeper online" or "✅ LOADED — keeper online" end
		for i = 1, (skip and 4 or 20) do                  -- 🎬 the BACKTRACK (v2.65:
			local u = ease(i / 20)                        -- the long, readable 8s
			place(0.5 + 0.45 * u, 0.13 + 0.87 * u)       -- center it came to, straight back down
			task.wait(1 / 30)
		end
