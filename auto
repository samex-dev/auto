-- 🏟️ TEAM TRACKER (home vs away — teammates are never threats)
-- Detection priority: player.Team -> game leaderboard (Home/Away nodes)
--                     -> character TeamColor. Unknown = treated as opponent.
-- ==========================================
local teamCache    = {} -- Player -> group key ("team:X" / "lb:Home" / "tc:...")
local lbSideByName = {} -- lowercased player name -> "Home" / "Away"
local myTeamLabel  = nil -- for the HUD
local lastTeamScan = 0
local lastLbScan   = 0

local function sideOfName(name)
	local n = string.lower(name)
	if n:find("home", 1, true) or n:find("host", 1, true) or n:find("local", 1, true) then
		return "Home"
	end
	if n:find("away", 1, true) or n:find("guest", 1, true) or n:find("visit", 1, true) then
		return "Away"
	end
	return nil
end

local function findBoard(parent)
	-- 1) A node whose name says leaderboard/scoreboard/teams/scores
	for _, inst in ipairs(parent:GetDescendants()) do
		local n = string.lower(inst.Name)
		if n:find("leaderboard", 1, true) or n:find("scoreboard", 1, true)
			or n:find("score", 1, true) or n:find("team", 1, true) then
			return inst
		end
	end
	-- 2) Fallback: any node that has BOTH a home-ish and an away-ish child
	for _, inst in ipairs(parent:GetDescendants()) do
		local hasHome, hasAway = false, false
		for _, child in ipairs(inst:GetChildren()) do
			local cn = string.lower(child.Name)
			if cn:find("home", 1, true) or cn:find("host", 1, true) then hasHome = true end
			if cn:find("away", 1, true) or cn:find("guest", 1, true) then hasAway = true end
		end
		if hasHome and hasAway then
			return inst
		end
	end
	return nil
end

local function scanLeaderboard()
	-- Find the game's leaderboard (workspace, ReplicatedStorage, ReplicatedFirst,
	-- PlayerGui), then the Home/Away nodes inside it, then player names
	-- (child names or TextLabels) under each side -> side map for EVERY player.
	local parents = { workspace, ReplicatedStorage, game:GetService("ReplicatedFirst") }
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if pg then parents[#parents + 1] = pg end

	local board = nil
	for _, parent in ipairs(parents) do
		board = findBoard(parent)
		if board then break end
	end
	if not board then return end

	local players = Players:GetPlayers()
	for _, node in ipairs(board:GetDescendants()) do
		local side = sideOfName(node.Name)
		if side then
			for _, inst in ipairs(node:GetDescendants()) do
				local iname = string.lower(inst.Name)
				local itext = inst:IsA("TextLabel") and string.lower(inst.Text) or nil
				for _, plr in ipairs(players) do
					local pname = string.lower(plr.Name)
					if iname == pname or itext == pname then
						lbSideByName[pname] = side
					end
				end
			end
		end
	end
end

local function refreshTeams()
	local now = os.clock()
	if now - lastLbScan >= 2 then
		lastLbScan = now
		pcall(scanLeaderboard)
	end
	if now - lastTeamScan < 1 then return end
	lastTeamScan = now

	-- Collect per-player candidate keys from each source
	local cands = {} -- plr -> { team = key, lb = key, tc = key }
	local teamNames, tcKeys = {}, {}
	local nTeam, nTc = 0, 0
	for _, plr in ipairs(Players:GetPlayers()) do
		local c = {}
		local t = plr.Team
		if t and t.Name ~= "" then
			c.team = "team:" .. t.Name
			teamNames[c.team] = true
			nTeam = nTeam + 1
		end
		local lb = lbSideByName[string.lower(plr.Name)]
		if lb then
			c.lb = "lb:" .. lb
		end
		local char = plr.Character
		local rootPart = char and char:FindFirstChild("HumanoidRootPart")
		-- 🛡️ TeamColor is NOT a valid member of a plain Part in some games —
		-- read it pcall-safe from the Model first, then the part.
		local tc = nil
		do
			local ok, v = pcall(function() return char.TeamColor end)
			if ok and v then tc = v end
			if not tc and rootPart then
				ok, v = pcall(function() return rootPart.TeamColor end)
				if ok and v then tc = v end
			end
		end
		if tc and (tc.R < 0.95 or tc.G < 0.95 or tc.B < 0.95) then
			c.tc = string.format("tc:%d-%d-%d",
				math.floor(tc.R * 255), math.floor(tc.G * 255), math.floor(tc.B * 255))
			tcKeys[c.tc] = true
			nTc = nTc + 1
		end
		cands[plr] = c
	end

	-- 🛡️ SANITY: if (almost) everyone shares ONE Team or ONE TeamColor, the
	-- game is reusing that field for something else (free-for-all modes do
	-- this) — it is NOT a home/away split. Discard the useless source so we
	-- fall back to the leaderboard. Without this, every opponent can be
	-- misread as "OWN TEAM" and the keeper would never dive.
	local function distinctCount(tbl)
		local n = 0
		for _ in pairs(tbl) do n = n + 1 end
		return n
	end
	local teamUseless = (nTeam >= 2) and (distinctCount(teamNames) <= 1)
	local tcUseless   = (nTc >= 2) and (distinctCount(tcKeys) <= 1)

	for _, plr in ipairs(Players:GetPlayers()) do
		local c = cands[plr]
		local key = nil
		if c.team and not teamUseless then
			key = c.team
		elseif c.lb then
			key = c.lb
		elseif c.tc and not tcUseless then
			key = c.tc
		end
		teamCache[plr] = key
	end

	local my = teamCache[LocalPlayer]
	if my then
		if my:sub(1, 5) == "team:" then
			myTeamLabel = my:sub(6)
		elseif my:sub(1, 4) == "lb:" then
			myTeamLabel = my:sub(5)
		else
			myTeamLabel = "Team " .. my:sub(4)
		end
	else
		myTeamLabel = nil
	end
end

local function teamKeyOf(plr)
	return teamCache[plr]
end

