-- VERSION — one string, printed at boot. The banner above and this constant
-- are the only two places the release number is written, so bump BOTH.
-- (The boot line used to hard-code "v2.44" and stayed frozen for ~39
-- releases — the console lied about which script was running.)
local VERSION = "v2.84"
-- ==========================================
-- SERVICES
-- ==========================================
local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Stats             = game:GetService("Stats")

local LocalPlayer = Players.LocalPlayer

local CONSOLE = (function()
	-- ==========================================
	-- 🖥️ v2.83 THE SCRIPT'S OWN CONSOLE — capture layer.
	--
	-- (user, verbatim: "make a button that when I press it shows the console but
	-- not the console of Roblox a console of urs which lets u read every bug
	-- every input that the script made and I don't have to record a vid so u
	-- can see everything cuz I would have to scroll in console so I would just
	-- make a pic and send it")
	--
	-- Roblox's console is a scrolling fight: it fills with the GAME's chatter,
	-- it truncates, and getting a bug out of it means recording a video and
	-- scrubbing. So the script keeps its OWN ring buffer, written at the source:
	-- every line it prints, time-stamped, including the ones the v2.7x log
	-- budget muted (the budget protects a struggling device's OUTPUT — it must
	-- never be allowed to hide a bug from the console).
	--
	-- Capture is deliberately CHEAP — one os.clock() and one table slot, no
	-- substring work — because it runs on every log() call, many of which
	-- happen every frame. Classification and colouring happen at RENDER time,
	-- when the panel is open, not per line.
	-- ==========================================
	local LOG_BUF, LOG_HEAD, LOG_SEQ, LOG_MAXN = {}, 0, 0, 600
	local function captureLog(msg)
		LOG_SEQ = LOG_SEQ + 1
		LOG_HEAD = (LOG_HEAD % LOG_MAXN) + 1
		LOG_BUF[LOG_HEAD] = { t = os.clock(), n = LOG_SEQ, s = tostring(msg) }
	end

	-- Every print the script makes is captured too, so the console carries the
	-- boot banner, the curtain and the loop errors — not just log() lines.
	local _rawPrint = print
	print = function(...)
		local n = select("#", ...)
		local parts, i = {}, 1
		while i <= n do parts[i] = tostring((select(i, ...))); i = i + 1 end
		captureLog(table.concat(parts, "\t"))
		_rawPrint(...)
	end

	-- Render-time classification (never runs on the hot path).
	local LOG_COLORS = {
		err  = "#ff6b6b", warn = "#ffcc55", dive = "#6bc7ff",
		bait = "#c792ea", info = "#c3cede",
	}
	local function classifyLog(s)
		if s:find("LOOP ERROR", 1, true) or s:find("attempt to", 1, true)
			or s:find("stack traceback", 1, true) or s:find("❌", 1, true)
			or s:find("error loading", 1, true) then return "err" end
		if s:find("WARN", 1, true) or s:find("⚠", 1, true) then return "warn" end
		if s:find("🪤", 1, true) or s:find("🎭", 1, true) or s:find("BAIT", 1, true) then return "bait" end
		if s:find("Dir: ", 1, true) or s:find("SAVE", 1, true) or s:find("dive", 1, true) then return "dive" end
		return "info"
	end
	-- Ordered snapshot (the buffer is a ring — the oldest slot is the next one).
	local function logSnapshot()
		local out = {}
		for i = 1, LOG_MAXN do
			local e = LOG_BUF[((LOG_HEAD + i - 1) % LOG_MAXN) + 1]
			if e then out[#out + 1] = e end
		end
		table.sort(out, function(a, b) return a.n < b.n end)
		return out
	end
	-- The plain-text export: what gets copied out and pasted to me.
	local function consoleText(filter)
		local lines, out, errs, warns = logSnapshot(), {}, 0, 0
		for _, e in ipairs(lines) do
			local lvl = classifyLog(e.s)
			if lvl == "err" then errs = errs + 1
			elseif lvl == "warn" then warns = warns + 1 end
			if (not filter) or filter == "ALL" or filter == lvl then
				out[#out + 1] = string.format("[%8.2f] %s", e.t, e.s)
			end
		end
		local head = string.format("=== GK AI %s console — %d line(s), %d error(s), %d warning(s) ===",
			VERSION, #out, errs, warns)
		return head .. "\n" .. table.concat(out, "\n"), errs, warns
	end
	-- Cheap level counts for the badge (no string building — this runs on a timer).
	local function countLevels()
		local lines, e, w = logSnapshot(), 0, 0
		for i = 1, #lines do
			local l = classifyLog(lines[i].s)
			if l == "err" then e = e + 1 elseif l == "warn" then w = w + 1 end
		end
		return e, w
	end

	-- ==========================================
	-- 🖥️ v2.83 THE CONSOLE PANEL — built once at boot, hidden until asked for.
	--
	-- It paints NOTHING while closed (v2.67: no automatic HUD paint), it is
	-- pcall-guarded end to end, and it is wired to nothing in the dive path —
	-- a console that can break the keeper is worse than no console. If any
	-- Instance call fails on an unusual client, the console simply does not
	-- appear and the keeper is untouched.
	-- ==========================================
	local consoleRefs = nil
	local function mk(class, props, parent)
		local o = Instance.new(class)
		for k, v in pairs(props) do o[k] = v end
		if parent then o.Parent = parent end
		return o
	end
	local function escRich(s)
		return s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
	end
	local function refreshConsole()
		local R = consoleRefs
		if not R then return end
		local lines, parts, shown = logSnapshot(), {}, 0
		for i = #lines, 1, -1 do                       -- newest first
			local e = lines[i]
			local lvl = classifyLog(e.s)
			if R.filter == "ALL" or R.filter == lvl then
				parts[#parts + 1] = string.format('<font color="#5d6b80">[%7.2f]</font> <font color="%s">%s</font>',
					e.t, LOG_COLORS[lvl], escRich(e.s))
				shown = shown + 1
				if shown >= 400 then break end           -- the panel's own ceiling
			end
		end
		R.rt.Text = table.concat(parts, "\n")
		R.rt.Size = UDim2.new(1, -12, 0, math.max(20, shown * 15))
		R.scroll.CanvasSize = UDim2.new(0, 0, 0, math.max(20, shown * 15 + 8))
		local errs, warns = countLevels()
		R.badge.Text = (errs > 0 and ("🔴 " .. errs .. " error(s) — tap ERR"))
			or (warns > 0 and ("🟡 " .. warns .. " warning(s)")) or "✅ no errors"
		R.badge.TextColor3 = (errs > 0 and Color3.fromRGB(255, 90, 90))
			or (warns > 0 and Color3.fromRGB(255, 200, 80)) or Color3.fromRGB(120, 220, 150)
		R.status.Text = string.format("%d line(s) shown · filter: %s", shown, R.filter)
	end
	local function toggleConsole()
		local R = consoleRefs
		if not R then return end
		R.gui.Enabled = not R.gui.Enabled
		if R.gui.Enabled then refreshConsole() end
		_rawPrint("[Auto-Dive] 🖥️ console " .. (R.gui.Enabled and "opened" or "closed"))
	end
	local function buildConsole(cfg)
		if cfg.SHOW_CONSOLE == false then return end -- on unless explicitly off
		local ok, pg = pcall(function() return LocalPlayer:WaitForChild("PlayerGui", 5) end)
