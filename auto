			for _, n in ipairs({ "AutoDiveConsole", "AutoDiveConsoleBtn" }) do
				local old = pg:FindFirstChild(n)
				if old then old:Destroy() end
			end
			-- ── the panel ────────────────────────────────────────────────
			local gui = mk("ScreenGui", {
				Name = "AutoDiveConsole", ResetOnSpawn = false,
				IgnoreGuiInset = true, DisplayOrder = 1002, Enabled = false,
			}, pg)
			local frame = mk("Frame", {
				Size = UDim2.new(0.74, 0, 0.76, 0), Position = UDim2.new(0.13, 0, 0.12, 0),
				BackgroundColor3 = Color3.fromRGB(9, 11, 17), BackgroundTransparency = 0.04,
				BorderSizePixel = 0, Parent = gui,
			})
			mk("UICorner", { CornerRadius = UDim.new(0, 10), Parent = frame })
			-- header
			local head = mk("Frame", {
				Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = Color3.fromRGB(18, 22, 32),
				BorderSizePixel = 0, Parent = frame,
			})
			mk("TextLabel", {
				Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.new(0, 12, 0, 0),
				BackgroundTransparency = 1, Text = "🖥️ GK AI CONSOLE — everything the script said",
				TextColor3 = Color3.fromRGB(190, 205, 225), Font = Enum.Font.GothamBold,
				TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Parent = head,
			})
			R.badge = mk("TextLabel", {
				Size = UDim2.new(0.34, 0, 1, 0), Position = UDim2.new(0.5, 0, 0, 0),
				BackgroundTransparency = 1, Text = "✅ no errors",
				TextColor3 = Color3.fromRGB(120, 220, 150), Font = Enum.Font.GothamBold,
				TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right, Parent = head,
			})
			mk("TextButton", {
				Size = UDim2.new(0, 34, 0, 26), Position = UDim2.new(1, -42, 0, 4),
				BackgroundColor3 = Color3.fromRGB(70, 30, 40), TextColor3 = Color3.fromRGB(255, 170, 170),
				Font = Enum.Font.GothamBold, TextSize = 15, Text = "✕", BorderSizePixel = 0,
