	{ "MAX_INTEREST_DISTANCE",      30.0,   600.0, 200 },
	{ "MAX_IMPACT_DISTANCE",        10.0,   400.0, 120 },
}

local function validateConfig()
	local fixes = {}
	for _, rule in ipairs(CONFIG_RULES) do
		local key, lo, hi, fallback = rule[1], rule[2], rule[3], rule[4]
		local v = CONFIG[key]
		if type(v) ~= "number" or v ~= v or v < lo or v > hi then
			CONFIG[key] = fallback
			fixes[#fixes + 1] = string.format("%s -> %s (was %s)", key, tostring(fallback), tostring(v))
		end
	end
	-- relationships between keys a range check cannot see
	if CONFIG.SIM_STEP_MAX < CONFIG.SIM_STEP_MIN then
		CONFIG.SIM_STEP_MAX = CONFIG.SIM_STEP_MIN
		fixes[#fixes + 1] = "SIM_STEP_MAX raised to SIM_STEP_MIN"
	end
	if CONFIG.COMMIT_MAX_DIST < CONFIG.COMMIT_BASE_DIST then
		CONFIG.COMMIT_MAX_DIST = CONFIG.COMMIT_BASE_DIST
		fixes[#fixes + 1] = "COMMIT_MAX_DIST raised to COMMIT_BASE_DIST"
	end
	if CONFIG.MIN_DIVE_SPEED < CONFIG.MIN_SHOT_SPEED then
		CONFIG.MIN_SHOT_SPEED = CONFIG.MIN_DIVE_SPEED
		fixes[#fixes + 1] = "MIN_SHOT_SPEED clamped to MIN_DIVE_SPEED (a slow tier below the dive tier is a contradiction)"
	end
	local ballNameCount = 0
	for _ in pairs(CONFIG.BALL_NAMES) do ballNameCount = ballNameCount + 1 end
	-- (pairs, not # : BALL_NAMES is a SET keyed by name, so # is always 0)
	if ballNameCount == 0 then
		CONFIG.BALL_NAMES = { ball = true, football = true, soccerball = true,
			ballpart = true, gkball = true, matchball = true, theball = true,
			mainball = true, gameball = true, ballmodel = true, ballhitbox = true }
		fixes[#fixes + 1] = "BALL_NAMES was empty, restored the defaults (the tracker cannot run without it)"
	end
	return fixes
end

