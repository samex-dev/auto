-- ==========================================
-- 📝 LOGGING — one gate so VERBOSE=false is genuinely quiet
-- ==========================================
-- 📟 v2.57 LOG BUDGET — on weak phones PRINTS ARE FRAMES: with the
-- executor console attached, one print can cost more than the entire Lua
-- decision for its frame, and a scramble (handler flipping every swap, floor
-- reads, dive lines) can stack a dozen in a second. Every console line now
-- flows through a sliding budget: 8 lines per 2 s normally, 3 while the
-- low-spec guardian is easing. Boot gets a wider first window (12) so the
-- load banner is never clipped. Muted lines are NEVER lost silently — the
-- next allowed line reports the count. VERBOSE=false still mutes everything.
local ecoLogTier = 0        -- the governor (below, later in the file) writes its tier here
local logT0, logN, logMax, logMuted = -999, 0, 12, 0
local function log(msg, urgent)
	-- 🖥️ v2.83: captured BEFORE the verbose/budget gates — a muted line must
	-- still reach the script's own console. The budget exists to protect a
	-- struggling device's OUTPUT; it must never hide a bug from the console.
	CONSOLE.capture(msg)
	if not CONFIG.VERBOSE then return end
	local t = os.clock()
	if t - logT0 >= 2 then
		logT0, logN = t, 0
		logMax = (ecoLogTier > 0) and 3 or 8
	end
	-- urgent=true lines (guardian tier flips, PERF, remote heal) BYPASS the
	-- budget — they are exactly the lines a struggling device most needs to show.
	if not urgent then
		if logN >= logMax then
			logMuted = logMuted + 1
			return
		end
		logN = logN + 1
	end
	if logMuted > 0 then
		msg = msg .. "  (+" .. logMuted .. " lines muted by log budget)"
		logMuted = 0
	end
	CONSOLE.raw(msg) -- 🖥️ v2.83: the console already captured it (see capture above)
end

-- 🔌 v2.49 SELF-HEALING DIVE HANDLE — "when a new match happens it just doesn't
-- work anymore", and it was US, not the game: the boot lookup above grabbed the
-- dive RemoteEvent exactly ONCE. Roblox match frameworks destroy and rebuild
-- match-scoped objects between matches; a client firing into the old instance
-- gets an error inside a silent pcall — every gate still decides, every line
-- still logs, the keeper never dives again. (Same class of bug as the game's own
-- once-checked roles, ironically.) The handle is now live: validated at every
-- use, re-found the instant a replacement exists, and it announces itself so
-- the console shows the healing instead of the silence.
local diveBlockedWarned = false
local diveRetryAt = 0
local function ensureDiveRemote()
	if DiveEvent and DiveEvent.Parent then return DiveEvent end
	local now = os.clock()
	local died = false
	if DiveEvent then
		DiveEvent, diveEventPath = nil, nil
		log("[AI-Dive] 🔌 dive remote vanished (match reset?) — re-searching")
		died = true     -- death under our feet is a legit trigger: search NOW,
	end                 -- never make the keeper wait out the poll throttle
	if died or now >= diveRetryAt then
		diveRetryAt = now + 4
		local ev, path = findDiveRemote(true)
		if ev then
			DiveEvent, diveEventPath = ev, path
			diveBlockedWarned = false
			log("[AI-Dive] 🔌 dive remote acquired: " .. tostring(path))
			return ev
		end
	end
	return nil
end

