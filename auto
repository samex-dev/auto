-- ==========================================
-- 🥅 GOAL TRACKER (optional, graceful fallback)
-- Finds the posts (or the goal model), derives the goal mouth geometry:
--   linePos    center of the goal line (post base level)
--   axis       unit vector along the goal mouth (left <-> right)
--   normal     unit vector from the goal OUT to the field (toward the keeper)
--   halfWidth  half the goal mouth width
--   crossbarY  absolute Y of the crossbar
-- ==========================================
local goalInfo     = nil
local lastGoalScan = 0
-- 🧱 v2.44: the goal is found ONCE and then remembered. The old scan walked
-- workspace:GetDescendants() — every instance in the game, tens of thousands on
-- a busy server — once a second, forever, purely to re-discover the same three
-- parts. Now the parts themselves are cached: the geometry is re-measured from
-- them (O(1) property reads), and a full tree walk only runs when a cached part
-- disappears (goal rebuilt / removed) or something is added or removed in
-- workspace. The walk is also capped, so one scan can never stall a frame.
local goalParts = { left = nil, right = nil, bar = nil, model = nil }
local goalDirty = true
local GOAL_MEASURE_EVERY = 2  -- seconds between re-measures from the cached parts

local function goalPartsAlive()
	return (goalParts.left ~= nil and goalParts.left.Parent ~= nil)
		and (goalParts.right ~= nil and goalParts.right.Parent ~= nil)
end

local function goalFindParts()
	local left, right, bar, model
	local visited = 0
	for _, obj in ipairs(workspace:GetDescendants()) do
		visited = visited + 1
		-- class check FIRST: most instances in a live match are decals,
		-- attachments, sounds and folders, and none of them need a name lowered
		if obj:IsA("BasePart") then
			local n = string.lower(obj.Name)
			if GOAL_LEFT_NAMES[n] and not left then
				left = obj
			elseif GOAL_RIGHT_NAMES[n] and not right then
				right = obj
			elseif n == "crossbar" and not bar then
				bar = obj
			end
		elseif obj:IsA("Model") and not model and obj.PrimaryPart then
			if GOAL_MODEL_NAMES[string.lower(obj.Name)] then model = obj end
		end
		if left and right and bar then break end
		if visited >= CONFIG.GOAL_SCAN_CAP then break end
	end
	goalParts.left, goalParts.right, goalParts.bar, goalParts.model = left, right, bar, model
end

local function goalMeasure(keeperPos)
	local left, right, bar, goalModel = goalParts.left, goalParts.right, goalParts.bar, goalParts.model
	local info = nil

	-- Case A: explicit posts (the cheap, exact path)
	if left and right then
		local halfY = left.Size.Y / 2
		local leftTopY  = left.Position.Y + halfY
		local leftBaseY = left.Position.Y - halfY
		local rHalfY    = right.Size.Y / 2
		local rightTopY = right.Position.Y + rHalfY
		local barY = bar and (bar.Position.Y + bar.Size.Y / 2) or math.min(leftTopY, rightTopY)

		local dx = right.Position.X - left.Position.X
		local dy = rightTopY - leftTopY
		local dz = right.Position.Z - left.Position.Z
		local width = sqrt(dx * dx + dy * dy + dz * dz)
		if width > 0 then
			local halfWidth = width / 2
			local linePos = Vector3.new(
				(left.Position.X + right.Position.X) / 2,
				(leftBaseY + (right.Position.Y - rHalfY)) / 2,
				(left.Position.Z + right.Position.Z) / 2)
			local axis = Vector3.new(dx / width, dy / width, dz / width)
			local n1 = axis:Cross(UP)
			-- The goal mouth faces the field = the side the keeper stands on.
			local normal = (keeperPos - linePos):Dot(n1) >= 0 and n1 or -n1
			local barHeight = barY - math.min(leftBaseY, right.Position.Y - rHalfY)

			-- Sanity: reasonable size, keeper actually in front of this goal.
			if halfWidth >= 3 and halfWidth <= 30
				and barHeight >= 3 and barHeight <= 20
				and (keeperPos - linePos).Magnitude < 60
				and (keeperPos - linePos):Dot(normal) > 2 then
				info = { linePos = linePos, axis = axis, normal = normal, halfWidth = halfWidth, crossbarY = barY }
			end
		end
	end

	-- Case B: a goal model (bbox: the mouth is the side facing the keeper)
	if not info and goalModel and goalModel.Parent then
		local minV, maxV = goalModel:GetBoundingBox()
		local size   = maxV - minV
		local center = (minV + maxV) / 2

		local axis, halfWidth, extent
		if size.X >= size.Z then
			axis, halfWidth, extent = Vector3.x, size.X / 2, size.Z
		else
			axis, halfWidth, extent = Vector3.z, size.Z / 2, size.X
		end
		local n1 = axis:Cross(UP)
		local normal = (keeperPos - center):Dot(n1) >= 0 and n1 or -n1
		local linePos = center - (normal * (extent / 2))
		local bar = maxV.Y

		if halfWidth >= 3 and halfWidth <= 30
			and (bar - minV.Y) >= 3 and (bar - minV.Y) <= 20
			and (keeperPos - center).Magnitude < 60
			and (keeperPos - center):Dot(normal) > 2 then
			info = { linePos = linePos, axis = axis, normal = normal, halfWidth = halfWidth, crossbarY = bar }
		end
	end

	if info then
		-- reuse the table the whole script already holds a reference to
		if goalInfo then
			goalInfo.linePos, goalInfo.axis, goalInfo.normal = info.linePos, info.axis, info.normal
			goalInfo.halfWidth, goalInfo.crossbarY = info.halfWidth, info.crossbarY
		else
			goalInfo = info
		end
	else
		goalInfo = nil
	end
	return goalInfo
end

local function scanGoal(keeperPos)
	if not CONFIG.USE_GOAL_DETECTION then
		goalInfo = nil
		return nil
	end
	local now = os.clock()
	local haveParts = goalPartsAlive()
	if goalInfo and haveParts and not goalDirty and (now - lastGoalScan) < GOAL_MEASURE_EVERY then
		return goalInfo
	end
	-- a full tree walk is the expensive part: at most one per second, and only
	-- when the cached parts are gone or the world changed
	if (not haveParts or goalDirty) then
		if (now - lastGoalScan) < 1 and goalInfo then return goalInfo end
		goalDirty = false
		goalFindParts()
	end
	lastGoalScan = now
	return goalMeasure(keeperPos)
end

-- 🧹 If parts vanish (goal rebuilt, map streamed out) the next scan must look
-- again instead of waiting for the refresh interval.
workspace.DescendantRemoving:Connect(function(inst)
	if inst == goalParts.left or inst == goalParts.right or inst == goalParts.bar or inst == goalParts.model then
		goalDirty = true
	end
end)

-- ==========================================
-- SENSORS
-- ==========================================
-- 🗂️ ONE SAMPLE RING, ZERO PER-FRAME ALLOCATION.
-- Four histories (ball positions, keeper positions, striker positions, speeds)
-- used to build a fresh table every frame — ~240 tables/second of garbage, and
-- a Lua 5.1 GC step landing inside a dive window is exactly the frame hiccup the
-- loop then has to guard against. Callers fill a reused slot instead.
local function sampleSlot(list, limit)
	local n = #list + 1
	if n > limit then
		table.remove(list, 1)
		n = #list + 1
	end
	local slot = list[n]
	if not slot then
		slot = {}
		list[n] = slot
	end
	return slot
end
local posHistory = {} -- { {p = Vector3, t = number}, ... } oldest -> newest

local function addHistorySample(pos, t)
	local last = posHistory[#posHistory]
	if last and ((t - last.t) > 0.5 or (pos - last.p).Magnitude > 100) then
		posHistory = {} -- teleport / frozen frame: stale data, reset
	end
	local slot = sampleSlot(posHistory, CONFIG.HISTORY_LENGTH)
	slot.p, slot.t = pos, t
end

-- Two-window estimator with a FAST warmup:
--   n >= 4: velocity from the last ~3 frames  (reaction starts in ~50ms)
--   n >= 7: + curvature from (recent half - older half), deadzoned + capped
-- O(1), no per-frame averaging, immune to single-frame noise.
local function estimateMotion()
	local n = #posHistory
	if n < 4 then return nil, nil end

	local tN, pN = posHistory[n].t, posHistory[n].p
	local tS, pS = posHistory[n - 3].t, posHistory[n - 3].p
	local dtRecent = tN - tS
	if dtRecent < 0.001 then return nil, nil end

	local vRecent = (pN - pS) / dtRecent

	local accel = Vector3.zero
	if n >= 7 then
		local a = n - 4 -- recent window: indices a .. n
		local b = a - 1 -- older window:  indices 1 .. b

		local tA, pA = posHistory[a].t, posHistory[a].p
		local t1, p1 = posHistory[1].t, posHistory[1].p
		local tB, pB = posHistory[b].t, posHistory[b].p

		local dtOlder = tB - t1
		local dtMid   = ((tA + tN) - (t1 + tB)) / 2
		if dtOlder > 0.001 and dtMid > 0.001 then
			local vOlder = (pB - p1) / dtOlder
			accel = (vRecent - vOlder) / dtMid
		end

		-- 🛡️ CURVE DAMPENER: deadzone kills jitter, cap stops over-curving guesses
		if accel.Magnitude < CONFIG.CURVE_DEADZONE then
			accel = Vector3.zero
		elseif accel.Magnitude > CONFIG.CURVE_CAP then
			accel = accel.Unit * CONFIG.CURVE_CAP
		end
	end

	return vRecent, accel
end

local pingCache, pingCacheAt = nil, 0
local function getNetworkPing()
	-- v2.44: cached for 0.5s. The old version built a closure + pcall and walked
	-- Stats.Network on EVERY call — and the loft-catch gate calls it every frame a
	-- lofted ball is in range, the HUD ~10x a second. Ping does not move that fast.
	local t = os.clock()
	if pingCache and (t - pingCacheAt) < 0.5 then return pingCache end
	local ok, ping = pcall(function()
		return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
	end)
	pingCache = (ok and (ping / 1000)) or 0.05
	pingCacheAt = t
	return pingCache
end

-- Cached other-player roots (refreshed at most twice a second).
-- Entries: { player = Player, root = BasePart, vel = Vector3|nil }
local playerRoots     = {}
local lastRootRefresh = 0
-- (playerVelStore is declared earlier — see the PlayerRemoving section)

local function refreshPlayerRoots()
	local now = os.clock()
	if now - lastRootRefresh < 0.5 then return playerRoots end
	lastRootRefresh = now

	local list = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local character = plr.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root then
				local entry = { player = plr, root = root, vel = nil }
				local prev = playerVelStore[plr]
				if prev and (now - prev.t) > 0.05 then
					local dt = now - prev.t
					-- teleport/respawn guard: never average a teleport as speed
					if (root.Position - prev.pos).Magnitude < dt * 80 then
						entry.vel = (root.Position - prev.pos) / dt
					end
				end
				playerVelStore[plr] = { pos = root.Position, t = now }
				list[#list + 1] = entry
			end
		end
	end
	-- drop players who left
	for plr in pairs(playerVelStore) do
		local found = false
		for _, e in ipairs(list) do
			if e.player == plr then found = true break end
		end
		if not found then playerVelStore[plr] = nil end
	end
	playerRoots = list
	return playerRoots
end

-- 🎯 HITBOX-AWARE CATCH: the game decides a save by HITBOX OVERLAP — the
-- ball touching the keeper's parts during the dive (see
-- ReplicatedStorage.Modules.MuchachoHitbox). We mirror that exact check so
-- the save counter matches what the game itself counts.
local hitboxCache = { char = nil, parts = nil, t = 0 }
local function ballOverlapsKeeper(character, ballPos)
	if not character then return false end
	local pad = CONFIG.BALL_RADIUS + CONFIG.HITBOX_EXTRA
	-- v2.44: the PART LIST is cached for 0.5s (a full character:GetDescendants()
	-- walk per frame, for up to 1.5s while a dive is unresolved, was the priciest
	-- thing in the save check). Positions are still read live, so a moving
	-- hitbox is judged exactly as before.
	local t = os.clock()
	local parts = hitboxCache.parts
	if hitboxCache.char ~= character or not parts or (t - hitboxCache.t) >= 0.5 then
		parts = {}
		for _, p in ipairs(character:GetDescendants()) do
			if p:IsA("BasePart") and p.Name ~= "GKHitbox" then parts[#parts + 1] = p end
		end
		hitboxCache.char, hitboxCache.parts, hitboxCache.t = character, parts, t
	end
	for _, p in ipairs(parts) do
		local c, sz = p.Position, p.Size
		if math.abs(ballPos.X - c.X) <= sz.X / 2 + pad
			and math.abs(ballPos.Y - c.Y) <= sz.Y / 2 + pad
			and math.abs(ballPos.Z - c.Z) <= sz.Z / 2 + pad then
			return true
		end
	end
	return false
end

