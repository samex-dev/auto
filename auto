local charByPlayer      = {}   -- Player -> known profile key (or nil)
local styleNameByPlayer = {}   -- Player -> style display name (string or nil)
local lastCharScan      = 0
local abilityAlert      = nil  -- { char, speed, aerial, barrage, move, t, expiresAt }

-- THE GAME STORES EACH PLAYER'S CHOSEN STYLE IN A FOLDER CALLED "VALUES"
-- ON THEIR PLAYER OBJECT (Players.<plr>:FindFirstChild("Values")).
-- Read it FIRST — it's the most reliable source. Checks attributes and
-- ValueInstances (also one level deep).
-- Returns: displayName (string or nil), charKey (known profile key or nil)
local function readPlayerStyle(plr)
	local values = plr:FindFirstChild("Values")
	if not values then return nil, nil end

	local strong, weak = {}, {}
	-- 🎭 v2.47: "Role"/"Position" are read too — the game keeps SIDE/ROLE data in
	-- the same Values folder, and before this it was only harvested incidentally
	-- (a child NAMED Role was visible, an attribute named Role was not). Now the
	-- read is continuous: every scan pass re-reads every field for every player,
	-- so a mid-match role or style swap re-arms the counter on the next scan
	-- instead of trusting whatever was true when the script booted.
	local ATTRS = { "Character", "Style", "CharacterName", "StyleName", "Role", "Position" }

	local function pushStrong(s)
		if type(s) == "string" and s ~= "" then strong[#strong + 1] = s end
	end
	local function pushWeak(s)
		if type(s) == "string" and s ~= "" then weak[#weak + 1] = s end
	end

	for _, an in ipairs(ATTRS) do
		pushStrong(values:GetAttribute(an))
	end
	local function harvest(inst)
		for _, c in ipairs(inst:GetChildren()) do
			if c:IsA("StringValue") then
				pushStrong(c.Value)
			elseif c:IsA("NumberValue") or c:IsA("IntValue") then
				pushStrong(tostring(c.Value))
			end
			pushWeak(c.Name)
			for _, an in ipairs(ATTRS) do
				pushStrong(c:GetAttribute(an))
			end
		end
	end
	harvest(values)
	for _, sub in ipairs(values:GetChildren()) do
		if sub:IsA("Folder") or sub:IsA("Model") then
			harvest(sub)
		end
	end

	-- A known style from any source wins immediately
	for _, list in ipairs({ strong, weak }) do
		for _, s in ipairs(list) do
			local key = matchCharKey(s)
			if key then
				return s, key
			end
		end
	end
	-- Otherwise: first strong source that looks like a real name
	-- (letters, not just numbers) — shows even unknown/new styles.
	for _, s in ipairs(strong) do
		local n = normName(baseName(s))
		if n ~= "" and n:len() >= 3 and n:find("%a") then
			return s, nil
		end
	end
	return nil, nil
end

-- Fallback: scan the character model / player name for a roster name.
local function scanModelForChar(plr)
	local char = plr.Character
	if not char then return nil end
	local candidates = { char.Name, plr.Name }
	for _, d in ipairs(char:GetDescendants()) do
		candidates[#candidates + 1] = d.Name
	end
	for _, c in ipairs(candidates) do
		local key = matchCharKey(c)
		if key then
			return key
		end
	end
	return nil
end

-- 🕵️ v2.48 ROLE FORENSICS: the game checks a player's style/role ONCE (at join or
-- match start) — the user's screenshot showed the fallout: stale red labels
-- ("STAND USER") floating over EMPTY GRASS mid-pitch after another match, names
-- that stopped matching anyone. We cannot rewrite the server's labels, but its
-- EFFECTS cannot lie: an instance named "ShidouBigBangDrive" was cast by a Shidou,
-- right there, right then. Every resolved move credits the nearest opponent to
-- its spawn point; TWO same-style casts that contradict the claimed role OVERRIDE
-- it (tag + handler read follow), until the game itself changes its Values string
-- — then the override stands down and the label is trusted again (self-heal).
local liveRoleEvidence = {} -- [Player] = { char, n, t }
local roleOverride     = {} -- [Player] = the corrected char key
local lastRawStyle     = {} -- [Player] = last raw Values string (self-heal detect)
local ROLE_FORENSIC_RADIUS = 14 -- studs: an effect spawns AT its caster

-- 👑 v2.53 shared finder (role forensics AND the awakening watch): nearest live
-- opponent to a world position within radius studs.
local function nearestOpponentNear(pos, radius)
	local best, bd = nil, radius
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local root = plr.Character:FindFirstChild("HumanoidRootPart")
			if root then
				local d = (root.Position - pos).Magnitude
				if d < bd then bd, best = d, plr end
			end
		end
	end
	return best
end
local function roleForensics(info, inst)
	-- keeper-kit effects get thrown all over the box around OTHER players, and
	-- SHARED-NAME CUTSCENES (The Destroyer is BOTH Rin’s and Shidou’s awakening,
	-- v2.51 wiki) attribute NOBODY — only real field-style casts are evidence.
	local charKey = info and info.char
	if not charKey or charKey == "gagamaru" or info.cutscene then return end
	local ok, pos = pcall(function() return inst.Position end)
	if not (ok and pos) then return end
	local now = os.clock()
	local best = nearestOpponentNear(pos, ROLE_FORENSIC_RADIUS)
	if not best then return end
	local ev = liveRoleEvidence[best]
	if (not ev) or ev.char ~= charKey or (now - ev.t) > 6 then
		liveRoleEvidence[best] = { char = charKey, n = 1, t = now }
		return
	end
	ev.n, ev.t = ev.n + 1, now
	if ev.n >= 2 and charByPlayer[best] ~= charKey then
		roleOverride[best] = charKey
		local lbl = (CHAR_PROFILES[charKey] and CHAR_PROFILES[charKey].label) or charKey
		log(string.format("[AI-Dive] 🕵️ ROLE FORENSICS | %s | game says \"%s\" but cast %s twice — trusting the CASTS",
			best.Name, tostring(styleNameByPlayer[best] or "?"), lbl))
		charByPlayer[best]      = charKey
		styleNameByPlayer[best] = lbl
	end
end

-- 👑 v2.53 AWAKENING WATCH. Every documented G cutscene is a PROMISE, not a
-- shot — fandom pages repeat “Requires the ball” and what follows IS the awakened
-- bomb (Big Bang Drive, Godspeed Kill Shot, Beinchuss, the 5-Stage Volley, King's
-- return...). When a cutscene effect resolves, credit the nearest player to it and
-- force FULL reads against that man for 6.5 s — never quick-open at someone mid-
-- animation. ONE table = ONE mainStep upvalue (the budget is real).
local awakeWatch = { plr = nil, untilT = 0 }
local function awakeningWatch(inst)
	local ok, pos = pcall(function() return inst.Position end)
	if not (ok and pos) then return end
	local plr = nearestOpponentNear(pos, 20)
	if not plr then return end
	awakeWatch.plr, awakeWatch.untilT = plr, os.clock() + 6.5
	log(string.format("[AI-Dive] 👑 AWAKENING | %s | %s — full reads until it resolves", plr.Name, tostring(inst.Name)))
end

local function scanCharacters()
	local now = os.clock()
	if now - lastCharScan < 1 then return end
	lastCharScan = now

	for _, plr in ipairs(Players:GetPlayers()) do
		-- 1) The game's Values folder (authoritative — until forensics proves it stale)
		local name, key = readPlayerStyle(plr)
		if name ~= nil then
			if lastRawStyle[plr] ~= name and roleOverride[plr] then
				roleOverride[plr] = nil            -- the game updated its own mind: stand down
				liveRoleEvidence[plr] = nil
				log("[AI-Dive] 🕵️ ROLE FORENSICS | " .. plr.Name .. " | Values changed — trusting the game again")
			end
			lastRawStyle[plr] = name
		end
		if key then
			if roleOverride[plr] then
				key = roleOverride[plr]
				charByPlayer[plr] = key
				styleNameByPlayer[plr] = (CHAR_PROFILES[key] and CHAR_PROFILES[key].label) or name
			else
				charByPlayer[plr] = key
				styleNameByPlayer[plr] = name or CHAR_PROFILES[key].label
			end
		elseif name then
			charByPlayer[plr] = nil
			styleNameByPlayer[plr] = name -- unknown style: still show it
		else
			-- 2) Character model name scan
			local modelKey = scanModelForChar(plr)
			charByPlayer[plr] = modelKey
			styleNameByPlayer[plr] = modelKey and CHAR_PROFILES[modelKey].label or nil
		end
	end
end

-- The game names move effects "<Character><MoveName>" (e.g. "ShidouDoubleJumpShot"),
-- so match the full normalized name first, then retry with each known character
-- prefix stripped.
local MOVE_PREFIXES = {
	"nelshidou", "demonsidou", "shidou",
	"nelisagi", "isagi", "nelnagi", "nagi", "nelkaiser", "kaiser", "nelrin", "rin",
	"nelbachira", "bachira", "barou", "chigiri", "gagamaru", "sae", "reo",
	"ichigo", "ronaldo", "donlorenzo", "aiku", "otoya", "yukimiya", "kunigami",
	"kurona", "hiori", "igaguri", "devilfruit", "dio", "luffy", "naoya",
}

-- ⚡ v2.44: the in-game effect names are "<Character><Move>" (ShidouDoubleJumpShot),
-- so the whole cross product of prefix x move can be precomputed ONCE at load.
-- DescendantAdded then costs a single hash lookup for the 99.99% of instances
-- that are particles and attachments — the old handler lower+gsub-normalised
-- EVERY name and then tried 33 prefix strips against ~150 moves.
local MOVE_EXACT_INFO, MOVE_EXACT_KEY = {}, {}
for key, info in pairs(MOVE_INFO) do
	MOVE_EXACT_INFO[key] = info
	MOVE_EXACT_KEY[key]  = key
end
for _, prefix in ipairs(MOVE_PREFIXES) do
	for key, info in pairs(MOVE_INFO) do
		local full = prefix .. key
		MOVE_EXACT_INFO[full] = info
		MOVE_EXACT_KEY[full]  = key
	end
end

local function lookupMove(key)
	if MOVE_INFO[key] then
		return MOVE_INFO[key], key
	end
	for _, prefix in ipairs(MOVE_PREFIXES) do
		local rest = key:sub(#prefix + 1)
		if rest and MOVE_INFO[rest] then
			return MOVE_INFO[rest], rest
		end
	end
	return nil, nil
end

-- 🎯 ONE workspace watcher (v2.44). The ball tracker and the move-effect
-- detector used to be two separate DescendantAdded connections, each doing
-- string work on every instance the game ever spawns. They are one dispatch now,
-- with cheap rejects first: length, then the exact-name hash, and only then the
-- normalise-and-strip path for odd spellings.
local function armAbility(info, moveKey, rawName, counterKey)
	-- Alias keys (e.g. "phantomsnipe") point at their primary counter via
	-- counterKey, so one counter serves every name spelling.
	local cm = COUNTER_MODES[counterKey or (info and info.counterKey) or moveKey]
	-- Timestop moves arm longer: the 3s stop ends, THEN the shot comes.
	local armed = (cm and cm.armed) or 4
	local t = os.clock()
	abilityAlert = {
		char = info and info.char,
		speed = info and info.speed,
		aerial = info and info.aerial,
		barrage = info and info.barrage,
		move = rawName,
		moveKey = moveKey,
		counterKey = info and info.counterKey,
		t = t,
		expiresAt = t + armed,
	}
	log(string.format("[AI-Dive] 🎯 %s detected — counter: %s", rawName, cm and cm.name or "standard"))
end

workspace.DescendantAdded:Connect(function(inst)
	-- 🔌 v2.49: when the game RE-CREATES the dive remote (new match), grab it the
	-- instant it appears — zero polling, zero missed dives in between.
	if not DiveEvent and inst:IsA("RemoteEvent") then
		local dname = string.lower(inst.Name or "")
		if dname == "gkdive" or dname:find("dive", 1, true) then
			DiveEvent = inst
			diveEventPath = (inst.Parent and inst.Parent.Name or "?") .. "." .. inst.Name
			diveBlockedWarned = false
			log("[AI-Dive] 🔌 dive remote acquired: " .. tostring(diveEventPath))
		end
	end

	local name = inst.Name
	if not name or #name < 4 then return end

	-- 1) the ball (only while we do not have one — the common case costs nothing)
	if (not cachedBall or not cachedBall.Parent) and ballNameMatch(name) then
		local part = resolveBallPart(inst)
		if part then
			cachedBall = part
			lastBallScan = os.clock()
		end
	end

	-- 2) move effects: exact hit first (the shape the game actually uses)
	local lower = string.lower(name)
	local info = MOVE_EXACT_INFO[lower]
	if info then
		armAbility(info, MOVE_EXACT_KEY[lower], name)
		roleForensics(info, inst)
		if info.cutscene then awakeningWatch(inst) end
		return
	end
	if not lower:find("[^%a%d]") and lower:sub(1, 6) ~= "ichigo" then
		return -- plain alphanumeric name that is not a known effect: nothing to do
	end

	local key = normName(name)
	local moveKey
	info, moveKey = lookupMove(key)
	if info and moveKey then
		armAbility(info, moveKey, name)
		roleForensics(info, inst)
		if info.cutscene then awakeningWatch(inst) end
	else
		-- 🥅 ICHIGO GENERIC CATCH-ALL (v2.40): his in-game move names are
		-- unpublished, so ANY effect named "Ichigo<Move>" arms the ICHIGO
		-- WALL. A plain character model named "Ichigo" (no move part) is
		-- ignored — there must be a real move suffix after the prefix.
		local rest = (key:sub(1, 6) == "ichigo") and key:sub(7) or nil
		if rest and #rest >= 4 then
			armAbility({ char = "ichigo", speed = "fast", aerial = false, barrage = false },
				nil, name, "ichigomove")
			log("[AI-Dive] 🎯 " .. name .. " — send me the exact console name for a dedicated Ichigo counter")
		end
	end
end)

-- ==========================================
-- 🏷️ STYLE NAME TAGS (billboard above every player's head)
-- You = blue, teammate = green, opponent = red, unknown side = gray.
-- ==========================================
local styleTags   = {}   -- [Player] = { anchor, label }
local tagAnchors  = {}   -- array of { player, anchor, bb } for per-frame following
-- 📱 v2.55: the current UI scale, owned by fitUi (defined below) but READ
-- at this height so freshly created style tags are born at the right size.
local uiScaleCur, uiFitW = 1, -1
local lastTagScan = 0
local tagsFolder  = nil

local function tagColorFor(plr)
	if plr == LocalPlayer then
		return Color3.fromRGB(90, 170, 255) -- you: blue
	end
	local myKey = teamKeyOf(LocalPlayer)
	local k = teamKeyOf(plr)
	if myKey and k and k == myKey then
		return Color3.fromRGB(90, 240, 130) -- teammate: green
	elseif myKey and k then
		return Color3.fromRGB(255, 95, 95)  -- opponent: red
	end
	return Color3.fromRGB(205, 205, 215)   -- unknown side: gray
end

local function updateStyleTags()
	if not CONFIG.SHOW_STYLE_TAGS or not aiEnabled then return end
	local now = os.clock()
	if now - lastTagScan < 0.5 then return end
	lastTagScan = now

	if not tagsFolder then
		local old = workspace:FindFirstChild("AutoDiveStyleTags")
		if old then old:Destroy() end
		tagsFolder = Instance.new("Folder")
		tagsFolder.Name = "AutoDiveStyleTags"
		tagsFolder.Parent = workspace
	end

	local alive = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		-- v2.48: a tag needs a LIVING character with a root to sit on. Players in
		-- intermission/respawn get none, and last match's tag is torn down instead
		-- of ghosting over empty grass — the exact failure the game's own role
		-- labels show mid-pitch after "another match happens".
		local char = plr.Character
		local rootForTag = char and char:FindFirstChild("HumanoidRootPart")
		if rootForTag then
		alive[plr] = true
		local tag = styleTags[plr]
		if not tag then
			local anchor = Instance.new("Part")
			anchor.Name = "TagAnchor"
			anchor.Size = Vector3.new(0.01, 0.01, 0.01)
			anchor.Anchored = true
			anchor.CanCollide = false
			anchor.CanQuery = false
			anchor.CanTouch = false
			anchor.Transparency = 1
			anchor.Parent = tagsFolder

			local bb = Instance.new("BillboardGui")
			bb.Name = "StyleTag"
			bb.Adornee = anchor
			bb.Size = UDim2.fromOffset(14, 4)
			bb.AlwaysOnTop = true
			bb.MaxDistance = 220
			bb.Parent = anchor

			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.GothamBold
			label.TextSize = math.floor(22 * uiScaleCur + 0.5) -- 📱 born at the fitted size
			label.Text = "..."
			label.Parent = bb

			tag = { anchor = anchor, label = label, bb = bb, root = rootForTag }
			styleTags[plr] = tag
			tagAnchors[#tagAnchors + 1] = {
				player = plr, anchor = anchor, bb = bb,
				root = rootForTag, char = char,
			}
		end

		local name = styleNameByPlayer[plr] or plr.Name
		local text = string.upper(name)
		if plr == LocalPlayer then
			text = "★ " .. text
		end
		if tag.label.Text ~= text then
			tag.label.Text = text
		end
		local c = tagColorFor(plr)
		if tag.label.TextColor3 ~= c then
			tag.label.TextColor3 = c
		end
		end
	end

	for plr, tag in pairs(styleTags) do
		if not alive[plr] then
			tag.anchor:Destroy()
			styleTags[plr] = nil
		end
	end
	local i = 1
	while i <= #tagAnchors do
		if not styleTags[tagAnchors[i].player] then
			table.remove(tagAnchors, i)
		else
			i = i + 1
		end
	end
end

