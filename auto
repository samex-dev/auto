	history = {},   -- { pos, t } the keeper's recent positions
}

-- Pre-allocated prediction path (avoids per-frame table allocation)
local MAX_STEPS = math.ceil(CONFIG.SIM_HORIZON / CONFIG.SIM_STEP_MIN) + 2
local pathPos   = table.create(MAX_STEPS)
local pathCount = 0

local function mainStep(deltaTime)
	-- 0) LIVENESS GATES
	Camera = workspace.CurrentCamera or Camera -- the game can recreate it mid-match
	local character = LocalPlayer.Character
	local rootPart  = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid  = character and character:FindFirstChildOfClass("Humanoid")

	if not rootPart or not humanoid or humanoid.Health <= 0 then
		posHistory = {}
		GK.history = {}
		ST.commitDir, ST.commitFrames = nil, 0
		prevRealDepth = nil
		hideVisuals()
		markIdle()
		return
	end

	local ballPart = refreshBall()
	if not ballPart then
		hideVisuals()
		markIdle()
		return
	end

	local ballPos = ballPart.Position
	local now     = tick()

	-- 1) SENSOR MEMORY (noise filtering + hiccup/teleport guards)
	if deltaTime > 0.35 then
		return -- frame hiccup: skip so we don't poison the history
	end
	addHistorySample(ballPos, now)
	yHistory[#yHistory + 1] = ballPos.Y
	if #yHistory > 300 then table.remove(yHistory, 1) end

	local velocity, accel
	if CONFIG.USE_ASSEMBLY_VELOCITY then
		velocity = ballPart.AssemblyLinearVelocity
		accel    = Vector3.zero -- no curve estimate when using the direct sensor
	else
		velocity, accel = estimateMotion() -- nil until fresh samples exist
	end

	if not velocity then
		hideVisuals()
		markIdle()
		return
	end

	local speed = velocity.Magnitude
	ST.smoothedSpeed = ST.smoothedSpeed + (speed - ST.smoothedSpeed) * 0.6

	-- 🎯 STRIKE RESET: charged shots start from a still ball.
	-- When a still spell just ended, discard the mixed still/moving samples so
	-- the sensor re-locks on the fresh shot from the very first frame.
	if speed < 5 then
		ST.stillFrames = ST.stillFrames + 1
	elseif ST.stillFrames > 6 then
		posHistory   = {}
		ST.stillFrames  = 0
		ST.commitDir    = nil -- fresh ball: read it fresh
		ST.commitFrames = 0
		-- 🎯 WHO JUST KICKED IT? The nearest other player at the ball is the
		-- shooter — remember their team for the whole flight (own shot = no saves)
		-- and start sampling this shot's power to learn their style.
		local shooterPlayer, shooterKey, sd = nil, nil, math.huge
		for _, e in ipairs(refreshPlayerRoots()) do
			local d = (ballPos - e.root.Position).Magnitude
			if d < sd then
				sd, shooterPlayer, shooterKey = d, e.player, teamKeyOf(e.player)
			end
		end
		-- v2.34: if the server says who controlled the ball (NetworkOwner),
		-- that is the shooter — more reliable than "nearest player".
		local netShooter = networkOwnerPlayer(ballPart)
		if sd <= CONFIG.SHOOTER_TOUCH_RADIUS then
			local who = netShooter or shooterPlayer
			lastShooterKey    = who and teamKeyOf(who) or nil
			lastShooterPlayer = who or shooterPlayer
			lastShooterTime   = os.clock()
			ST.lastShotReset     = os.clock()
			ST.peakSinceShot     = 0 -- fresh credit: the fake test starts clean
			pendingShotRecord = { player = lastShooterPlayer, t = os.clock(), maxSpeed = 0 }
		else
			lastShooterKey, lastShooterPlayer = nil, nil -- nobody at the ball: clear
		end
	end

	if speed < CONFIG.MIN_INTEREST_SPEED then
		hideVisuals()
		markIdle()
		return
	end

	local rootPos      = rootPart.Position
	local distToGoalie = (ballPos - rootPos).Magnitude
	if distToGoalie > CONFIG.MAX_INTEREST_DISTANCE then
		hideVisuals()
		markIdle()
		return
	end

	-- ⏱ tNow/myKey are declared HERE (before the GK prediction block) —
	-- everything below the ball-distance gate depends on them.
	local tNow  = os.clock()
	local myKey = teamKeyOf(LocalPlayer)

	-- 🧤 GK MOVE PREDICTION: the keeper is usually MOVING (recovering after
	-- a dive, sweeping off the line). The save check happens where the
	-- keeper WILL be, so aim the whole ball prediction at the keeper's
	-- future position — extrapolated toward the ball's ETA (teleport-guarded).
	local aimPos = rootPos
	GK.history[#GK.history + 1] = { pos = rootPos, t = tNow }
	if #GK.history > 24 then table.remove(GK.history, 1) end
	do
		local n = #GK.history
		local j = 1
		while j < n and (GK.history[n].t - GK.history[j].t) < 0.4 do
			j = j + 1
		end
		local dt = GK.history[n].t - GK.history[j].t
		local span = (GK.history[n].pos - GK.history[j].pos).Magnitude
		-- span < dt*80 = normal movement (a respawn teleport is ignored)
		if dt > 0.08 and span < dt * 80 then
			local gVel = (GK.history[n].pos - GK.history[j].pos) / dt
			local estTTI = math.max(0, (distToGoalie - 3) / math.max(speed, 1))
			local lead = math.min(estTTI, CONFIG.GK_PREDICT_MAX)
			if lead > 0.05 then
				aimPos = rootPos + gVel * lead
			end
		end
	end

	local goal  = scanGoal(rootPos)
	refreshTeams()

	-- 🥅 REAL-TIME CONCEDE: a goal is counted only when the ACTUAL ball
	-- crosses the line through the mouth (never the prediction, and a recent
	-- save can't double-count as a goal). If WE last shot it, it's OUR GOAL.
	if goal then
		local realDepth = (ballPos - goal.linePos):Dot(goal.normal)
		if realDepth > 2 then
			ST.lastInFront = tNow
		end
		if prevRealDepth and prevRealDepth > 0 and realDepth <= 0 then
			local lateralNow = (ballPos - goal.linePos):Dot(goal.axis)
			local inMouth = (math.abs(lateralNow) <= goal.halfWidth + CONFIG.BALL_RADIUS)
				and (ballPos.Y <= goal.crossbarY + CONFIG.BALL_RADIUS)
			-- 🐛 FAKE-GOAL FIX: a goal is the RESULT of a shot — it must
			-- happen shortly after a credited kick, at shot speed. A carried
			-- ball walked behind you or a wide crossing is not a goal.
			local fromShot = (tNow - ST.lastShotReset) < CONFIG.CONCEDE_SHOT_WINDOW
			if inMouth and fromShot and speed > CONFIG.CONCEDE_MIN_SPEED
				and (tNow - ST.lastConcede) > 3 and (tNow - ST.lastSaveTime) > 3 then
				ST.lastConcede = tNow
				local ownGoal = (myKey and lastShooterKey == myKey)
					and (tNow - lastShooterTime) < CONFIG.SHOT_OWNER_MEMORY
				if ownGoal then
					ST.pendingFlash = { text = "OUR GOAL!!", color = Color3.fromRGB(80, 255, 120), t = tNow }
					print("[AI-Dive] ⚽ OUR GOAL!")
				else
					matchStats.conceded = matchStats.conceded + 1
					diveWatch.resolved = true
					ST.pendingFlash = { text = "GOAL...", color = Color3.fromRGB(255, 60, 60), t = tNow }
					print("[AI-Dive] 🥅 CONCEDED")
				end
			end
		end
		prevRealDepth = realDepth
	else
		prevRealDepth = nil
	end

	-- 📈 SAMPLE SHOT POWER: ~0.25s after a kick, record the shot's peak speed
	-- for that player. This is how the AI learns a Big Bang Drive sniper from
	-- a weak long shot.
	if pendingShotRecord then
		local age = tNow - pendingShotRecord.t
		if age >= 0.25 then
			local rec, pendingShotRecord = pendingShotRecord, nil
			if rec.maxSpeed >= 40 and rec.player then
				local st = playerShotStats[rec.player] or { sum = 0, n = 0 }
				st.sum, st.n = st.sum + rec.maxSpeed, st.n + 1
				playerShotStats[rec.player] = st
			end
		else
			pendingShotRecord.maxSpeed = math.max(pendingShotRecord.maxSpeed, speed)
		end
	end

	-- 2) DYNAMIC THREAT DETECTION + 🎯 POSSESSION
	local oppRoots      = {}
	local carrierKey    = nil
	local carrierPlayer = nil
	local carrierPos    = nil
	local carrierDist   = math.huge
	local nearDist      = math.huge
	local nearPlayer    = nil
	for _, e in ipairs(refreshPlayerRoots()) do
		local k = teamKeyOf(e.player)
		if not (myKey and k == myKey) then
			oppRoots[#oppRoots + 1] = e.root
		end
		local d = (ballPos - e.root.Position).Magnitude
		if d < nearDist then
			nearDist, nearPlayer = d, e.player
		end
		-- Carrier = the closest player at a (slow) ball
		if speed < CONFIG.DRIBBLE_MAX_SPEED and d < carrierDist
			and d <= CONFIG.BALL_CARRIER_RADIUS then
			carrierDist, carrierKey, carrierPlayer, carrierPos = d, k, e.player, e.root.Position
		end
	end

	-- 🤲 CARRY CORRELATION: the ball is CARRIED (hand-carry or feet-dribble,
	-- ANY speed) when it's close to a player AND moving WITH them. A carried
	-- ball is not a shot — no dive. This also kills shot FEINTS: the attacker
	-- plays the shot animation without releasing, and the ball stays glued to
	-- their feet.
	local isCarried   = false
	local carryPlayer = nil
	for _, e in ipairs(refreshPlayerRoots()) do
		if not (myKey and teamKeyOf(e.player) == myKey) then
			local d = (ballPos - e.root.Position).Magnitude
			if d <= CONFIG.CARRY_RADIUS and e.vel then
				local rel = velocity - e.vel
				if rel.Magnitude < CONFIG.CARRY_REL_SPEED then
					isCarried = true
					carryPlayer = e.player
					break
				end
			end
		end
	end

	-- 🎯 Who owns the ball right now?
	--   1) NETWORK OWNERSHIP (v2.34, authoritative): the server sets the
	--      ball's NetworkOwner to the controlling player's root. Teammate
	--      owns it => NEVER dive. Opponent owns it => full threat, even
	--      if a teammate is standing right next to the ball (the old
	--      nearest-player heuristic used to flip on that and we'd either
	--      dive on our own ball or freeze on theirs).
	--   2) Heuristic fallback (NetworkOwner nil): a carrier (player at a
	--      slow ball) or a carry (any speed) wins; otherwise the last
	--      shooter keeps "owning" the flight for SHOT_OWNER_MEMORY.
	local netOwner = networkOwnerPlayer(ballPart)
	local poss
	if netOwner then
		local own = (netOwner == LocalPlayer)
			or (myKey ~= nil and teamKeyOf(netOwner) == myKey)
		poss = own and "own" or "opp"
	elseif carrierKey or carryPlayer then
		local cKey = carrierKey or teamKeyOf(carryPlayer)
		poss = (myKey and cKey == myKey) and "own" or "opp"
	elseif lastShooterKey and (tNow - lastShooterTime) < CONFIG.SHOT_OWNER_MEMORY then
		poss = (myKey and lastShooterKey == myKey) and "own" or "opp"
	end

	-- 🎯 CONTROLLED-BALL GATE (v2.40 — the "dives when they don't shoot" fix):
	-- a RELEASED shot moves AWAY from its shooter — the ball-to-nearest-
	-- opponent gap GROWS at shot speed. A CARRIED ball (hand-carry,
	-- dribble-in, walk-in) keeps a roughly CONSTANT gap. We track that gap
	-- across frames: growing > CONTROLLED_SEP_RATE (20 studs/s) = a real
	-- release (no block); flat/closing = CONTROLLED (never dive — the GK
	-- TACKLE path handles it). No opponent velocity needed, so it's immune
	-- to the 0.5s root-refresh staleness. The first frame next to an
	-- opponent is conservatively "controlled" — a real slow shot proves its
	-- separation within ~3 frames (~50ms), which costs nothing because a
	-- slow shot is exactly the ball that gives time.
	local ballControlled = false
	local bestD = nil
	for _, e in ipairs(refreshPlayerRoots()) do
		if not (myKey and teamKeyOf(e.player) == myKey) then
			local d = (ballPos - e.root.Position).Magnitude
			if d <= CONFIG.CONTROLLED_RADIUS and (not bestD or d < bestD) then
				bestD = d
			end
		end
	end
	if bestD and speed <= CONFIG.DRIBBLE_MAX_SPEED then
		local dtC = ST.ctrlT and (now - ST.ctrlT) or 0
		local sep = 0
		if ST.ctrlD and dtC > 0.05 then
			if math.abs(bestD - ST.ctrlD) > dtC * 80 then
				-- 🛡️ teleport / new-possession guard: a gap jump no one
				-- could walk (ball saved, re-carried, respawn) — restart
				-- the baseline and assume controlled this frame.
				sep = 0
			else
				sep = (bestD - ST.ctrlD) / dtC
			end
		end
		ballControlled = (not ST.ctrlD) or (sep <= CONFIG.CONTROLLED_SEP_RATE)
		ST.ctrlD, ST.ctrlT = bestD, now
	else
		ST.ctrlD, ST.ctrlT = nil, nil
	end

	-- 🎪 CHARGE READ (the juggle tell): research shows Shidou's Big Bang
	-- Drive, Dragon Drive AND Bicycle Kick all need the ball IN THE AIR —
	-- the shooter juggles it up first, then fires. 2 juggle cycles from an
	-- opponent in front of goal = an explosive aerial shot is being set up.
	local vySign = velocity.Y > 5 and 1 or (velocity.Y < -5 and -1 or 0)
	if vySign == 1 and CHARGE.lastVySign == -1 then
		-- the ball just rose off a player's feet (a juggle touch)
		if nearPlayer and nearDist <= CONFIG.CHARGE_JUGGLE_RADIUS
			and (tNow - CHARGE.windowStart) <= 3 then
			if CHARGE.cycles == 0 then CHARGE.windowStart = tNow end
			CHARGE.cycles = CHARGE.cycles + 1
			local isEnemyCarrier = not (myKey and teamKeyOf(nearPlayer) == myKey)
			if CHARGE.cycles >= 2 and isEnemyCarrier and distToGoalie < CONFIG.CHARGE_RANGE then
				CHARGE.armedUntil = tNow + CONFIG.CHARGE_ALERT_TIME
				CHARGE.style = styleNameByPlayer[nearPlayer] or nearPlayer.Name
				CHARGE.cycles = 0
				print("[AI-Dive] 🎪 CHARGED SHOT — " .. CHARGE.style
					.. " is juggling in front of the goal! Staying armed.")
			end
		end
	end
	CHARGE.lastVySign = vySign
	if (tNow - CHARGE.windowStart) > 3 then
		CHARGE.cycles = 0
	end

	-- 🧭 STRIKER MOVE PREDICTION: track the threat player, project them into
	-- the future, and read which side they're DRIVING toward — so the keeper
	-- knows where the shot will come from BEFORE it's struck.
	local striker = nil
	if poss == "opp" then
		striker = (speed < CONFIG.DRIBBLE_MAX_SPEED and carrierPlayer) or lastShooterPlayer
	end
	MOVE.pos = nil
	MOVE.side = nil
	if striker then
		if MOVE.player ~= striker then
			MOVE.player = striker
			MOVE.history = {}
		end
		local sPos = nil
		for _, e in ipairs(refreshPlayerRoots()) do
			if e.player == striker then
				sPos = e.root.Position
				break
			end
		end
		if sPos then
			MOVE.history[#MOVE.history + 1] = { pos = sPos, t = tNow }
			if #MOVE.history > 20 then table.remove(MOVE.history, 1) end
			-- velocity over the last ~PREDICT_TIME of movement
			local n = #MOVE.history
			local j = 1
			while j < n and (MOVE.history[n].t - MOVE.history[j].t) < CONFIG.PREDICT_TIME do
				j = j + 1
			end
			local dt = MOVE.history[n].t - MOVE.history[j].t
			if dt > 0.08 then
				local sVel = (MOVE.history[n].pos - MOVE.history[j].pos) / dt
				if sVel.Magnitude > CONFIG.PREDICT_MIN_SPEED then
					MOVE.pos = MOVE.history[n].pos + sVel * CONFIG.PREDICT_TIME
					local sLat = (MOVE.pos - rootPos):Dot(Camera.CFrame.RightVector)
					if sLat > 3 then
						MOVE.side = "Right"
					elseif sLat < -3 then
						MOVE.side = "Left"
					end
				end
			end
		end
		-- 🎯 PRIME the direction read toward the drive side: a shot that
		-- matches the drive confirms one frame faster than a cold read.
		if MOVE.side and speed < CONFIG.DRIBBLE_MAX_SPEED then
			ST.commitDir = MOVE.side
			ST.commitFrames = 1
		end
	else
		MOVE.player = nil
		MOVE.history = {}
	end

	-- ⚔️ STYLE AWARENESS: who is attacking? Adapt the keeper's thresholds.
	-- A fresh move-effect alert (last ~2.5s) overrides the character guess.
	scanCharacters()
	local attackerPlayer = (poss == "opp") and (carrierPlayer or lastShooterPlayer) or nil
	local attackerChar, profile
	if abilityAlert and (tNow - abilityAlert.t) < 2.5 then
		attackerChar = abilityAlert.char
		profile = CHAR_PROFILES[attackerChar]
	elseif attackerPlayer then
		attackerChar = charByPlayer[attackerPlayer]
		profile = CHAR_PROFILES[attackerChar]
	end

	local effBombSpeed = CONFIG.BOMB_SPEED
	local effHeightMax = CONFIG.REACH_HEIGHT_MAX
	local effCooldown  = CONFIG.COOLDOWN_TIME
	if profile then
		effBombSpeed = math.min(effBombSpeed, profile.bombThreshold or 999)
		effHeightMax = CONFIG.REACH_HEIGHT_MAX + (profile.heightBonus or 0)
		if profile.barrage then
			effCooldown = math.min(effCooldown, 0.5)
		end
	end
	-- Ability alert (move just fired): even more aggressive for 4 seconds.
	if abilityAlert and abilityAlert.expiresAt > tNow then
		if abilityAlert.aerial then
			effHeightMax = math.max(effHeightMax, CONFIG.REACH_HEIGHT_MAX + 10)
		end
		if abilityAlert.speed == "extreme" then
			effBombSpeed = math.min(effBombSpeed, 120)
		end
		if abilityAlert.barrage then
			effCooldown = math.min(effCooldown, 0.5)
		end
	end

	-- 🎮 COUNTER MODE: a specific move just fired -> switch to that move's
	-- DEDICATED counter (every ability has its own response, see COUNTER_MODES).
	local activeMode = nil
	if abilityAlert and abilityAlert.expiresAt > tNow then
		local cm = COUNTER_MODES[abilityAlert.counterKey or abilityAlert.moveKey]
		if cm then
			activeMode = cm
			effBombSpeed = math.min(effBombSpeed, cm.bombThreshold or 999)
			effHeightMax = math.max(effHeightMax, CONFIG.REACH_HEIGHT_MAX + (cm.heightBonus or 0))
			if cm.cooldownScale then
				effCooldown = math.min(effCooldown, CONFIG.COOLDOWN_TIME * cm.cooldownScale)
			end
		end
	end

	-- 🎯 PRIME SIDE: some researched counters know which side a move favors
	-- (Sae's Curve Shot "always goes left") — prime the read before release.
	-- (v2.34: the prime now lasts the WHOLE move alert, not just 2.5s — a
	-- curve shot released late in the wind-up still curves — and it is only
	-- dropped once the ball persistently proves itself a straight shot.)
	if activeMode and activeMode.primeSide
		and abilityAlert
		and ST.curveOtherFrames < 20 then
		ST.commitDir = activeMode.primeSide
		ST.commitFrames = 1
	end

	-- 🦸 STAND USER OP MODE: the attacker is a Stand user (Dio & Co.) ->
	-- the keeper goes FULL OP: 150-stud reach, bomb threshold 110, re-arm in
	-- 0.35s, and anything moving is met at full speed.
	local standOp = false
	if abilityAlert and abilityAlert.expiresAt > tNow then
		local ap = CHAR_PROFILES[abilityAlert.char]
		if ap and ap.stand then standOp = true end
	end
	if not standOp and profile and profile.stand then
		standOp = true
	end
	if standOp then
		effBombSpeed = math.min(effBombSpeed, 110)
		effHeightMax = math.max(effHeightMax, CONFIG.REACH_HEIGHT_MAX + 15)
		effCooldown  = math.min(effCooldown, 0.35)
	end

	-- 🎪 CHARGED SHOT (juggle tell still live): the next shot is an explosive
	-- aerial — meet it like a bomb, from higher up.
	local charged = (tNow < CHARGE.armedUntil)
	if charged then
		effBombSpeed = math.min(effBombSpeed, 120)
		effHeightMax = math.max(effHeightMax, CONFIG.REACH_HEIGHT_MAX + 8)
	end

	-- 🚀 LATE-SPIKE DETECTOR (Perfect Impact & friends): a shot that suddenly
	-- explodes in speed mid-flight is met instantly, whatever else it is.
	local speedSpike = false
	speedHistory[#speedHistory + 1] = { t = tNow, s = speed }
	while #speedHistory > 0 and (tNow - speedHistory[1].t) > 0.4 do
		table.remove(speedHistory, 1)
	end
	do
		-- Ignore the strike's own launch (first 0.12s after a reset)
		local windowStart = ST.lastShotReset + 0.12
		local minS, count = math.huge, 0
		for _, h in ipairs(speedHistory) do
			if h.t > windowStart then
				count = count + 1
				if h.s < minS then minS = h.s end
			end
		end
		if count >= 3 and speed > minS + CONFIG.SPEED_SPIKE_DELTA then
			speedSpike = true
		end
	end

	-- 🎭 FAKE SHOT DETECTOR (v2.43 — the Barou fake, widened to FAST fakes):
	-- the v2.32 hold only covered pops peaking 40-69 — an in-game chop that
	-- pops at 75-95 sailed past the window and got a frame-zero dive. Now
	-- two layers cover the WHOLE pop range:
	--  (1) FRESH-POP CONFIRM: the first 0.10s of a sub-110 pop is unproven —
	--      a real strike sustains, a fake dies. No full dive in that window
	--      (the release gate already holds sub-75 pops at the feet, so the
	--      confirm mainly covers the 75-109 band where a fast fake lives).
	--      A 110+ pop is real shot speed — it dives on frame one.
	--  (2) BLEED HOLD: the pop dropped 12+ off its peak, is now under 70,
	--      AND the ball is still within 14 studs of where it was kicked —
	--      a fake DIED at the feet. A real shot (even one that bounces and
	--      bleeds) is already 14+ studs out by the time it drops that much,
	--      so it escapes the hold and still gets dived. Self-releasing: the
	--      moment the ball has traveled 14 studs the hold lifts.
	local fakeHold = false
	local freshPopConfirm = false
	do
		local sinceShot = tNow - ST.lastShotReset
		if speed > 5 then
			if sinceShot < 1.5 and speed > ST.peakSinceShot then
				ST.peakSinceShot = speed
			elseif sinceShot >= 1.5 then
				ST.peakSinceShot = 0 -- stale credit: the test starts clean
			end
			-- (1) FRESH-POP CONFIRM — but NEVER on a known curve move (Rin /
			-- Sae): those are researched REAL shots that must commit early,
			-- not fakes. A fake is a generic chop with no curve prime. The
			-- confirm ends early the moment the pop PROVES itself a real
			-- shot (already 12+ studs out AND still 75+ speed) — so a real
			-- strike loses only ~0.11s, while a bleeding fake (which drops
			-- below 75 before it travels 12 studs) is held the whole window.
			local cChar = lastShooterPlayer and lastShooterPlayer.Character
			local cRoot = cChar and cChar:FindFirstChild("HumanoidRootPart")
			local cTravel = cRoot and (ballPos - cRoot.Position).Magnitude or 999
			local provenShot = (cTravel >= 12) and (speed >= 75)
			freshPopConfirm = sinceShot > 0.01
				and sinceShot < CONFIG.FAKE_CONFIRM_TIME
				and ST.peakSinceShot > 20
				and ST.peakSinceShot < CONFIG.FAKE_CONFIRM_PEAK
				and (activeMode and activeMode.primeSide) == nil
				and (not provenShot)
			-- (2) BLEED HOLD
			if sinceShot > 0.04
				and sinceShot < CONFIG.FAKE_WINDOW
				and ST.peakSinceShot >= CONFIG.FAKE_PEAK_MIN
				and ST.peakSinceShot <= CONFIG.FAKE_PEAK_MAX
				and speed < CONFIG.FAKE_SPEED_MAX
				and (ST.peakSinceShot - speed) > CONFIG.FAKE_DROP_ABS then
				local sChar = lastShooterPlayer and lastShooterPlayer.Character
				local sRoot = sChar and sChar:FindFirstChild("HumanoidRootPart")
				local travel = sRoot and (ballPos - sRoot.Position).Magnitude or 0
				fakeHold = (not sRoot) or (travel <= CONFIG.FAKE_TRAVEL)
			end
		end
	end

	-- 📈 SHOOT FORECAST: while the ENEMY has the ball, how likely is the shot,
	-- and which side will it come in on? Chance climbs as they close in.
	-- Rush-style counters (Demon Rush, Lightning Dribble) widen the range.
	local shootRange = CONFIG.SHOOT_RANGE + (activeMode and (activeMode.rangeBoost or 0) or 0)
	local shootChance, sideL, sideR = nil, 50, 50
	-- Forecast from the PREDICTED striker position when available (0.35s
	-- ahead of where they are), falling back to their raw position.
	local fPos = (poss == "opp" and MOVE.pos) or carrierPos
	if poss == "opp" and fPos and speed < CONFIG.DRIBBLE_MAX_SPEED then
		local sd = (fPos - rootPos).Magnitude
		if sd <= shootRange then
			shootChance = math.max(5, math.floor((1 - sd / shootRange) * 100))
			-- Side forecast: strikers usually shoot from the side they're driving to
			local lat = (fPos - rootPos):Dot(Camera.CFrame.RightVector)
			local nearChance = math.floor((0.55 + 0.25 * math.clamp(math.abs(lat) / 25, 0, 1)) * 100)
			if lat >= 0 then
				sideR, sideL = nearChance, 100 - nearChance
			else
				sideL, sideR = nearChance, 100 - nearChance
			end
		end
	end

	-- 📏 DYNAMIC COMMIT STUDS: slow shots commit close (~25), fast shots commit
	-- earlier (up to 48). Predicted power comes from the possessor's history;
	-- some counter modes commit even farther out (commitBonus).
	local targetPlayer = carrierPlayer or lastShooterPlayer
	local predSpeed = nil
	if targetPlayer then
		local st = playerShotStats[targetPlayer]
		if st and st.n > 0 then
			predSpeed = st.sum / st.n
		end
	end
	if not predSpeed then
		predSpeed = 100
	end
	local commitBonus = activeMode and (activeMode.commitBonus or 0) or 0
	local commitDist = math.clamp(CONFIG.COMMIT_BASE_DIST + predSpeed * CONFIG.COMMIT_SPEED_FACTOR + commitBonus,
		CONFIG.COMMIT_BASE_DIST, CONFIG.COMMIT_MAX_DIST)

	-- Dribble = CARRY (any speed) OR an OPPONENT at a slow ball. A real
	-- struck ball clears both checks on the same frame, so point-blank
	-- volleys are never misread as a dribble.
	local isDribbling = isCarried
		or ((speed < CONFIG.DRIBBLE_MAX_SPEED) and anyRootNear(oppRoots, ballPos, CONFIG.DRIBBLE_IGNORE_RADIUS))

	-- 📸 RELEASE GATE (the official GK guide: "react to the ball's RELEASE,
	-- not the opening animation — diving during a dribble animation lets
	-- the attacker wait and finish into the empty side"): while the ball is
	-- still at an opponent's feet at sub-shot speed, it hasn't been shot —
	-- it's a dribble tap, a carry, or a shot ANIMATION (a feint). The keeper
	-- waits for the release; the dive fires the frame the ball leaves the
	-- feet at shot speed.
	local isDribbleTap = anyRootNear(oppRoots, ballPos, CONFIG.RELEASE_FEET_RADIUS)
		and (speed < CONFIG.SHOT_RELEASE_SPEED)
	if isDribbleTap then
		isDribbling = true
	end
	local isHyperShot = ST.smoothedSpeed >= CONFIG.HYPER_SHOT_SPEED
	local strikerDist = minRootDist(oppRoots, ballPos)

	-- Projection of ball velocity onto the "toward the keeper" axis.
	-- Positive = coming at us. Clearly negative = going away (pass/clear).
	local approachSpeed = (rootPos - ballPos):Dot(velocity) / math.max(speed, 1)
	local movingAway    = approachSpeed < -CONFIG.AWAY_THRESHOLD

	-- 🌈 JUGGLE / RAINBOW DETECTION: a juggling ball is not a shot.
	--   (a) It's RISING — shots don't rise at goal.
	--   (b) It just rose and is drifting down slowly — mid-juggle.
	--   (c) It's falling almost straight down with a player under it — a
	--       juggle drop (the carrier radius can't see the ball overhead).
	if velocity.Y > 3 then
		lastRiseTime = tNow
	end
	local playerUnderBall = false
	for _, e in ipairs(refreshPlayerRoots()) do
		local dx = ballPos.X - e.root.Position.X
		local dz = ballPos.Z - e.root.Position.Z
		if dx * dx + dz * dz <= CONFIG.JUGGLE_OVERHEAD_DIST * CONFIG.JUGGLE_OVERHEAD_DIST
			and (ballPos.Y - e.root.Position.Y) > 2 then
			playerUnderBall = true
			break
		end
	end
	local isJuggle = false
	-- 🎯 TOP-BIN FIX (v2.37): a ball at SHOT SPEED is a shot, not a juggle —
	-- even when it's RISING. Top-bin shots rise during their initial flight
	-- (you must kick up to aim at the top corner), and the old "any rise
	-- > 2 studs/s = juggle" rule misread them as juggles and the keeper
	-- stood still ("JUGGLE — SAFE") while the ball went into the top bin.
	-- A real juggle is a controlled ball and never reaches shot speed.
	if velocity.Y > CONFIG.JUGGLE_RISE_SPEED and speed < CONFIG.MIN_DIVE_SPEED then
		isJuggle = true
	else
		local hSpeed = math.sqrt(velocity.X * velocity.X + velocity.Z * velocity.Z)
		local recentlyRose = (tNow - lastRiseTime) < 0.7
		-- A ball skimming along the ground is NOT a juggle — the ball must be
		-- actually elevated for the drift case to apply.
		local ballAboveFeet = (ballPos.Y - rootPos.Y) > 1
		if (recentlyRose and hSpeed < CONFIG.JUGGLE_DRIFT_SPEED and ballAboveFeet)
			or ((velocity.Y < -8) and (hSpeed < CONFIG.JUGGLE_DROP_H_SPEED) and playerUnderBall) then
			isJuggle = true
		end
	end

	-- 3) 🌍 TRUE TRAJECTORY SIMULATOR: damped horizontal curve (from the
	-- estimator) + REAL GRAVITY + PITCH BOUNCE. Lofted shots, headers, chips
	-- and bounces at the line are predicted as real arcs — the path dots show
	-- the arc too.
	local minDistance  = math.huge
	local impactPos    = ballPos
	local timeToImpact = 0

	-- Ground level = the lowest the ball has been recently (its contact height)
	local groundY = ballPos.Y
	for _, y in ipairs(yHistory) do
		if y < groundY then groundY = y end
	end
	local gravity = -196.2
	do
		local ok, g = pcall(function() return workspace.Gravity end)
		-- 🐛 CRITICAL: Roblox's workspace.Gravity is a POSITIVE magnitude
		-- (196.2) that the engine applies DOWNWARD. The simulator integrates
		-- gY directly into +Y-up velocity, so it needs the NEGATIVE value.
		-- Using it raw made every long-flight prediction FLY UP — slow shots
		-- were ruled "over the bar" and never saved. (Found by the run test.)
		if ok and type(g) == "number" and g ~= 0 then gravity = -math.abs(g) end
	end

	local simPos = ballPos
	local simVel = velocity
	pathCount  = 0

	-- Adaptive step: the step shrinks as the ball goes faster, so a 200 studs/s
	-- bomb is integrated ~3x finer than a 60 studs/s pass — crossing and
	-- impact interpolation get much sharper on exactly the shots that matter.
	local simStep = math.clamp(2.0 / math.max(speed, 50), CONFIG.SIM_STEP_MIN, CONFIG.SIM_STEP_MAX)

	local crossPos = nil        -- where the trajectory crosses the line (prediction)
	local crossOnTarget = nil   -- true = through the mouth, false = wide/over

	local prevDepth  = goal and ((ballPos - goal.linePos):Dot(goal.normal)) or nil
	local prevSimPos = ballPos

	local t = 0
	while t < CONFIG.SIM_HORIZON and pathCount < MAX_STEPS - 1 do
		-- Magnus physics: a real curve holds (almost) full sideways force
		-- early in the flight, then decays — full curve for the first
		-- CURVE_FULL_TIME, then decay (stops over-curving on noisy estimates).
		local curveDampener = (t < CONFIG.CURVE_FULL_TIME)
			and 1.0
			or math.max(0, 1 - (t - CONFIG.CURVE_FULL_TIME) * CONFIG.CURVE_DECAY)
		-- Vertical: if the estimator measured free fall (accel.Y < -50) trust
		-- THAT (the game may run custom gravity); otherwise use world gravity.
		local gY = (accel.Y < -50) and accel.Y or gravity
		simVel = simVel + Vector3.new(accel.X * curveDampener, gY, accel.Z * curveDampener) * simStep
		simPos = simPos + (simVel * simStep)
		-- Pitch bounce. v2.41 BUG FIX: a ball RESTING on the ground was
		-- "bouncing" every step — gravity makes vy negative each step while
		-- simPos sits exactly at groundY — so BOUNCE_FRICTION (x0.75) hit
		-- vx/vz EVERY STEP and the predicted ball stopped dead a few studs
		-- away. Rolling balls (slow shots, deflections, wide passes) then
		-- never produced a line crossing, blinding the honest wide ruling
		-- and causing false dives at balls going wide. Now a bounce only
		-- happens when the ball is actually FALLING (vy below one step of
		-- gravity); a resting ball rolls with vy=0 and only the per-second
		-- rolling friction applies.
		if simPos.Y <= groundY then
			simPos = Vector3.new(simPos.X, groundY, simPos.Z)
			local restThreshold = math.abs(gY) * simStep * 1.5
			if simVel.Y < -restThreshold then
				simVel = Vector3.new(
					simVel.X * CONFIG.BOUNCE_FRICTION,
					-simVel.Y * CONFIG.BOUNCE_RESTITUTION,
					simVel.Z * CONFIG.BOUNCE_FRICTION)
			elseif simVel.Y < 0 then
				simVel = Vector3.new(simVel.X, 0, simVel.Z) -- resting: kill the gravity drip
			end
		end
		-- Rolling friction: a ball on the pitch decelerates (post-bounce
		-- deflections slow down instead of skating forever).
		if simPos.Y <= groundY + 0.05 then
			local roll = math.max(0, 1 - CONFIG.ROLL_FRICTION * simStep)
			simVel = Vector3.new(simVel.X * roll, simVel.Y, simVel.Z * roll)
		end

		-- Closest approach is measured against where the keeper WILL BE
		-- (aimPos), not where they are — a keeper mid-recover is moving.
		local d = (simPos - aimPos).Magnitude
		if d < minDistance then
			minDistance  = d
			impactPos    = simPos
			timeToImpact = t
		end

		pathCount = pathCount + 1
		pathPos[pathCount] = simPos

		-- 🥅 GOAL LINE CROSSING: first +depth -> -depth transition,
		-- interpolated to the exact crossing point.
		if goal and not crossPos and prevDepth then
			local depth = (simPos - goal.linePos):Dot(goal.normal)
			if prevDepth > 0 and depth <= 0 then
				local f = prevDepth / (prevDepth - depth)
				local cp = prevSimPos + (simPos - prevSimPos) * f
				local lateral = (cp - goal.linePos):Dot(goal.axis)
				crossPos = cp
				crossOnTarget = (math.abs(lateral) <= goal.halfWidth + CONFIG.BALL_RADIUS * 0.5)
					and (cp.Y <= goal.crossbarY + CONFIG.BALL_RADIUS * 0.5)
			end
			prevDepth = depth
		end
		prevSimPos = simPos
		t = t + simStep
	end

	if minDistance > CONFIG.MAX_IMPACT_DISTANCE then
		hideVisuals()
		markIdle()
		return
	end

	-- 📥 RECEIVER GATE (v2.42): the last "dives when they don't shoot" case —
	-- a PASS to a teammate. A pass at shot speed that the simulator predicts
	-- crossing the goal mouth reads "on target" and gets a full dive. But if
	-- a non-shooter opponent is standing ON THE BALL'S PREDICTED PATH, the
	-- ball is arriving at them — a receiver who collects it before the line —
	-- not a shot at goal. The keeper WATCHES (and dives at the tap-in if the
	-- receiver actually strikes it). Path proximity (not impact proximity)
	-- is self-correcting: once the ball has PAST the receiver, no opponent
	-- is on the remaining path and the keeper commits. The first 0.15s of
	-- the path is skipped (the launch window) — that's where the KICKER
	-- stands, and a kicker is not a receiver. A real shot's path has no
	-- opponent on it, so honest saves are untouched. The GK tackle (an
	-- intentional steal of a carrier at your feet) is a separate branch and
	-- is NOT gated.
	local receiverInPath = false
	if CONFIG.USE_RECEIVER_GATE then
		local maxSteps = math.min(pathCount, math.ceil(1.2 / simStep))
		for _, e in ipairs(refreshPlayerRoots()) do
			if e.player ~= lastShooterPlayer then
				local ePos = e.root.Position
				-- A RECEIVER is in FRONT of the ball (the ball is heading to
				-- them); the KICKER is behind it (the ball left them). This
				-- direction test excludes the kicker with no launch-window
				-- gap, so a receiver right up for the catch is still seen.
				local ahead = (ePos.X - ballPos.X) * velocity.X
					+ (ePos.Y - ballPos.Y) * velocity.Y
					+ (ePos.Z - ballPos.Z) * velocity.Z
				if ahead > 0 then
					-- cheap pre-filter: skip players far from the ball now
					local epx = ePos.X - ballPos.X
					local epy = ePos.Y - ballPos.Y
					local epz = ePos.Z - ballPos.Z
					if epx*epx + epy*epy + epz*epz < 35*35 then
						local r2 = CONFIG.RECEIVER_RADIUS * CONFIG.RECEIVER_RADIUS
						for i = 1, maxSteps do
							local p = pathPos[i]
							local dx = p.X - ePos.X
							local dy = p.Y - ePos.Y
							local dz = p.Z - ePos.Z
							if dx*dx + dy*dy + dz*dz <= r2 then
								receiverInPath = true
								break
							end
						end
					end
				end
				if receiverInPath then break end
			end
		end
	end

	-- 🧤 ON TARGET?
	-- First, can this ball even score? With goal geometry known, a crossing
	-- clearly wide of the posts or over the bar is a guaranteed miss —
	-- never dive at it, even in save-everything mode.
	local definitelyMiss = false
	if goal then
		-- v2.41: a ball that has ALREADY crossed the goal line can't score —
		-- don't chase it into the net. (Once past the line, crossPos
		-- disappears, which used to flip onTarget back to true and send the
		-- keeper diving at a ball 50 studs behind the goal.)
		definitelyMiss = ((ballPos - goal.linePos):Dot(goal.normal) < 0)
		if crossPos then
			local crossLateral = (crossPos - goal.linePos):Dot(goal.axis)
			-- v2.41 honest wide ruling: a ball crossing 3.5 studs outside
			-- the post (ball radius + prediction tolerance) or 4 studs over
			-- the bar CANNOT score — the keeper stays on its feet. This is
			-- what stopped the "he passed it wide, why did you dive" false
			-- dives. True corner balls (crossing at the post) are untouched.
			definitelyMiss = definitelyMiss
				or (math.abs(crossLateral) > goal.halfWidth + 3.5)
				or (crossPos.Y > goal.crossbarY + 4)
		end
	end

	local onTarget
	if definitelyMiss then
		onTarget = false
	elseif CONFIG.SAVE_EVERYTHING then
		onTarget = true -- commit to every scorable ball
	elseif goal then
		onTarget = (crossOnTarget == true) or (minDistance <= CONFIG.COMMIT_RADIUS)
	else
		onTarget = minDistance <= CONFIG.COMMIT_RADIUS
	end
	-- 🐌 SLOW SHOT DETECTOR (v2.29): a RELEASED shot slower than the full
	-- side-dive tier is a STEP-UP save, never a side dive. The old code only
	-- reacted when the ball was ALREADY inside a small 30/14/15 window — a
	-- slow shot from range sailed through and went in. Now the moment a slow
	-- on-target ball is read (20-59 studs/s, coming at us, not carried /
	-- dribbled / juggled / own team) it is ARMED: the HUD warns early
	-- ("SLOW SHOT INCOMING") and the keeper meets it with a Forward save from
	-- a wider window (34/18/20) — slow balls give time to move, so the
	-- sideways + height tolerances are bigger. It un-arms itself the frame
	-- the ball speeds up into full-dive territory or stops being a threat.
	-- 🎯 SLOW SHOT must be heading AT the goal line — a slow pass drifting
	-- near the keeper is not a shot (v2.40 false-dive fix).
	local slowShotAtGoal = true
	if goal then
		local toLine = goal.linePos - ballPos
		if toLine.Magnitude > 0.01 then
			slowShotAtGoal = (velocity:Dot(toLine.Unit)) >= (speed * CONFIG.SLOW_SHOT_GOAL_DOT)
		end
	end
	local slowShotArmed = onTarget
		and (speed >= CONFIG.MIN_SHOT_SPEED) and (speed < CONFIG.MIN_DIVE_SPEED)
		and not movingAway
		and (approachSpeed > 0)
		and not isCarried
		and not isJuggle
		and not ballControlled
		and slowShotAtGoal
		and (poss ~= "own")
		and not isDribbling

	-- 4) CAMERA MATRIX (left/right from the keeper's view), relative to the
	-- PREDICTED keeper position (aimPos) — the side you dive to should match
	-- where you'll be when the ball gets there.
	local impactOffset   = impactPos - aimPos
	local horizontalDist = impactOffset:Dot(Camera.CFrame.RightVector)
	local verticalDist   = impactPos.Y - aimPos.Y

	local direction = CONFIG.CENTER_ACTION
	if horizontalDist > CONFIG.CENTER_TOLERANCE then
		direction = "Right"
	elseif horizontalDist < -CONFIG.CENTER_TOLERANCE then
		direction = "Left"
	end

	-- 🥅 If the ball crosses the line, the crossing side is the truth —
	-- immune to camera rotation and keeper-position jitter.
	if goal and crossPos then
		local keeperRight = goal.normal:Cross(UP)
		local lateral2 = (crossPos - goal.linePos):Dot(keeperRight)
		if math.abs(lateral2) > CONFIG.CENTER_TOLERANCE then
			direction = lateral2 > 0 and "Right" or "Left"
		end
	end

	if CONFIG.INVERT_DIVE_DIRECTION then
		if direction == "Left" then direction = "Right"
		elseif direction == "Right" then direction = "Left"
		end
	end

	-- 🎈 AERIAL BIAS (deep-researched GK guide: "if shoots comes from air
	-- just jump... don't do left or right dive, try front dive"): a high,
	-- DESCENDING ball arriving near center is met with a Forward save.
	-- v2.41: range-capped — a lob from 40 studs is met by POSITIONING, not
	-- a 40-stud forward lunge (the slow-branch reach already handles the
	-- commit window up close).
	if velocity.Y < -5
		and verticalDist > CONFIG.AERIAL_BIAS_HEIGHT
		and math.abs(horizontalDist) <= CONFIG.AERIAL_BIAS_OFFSET
		and distToGoalie <= 35 then
		direction = "Forward"
	end

	-- 4b) FORWARD OVERRIDE: ball aimed straight at the body at a catchable height.
	-- Only replaces "Middle" — Left/Right decisions are never touched.
	if CONFIG.USE_FORWARD_DIVE and direction == CONFIG.CENTER_ACTION then
		if math.abs(horizontalDist) <= CONFIG.FORWARD_TOLERANCE
			and verticalDist >= CONFIG.REACH_HEIGHT_MIN
			and verticalDist <= CONFIG.FORWARD_HEIGHT_MAX then
			direction = "Forward"
		end
	end

	-- 4c) 🎯 WEAK-CENTER CATCH (v2.43): a WEAK shot (under 85) that's near
	-- the center is a CATCH, not a committed side dive — the "it dove left
	-- or right instead of forward" fix. A side dive on a central weak ball
	-- leaves the middle open (exactly how the slow shot got in). Overriding
	-- Left/Right here is deliberate: a keeper meets a weak central ball by
	-- stepping TO it (Forward), never by committing sideways. Off-center
	-- weak balls (beyond WEAK_CENTER_MAX) keep their side dive — they really
	-- are to the side.
	if speed < CONFIG.WEAK_SHOT_SPEED
		and math.abs(horizontalDist) <= CONFIG.WEAK_CENTER_MAX then
		direction = "Forward"
	end

	-- (The sweeper smother lives in the slow-ball branch of section 6 —
	--  a dead low ball gets a scoop only when it's truly dead, close & on target.)

	-- 5) VISUALS (state-colored, curved trajectory trail with fade)
	local threatColor
	if isDribbling or movingAway or speed < CONFIG.MIN_SHOT_SPEED or not onTarget then
		threatColor = Color3.fromRGB(120, 120, 120) -- gray: wide / not on target — stay on feet
	elseif direction == "Forward" then
		threatColor = Color3.fromRGB(255, 60, 60)    -- red: straight-on catch/push
	elseif isHyperShot then
		threatColor = Color3.fromRGB(255, 0, 255)    -- magenta: hyper shot
	elseif direction == "Left" then
		threatColor = Color3.fromRGB(50, 150, 255)   -- blue
	elseif direction == "Right" then
		threatColor = Color3.fromRGB(255, 150, 50)   -- orange
	else
		threatColor = Color3.fromRGB(255, 255, 50)   -- yellow: middle
	end

	if impactPart then
		impactPart.CFrame = CFrame.new(impactPos)
		impactPart.Color  = threatColor
		impactPart.Transparency = 0

		-- Dots span the predicted path 0.5s PAST the impact, so you can see
		-- where the ball is going after it gets past you.
		local dotEnd = math.min(timeToImpact + 0.5, CONFIG.SIM_HORIZON)
		for i, dot in ipairs(pathDots) do
			local tDot = dotEnd * (i / (#pathDots + 1))
			local idx  = math.clamp(math.floor(tDot / simStep) + 1, 1, pathCount)
			dot.CFrame       = CFrame.new(pathPos[idx])
			dot.Color        = threatColor
			dot.Transparency = 0.1 + 0.55 * (i / #pathDots) -- older dots fade out
		end
	end

	-- 6) ⚡ ZERO-LATENCY DIVE EXECUTION ⚡
	local hudLabel, hudColor

	-- 6t) 🤾 GK TACKLE (v2.40 — fan wiki mechanic): a FORWARD save on the
	-- ball CARRIER steals the ball — "as GK you can tackle your enemy by
	-- forward-saving them." An opponent controlling the ball at our feet is
	-- met with a Forward (tackle). Only while the ball is CONTROLLED (never
	-- a live shot), range-gated, cooldown-gated.
	local tackleFired = false
	if CONFIG.USE_GK_TACKLE and poss == "opp" and ballControlled
		and (speed < CONFIG.DRIBBLE_MAX_SPEED)
		and (os.clock() >= ST.tackleUntil)
		and (os.clock() >= ST.cooldownUntil)
		and (distToGoalie <= CONFIG.TACKLE_RANGE) then
		tackleFired = true
		direction = "Forward"
		hudLabel, hudColor = "GK TACKLE!", Color3.fromRGB(255, 60, 60)
		ST.tackleUntil = os.clock() + CONFIG.TACKLE_COOLDOWN
		ST.cooldownUntil = tNow + effCooldown
		CHARGE.lastDive = tNow
		diveWatch = { time = tNow, speed = speed, approach = approachSpeed, resolved = false }
		print(string.format("[AI-Dive] 🤾 GK TACKLE | forward save steal | @%.1f studs", distToGoalie))
		pcall(function() DiveEvent:FireServer("Forward") end)
	end

	-- 6a) 🎈 LOFT CATCH (deep-researched: the GK guide says never dive before
	-- the release, and Gagamaru's Leap/Perfect Save = lunge forward to catch):
	-- a DESCENDING lofted ball (chip, header, drop) within lunge range is met
	-- with a Forward catch at the exact moment it crosses hand height, solved
	-- ballistically. While the ball is still rising we wait — diving early
	-- leaves the opposite side open.
	local loftFired = false
	if speed >= CONFIG.MIN_SHOT_SPEED
		and not isDribbling and not isCarried and poss ~= "own" and not isJuggle and not movingAway
		and not receiverInPath -- v2.42: a lobbed pass to a receiver, not a shot
		and (os.clock() >= ST.cooldownUntil)
		and velocity.Y < -10 and verticalDist > 5 and distToGoalie < CONFIG.LOFT_MAX_DIST then
		local gY = (accel.Y < -50) and accel.Y or -196.2
		local y0, vy = ballPos.Y, velocity.Y
		local catchY = aimPos.Y + 1.5 -- hand height at the predicted position
		if y0 > catchY then
			local D = vy * vy - 2 * gY * (y0 - catchY)
			if D > 0 then
				local tCatch = (-vy - math.sqrt(D)) / gY -- descending root
				if tCatch > 0 and tCatch <= (CONFIG.LOFT_CATCH_WINDOW + getNetworkPing()) then
					local catchPos = ballPos + Vector3.new(velocity.X, 0, velocity.Z) * tCatch
					local catchLat = (catchPos - aimPos):Dot(Camera.CFrame.RightVector)
					if math.abs(catchLat) <= CONFIG.LOFT_CATCH_REACH then
						loftFired = true
						direction = "Forward"
					end
				end
			end
		end
	end
	if tackleFired then
		-- 🤾 GK TACKLE already fired above — the tackle IS the response;
		-- skip the dive cascade for this frame.
		ST.commitDir, ST.commitFrames = nil, 0
	elseif loftFired then
		hudLabel, hudColor = "LOFT CATCH!", Color3.fromRGB(255, 60, 60)
		if impactPart then impactPart.Color = Color3.fromRGB(255, 60, 60) end
		ST.cooldownUntil = tNow + effCooldown
		CHARGE.lastDive = tNow
		diveWatch = { time = tNow, speed = speed, approach = approachSpeed, resolved = false }
		print(string.format("[AI-Dive] 🎈 LOFT CATCH | @%.1f studs | vy %.0f",
			distToGoalie, velocity.Y))
		tryAutoJump(((crossPos and crossPos.Y) or math.max(impactPos.Y, ballPos.Y)) - rootPos.Y,
			goal and (goal.crossbarY - rootPos.Y) or nil) -- 🦘 jump for the LINE height
		pcall(function() DiveEvent:FireServer("Forward") end)

	-- NOTE: the MIN_SHOT_SPEED gate uses RAW speed (not the smoothed EMA) so
	-- a fresh strike is judged on the first frame, not 4 frames later.
	elseif isDribbling or poss == "own" or isJuggle or movingAway or speed < CONFIG.MIN_SHOT_SPEED then
		-- 🧤 PUNCH OUT: a dead, low ball right at your feet in the goal
		-- mouth (point-blank rainbow that dips short, soft drop, deflection
		-- at your toes) gets a last-frame Forward smother even below
		-- MIN_SHOT_SPEED. A ball at your feet in your goal is not "watching".
		-- Never fires on a ball a teammate is about to play, an opponent
		-- dribbling at your feet, a ball in the air (juggle), or a ball
		-- already rolling away.
		local punchOut = (speed < CONFIG.MIN_SHOT_SPEED)
			and (not isDribbling) and (not isCarried) and (poss ~= "own")
			and (not isJuggle) and (not movingAway) and (not ballControlled)
			and (os.clock() >= ST.cooldownUntil)
			and (distToGoalie <= CONFIG.PUNCHOUT_MAX_DIST)
			and (verticalDist >= CONFIG.REACH_HEIGHT_MIN)
			and (verticalDist <= CONFIG.PUNCHOUT_HEIGHT_MAX)
		if punchOut then
			direction = "Forward"
			hudLabel, hudColor = "PUNCH OUT!", Color3.fromRGB(255, 60, 60)
			if impactPart then impactPart.Color = Color3.fromRGB(255, 60, 60) end
			ST.cooldownUntil = tNow + effCooldown
			CHARGE.lastDive = tNow
			diveWatch = { time = tNow, speed = speed, approach = approachSpeed, resolved = false }
			print(string.format("[AI-Dive] 🧤 PUNCH OUT | Speed: %d | @%.1f studs",
				math.floor(speed), distToGoalie))
			tryAutoJump(((crossPos and crossPos.Y) or math.max(impactPos.Y, ballPos.Y)) - rootPos.Y,
				goal and (goal.crossbarY - rootPos.Y) or nil) -- 🦘 (rare: punch-out balls are low)
			pcall(function() DiveEvent:FireServer("Forward") end)
		else
			-- No dive, but keep the HUD live (studs/speed still useful).
			if isCarried then
				hudLabel = "CARRY — SAFE (no shot yet)"
			elseif isDribbleTap then
				hudLabel = "TAP — SAFE (waiting for release)"
			elseif isDribbling then
				hudLabel = "DRIBBLE — SAFE"
			elseif poss == "own" then
				hudLabel = "OWN TEAM BALL — SAFE"
			elseif isJuggle then
				hudLabel = "JUGGLE — SAFE"
			elseif movingAway then
				hudLabel = "BALL AWAY"
			else
				hudLabel = "WATCHING"
			end
			hudColor = Color3.fromRGB(120, 120, 120)
		end
		ST.commitDir, ST.commitFrames = nil, 0 -- threat gone: clear the read
	elseif not onTarget then
		hudLabel, hudColor = "WIDE — STAYING ON FEET", Color3.fromRGB(120, 120, 120)
		ST.commitDir, ST.commitFrames = nil, 0 -- wide of the goal: no read in progress
	elseif os.clock() < ST.cooldownUntil then
		hudLabel, hudColor = "COOLDOWN", Color3.fromRGB(255, 200, 60)
	elseif ST.smoothedSpeed < CONFIG.MIN_DIVE_SPEED and speed < CONFIG.MIN_DIVE_SPEED then
		-- 🐢 SLOW BALL: never a full side dive. A keeper saves a slow
		-- on-target shot by STEPPING FORWARD to it (catch/push), not a side
		-- dive. "SMOOTHER" = a dead low ball right at the feet (scoop).
		-- "SLOW FORWARD" = a slow on-target shot the keeper steps up to.
		-- A slow shot that went in and got missed was exactly this gap: it
		-- was on target but not "low + close" enough for the old smother.
		-- v2.29: when the SLOW SHOT DETECTOR is armed, the save window is
		-- WIDER (34/18/20 vs 30/14/15) — a slow ball gives time to move —
		-- and outside the window the HUD warns "SLOW SHOT INCOMING" so the
		-- keeper steps up instead of standing and watching it roll in.
		-- v2.31: the branch now also requires the RAW speed to be slow.
		-- The smoothed EMA lags ~4-6 frames after a release, so a FAST
		-- point-blank shot used to read as "slow" for its first frames and
		-- fire a premature Forward dive — whose 0.7s cooldown then blinded
		-- the keeper to the real side dive. (Found by the run test.)
		local wReach, wLateral, wHeight, label
		if slowShotArmed then
			wReach, wLateral, wHeight = CONFIG.SLOW_SHOT_REACH, CONFIG.SLOW_SHOT_LATERAL, CONFIG.SLOW_SHOT_HEIGHT
			label = "SLOW SHOT — STEP UP!"
		else
			wReach, wLateral, wHeight = CONFIG.SLOW_FORWARD_REACH, CONFIG.SLOW_FORWARD_OFFSET, CONFIG.SLOW_FORWARD_HEIGHT
			label = (distToGoalie <= CONFIG.SMOOTHER_MAX_DIST) and "SMOOTHER!" or "SLOW FORWARD!"
		end
		local slowSaveOK = (not fakeHold)
			and (not freshPopConfirm) -- v2.43: no step-dive on an unproven pop
			and (not ballControlled) -- v2.40: never step-dive at a controlled ball
			and (not receiverInPath) -- v2.42: a pass to a receiver, not a shot
			and onTarget
			and (approachSpeed > 0)
			and (ST.smoothedSpeed < CONFIG.SMOOTHER_MAX_SPEED)
			and (distToGoalie <= wReach)
			and (math.abs(horizontalDist) <= wLateral)
			and (verticalDist >= CONFIG.REACH_HEIGHT_MIN and verticalDist <= wHeight)
		if slowSaveOK then
			direction = "Forward"
			hudLabel, hudColor = label, Color3.fromRGB(255, 60, 60)
			if impactPart then impactPart.Color = Color3.fromRGB(255, 60, 60) end
			ST.cooldownUntil = tNow + effCooldown
			CHARGE.lastDive = tNow
			diveWatch = { time = tNow, speed = speed, approach = approachSpeed, resolved = false }
			print(string.format("[AI-Dive] 🐌 %s | Dir: Forward | Speed: %d | @%.1f studs",
				label, math.floor(speed), distToGoalie))
			tryAutoJump(((crossPos and crossPos.Y) or math.max(impactPos.Y, ballPos.Y)) - rootPos.Y,
				goal and (goal.crossbarY - rootPos.Y) or nil) -- 🦘 (rare: slow saves are low balls)
			pcall(function() DiveEvent:FireServer("Forward") end)
		elseif fakeHold then
			-- 🎭 a tap that died is not a shot — hold and stay set
			hudLabel, hudColor = "FAKE — HOLD", Color3.fromRGB(255, 150, 50)
			ST.commitDir, ST.commitFrames = nil, 0
		elseif slowShotArmed then
			-- armed but not yet in save range: warn EARLY so the keeper moves
			hudLabel, hudColor = "SLOW SHOT INCOMING — MOVE!", Color3.fromRGB(255, 200, 60)
			ST.commitDir, ST.commitFrames = nil, 0
		else
			hudLabel, hudColor = "SLOW — STAY ON FEET", Color3.fromRGB(120, 120, 120)
			ST.commitDir, ST.commitFrames = nil, 0
		end
	elseif fakeHold then
		-- 🎭 FAKE HOLD (fast tier): the ball popped and died — a real strike
		-- sustains. No dive until it sustains speed again (then this flag
		-- clears on its own and the normal dive logic resumes).
		hudLabel, hudColor = "FAKE — HOLD", Color3.fromRGB(255, 150, 50)
		ST.commitDir, ST.commitFrames = nil, 0
	else
		local currentPing = getNetworkPing()
		local dynamicDiveTime = CONFIG.BASE_DIVE_TIME
			+ (currentPing * CONFIG.PING_COMPENSATION)
			+ (speed / 500)

		-- 💥 URGENCY TIERS (distance × speed = how fast the keeper commits):
		--   BOMB  = player FAR + ball insanely fast -> dive on the VERY FRAME
		--           detected, as fast as possible, exactly where it's going.
		--   QUICK = player CLOSE + ball fast -> fast dive, but with a tiny
		--           direction read first (fast, but not frame-zero).
		local pointBlank  = isHyperShot and (distToGoalie <= CONFIG.DANGER_ZONE_DISTANCE)
		local isBomb      = (speed >= effBombSpeed) and (distToGoalie >= CONFIG.BOMB_FAR_DIST)
		local isExtreme   = speed >= CONFIG.EXTREME_SPEED
		local quickThresh = activeMode and (activeMode.quickSpeed or CONFIG.QUICK_SPEED) or CONFIG.QUICK_SPEED
		local isQuickShot = (speed >= quickThresh) and (distToGoalie < CONFIG.BOMB_FAR_DIST)
		local instant     = pointBlank or isExtreme or (speed >= CONFIG.BIG_BANG_SPEED) or isBomb or speedSpike
		-- SNAP counters (Timestop just ended, Big Bang, Flame Shot, King's Chop):
		-- anything moving fast is met on the very frame, no matter what.
		if activeMode and activeMode.snap and speed >= 80 then
			instant = true
		end
		-- 🦸 STAND OP: against a Stand user, everything that's moving is live.
		if standOp and speed >= 90 then
			instant = true
		end

		local activeReach = CONFIG.SAVE_EVERYTHING and CONFIG.REACH_EVERYTHING
			or (isHyperShot and (CONFIG.REACH_LEFT_RIGHT * 2) or CONFIG.REACH_LEFT_RIGHT)
		-- ☄️ EXTREME / STAND OP: maximum horizontal reach
		if isExtreme or standOp then
			activeReach = math.max(activeReach, CONFIG.EXTREME_REACH)
		end

		local withinReach = (math.abs(horizontalDist) <= activeReach)
			and (verticalDist >= CONFIG.REACH_HEIGHT_MIN)
			and (verticalDist <= effHeightMax)

		-- 📏 Commit gate: bombs bypass it (they must be met at full speed,
		-- no waiting for the ball to fly in). Everything else commits inside
		-- the dynamic commit distance (25 for slow shots, up to 48 for Big Bang power).
		local withinCommit = instant or (distToGoalie <= commitDist)

		-- 📐 CURVE COMMIT (v2.32 — why Rin's Killer Shot STILL slipped in
		-- after v2.31): v2.31 primed the read to the curve side, but the
		-- dive still waited for the ball to "show" the break — and the dive
		-- animation takes ~0.4s while the break lands at 0.5-1.0s of
		-- flight, so the late commit to the true side always arrived AFTER
		-- the ball. Now: the moment the shot is confirmed (released, on
		-- target, coming at us), the keeper COMMITS TO THE PRIME SIDE —
		-- 0.2s BEFORE the normal window opens — and holds it. The prime is
		-- abandoned only if the ball PERSISTENTLY goes the other way (3
		-- stable frames ≥ 18 studs opposite) — that means the player isn't
		-- doing the signature curve, and the normal read resumes.
		local curveDir = nil
		if activeMode and activeMode.primeSide and onTarget and approachSpeed > 0
			and speed >= CONFIG.MIN_SHOT_SPEED and not isDribbling and not fakeHold then
			local oppositeDir = (activeMode.primeSide == "Left" and "Right")
				or (activeMode.primeSide == "Right" and "Left")
			local sinceShot = tNow - ST.lastShotReset
			local clearlyOther = (oppositeDir == "Right" and horizontalDist >= 20)
				or (horizontalDist <= -20)
			-- Only count "other side" frames while the ball is a live shot
			-- (not dying) and past the first tenth of a second.
			ST.curveOtherFrames = (clearlyOther and speed >= 60 and sinceShot > 0.1)
				and (ST.curveOtherFrames + 1) or 0
			--  ABANDON RULE (v2.34 — why Rin STILL slipped in): the old
			-- rule abandoned the prime after just 3 frames (50ms) on the
			-- other side — but a curve shot's FEINT spends 0.15-0.3s on the
			-- wrong side BEFORE it bends, so the prime was lost mid-feint,
			-- the read re-formed on the post-break side, and the dive
			-- arrived late. Now the prime is abandoned only when the ball
			-- PROVES itself a straight shot: 20+ frames (≈0.33s) clearly
			-- ≥ 20 studs on the other side at shot speed.
			if ST.curveOtherFrames < 20 then
				curveDir = activeMode.primeSide
			end
		end
		local curveInWindow = (curveDir ~= nil)
			and (timeToImpact <= dynamicDiveTime + CONFIG.CURVE_COMMIT_LEAD)
		local inWindow = instant or (timeToImpact <= dynamicDiveTime) or curveInWindow

		if freshPopConfirm then
			-- 🎭 The pop is unproven — a real strike sustains, a fake dies.
			-- No full dive in the first 0.10s of a sub-110 pop (this is
			-- what stops the frame-zero dive on Barou's fast fake).
			hudLabel, hudColor = "POP — CONFIRM", Color3.fromRGB(255, 150, 50)
			ST.commitDir, ST.commitFrames = nil, 0
		elseif receiverInPath then
			-- 📥 A pass heading to a receiver, not a shot — watch the ball
			-- arrive at them. If they tap it in, that tap is a fresh shot
			-- and the keeper dives at the tap.
			hudLabel, hudColor = "RECEIVER IN PATH — WATCH", Color3.fromRGB(255, 150, 50)
			ST.commitDir, ST.commitFrames = nil, 0
			if (os.clock() - ST.lastReceiverPrint) > 2.5 then
				ST.lastReceiverPrint = os.clock()
				print(string.format("[AI-Dive] 📥 RECEIVER IN PATH — watching (pass, not a shot) | @%.1f studs",
					distToGoalie))
			end
		elseif not (inWindow and withinReach and withinCommit) then
			if curveDir then
				hudLabel, hudColor = "CURVE " .. curveDir .. " — ARMED", Color3.fromRGB(255, 200, 60)
			else
				hudLabel, hudColor = "READING " .. direction, threatColor
			end
		else
			-- 🧠 COMMIT DISCIPLINE by urgency + counter mode:
			--   deceiver moves (Backheel, Gear 5) -> FORCED 2-frame read,
			--     even in save-everything — their first frame lies
			--   BOMB / instant / zero-hesitate moves -> frame zero
			--   QUICK -> QUICK_READ_FRAMES of direction stability
		--   slower (Neuer) -> COMMIT_CONFIRM_FRAMES on the same side
		-- 📏 NEAR-POST BIAS (researched GK guide: "Move toward the near post
		-- when the attacker approaches from a wide position"): a wide striker
		-- shoots ACROSS to the near post far more often than at the far
		-- corner. While the threat is wide, the FAR side costs ONE extra
		-- read frame — the read can still flip either way (a genuine
		-- far-post shot is met just one frame later, ≈17ms), while the
		-- keeper's weight goes where the guide says it should.
		local nearPostSide = nil
		if fPos then
			local threatLat = (fPos - rootPos):Dot(Camera.CFrame.RightVector)
			if math.abs(threatLat) >= CONFIG.WIDE_STRIKER_LAT then
				nearPostSide = threatLat > 0 and "Right" or "Left"
			end
		end
		local modeConfirm = activeMode and activeMode.confirmFrames or nil
			local needsConfirm, confirmFrames = false, CONFIG.COMMIT_CONFIRM_FRAMES
			if modeConfirm and modeConfirm > 1 then
				needsConfirm, confirmFrames = true, modeConfirm
			elseif (not instant) and isQuickShot and CONFIG.QUICK_READ_FRAMES > 1
				and (not modeConfirm) then
				needsConfirm, confirmFrames = true, CONFIG.QUICK_READ_FRAMES
			elseif (not instant) and (not CONFIG.SAVE_EVERYTHING)
			and (timeToImpact > CONFIG.COMMIT_CONFIRM_TTI)
			and (CONFIG.COMMIT_CONFIRM_FRAMES > 1) then
				needsConfirm, confirmFrames = true, CONFIG.COMMIT_CONFIRM_FRAMES
			end
		-- near-post bias: the FAR side vs a wide threat needs one extra frame
		if needsConfirm and nearPostSide
			and (direction == "Left" or direction == "Right")
			and direction ~= nearPostSide then
			confirmFrames = confirmFrames + 1
		end

		local confirmed = not needsConfirm
		if needsConfirm then
			if direction ~= ST.commitDir then
				ST.commitDir, ST.commitFrames = direction, 1
			else
				ST.commitFrames = ST.commitFrames + 1
				confirmed = (ST.commitFrames >= confirmFrames)
			end
		end
		-- 📐 CURVE COMMIT: the prime side confirms on the FIRST frame — the
		-- move's signature IS the side, and a bending ball's wobbling
		-- prediction is less trustworthy than the researched bend. (If the
		-- ball persistently goes the other way, curveDir was abandoned
		-- above and the normal read applies.)
		if curveDir then
			direction = curveDir
			confirmed = true
		end

		if confirmed then
				if isBomb then
					hudLabel = "BOMB DIVE " .. direction .. "!!"
				elseif isQuickShot and (not instant) then
					hudLabel = "QUICK DIVE " .. direction .. "!"
				else
					hudLabel = "DIVE " .. direction .. "!"
				end
				hudColor = threatColor

				ST.commitDir, ST.commitFrames = nil, 0
				ST.cooldownUntil = os.clock() + effCooldown
				CHARGE.lastDive = tNow
				diveWatch = { time = tNow, speed = speed, approach = approachSpeed, resolved = false }

					local tag
					if isExtreme then
						tag = "☄️ EXTREME — MAX URGENCY"
					elseif speedSpike then
						tag = "🚀 LATE SPIKE — INSTANT"
					elseif isBomb then
						tag = "💥 BOMB — FULL SPEED"
					elseif pointBlank then
						tag = "⚡ INSTANT REACTION"
					elseif speed >= CONFIG.BIG_BANG_SPEED then
						tag = "💥 BIG BANG"
					elseif isHyperShot then
						tag = "🔥 HYPER"
					elseif isQuickShot then
						tag = "🔥 QUICK"
					else
						tag = "🧤 NEUER"
					end
					if standOp then
						tag = tag .. " | 🦸 STAND OP"
					end
					if activeMode then
						tag = tag .. " | 🎮 " .. activeMode.name
					end
					print(string.format("[AI-Dive] %s | Dir: %s | Ping: %dms | TTI: %.2fs | Speed: %d | @%d studs",
						tag, direction, math.floor(currentPing * 1000), timeToImpact, math.floor(speed),
						math.floor(distToGoalie)))
				tryAutoJump(((crossPos and crossPos.Y) or math.max(impactPos.Y, ballPos.Y)) - rootPos.Y,
					goal and (goal.crossbarY - rootPos.Y) or nil) -- 🦘 top-bin dives jump first
				pcall(function() DiveEvent:FireServer(direction) end)
			else
				hudLabel = (isQuickShot and (not instant) and "QUICK READ " or "READING ") .. direction
				hudColor = threatColor
			end
		end
	end

	-- 7) 🖐️ SAVE DETECTION (IN HAND / HITBOX): a save counts ONLY when the
	-- ball ends up secured by you and moving slowly. "Secured" mirrors the
	-- game's own check: ball in hand (root radius) OR overlapping any of the
	-- keeper's hitbox parts. Parries, bounces and deflections don't count.
	if not diveWatch.resolved then
		local age = tNow - diveWatch.time
		if age > 1.5 then
			diveWatch.resolved = true -- expired: ball was never secured
		else
			local secured = (ballPos - rootPos).Magnitude <= CONFIG.BALL_IN_HAND_RADIUS
				or ballOverlapsKeeper(character, ballPos)
			if secured and speed < 30 then
				diveWatch.resolved = true
				matchStats.saves = matchStats.saves + 1
				ST.lastSaveTime = tNow
				ST.pendingFlash = { text = "SAVE!!", color = Color3.fromRGB(80, 255, 120), t = tNow }
				print("[AI-Dive] 🧤 SAVE! (ball secured)")
			end
		end
	end

	--  WIDE diagnostic: if the keeper is being held back by the can't-score
	-- ruling, log WHY (once every 2.5s) so it's easy to verify.
	if not onTarget and goal and crossPos and (os.clock() - ST.lastWidePrint) > 2.5 then
		ST.lastWidePrint = os.clock()
		print(string.format("[AI-Dive]  ruled WIDE/MISS — lateral %.1f (post %.1f), height %.1f (bar %.1f)",
			math.abs((crossPos - goal.linePos):Dot(goal.axis)), goal.halfWidth,
			crossPos.Y, goal.crossbarY))
	end

	-- 8) 🥅 CONCEDE DETECTION (fallback without goal geometry):
	-- ball went behind the keeper within ~1.5s of being in front of it.
	if not goal then
		local keeperFacing = Camera.CFrame.LookVector
		local depthK = (ballPos - rootPos):Dot(keeperFacing)
		if depthK > 2 then
			ST.lastInFront = tNow
		-- 🐛 FAKE-GOAL FIX: a concede needs a credited shot within the window
		-- AND the ball crossing at shot speed — post-save rebounds, wide
		-- crossings, and carried balls no longer count.
		elseif depthK < -2 and (tNow - ST.lastInFront) < 1.5
			and (tNow - ST.lastShotReset) < CONFIG.CONCEDE_SHOT_WINDOW
			and speed > CONFIG.CONCEDE_MIN_SPEED
			and (tNow - ST.lastConcede) > 3 and (tNow - ST.lastSaveTime) > 3 then
			ST.lastConcede = tNow
			local ownGoal = (myKey and lastShooterKey == myKey)
				and (tNow - lastShooterTime) < CONFIG.SHOT_OWNER_MEMORY
			if ownGoal then
				ST.pendingFlash = { text = "OUR GOAL!!", color = Color3.fromRGB(80, 255, 120), t = tNow }
				print("[AI-Dive] ⚽ OUR GOAL!")
			else
				matchStats.conceded = matchStats.conceded + 1
				diveWatch.resolved = true
				ST.pendingFlash = { text = "GOAL...", color = Color3.fromRGB(255, 60, 60), t = tNow }
				print("[AI-Dive] 🥅 CONCEDED")
			end
		end
	end

	-- 9) 📡 PUBLISH STATE (HUD / billboard / zone)
	-- 🔄 RECOVER CUE: for 1s after a dive, remind the keeper to reposition
	-- before the rebound / second shot.
	local displayLabel = hudLabel
	if (tNow - CHARGE.lastDive) < 1.0 then
		displayLabel = "🔄 RECOVER"
	end
	stateInfo.active  = true
	stateInfo.dist    = distToGoalie
	stateInfo.speed   = math.floor(speed)
	stateInfo.tti     = timeToImpact
	stateInfo.dir     = direction
	stateInfo.label   = displayLabel
	stateInfo.color   = hudColor
	stateInfo.zoneOn  = (hudLabel:find("DIVE", 1, true) ~= nil) or (hudLabel:sub(1, 7) == "READING")
	stateInfo.rootPos = rootPos
	stateInfo.toLine  = goal and ((ballPos - goal.linePos):Dot(goal.normal)) or nil
	stateInfo.striker = strikerDist
	stateInfo.team    = myTeamLabel
	stateInfo.poss    = poss
	local attackerLabel = nil
	if profile then
		local mods = {}
		if profile.aerial then mods[#mods + 1] = "AERIAL" end
		if profile.barrage then mods[#mods + 1] = "BARRAGE" end
		attackerLabel = profile.label
		if #mods > 0 then attackerLabel = attackerLabel .. " (" .. table.concat(mods, "+") .. ")" end
	elseif attackerPlayer then
		local raw = styleNameByPlayer[attackerPlayer]
		if raw then attackerLabel = string.upper(raw) end -- unknown style: show raw name
	end
	stateInfo.attacker = attackerLabel
	stateInfo.mode     = activeMode and activeMode.name or nil
	stateInfo.charged  = charged and CHARGE.style or nil
	stateInfo.side     = MOVE.side
	stateInfo.band     = distBand(distToGoalie)
	stateInfo.shoot   = shootChance
	stateInfo.sideL   = sideL
	stateInfo.sideR   = sideR
	stateInfo.commit  = math.floor(commitDist)
	stateInfo.power   = math.floor(predSpeed)

	updateBillboard()
	updateZone()
	updateStyleTags() -- self-throttled to 0.5s: new joiners + style changes
	updateHud(hudLabel ~= lastHudLabel)
	lastHudLabel = hudLabel
end

local lastErrReport = 0
local errCount = 0
RunService.Heartbeat:Connect(function(deltaTime)
	-- 🛡️ The loop is pcall-guarded: a single nil reference mid-frame can
	-- never kill the whole script. The FIRST THREE errors are always printed
	-- (so you can see what broke), then throttled to one per 5 seconds.
	local ok, err = pcall(mainStep, deltaTime)
	if not ok then
		errCount = errCount + 1
		if errCount <= 3 or (os.clock() - lastErrReport) > 5 then
			lastErrReport = os.clock()
			print("[Auto-Dive] ❌ LOOP ERROR #" .. errCount .. ": " .. tostring(err))
			warn("[Auto-Dive] loop error: " .. tostring(err))
		end
	end
end)

-- ==========================================
-- BOOT
-- ==========================================
setupVisuals()
createHud()
createBillboard()
createZone()
scanBall()
scanCharacters()
updateStyleTags()
updateHud(true)
print(string.format("[Auto-Dive] ⚡ Zero-Latency AI Engine Active! (v2.43 Fake Killer + Weak-Center Catch | net: bar %ds / %ds wide) ⚡",
	CONFIG.NET_CROSSBAR_STUDS, CONFIG.NET_WIDTH_STUDS))
