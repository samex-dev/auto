-- 🎛️ v2.82 THE ADAPTIVE CLOCK. The windows this script thinks in were tuned
-- on a healthy desktop; a 25 fps phone samples the world in stuttering
-- chunks and a 400 ms link delivers a ball that left the foot half a second
-- ago. Both make the same tuned window convict fakes that were strikes and
-- commit to where the ball WAS. So the clock measures — ping off
-- getNetworkPing, the alert→motion gap off the shot credit, fps off the
-- paint governor — and returns ONE scale applied at every time window.
ST.clock = (function()
	local c = CONFIG
	return {
		scale = function(self, now)
			if not c.ADAPTIVE_CLOCK then return 1 end
			local frame = math.floor((now or 0) * 60)
			if self.frame == frame and self.s then return self.s end
			local pingMs = getNetworkPing() * 1000
			local linkMs = math.max(pingMs, (ST.netLag or 0) * 1000)
			local lagT = math.clamp(linkMs / 1000 / c.CLOCK_LAG_MAX, 0, 1)
			local fps = ST.fpsAvg or 60
			local frameT = fps >= c.CLOCK_FPS_LOW and 0
				or math.clamp((c.CLOCK_FPS_LOW - fps) / math.max(1, c.CLOCK_FPS_LOW - c.CLOCK_FPS_FLOOR), 0, 1)
			local s = math.clamp(1 + 0.5 * lagT + 0.2 * frameT, c.CLOCK_MIN, c.CLOCK_MAX)
			self.s, self.frame = s, frame
			if math.abs(s - (self.last or 1)) > 0.08 and (now or 0) - (self.logT or -1e9) > 12 then
				self.last, self.logT = s, now or 0
				log(string.format("🎛️ ADAPTIVE — link ~%.0f ms · ~%.0f fps · windows ×%.2f — the keeper breathes with the device",
					linkMs, fps, s), true)
			end
			return s
		end,
		sampleLag = function(self, lag)
			if type(lag) == "number" and lag >= 0 and lag < 1.5 then
				ST.netLag = (ST.netLag or 0) * (1 - c.CLOCK_SAMPLE) + lag * c.CLOCK_SAMPLE
			end
		end,
	}
end)()

-- 📈 v2.80 THE MAN LEDGER — everything a named opponent has done to this
-- keeper, counted per name, decaying slowly, read BEFORE the next strike. It
-- lives on ST (like ST.bait, ST.keeperState) rather than on new locals: the
-- frame function is near Lua's upvalue wall (60/60 — no new file-scoped names
-- may be referenced from inside it), so every hook into the loop is a SINGLE
-- line calling into this object.
ST.prof = (function()
	local c = CONFIG.PROFILE
	local P = { p = {}, car = {}, pend = {}, tickAt = 0, lastH = nil }
	local function row(k)
		local pr = P.p[k]
		if not pr then
			pr = { key = k, shots = 0, spAvg = 0, distAvg = 0, drib = 0,
				touch = 0, pass = 0, box = 0, swings = 0, saved = 0, conceded = 0,
				cR = 0, cL = 0, cM = 0, cls = nil, clsT = 0 }
			P.p[k] = pr
		end
		return pr
	end
	-- a shot attempt was just CREDITED to `who` (hooked at the still→motion
	-- attribution, BEFORE the release gate — a baiter's quit-shots are part of
	-- HIS pattern too). It only enters the ledger once it ages un-cancelled:
	-- a two-frame tap that never left the foot is footwork, not a shot.
	function P:arm(who, spd, dist, now)
		if not who then return end
		local pd = P.pend[who]
		if pd then
			if now - pd.t0 < 0.25 then
				-- same man, one blink apart: the double-count is ONE shot with
				-- a hotter speed, not two
				pd.speed = math.max(pd.speed or 0, spd or 0)
				pd.dist  = math.max(pd.dist or 0, dist or 0)
				return
			end
			-- his last attempt is old enough to stand on its own: settle it
			-- into the ledger BEFORE the new arm replaces the pending slot —
			-- the per-frame flush only reaches the pending while the shooter is
			-- still attributed, and mid-flight he is NOT (a ball far from
			-- every man clears the attribution; the feed's flush would starve)
			if now - pd.t0 >= c.arm then P:flush(who, now) end
		end
		P.pend[who] = { t0 = now, speed = spd, dist = dist }
	end
	function P:flush(who, now)
		if not who then return end
		local pd = P.pend[who]
		if not pd then return end
		if now - pd.t0 < c.arm then return end
		P.pend[who] = nil
		local pr = row(who)
		local cnt = pr.shots + 1
		pr.spAvg = ((pr.spAvg * pr.shots) + (pd.speed or 0)) / cnt
		pr.distAvg = ((pr.distAvg * pr.shots) + (pd.dist or 0)) / cnt
		pr.shots = cnt
		pr.touch = pr.touch + 1
	end
	-- a carry segment: the frame loop names who HAS the ball right now
	-- (speed under DRIBBLE_MAX, within the carrier radius). Open on first
	-- frame; track how deep it gets; feed() closes it when it goes stale.
	function P:carrier(name, dGoal, now)
		if not name then return end
		local cd = P.car[name]
		if not cd then
			cd = { t = now, last = now, box = false }
			P.car[name] = cd
			row(name).touch = row(name).touch + 1
		end
		cd.last = now
		if dGoal < c.boxDist then cd.box = true end
	end
	-- the handler flip at the attack side: whoever HELD before the flip just
	-- passed it — the only pass telemetry that exists without a humanoid
	-- physically carrying (a loose ball ping-pong never flips the handler).
	function P:handle(name, now)
		local prev = P.lastH
		if prev ~= nil and name ~= nil and prev ~= name then
			row(prev).pass = row(prev).pass + 1
			row(name).touch = row(name).touch + 1
		end
		P.lastH = name
	end
	-- 🎭 v2.81: a named SWING that never moved the ball — footwork theatre,
	-- banked against the man. Not a shot (the ball stayed dead), but it IS a
	-- touch, and a fake-artist's touches are mostly theatre: the share bars
	-- read him honest with the swing counted as a touch, not as fire.
	function P:swing(who, now)
		if not who then return end
		local pr = row(who)
		pr.swings = pr.swings + 1
		pr.touch = pr.touch + 1
	end
	-- 📈 v2.82 PATTERN LEAD: the corner a shot was AIMED at (the predicted
	-- crossing that reaches the line), banked per name. Three corners in the
	-- same house is a habit — the stance consults it before the crossing
	-- promises it.
	function P:corner(who, side)
		if not who then return end
		local pr = row(who)
		if side == "R" then pr.cR = (pr.cR or 0) + 1
		elseif side == "L" then pr.cL = (pr.cL or 0) + 1
		else pr.cM = (pr.cM or 0) + 1 end
	end
	-- 🚀 v2.83 TRAJECTORY 3.0 — THE CONCESSION BANK: the corner ledger counts
	-- where a man AIMS; the bank counts where he BEATS us. Aim and result are
	-- different books: a man who aims right 70% of the time but only scores
	-- left is telling the keeper the read is right and the DIVE is wrong —
	-- which is a different fix. perCorner(side) returns the split so the
	-- heartbeat (and any future correction) can see the leak.
	function P:bank(who, side, scored)
		if not who then return end
		local pr = row(who)
		if side == "R" then
			pr.bR = (pr.bR or 0) + 1
			if scored then pr.bRs = (pr.bRs or 0) + 1 end
		elseif side == "L" then
			pr.bL = (pr.bL or 0) + 1
			if scored then pr.bLs = (pr.bLs or 0) + 1 end
		else
			pr.bM = (pr.bM or 0) + 1
			if scored then pr.bMs = (pr.bMs or 0) + 1 end
		end
	end
	function P:leak(who)
		if not who then return nil, 0 end
		local pr = P.p[who]
		if not pr then return nil, 0 end
		local worst, worstSide, tot, scored = 0, nil, 0, 0
		for _, s in ipairs({ "R", "L", "M" }) do
			local n, sc = (pr["b" .. s] or 0), (pr["b" .. s .. "s"] or 0)
			tot, scored = tot + n, scored + sc
			if sc > worst then worst, worstSide = sc, s end
		end
		if tot < 3 or worst < 2 then return nil, 0 end
		return worstSide, worst / tot
	end
	-- ⚠️ FORWARD DECLARATION: `classify` is defined at the BOTTOM of this
	-- module, but P:classOf (below) calls it. `local function classify(pr)` is
	-- sugar for `local classify; classify = function...` — the binding only
	-- exists from that line onward, so a call from EARLIER in the module
	-- resolved to the GLOBAL classify, which is nil. That was a per-frame
	-- "attempt to call a nil value" in the live console (LOOP ERROR, frame
	-- killed). The local is declared HERE and ASSIGNED at the bottom.
	local classify
	-- 🪤 v2.83 readers for the bait 3.0 tiers: the BOMB class (a man
	-- whose real shot is a bomb — the power style tag is the strong read, the
	-- ledger's high mean speed is the weak one) and the row/class accessors.
	function P:powerClass(key)
		local pr = self.p[key]
		return pr ~= nil and pr.shots >= 2.5 and pr.spAvg >= 55 -- 2.5: the count decays; 3 read at the next strike is 2.9
	end
	function P:rowOf(key)
		return self.p[key]
	end
	function P:classOf(key)
		local pr = self.p[key]
		if not pr then return nil end
		if not pr.cls then pr.cls = classify(pr) end
		return pr.cls
	end
	function P:pattern(who)
		if not who then return nil end
		local pr = P.p[who]
		if not pr then return nil end
		local n = (pr.cR or 0) + (pr.cL or 0) + (pr.cM or 0)
		if n < 2 then return nil end
		local best, bestSide = 0, nil
		if (pr.cR or 0) > best then best, bestSide = pr.cR, "R" end
		if (pr.cL or 0) > best then best, bestSide = pr.cL, "L" end
		if (pr.cM or 0) > best and bestSide == nil then best, bestSide = pr.cM, "M" end
		if bestSide and best / n >= 2 / 3 then return bestSide, best / n end
		return nil
	end
	-- the ledger's own consequences, kept next to the class it produced:
	function P:result(scored, who)
		if not who then return end
		local pr = row(who)
		if scored then pr.conceded = pr.conceded + 1 else pr.saved = pr.saved + 1 end
	end
	-- ⬆️ forward-declared above (see the note at P:powerClass) — ASSIGN, do not
	-- redeclare: a second `local function classify` would make a NEW local that
	-- shadows this one and P:classOf would see nil again.
	classify = function(pr)
		if pr == nil then return nil end
		local shots = math.floor(pr.shots + 0.5)
		local t = math.floor(pr.touch)
		if shots >= c.minShot and shots / (t + 1) >= c.shotShare then
			return pr.distAvg >= c.sniperDist and "SNIPER" or "FINISHER"
		end
		if t >= c.minTouch and pr.drib / (t + 1) >= c.dribShare then
			-- carries that REACH our third are a threat; carries that circle
			-- the halfway line are a fullback doing a fullback's job
			if pr.box / math.max(1, pr.drib) > c.dribBoxShare then
				return "DRIBBLER"
			end
		end
		if t >= c.fbTouch and shots == 0
			and pr.box / math.max(1, t) <= c.fbBoxShare then
			return "FULLBACK"
		end
		return nil
	end
	function P:tick(now)
		-- a tick is a fair moment to settle aged pendings: a streak that
		-- PAUSES still shows its true count at the next beat
		for k in pairs(P.pend) do P:flush(k, now) end
		for _, pr in pairs(P.p) do
			pr.shots, pr.drib, pr.pass, pr.box, pr.swings =
				pr.shots * c.decay, pr.drib * c.decay,
				pr.pass * c.decay, pr.box * c.decay, pr.swings * c.decay
			pr.touch = pr.touch * c.decay
			local cls = classify(pr)
				if cls ~= pr.cls and (now - pr.clsT) >= c.logGap then
				pr.cls, pr.clsT = cls, now
				if cls then
					log(string.format("📈 PROFILE %s — %s · %d shots av %.0f/s from %.0f studs · %.1f/min · %d dribbles · %d passes · %d swings · %d%% in our third · %d saved, %d conceded",
						tostring(pr.key):upper():sub(1, 12), cls,
						math.floor(pr.shots + 0.5),
						pr.shots > 0 and pr.spAvg or 0,
						pr.shots > 0 and pr.distAvg or 0,
						pr.shots * 60 / math.max(1, now),
						math.floor(pr.drib + 0.5), math.floor(pr.pass + 0.5),
						math.floor(pr.swings + 0.5),
						math.floor(100 * pr.box / math.max(1, pr.touch) + 0.5),
						pr.saved, pr.conceded), true)
				end
			end
		end
	end
	-- every ball-state frame: flush the armed shot when it ages, close stale
	-- carrier segments, keep the pending strike's live speed warm, tick.
	function P:feed(now)
		local shooter = lastShooterPlayer and lastShooterPlayer.Name
		if shooter then
			P:flush(shooter, now)
			local pd = P.pend[shooter]
			if pd and ST.commitDir ~= nil then
				-- the commit is riding on this flight: keep the estimate hot
				pd.speed = math.max(pd.speed or 0, ST.smoothedSpeed or 0)
			end
		end
		for nm, cd in pairs(P.car) do
			if now - cd.last > 0.15 then
				local pr = P.p[nm]
				if pr then
					-- a quarter-second of continuous carry is a dribble; a
					-- one-frame graze on the bounce is not
					if cd.last - cd.t >= 0.25 then pr.drib = pr.drib + 1 end
					if cd.box then pr.box = pr.box + 1 end
				end
				P.car[nm] = nil
			end
		end
		if now >= P.tickAt then
			P.tickAt = now + c.tick
			P:tick(now)
		end
	end
	-- thrust adjustment for a shot about to be committed: the ledger nudges
	-- the physics' own knob, never the rules themselves
	function P:thrust(who)
		if not who then return nil end
		local pr = P.p[who]
		if not pr or not pr.cls then return nil end
		if pr.cls == "SNIPER" then return c.mSniper end
		if pr.cls == "FINISHER" then return c.mFinisher end
		if pr.cls == "DRIBBLER" then return c.mDrib end
		if pr.cls == "FULLBACK" then return c.mDef end
		return nil
	end
	-- is this man's spike the kind we now distrust while it is still one
	-- frame old? (a classified DRIBBLER's, exactly like a baiter's)
	function P:gated(who)
		if not who then return false end
		local pr = P.p[who]
		return (pr ~= nil and pr.cls == "DRIBBLER") and true or false
	end
	return P
end)()

-- 🧠 v2.83 MATCH SENSE — everything about the MATCH that is not the ball.
-- The ball readers answer "where is it going"; these answer "what kind of
-- moment is this", and a keeper who cannot tell a corner from a counter is
-- playing the same second of football over and over. Every read is a single
-- method fed by ONE line from the frame loop (the loop is at Lua's 60-upvalue
-- ceiling — the module lives on ST for exactly that reason). Nothing here
-- invents a game number: distances are measured against the goal geometry
-- the script already resolved, and thresholds are keeper-side choices.
ST.sense = (function()
	local S = { t0 = os.clock(), conceded = 0, saved = 0, streak = 0, lastGoalT = -1e9 }
	-- (1) MATCH CLOCK: minutes elapsed since the script booted. Not a game
	-- claim (the script cannot see the match timer) — it is OUR clock, and it
	-- is what makes the late-game reads below possible at all.
	function S:clock() return os.clock() - self.t0 end
	-- (2) SCORE STATE: are we ahead, level, or chasing? A keeper protects a
	-- lead differently from how he chases a goal — same save, different risk.
	function S:state()
		local d = self.saved - self.conceded
		if self.conceded == 0 and self.saved == 0 then return "LEVEL", 0 end
		return (d > 0 and "AHEAD") or (d < 0 and "BEHIND") or "LEVEL", d
	end
	-- (3) TILT METER: consecutive concessions, and how fresh the last one is.
	-- A keeper who has just been beaten twice is not a worse keeper, but he
	-- IS one who must not start guessing — the read reverts to the strict
	-- middle discipline until a save resets the streak.
	function S:tilt()
		local fresh = (os.clock() - self.lastGoalT) < 20
		return self.streak, fresh
	end
	function S:onConceded() self.conceded = self.conceded + 1; self.streak = self.streak + 1; self.lastGoalT = os.clock() end
	function S:onSaved()    self.saved = self.saved + 1; self.streak = 0 end
	-- (4) PRESSURE COUNT: how many opponents are inside our third right now.
	-- One man in our third is a break; four is a siege, and a siege is exactly
	-- when the second ball decides the match.
	function S:pressure(roots, myGoal)
		if not myGoal then return 0 end
		local n = 0
		for _, r in ipairs(roots or {}) do
			if r and r.Position then
				local d = (r.Position - myGoal).Magnitude
				if d < 40 then n = n + 1 end
			end
		end
		return n
	end
	-- (5) SET PIECE: a dead ball with a WALL of opponents standing off it. The
	-- shot that comes out of it is blocked, deflected and rebounded far more
	-- often than a strike from open play — the keeper holds a beat longer.
	function S:setPiece(ballSpeed, nearCount)
		return ballSpeed < 6 and (nearCount or 0) >= 3
	end
	-- (6) BACK PASS: the ball travelling AWAY from the opposition goal from
	-- our own man's foot is a pass back, never a shot. Diving at it is the
	-- own goal every keeper fears.
	function S:backPass(approachSpeed, ownTouch)
		return ownTouch == true and approachSpeed < -2
	end
	-- (7) SHOOTING ANGLE: how wide the striker's angle to the goal mouth is.
	-- Measured from the goal's own geometry (the posts the script resolved),
	-- never assumed — an angle is a fact about the positions, not a number
	-- anyone published.
	function S:angle(ballPos, goal)
		if not goal then return nil end
		local toBall = ballPos - goal.linePos
		local along = math.max(1, toBall:Dot(goal.normal))
		local lat = toBall:Dot(goal.axis)
		-- Apparent goal width: how much of the striker's view the mouth
		-- fills (mouth / range), plus how far off-axis he is standing.
		-- Deliberately TRIG-FREE: Lua 5.4 dropped math.atan2 while Luau
		-- kept it, and this script has to run on both — so the read is a
		-- ratio, not an angle in degrees. Same ordering, no dependency.
		return (goal.halfWidth * 2) / along, lat / along
	end
	-- (8) NEAR POST: which post the ball is closer to. At a tight angle the
	-- near post is the percentage finish (there is more goal to miss than to
	-- hit at the far one), so the near post is the side worth shading.
	function S:nearPost(ballPos, goal)
		if not goal then return nil end
		local d = (ballPos - goal.linePos):Dot(goal.axis)
		return d >= 0 and "R" or "L"
	end
	-- (9) SHADE LINE: where the keeper should STAND, not dive — bisecting the
	-- angle to the ball cuts the shooter's visible goal. This is positioning,
	-- the cheapest save there is, and it is what makes every dive shorter.
	function S:shade(ballPos, goal, frac)
		if not goal then return nil end
		local f = frac or 0.35
		local toBall = (ballPos - goal.linePos)
		local lat = toBall:Dot(goal.axis)
		local along = math.max(0, toBall:Dot(goal.normal))
		local want = math.clamp(lat * f, -goal.halfWidth, goal.halfWidth)
		return want, along
	end
	-- (10) SECOND BALL: a loose ball in the box within a few seconds of a
	-- save is the rebound no one has claimed. The keeper who stayed down is
	-- the keeper who concedes the tap-in.
	function S:secondBall(now, ballSpeed, distToGoalie)
		return (now - self.lastGoalT) < 8 and ballSpeed < 25 and (distToGoalie or 99) < 22
	end
	-- (11) CHAOS: a crowd around the ball. Crowds produce deflections, and a
	-- deflection is a shot with no name on it — the keeper's read must come
	-- from the ball, never from the man.
	function S:chaos(nearCount) return (nearCount or 0) >= 4 end
	-- (16) ONE-ON-ONE: one attacker carrying it at the keeper with nothing
	-- between them. The only situation where narrowing the ANGLE is worth
	-- more than holding the line — and the only one where the keeper is
	-- allowed to come off it. Requires the nearest opponent to be close to
	-- the ball AND the keeper to still have ground in front of him.
	function S:oneOnOne(oppNearBall, distToGoalie)
		return (oppNearBall or 99) <= 6 and (distToGoalie or 0) < 30 and (distToGoalie or 0) > 8
	end
	-- (17) COUNTER: the ball turned over deep in our half while the other
	-- team is still committed forward. The first ball out of a counter is
	-- the most dangerous pass in football, and it is aimed at a runner, not
	-- at goal — so the keeper holds his line instead of chasing the carrier.
	function S:counter(ballDepth, pressureCount)
		return (ballDepth or 0) < 45 and (pressureCount or 0) >= 3
	end
	-- (12) LATE GAME: past 3 minutes of our own clock with a one-goal game,
	-- every 50/50 becomes a moment to protect rather than to win. Strict
	-- discipline, no guessing.
	function S:lateGame()
		local st, d = self:state()
		return self:clock() > 180 and math.abs(d or 0) <= 1, st
	end
	-- (13) SHUTOUT: still unbroken this match. Worth protecting properly —
	-- and worth saying out loud once, because a clean sheet is the only
	-- goalkeeping stat that ends a match undefeated.
	function S:shutout() return self.conceded == 0 and self.saved > 0 end
	-- (14) WORKLOAD: shots faced per minute — the number that tells a keeper
	-- whether he is under siege or under-used, and whether his reads are
	-- being tested at all tonight.
	function S:workload()
		local m = self:clock() / 60
		if m < 0.1 then return 0 end
		return (self.conceded + self.saved) / m
	end
	-- (15) FORM: save rate across the match. A keeper below 50% is not unlucky,
	-- he is being beaten by something specific — the ledger is where to look.
	function S:form()
		local n = self.conceded + self.saved
		if n < 3 then return nil end
		return self.saved / n
	end
	return S
end)()

-- ==========================================
-- 🔮 v2.84 GK MOVE PREDICTION 2.0 — the keeper's own crystal ball.
--
-- (user: "make a better GK move prediction — the GK move prediction 2.0
-- will have looks at what position you are currently and also predicts
-- where you will go next")
--
-- v2.44 already extrapolated the KEEPER toward the ball's ETA from a raw
-- position delta (aimPos). 2.0 is the whole picture instead of one vector:
--
--   WHERE YOU ARE       keeper position, velocity, ACCELERATION, and state
--                       (set / moving / recovering / diving)
--   WHERE YOU'RE GOING  predicted keeper position at any horizon, and
--                       whether a given point is REACHABLE in time
--   WHERE HE IS         every opponent's measured position and velocity
--   WHERE HE'S GOING    predicted opponent position at any horizon
--   WHAT HAPPENS NEXT   an INTENT read — shot / pass / carry / cross / clear
--                       — blended from live geometry AND that man's own
--                       ledger habits (what he has actually done tonight)
--
-- Nothing here invents a game number. Velocities are measured, the reach
-- cap is the keeper's own configured speed, and the intent weights are the
-- script's CONFIDENCE, not a claim about what the game will do.
-- ==========================================
ST.mp = (function()
	local M = {
		k = { pos = nil, vel = nil, acc = nil, t = 0, lastV = nil, lastT = 0 },
		opp = {},                                   -- name -> { pos, vel, t }
		last = { shot = 0, pass = 0, carry = 0, cross = 0, clear = 0, back = 0 },
		mix = { shot = 0, pass = 0, carry = 0, cross = 0, clear = 0, back = 0 },
		top = nil, topT = -1e9, hold = nil, holdN = 0,
		tgtName = nil, tgtT = -1e9, tgtPos = nil,
	}
	local TP = 80          -- studs/s beyond which a "move" is a respawn, not motion
	-- ⚠️ TRAP, and it has bitten twice: every value the predictor publishes is
	-- stored as a FIELD on this same table that also holds the METHODS. Naming
	-- a stored value after a method (`ST.mp.threat = ...`, `ST.mp.trend = ...`)
	-- silently REPLACES the method with a number, and the next frame dies with
	-- "attempt to call a number value". Stored values therefore carry a
	-- distinct suffix (threatV, offLineV, trendV, ...) — check your name
	-- against the method list before adding one. tools/lint.py enforces it.
	local function v3() return Vector3.zero end
	local function clamp01(x) return x < 0 and 0 or (x > 1 and 1 or x) end

	-- (1) KEEPER OBSERVE: record where the keeper is, and derive velocity
	-- and ACCELERATION from it. Teleport-guarded: a respawn must never be
	-- read as 800 studs/s of keeper motion.
	function M:observeKeeper(pos, now)
		local k = self.k
		if k.pos and k.t > 0 then
			local dt = now - k.t
			if dt > 0.02 then
				local d = (pos - k.pos).Magnitude
				if d < dt * TP then
					local v = (pos - k.pos) / dt
					if k.vel then k.acc = (v - k.vel) / dt end
					k.vel = k.lastV and (k.lastV + (v - k.lastV) * 0.5) or v
					k.lastV = v
				end
			end
		end
		k.pos, k.t = pos, now
	end
	-- (2) KEEPER VELOCITY / (3) SPEED
	function M:keeperVel() return self.k.vel end
	function M:keeperSpeed() return self.k.vel and self.k.vel.Magnitude or 0 end
	-- (4) KEEPER AT +dt — where the keeper WILL BE, with acceleration
	-- carried into the horizon (v2.44 used a flat velocity only).
	function M:keeperAt(dt)
		local k = self.k
		if not k.pos then return nil end
		if not k.vel then return k.pos end
		local a = k.acc or v3()
		return k.pos + k.vel * dt + a * (0.5 * dt * dt)
	end
	-- (5) KEEPER STATE: what the keeper is doing right now. A keeper
	-- mid-recovery cannot reach the same ball as a set one, and every
	-- reachability answer below has to know which he is.
	function M:keeperState(now, lastDiveT, cooldownUntil)
		if lastDiveT and (now - lastDiveT) < 0.35 then return "DIVING" end
		if cooldownUntil and now < cooldownUntil then return "RECOVERING" end
		if self:keeperSpeed() > 4 then return "MOVING" end
		return "SET"
	end
	-- (6) OPPONENT OBSERVE — one entry per man, measured.
	function M:observeOpponent(name, pos, vel, now)
		if not name then return end
		local e = self.opp[name]
		if not e then e = {}; self.opp[name] = e end
		e.pos, e.vel, e.t = pos, vel, now
	end
	-- (7) OPPONENT AT +dt — where HE will be (8) OPPONENT VELOCITY
	function M:atOpponent(name, dt)
		local e = self.opp[name]
		if not e or not e.pos then return nil end
		if not e.vel then return e.pos end
		return e.pos + e.vel * dt
	end
	function M:opponentVel(name)
		local e = self.opp[name]
		return e and e.vel or nil
	end
	-- (9) CLOSING RATE — is this man advancing on our goal or retreating?
	function M:closing(name, goal)
		local e = self.opp[name]
		if not e or not e.vel or not goal then return 0 end
		return -e.vel:Dot(goal.normal)
	end
	-- (10) SPACE AHEAD — how much unoccupied ground he has toward our goal.
	-- A carrier with a road in front of him is a carry; one walled in is a
	-- pass or a shot.
	function M:spaceAhead(name, goal, roots, myKey, teamOf)
		local e = self.opp[name]
		if not e or not e.pos or not goal then return 0 end
		local dir = -goal.normal
		local best = 60
		for _, r in ipairs(roots or {}) do
			if r.player and teamOf(r.player) ~= myKey and r.root then
				local rel = r.root.Position - e.pos
				local along = rel:Dot(dir)
				if along > 1 and along < best then
					local lat = (rel - dir * along).Magnitude
					if lat < 6 then best = along end
				end
			end
		end
		return best
	end
	-- (11) SUPPORT — how many team-mates sit in his passing cone. Zero
	-- options in front of a goal is a shot; three is a pass.
	function M:support(ballPos, roots, myKey, teamOf, dir)
		local n = 0
		for _, r in ipairs(roots or {}) do
			if r.player and r.root and teamOf(r.player) ~= myKey then
				local rel = r.root.Position - ballPos
				local d = rel.Magnitude
				if d > 3 and d < 45 then
					if rel:Dot(dir) / d > 0.3 then n = n + 1 end
				end
			end
		end
		return n
	end
	-- (12) OPENNESS — how much of the mouth he can actually see from there.
	function M:openness(ballPos, goal)
		if not goal then return 0 end
		local to = goal.linePos - ballPos
		local d = math.max(1, to.Magnitude)
		return clamp01((goal.halfWidth * 2) / d)
	end
	-- (13) GEOMETRY WEIGHTS — the live half of the intent read.
	function M:weigh(goal, distToGoal, angleFrac, openness, support, space, closing)
		local w = { shot = 0, pass = 0, carry = 0, cross = 0, clear = 0, back = 0 }
		-- shot: close enough, mouth open, running out of road
		w.shot = clamp01((1 - distToGoal / 45)) * 0.6 + openness * 0.4
		if distToGoal < 22 then w.shot = w.shot + 0.25 end
		-- pass: options in the cone and not in the box yet
		w.pass = clamp01(support / 3) * 0.7 + (distToGoal > 30 and 0.2 or 0)
		-- carry: road ahead, not close enough to strike
		w.carry = clamp01(space / 40) * 0.6 + (distToGoal > 25 and 0.25 or 0)
		-- cross: wide and far
		w.cross = (1 - openness) * 0.5 + (distToGoal > 28 and 0.25 or 0)
		-- clear: deep in his own half with pressure
		w.clear = (distToGoal > 55 and support < 2) and 0.35 or 0
		-- back: moving away from our goal
		w.back = closing < -3 and 0.4 or 0
		for k in pairs(w) do
			w[k] = math.max(0, math.min(1, w[k] + (angleFrac or 0) * (k == "shot" and 0.15 or 0)))
		end
		self.last = w
		return w
	end
	-- (14) HABITS — the ledger half: what this man has actually DONE.
	function M:habits(prof, name)
		if not prof or not name then return nil end
		local pr = prof:rowOf(name)
		if not pr then return nil end
		local shots = pr.shots or 0
		local touch = math.max(1, pr.touch or 0)
		local drib = pr.drib or 0
		return {
			shot = clamp01(shots / math.max(2, touch) * 2),
			pass = clamp01((pr.pass or 0) / touch),
			carry = clamp01(drib / touch),
			cross = clamp01((pr.cR or 0) / math.max(1, shots) * 0.5),
			clear = 0, back = clamp01((pr.pass or 0) / math.max(1, touch) * 0.3),
		}
	end
	-- (15) BLEND — geometry x habits. Habits only ever NUDGE: the live
	-- picture is the evidence, the ledger is the prior, and a man who has
	-- passed all night still gets read as a shooter if he is 8 studs out
	-- with an open mouth and no options.
	function M:blend(prof, name)
		local g, h = self.last, self:habits(prof, name)
		local out = {}
		for _, k in ipairs({ "shot", "pass", "carry", "cross", "clear", "back" }) do
			out[k] = h and (g[k] * 0.7 + h[k] * 0.3) or g[k]
		end
		self.mix = out
		return out
	end
	-- (16) TOP INTENT — the winner and how much the read believes itself.
	function M:topIntent()
		local best, bestV = nil, 0
		local total = 0
		for _, k in ipairs({ "shot", "pass", "carry", "cross", "clear", "back" }) do
			local v = self.mix[k] or 0
			total = total + v
			if v > bestV then bestV, best = v, k end
		end
		local conf = total > 0 and (bestV / total) or 0
		return best, bestV, conf
	end
	-- (17) STABILITY — an intent that flips every frame is noise, not a
	-- prediction. Two agreeing frames make it the held read.
	function M:stable(now)
		local top = self.top
		if self.hold == top then self.holdN = self.holdN + 1
		else self.hold, self.holdN = top, 1 end
		return self.hold, self.holdN
	end
	-- (18) TARGET — the most likely receiver when the read is a pass.
	function M:target(ballPos, roots, myKey, teamOf, goal)
		if not goal then return nil end
		local best, bestS, bestP = nil, -1, nil
		for _, r in ipairs(roots or {}) do
			if r.player and r.root and teamOf(r.player) ~= myKey then
				local p = r.root.Position
				local rel = p - ballPos
				local d = rel.Magnitude
				if d > 3 and d < 45 then
					local adv = (-goal.normal):Dot(rel) / d        -- forward = good
					local s = adv * 0.6 + (1 - d / 45) * 0.4
					if s > bestS then bestS, best, bestP = s, r.player, p end
				end
			end
		end
		-- NOTE: never store this as self.target — that IS the method.
		self.tgtName, self.tgtT = best and best.Name or nil, os.clock()
		self.tgtPos = bestP
		return self.tgtName, bestP
	end
	-- (19) NEXT BALL — short-horizon ball position (gravity included).
	function M:nextBall(pos, vel, dt, gravity)
		local g = gravity or 0
		return pos + vel * dt + Vector3.new(0, -0.5 * g * dt * dt, 0)
	end
	-- (20) INTERCEPT RACE — who reaches the ball first, keeper or man?
	function M:race(ballPos, ballVel, keeperPos, oppPos, keeperSpeed, oppSpeed)
		local function tTo(a, b, s)
			local d = (b - a).Magnitude
			return d / math.max(1, s)
		end
		local tK = tTo(keeperPos, ballPos, keeperSpeed)
		local tO = tTo(oppPos, ballPos, oppSpeed)
		return tK, tO, (tK < tO)
	end
	-- (21) REACHABLE — can the keeper get from A to B inside dt?
	function M:reachable(from, to, dt, speedCap)
		if not from or not to then return false end
		local d = (to - from).Magnitude
		return d <= math.max(1, speedCap) * math.max(0, dt)
	end
	-- (22) THREAT — one number: how dangerous is this possession right now.
	function M:threat(distToGoal, speed, openness, intentConf)
		local near = clamp01(1 - distToGoal / 50)
		local fast = clamp01(speed / 120)
		return clamp01(near * 0.45 + fast * 0.25 + openness * 0.2 + (intentConf or 0) * 0.1)
	end
	-- (23) PRESSURE — how many opponents are near the ball.
	function M:pressure(ballPos, roots, myKey, teamOf, radius)
		local n, r2 = 0, (radius or 8) * (radius or 8)
		for _, r in ipairs(roots or {}) do
			if r.player and r.root and teamOf(r.player) ~= myKey then
				local d = r.root.Position - ballPos
				if d:Dot(d) <= r2 then n = n + 1 end
			end
		end
		return n
	end
	-- (24) FACING — is he looking at our goal or away from it?
	function M:facing(name, goal)
		local e = self.opp[name]
		if not e or not e.vel or not goal then return 0 end
		local v = e.vel
		if v.Magnitude < 1 then return 0 end
		return (-goal.normal):Dot(v) / v.Magnitude
	end
	-- (25) CORNER — which corner the read is pointing at.
	function M:corner(crossLateral, centerTol)
		if not crossLateral then return "M" end
		if crossLateral > (centerTol or 2.4) then return "R" end
		if crossLateral < -(centerTol or 2.4) then return "L" end
		return "M"
	end
	-- (26) POWER CLASS — how hard the predicted strike would be.
	function M:power(speed, bombAt)
		if speed >= (bombAt or 130) then return "BOMB" end
		if speed >= 80 then return "HARD" end
		if speed >= 45 then return "FIRM" end
		return "SOFT"
	end
	-- (27) OFF-LINE — how far the keeper is from his own goal centre line.
	function M:offLine(keeperPos, goal)
		if not goal then return 0 end
		return math.abs((keeperPos - goal.linePos):Dot(goal.axis))
	end
	-- (28) SUMMARY — the one line that says what the prediction believes.
	function M:summary()
		local top, v = self.top, self.mix[self.top or "shot"] or 0
		return string.format("%s %.0f%%%s", tostring(top):upper(), (v or 0) * 100,
			self.tgtName and (" → " .. tostring(self.tgtName)) or "")
	end
	-- (29) LANE — is the passing lane to a man actually open? A receiver you
	-- cannot reach is not an option, whatever the geometry says.
	function M:lane(from, to, roots, myKey, teamOf, radius)
		if not from or not to then return false end
		local seg = to - from
		local len = seg.Magnitude
		if len < 0.001 then return true end
		local u = seg / len
		local lim = radius or 3
		for _, r in ipairs(roots or {}) do
			if r.player and r.root and teamOf(r.player) == myKey then
				local rel = r.root.Position - from
				local along = rel:Dot(u)
				if along > 1 and along < len then
					if (rel - u * along).Magnitude < lim then return false end
				end
			end
		end
		return true
	end
	-- (30) DIVE WINDOW — how much longer the keeper can still decide. The
	-- hardest thing to feel in goal is time running out, so it gets a number.
	function M:diveWindow(tti, reaction)
		return math.max(0, (tti or 0) - (reaction or 0.12))
	end
	-- (31) RECOVER IN — seconds until the keeper is armed again.
	function M:recoverIn(now, cooldownUntil)
		return math.max(0, (cooldownUntil or 0) - now)
	end
	-- (32) SECOND — where the receiver would go NEXT. One pass ahead is
	-- guesswork; two is a plan, and it is what lets the keeper shade early.
	function M:second(name, dt)
		return self:atOpponent(name, dt or 1.2)
	end
	-- (33) BOUNCE — predicted height when the ball lands. A ball that sits up
	-- is a catch; one that skids is a dive.
	function M:bounce(pos, vel, gravity, restY)
		local g = gravity or 196.2
		local vy, y = vel.Y, pos.Y - (restY or 0)
		local disc = vy * vy + 2 * g * y
		if disc <= 0 then return nil, 0 end
		local t = (vy + math.sqrt(disc)) / g
		return t, (pos + vel * t - Vector3.new(0, 0.5 * g * t * t, 0)).Y
	end
	-- (34) MOUTH — the goal-relative lateral of a point: which side of the
	-- goal it belongs to, in studs, from the keeper's own frame.
	function M:mouth(point, goal)
		if not goal or not point then return 0 end
		return (point - goal.linePos):Dot(goal.axis)
	end
	-- (35) KEEPER BIAS — which way the keeper is already travelling. A keeper
	-- moving the wrong way needs to start earlier than one already leaning in.
	function M:bias(goal)
		local v = self.k.vel
		if not v or not goal then return 0 end
		return v:Dot(goal.axis)
	end
	-- (36) SECOND-ORDER THREAT — how bad it gets if the read is a pass and
	-- the receiver takes it on. This is the number that says "shade now".
	function M:followThreat(name, goal)
		local p = self:atOpponent(name, 1.2)
		if not p or not goal then return 0 end
		local d = (p - goal.linePos).Magnitude
		return clamp01(1 - d / 50)
	end
	-- (37) SHOT SIDE — the striker's own body orientation, not the ball's.
	-- Which shoulder he is turned towards is the earliest cue there is.
	function M:shotSide(name, goal)
		local v = self:opponentVel(name)
		if not v or not goal then return "M" end
		local lat = v:Dot(goal.axis)
		if lat > 3 then return "R" end
		if lat < -3 then return "L" end
		return "M"
	end
	-- (38) CONFIDENCE — the read discounted by how little we actually know
	-- about this man. Three touches of ledger is an anecdote, not a habit.
	function M:confidence(prof, name)
		local _, _, conf = self:topIntent()
		local pr = prof and name and prof:rowOf(name)
		local touch = pr and (pr.touch or 0) or 0
		local weight = clamp01(touch / 12)
		return conf * (0.6 + 0.4 * weight)
	end
	-- (39) PRESSURE TREND — is the pressure on the carrier building or
	-- easing? Building pressure forces the error; easing pressure invites it.
	function M:trend()
		local p = self.pressV or 0
		local prev = self.pressPrev or p
		self.pressPrev = p
		return p - prev
	end
	-- (40) VERDICT — the whole read as one sentence for the console. Logs are
	-- the only channel to the user (per the v2.67 rule: no HUD paint), so the
	-- prediction has to be able to introduce itself in one line.
	function M:verdict()
		local top = self.top or "?"
		local conf = self.conf or 0
		local reach = self.canReach and "REACHABLE" or "OUT OF REACH"
		return string.format("%s %.0f%% — %s · keeper %s%s", tostring(top):upper(),
			conf * 100, reach, tostring(self.state),
			(self.tgtName and (" → " .. tostring(self.tgtName)) or ""))
	end
	return M
end)()



-- 🎭 v2.81 THE SWING READ — the animation announces; the ball testifies.
-- The game's skill effect appears (DescendantAdded — the same wiring the
-- counters ride) the frame a move's ANIMATION starts, shot or fake. A
-- shot-shaped announcement followed by a ball that never moved is footwork
-- theatre: the alert is VOIDED (the counter must not pre-dive at a ghost
-- shot), the man banks a bait episode (his tax and his gate upgrade
-- themselves), and the ledger counts a swing. The same watch hands the
-- backheel family the opposite favor: a NAMED tricky strike announces at the
-- kick, and its trust stamp keeps the soft-ball nets (fake bleed, bait
-- roller) from eating a real ~50/s heel flick — "IT NEVER SAVES BACKHEEL
-- SHOTS LIKE BRUH" ends here.
ST.swing = {}
function ST.swing:check(now, alert, episode)
	if alert and alert.t and self.at ~= alert.t then
		self.at = alert.t
		self.done = nil
		local s = alert.speed
		-- the v2.70 SNAP watchdog already bills snap-class swings (chop & co.)
		-- — the watch must not double-count the same air-punch
		local cm = COUNTER_MODES[alert.counterKey or alert.moveKey or ""]
		if cm and cm.snap then
			self.t0, self.done = nil, true
			return
		end
		-- shot-shaped rows only: dribble/steal/defense/cutscene announcements
		-- swing arms that never swing — no watch, no trust.
		if s == "extreme" or s == "fast" or s == "tricky" then
			self.t0 = alert.t
		else
			self.t0 = nil
		end
		if s == "tricky" or (alert.moveKey and tostring(alert.moveKey):find("backheel")) then
			-- the trust stamp keys on the man on the ball RIGHT NOW (the
			-- strike's own credit lands the same frame or a hair later)
			local bp = cachedBall and cachedBall.Position
			if bp then
				for _, e in ipairs(refreshPlayerRoots()) do
					if (e.root.Position - bp).Magnitude <= 12 then
						ST.trickyT, ST.trickyName = now, e.player.Name
						break
					end
				end
			end
		end
	end
	if self.t0 and not self.done then
		local v = estimateMotion()
		local sp = v and v.Magnitude or 0
		if sp <= CONFIG.SWING_DEAD then
			-- who is on it: the swing needs a NAME to bill
			local nm, key = nil, nil
			local bp = cachedBall and cachedBall.Position
			if bp then
				for _, e in ipairs(refreshPlayerRoots()) do
					if (e.root.Position - bp).Magnitude <= 10 then
						nm = e.player and e.player.Name
						key = teamKeyOf(e.player)
						break
					end
				end
			end
			if nm and now - self.t0 >= CONFIG.SWING_HOLD * ST.clock:scale(now) then
				self.done, self.t0 = true, nil
				ST.prof:swing(nm, now)
				if episode and key then episode(key, now) end
				log(string.format("🎭 SWING FAKE — %s played the shot animation (%s); the ball never moved — episode banked, the counter stays ready for the follow-up",
					tostring(nm):upper():sub(1, 12), tostring(alert and alert.move or "?")), true)
			end
		elseif sp >= CONFIG.SWING_DEAD + 14 then
			self.t0 = nil -- the swing MOVED something: a strike, judged by every other rule
		end
	end
end

