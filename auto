-- ==========================================
-- 📡 NETWORK OWNERSHIP — authoritative ball possession (v2.34)
-- When the server gives a player CONTROL of the ball (dribble/hold), that
-- player's character root becomes the ball part's NetworkOwner — a property
-- that replicates to clients, so we can READ who really owns the ball
-- instead of guessing from distance. This kills the two classic heuristic
-- failures: diving while a TEAMMATE owns the ball, and refusing to dive
-- (or diving late) when an OPPONENT owns it but a teammate happens to be
-- standing next to the ball. If the game ever leaves NetworkOwner nil,
-- the distance heuristics below take over exactly as before.
-- ==========================================
local function networkOwnerPlayer(ballPart)
	if not ballPart then return nil end
	local owner = nil
	local ok, o = pcall(function() return ballPart.NetworkOwner end)
	if ok then owner = o end
	if not owner then return nil end
	for _, plr in ipairs(Players:GetPlayers()) do
		local char = plr.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root == owner then return plr end
	end
	return nil
end

-- ==========================================
-- 🦘 TOP-BIN AUTO-JUMP (v2.37)
-- Community-observed mechanic: a keeper who JUMPS and then DIVES reaches
-- higher than a flat dive — that's how top-bin (top corner) balls get
-- saved. We reproduce it: when the predicted impact is high enough, fire
-- a local jump right before the dive fires. pcall-wrapped on both known
-- local jump methods (ChangeState = the standard local trick, Jump = the
-- server API many games still allow from LocalScripts) — if the game
-- restricts both, it's a clean no-op and the dive fires as before.
-- ==========================================
-- 📏 FALLBACK NET (v2.39): when the live post scan misses, the "top bin" is
-- still defined against the REAL net — the one measured pixel-for-pixel from
-- the keeper's own in-game screenshot (≈ 8 studs tall). A standing keeper's
-- root sits ~3 studs off the ground, so the net ABOVE the root ≈
-- crossbar - 3 = 5 studs; the top bin is the top 30% of THAT.
local function fallbackGoalHeightAboveRoot()
	return math.max(2, CONFIG.NET_CROSSBAR_STUDS - 3)
end

local lastAutoJump = 0
local function tryAutoJump(impactHeightAboveRoot, goalHeightAboveRoot)
	if not CONFIG.AUTO_JUMP_TOP_BIN then return false end
	-- 📏 DATA-DRIVEN TOP-BIN TEST: the fandom publishes no net dimensions,
	-- so the script measures the REAL in-game goal (crossbar height) at
	-- runtime. The "top bin" is defined against the ACTUAL measured net:
	-- jump when the predicted impact reaches a fraction of the real goal
	-- height. If the goal isn't detected, fall back to the screenshot-measured
	-- net (v2.39) instead of a blind fixed threshold.
	local goalH = (goalHeightAboveRoot and goalHeightAboveRoot > 2)
		and goalHeightAboveRoot
		or fallbackGoalHeightAboveRoot()
	local topBin = impactHeightAboveRoot >= (goalH * CONFIG.TOP_BIN_JUMP_FRACTION)
	if not topBin then return false end
	local now = os.clock()
	if now - lastAutoJump < CONFIG.AUTO_JUMP_COOLDOWN then return false end
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return false end
	local ok1 = pcall(function()
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	end)
	local ok2 = false
	if not ok1 then
		ok2 = pcall(function() humanoid:Jump() end)
	end
	if ok1 or ok2 then
		lastAutoJump = now
		print("[AI-Dive] 🦘 TOP-BIN JUMP (impact " .. string.format("%.1f", impactHeightAboveRoot)
			.. " studs up" .. (goalHeightAboveRoot and string.format(" / net %.1f", goalHeightAboveRoot) or "") .. ")")
		return true
	end
	return false
end

