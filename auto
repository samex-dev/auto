			hudRefs.line2.TextColor3 = stateInfo.color
		end
	end

	-- Big flash: SAVE!! / GOAL...
	if ST.pendingFlash and (t - ST.pendingFlash.t) < 1.4 then
		hudRefs.flash.Visible = true
		hudRefs.flash.Text = ST.pendingFlash.text
		hudRefs.flash.TextColor3 = ST.pendingFlash.color
	else
		hudRefs.flash.Visible = false
	end
end

