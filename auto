-- ==========================================
-- BALL TRACKER (event-driven, no re-scans)
-- ==========================================
local cachedBall   = nil
local lastBallScan = 0
-- v2.59 THE WALK DIET (third lag report). The bench kept saying "fast" while
-- the friend's phone said "lag" because the cost was never our Lua — it was
-- workspace:GetDescendants() marathons: the ball-lost fallback re-walked the
-- ENTIRE tree every 0.5 s (every kickoff, every restart) and the leaderboard
-- hunt walked four service trees twice each, every 2 s, FOREVER in a game with
-- no findable board. Each walk is milliseconds of ENGINE time on mobile.
-- Escalating backoffs now: misses double the wait, the DescendantAdded fast
-- path (untouched) makes rediscovery instant anyway.
local BALL_SCAN_WAITS = {0.5, 1, 2, 5}
local ballScanMiss = 0

-- Every built-in ball name contains "ball" (Ball, GK_Ball, soccer-ball,
-- matchball…), so the DescendantAdded firehose can reject almost every name
-- with ONE plain substring test instead of lower+gsub-ing it. If you add a
-- BALL_NAMES key that does not contain "ball", the fast path turns itself off.
local BALL_FILTER = "ball"
for configured in pairs(CONFIG.BALL_NAMES) do
	if not string.lower(configured):find("ball", 1, true) then
		BALL_FILTER = nil
		break
	end
end

local function ballNameMatch(name)
	local lower = string.lower(name or "")
	if BALL_FILTER and not lower:find(BALL_FILTER, 1, true) then
		return nil
	end
	return CONFIG.BALL_NAMES[lower:gsub("[^%a%d]", "")]
end

local function resolveBallPart(inst)
	if inst:IsA("BasePart") then return inst end
	if inst:IsA("Model") then
		if inst.PrimaryPart then return inst.PrimaryPart end
		-- Fallback: first solid child part (some balls have no PrimaryPart)
		for _, d in ipairs(inst:GetChildren()) do
			if d:IsA("BasePart") then return d end
		end
	end
	return nil
end

local lastBallRef, lastBallName = nil, nil
local blindLogged = false
local function findBall(deep)
	-- v2.60 UNBLIND. v2.59 capped EVERY walk at 5000 visits — but in a real
	-- place the ball can live deeper than that, and then the cap did not trim
	-- the lag, it removed the keeper: boot walk misses, every retry misses,
	-- no dives, no trajectory, nothing. The cap only ever makes sense as a
	-- MIDDLE tier, never as the whole strategy. Structure: (0) the remembered
	-- parent — an O(1) FindFirstChild, (1) workspace's DIRECT children, where
	-- balls nearly always live (cheap, uncapped), and (2) the descendants
	-- walk: capped on the cheap retry tiers, UNCAPPED on boot and on the two
	-- long backoff steps, so a ball anywhere in the tree is found eventually,
	-- always — the worst case for "never" became "within five seconds".
	if lastBallRef and lastBallRef.Parent then
		local hit = lastBallRef.Parent:FindFirstChild(lastBallName)
		if hit and ballNameMatch(hit.Name) then
			local part = resolveBallPart(hit)
			if part then return part end
		end
	end
	for _, obj in ipairs(workspace:GetChildren()) do
		if ballNameMatch(obj.Name) then
			local part = resolveBallPart(obj)
			if part then
				lastBallRef, lastBallName = obj, obj.Name
				return part
			end
		end
	end
	local visited = 0
	for _, obj in ipairs(workspace:GetDescendants()) do
		visited = visited + 1
		if deep ~= true and visited > 5000 then break end
		if ballNameMatch(obj.Name) then
			local part = resolveBallPart(obj)
			if part then
				lastBallRef, lastBallName = obj, obj.Name
				return part
			end
		end
	end
	return nil
end

local function refreshBall()
	if cachedBall and cachedBall.Parent then
		return cachedBall
	end
	-- Ball vanished: fast path is the DescendantAdded hook below;
	-- this is the throttled fallback (at most one full scan per 0.5s).
	-- v2.60: the escalation counts WALK MISSES, not frames (v2.59 incremented
	-- ballScanMiss every call — by frame 4 it was already at the 5 s rung, so
	-- the FIRST fallback scan ran at t=5 s, not t=0.5 s), and the two long
	-- steps walk uncapped. After ~7 blind seconds one urgent telemetry line
	-- says so — the mute-proof kind — because "no dives" with this line means
	-- BALL BLINDNESS, and without it means paste/version.
	local now = os.clock()
	if now - lastBallScan >= BALL_SCAN_WAITS[math.min(ballScanMiss + 1, #BALL_SCAN_WAITS)] then
		lastBallScan = now
		cachedBall = findBall(ballScanMiss >= 2)
		if cachedBall then
			ballScanMiss = 0
			blindLogged = false
		else
			ballScanMiss = ballScanMiss + 1
			if ballScanMiss == 4 and not blindLogged then
				blindLogged = true
				log("[AI-Dive] ⚠️ BALL HUNT: no ball after 7 s — uncapped deep scans now running every 5 s (HUD says 'scanning for ball...')", true)
			end
		end
	end
	return cachedBall
end

local function scanBall()
	cachedBall = findBall(true) -- v2.60: boot gets the uncapped walk
	lastBallScan = os.clock()
	ballScanMiss = 0
end

-- ==========================================
-- 🏟️ TEAM TRACKER (home vs away — teammates are never threats)
-- Detection priority: player.Team -> game leaderboard (Home/Away nodes)
--                     -> character TeamColor. Unknown = treated as opponent.
-- ==========================================
local teamCache    = {} -- Player -> group key ("team:X" / "lb:Home" / "tc:...")
local lbSideByName = {} -- lowercased player name -> "Home" / "Away"
local myTeamLabel  = nil -- for the HUD
local lastTeamScan = 0
local lastLbScan   = 0
-- v2.59: same diet for the leaderboard hunt — 2 s, then 5/15/60 while it keeps
-- missing; the 1 s team pass below (the one decisions run on) is UNTOUCHED.
local LB_SCAN_WAITS = {2, 5, 15, 60}
local lbScanLevel, lastLbPlayers, lbFound = 1, -1, false

local function sideOfName(name)
	local n = string.lower(name)
	if n:find("home", 1, true) or n:find("host", 1, true) or n:find("local", 1, true) then
		return "Home"
	end
	if n:find("away", 1, true) or n:find("guest", 1, true) or n:find("visit", 1, true) then
		return "Away"
	end
	return nil
end

local cachedBoard = nil
local function findBoard(parent, deep)
	-- v2.59: discover ONCE, remember (goal-scan doctrine, v2.44, finally
	-- applied here) — while the cached board's Parent lives, zero walks.
	-- v2.60: the cap is a MIDDLE tier only — deep hunts (long backoff steps)
	-- walk the whole tree, so a board parked at instance #30,000 is still
	-- found; a capped miss just waits for the next tier, it never decides.
	if cachedBoard and cachedBoard.Parent then return cachedBoard end
	-- 1) A node whose name says leaderboard/scoreboard/teams/scores
	local visited = 0
	for _, inst in ipairs(parent:GetDescendants()) do
		visited = visited + 1
		if deep ~= true and visited > 5000 then break end
		local n = string.lower(inst.Name)
		if n:find("leaderboard", 1, true) or n:find("scoreboard", 1, true)
			or n:find("score", 1, true) or n:find("team", 1, true) then
			cachedBoard = inst
			return inst
		end
	end
	-- 2) Fallback: any node that has BOTH a home-ish and an away-ish child
	local visited2 = 0
	for _, inst in ipairs(parent:GetDescendants()) do
		visited2 = visited2 + 1
		if deep ~= true and visited2 > 5000 then break end
		local hasHome, hasAway = false, false
		for _, child in ipairs(inst:GetChildren()) do
			local cn = string.lower(child.Name)
			if cn:find("home", 1, true) or cn:find("host", 1, true) then hasHome = true end
			if cn:find("away", 1, true) or cn:find("guest", 1, true) then hasAway = true end
		end
		if hasHome and hasAway then
			cachedBoard = inst -- v2.60: pass 2's find deserves the cache too
			return inst
		end
	end
	return nil
end

local function scanLeaderboard()
	-- Find the game's leaderboard (workspace, ReplicatedStorage, ReplicatedFirst,
	-- PlayerGui), then the Home/Away nodes inside it, then player names
	-- (child names or TextLabels) under each side -> side map for EVERY player.
	local parents = { workspace, ReplicatedStorage, game:GetService("ReplicatedFirst") }
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if pg then parents[#parents + 1] = pg end

	local board = nil
	for _, parent in ipairs(parents) do
		board = findBoard(parent, lbScanLevel >= 3) -- v2.60: long steps go deep
		if board then break end
	end
	if not board then return end

	lbFound = true -- v2.59: a found board resets the escalation even if empty
	local byName = {} -- v2.59: O(1) name lookup, was a nested node x player loop
	for _, plr in ipairs(Players:GetPlayers()) do
		byName[string.lower(plr.Name)] = plr.Name
	end
	local seen = 0
	for _, node in ipairs(board:GetDescendants()) do
		seen = seen + 1
		if seen > 3000 then break end
		local side = sideOfName(node.Name)
		if side then
			for _, inst in ipairs(node:GetDescendants()) do
				local iname = string.lower(inst.Name)
				local itext = inst:IsA("TextLabel") and string.lower(inst.Text) or nil
				local pname = byName[iname] or (itext and byName[itext])
				if pname then lbSideByName[pname] = side end
			end
		end
	end
end

local function refreshTeams()
	local now = os.clock()
	if now - lastLbScan >= LB_SCAN_WAITS[math.min(lbScanLevel, #LB_SCAN_WAITS)] then
		lastLbScan = now
		lbFound = false
		pcall(scanLeaderboard)
		lbScanLevel = lbFound and 1 or (lbScanLevel + 1)
	end
	if now - lastTeamScan < 1 then return end
	lastTeamScan = now
	-- v2.60: the roster check belongs UNDER the 1 s gate — v2.59 called
	-- #Players:GetPlayers() every single frame, which is its own little bill.
	local np = #Players:GetPlayers()
	if np ~= lastLbPlayers then lastLbPlayers, lbScanLevel = np, 1 end -- roster moved: go hunting again

	-- Collect per-player candidate keys from each source
	local cands = {} -- plr -> { team = key, lb = key, tc = key }
	local teamNames, tcKeys = {}, {}
	local nTeam, nTc = 0, 0
	for _, plr in ipairs(Players:GetPlayers()) do
		local c = {}
		local t = plr.Team
		if t and t.Name ~= "" then
			c.team = "team:" .. t.Name
			teamNames[c.team] = true
			nTeam = nTeam + 1
		end
		local lb = lbSideByName[string.lower(plr.Name)]
		if lb then
			c.lb = "lb:" .. lb
		end
		local char = plr.Character
		local rootPart = char and char:FindFirstChild("HumanoidRootPart")
		-- 🛡️ TeamColor is NOT a valid member of a plain Part in some games —
		-- read it pcall-safe from the Model first, then the part.
		local tc = nil
		do
			local ok, v = pcall(function() return char.TeamColor end)
			if ok and v then tc = v end
			if not tc and rootPart then
				ok, v = pcall(function() return rootPart.TeamColor end)
				if ok and v then tc = v end
			end
		end
		if tc and (tc.R < 0.95 or tc.G < 0.95 or tc.B < 0.95) then
			c.tc = string.format("tc:%d-%d-%d",
				math.floor(tc.R * 255), math.floor(tc.G * 255), math.floor(tc.B * 255))
			tcKeys[c.tc] = true
			nTc = nTc + 1
		end
		cands[plr] = c
	end

	-- 🛡️ SANITY: if (almost) everyone shares ONE Team or ONE TeamColor, the
	-- game is reusing that field for something else (free-for-all modes do
	-- this) — it is NOT a home/away split. Discard the useless source so we
	-- fall back to the leaderboard. Without this, every opponent can be
	-- misread as "OWN TEAM" and the keeper would never dive.
	local function distinctCount(tbl)
		local n = 0
		for _ in pairs(tbl) do n = n + 1 end
		return n
	end
	local teamUseless = (nTeam >= 2) and (distinctCount(teamNames) <= 1)
	local tcUseless   = (nTc >= 2) and (distinctCount(tcKeys) <= 1)

	for _, plr in ipairs(Players:GetPlayers()) do
		local c = cands[plr]
		local key = nil
		if c.team and not teamUseless then
			key = c.team
		elseif c.lb then
			key = c.lb
		elseif c.tc and not tcUseless then
			key = c.tc
		end
		teamCache[plr] = key
	end

	local my = teamCache[LocalPlayer]
	if my then
		if my:sub(1, 5) == "team:" then
			myTeamLabel = my:sub(6)
		elseif my:sub(1, 4) == "lb:" then
			myTeamLabel = my:sub(5)
		else
			myTeamLabel = "Team " .. my:sub(4)
		end
	else
		myTeamLabel = nil
	end
end

local function teamKeyOf(plr)
	return teamCache[plr]
end

