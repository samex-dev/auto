-- SERVICES
-- ==========================================
local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Stats             = game:GetService("Stats")

local LocalPlayer = Players.LocalPlayer
local Camera      = workspace.CurrentCamera
local UP          = Vector3.new(0, 1, 0)
-- the trajectory integrator runs hundreds of steps a frame: hoist the two math
-- functions it leans on out of the global table (an upvalue read beats a global
-- lookup + table index, and this is the innermost loop in the script)
local sqrt, abs = math.sqrt, math.abs

-- ==========================================
-- 🎯 DIVE REMOTE — resolved defensively, never a hard dependency (v2.44)
-- The old boot line was
--   ReplicatedStorage:WaitForChild("Events"):WaitForChild("GKDive")
-- which YIELDS FOREVER when the game does not have exactly that remote: no
-- HUD, no prediction, no error — a silently dead script (very easy to mistake
-- for "the AI doesn't work"). Now: a bounded search over the usual names, and
-- if nothing is found the AI still runs every gate (so you can watch it decide)
-- and each dive becomes a logged no-op that names the remote it wanted.
-- ==========================================
local DIVE_EVENT_PARENTS = { "Events", "GKEvents", "Remotes" }
local DIVE_EVENT_NAMES   = { "GKDive", "GK Dive", "Dive", "KeeperDive", "GoalkeeperDive" }

-- v2.49: findDiveRemote(instant) — instant=true skips the WaitForChild blocks (the
-- self-heal path runs IN-GAME between dives; a 3s freeze per folder there would
-- miss the very shots the keeper exists for). Boot still uses the patient form.
local function findDiveRemote(instant)
	local parents = {}
	parents[#parents + 1] = ReplicatedStorage
	for _, folderName in ipairs(DIVE_EVENT_PARENTS) do
		local f = ReplicatedStorage:FindFirstChild(folderName)
		if not f and not instant then
			-- the game may still be streaming it in: bounded wait, never forever
			local ok, inst = pcall(function() return ReplicatedStorage:WaitForChild(folderName, 3) end)
			if ok then f = inst end
		end
		if f then parents[#parents + 1] = f end
	end
	for _, container in ipairs(parents) do
		for _, name in ipairs(DIVE_EVENT_NAMES) do
			local inst = container:FindFirstChild(name)
			if inst and inst:IsA("RemoteEvent") then return inst, container.Name .. "." .. name end
		end
		local ok, first = pcall(function()
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("RemoteEvent")
					and string.lower(child.Name):find("dive", 1, true) then
					return child
				end
			end
		end)
		if ok and first then return first, container.Name .. "." .. first.Name end
	end
	return nil
end

local DiveEvent, diveEventPath = findDiveRemote()
if not DiveEvent then
	warn("[Auto-Dive] ⚠️ no dive RemoteEvent found (looked for: "
		.. table.concat(DIVE_EVENT_NAMES, ", ") .. ") — prediction + HUD stay live, "
		.. "dives will be logged as NO-DIVE. Set DIVE_EVENT_NAMES to your game's remote name.")
end

