		local pingMs  = math.floor(getNetworkPing() * 1000)
		local striker = (stateInfo.striker < 25) and (string.format("   🏃 %3.0f", stateInfo.striker)) or ""
		local possStr = stateInfo.poss and (string.format("   🎯 %s",
			stateInfo.poss == "own" and "OURS" or "THEIRS")) or ""
		local commitStr = (stateInfo.commit > 0) and (string.format("   📏@%d", stateInfo.commit)) or ""
		local bandStr = stateInfo.band and (string.format("[%s]", stateInfo.band)) or ""
		local l1 = string.format("⚽ %5.1f %s   🚀 %3d/s   ⏱ TTI %s   📶 %dms%s%s%s%s",
			stateInfo.dist, bandStr, stateInfo.speed, ttiStr, pingMs, lineStr, striker, possStr, commitStr)
		if hudRefs.line1.Text ~= l1 then hudRefs.line1.Text = l1 end
		local shotStr = ""
		if stateInfo.shoot then
			shotStr = string.format("   📈 %d%% ◀%d/▶%d 🏹%d",
				stateInfo.shoot, stateInfo.sideL, stateInfo.sideR, stateInfo.power)
		end
		local modeStr = stateInfo.mode and (string.format("   ⚙️ %s", stateInfo.mode)) or ""
		local chargeStr = stateInfo.charged and (string.format("   🎪 CHARGED: %s", string.upper(stateInfo.charged))) or ""
		local sideStr = stateInfo.side and (string.format("   🧭 DRIVING %s", string.upper(stateInfo.side))) or ""
		local l2 = stateInfo.label .. "   " .. attackStr .. teamStr .. "   |   " .. statsStr .. shotStr .. sideStr .. modeStr .. chargeStr
