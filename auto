local fitUi = nil  -- 📱 v2.55: defined after the UI builders; the governor polls it

-- 🐢 v2.54 THE GOVERNOR (see CONFIG.LOW_SPEC_GUARDIAN). It owns the tag-follow
-- loop too (folded in from its own connection: one Heartbeat, one cadence, and
-- the follow is the exact paint a weak phone cannot afford 60 times a second).
local zoneFolderRef = nil   -- set by createZone at boot; hidden in tier 2
local emaDt = 0
local uiFitPoll = 0
RunService.Heartbeat:Connect(function(dt)
	-- 📱 0) viewport watch (v2.55): one property read per second, and the
	-- actual re-fit only runs when the screen width really moved (≥8 px).
	-- Independent of the paint guardian below — UI fit is about SIZE, not fps.
	if CONFIG.UI_AUTO_FIT and fitUi then
		local tv = os.clock()
		if tv - (uiFitPoll or 0) > 1 then
			uiFitPoll = tv
			fitUi(false)
		end
	end
	-- 1) paint governor (guarded: with LOW_SPEC_GUARDIAN off nothing below runs
	--    and ST.ecoTier simply stays 0 = full paint forever)
	if CONFIG.LOW_SPEC_GUARDIAN and aiEnabled then
		-- v2.78: the match log showed easing↔full FLIPPING every ~1s on a
		-- steady 48fps phone — 1/48 = 0.0208 sits INSIDE the 0.019/0.0245
		-- deadband, so only frame-time NOISE was crossing the edges, at the
		-- old 0.10 alpha (~6-frame memory) that noise moves a full threshold
		-- per second. Slower EMA + a recovery dwell: downshifts remain
		-- instant (protect the phone first), upshifts need calm frames.
		emaDt = emaDt * 0.96 + (dt or 0.016) * 0.04
		-- 🎛️ v2.82: the same frame EMA the paint governor reads feeds the clock
		if emaDt > 0.001 then ST.fpsAvg = (ST.fpsAvg or 60) * 0.95 + (1 / emaDt) * 0.05 end
		local tier = ST.ecoTier or 0
		local want = tier
		if emaDt > 0.040 then want = 2
		elseif emaDt > 0.0245 then
			if want < 1 then want = 1 end
		elseif emaDt < 0.019 then want = 0
		elseif emaDt < 0.031 and want == 2 then want = 1
		end
		if CONFIG.ECO_LOCK and CONFIG.ECO_LOCK > want then want = CONFIG.ECO_LOCK end
		-- 3s RECOVERY DWELL: climbing back to a richer tier must be earned —
		-- three calm seconds since the last flip. Sliding down never waits.
		local gnow = os.clock()
		if want < tier and ST.ecoFlipT and (gnow - ST.ecoFlipT) < 3.0 then
			want = tier
		end
		if want ~= tier then
			ST.ecoTier = want
			ST.ecoFlipT = gnow
			ecoLogTier = want -- the log budget tightens with the paint (see log())
			-- log EVERY tier change: the EMA at 0.04 (~1s memory) plus the
			-- recovery dwell are the anti-spam — a flip now needs sustained
			-- frame-time in the other direction, not one jittery second
			if want > 0 then
				log(want == 2 and "[AI-Dive] 🐢 LOW-SPEC GUARDIAN: deep — dots, tags and zones OFF (dives untouched)"
					or "[AI-Dive] 🐢 LOW-SPEC GUARDIAN: easing paint (dives untouched)", true)
			else
				log("[AI-Dive] 🐢 LOW-SPEC GUARDIAN: full paint (device recovered)", true)
			end
			local show = want < 2
			for i = 1, #tagAnchors do
				local bb = tagAnchors[i].bb
				if bb then pcall(function() bb.Enabled = show end) end
			end
			if zoneFolderRef then pcall(function() zoneFolderRef.Visible = show end) end
			if want > 0 then hideVisuals() end
		end
		-- 📟 v2.57: while the device is under 50 fps, a small health line every
		-- 20 s — fps, tier, and whether the lock is forcing it. Silent on healthy
		-- devices; on a lagging one it gives the friend something to paste back that
		-- says more than "it lags".
		if emaDt > 0.020 then
			local tp = os.clock()
			if tp - (ST.perfT or 0) > 20 then
				ST.perfT = tp
				log(string.format("[AI-Dive] 📟 PERF | ~%.0f fps | lua %.3f ms/f | paint tier %d%s",
					1 / math.max(emaDt, 1e-4), (ST.luaEma or 0) * 1000, want,
					(CONFIG.ECO_LOCK or 0) > 0 and " (ECO_LOCK)" or ""), true)
			end
		end
	end
	-- 2) tag follow (v2.44: root found ONCE, re-found when it dies; v2.48: also
	--    re-bound on CHARACTER identity change; v2.54: tiered cadence)
	local n = #tagAnchors
	if n == 0 or not CONFIG.SHOW_STYLE_TAGS then return end
	if (ST.ecoTier or 0) >= 2 then return end
	if (ST.ecoTier or 0) == 1 then
		local tn = os.clock()
		if tn - (ST.tagFollowT or 0) < 0.05 then return end
		ST.tagFollowT = tn
	end
	local lift = CONFIG.TAG_HEIGHT
	for i = 1, n do
		local t = tagAnchors[i]
		local root = t.root
		if not root or not root.Parent or t.char ~= t.player.Character then
			local char = t.player.Character
			t.char = char
			root = char and char:FindFirstChild("HumanoidRootPart")
			t.root = root
		end
		if root then
			local rp = root.Position
			t.anchor.CFrame = CFrame.new(rp.X, rp.Y + lift, rp.Z)
		end
	end
end)

local function updateHud(force)
	if not hudRefs then return end
	local t = os.clock()
	-- 🐢 v2.54: every Text write re-lays the label — on a weak phone that is
	-- often the single most expensive line in the script. 10 Hz normally, 3.5x/7x
	-- eased under the guardian, and every write below is now gated on CHANGE.
	local every = 0.1
	if ST.ecoTier == 1 then every = 0.35 elseif ST.ecoTier == 2 then every = 0.7 end
	if not force and (t - lastHudUpdate) < every then return end
	lastHudUpdate = t

	local statsStr = string.format("🧤 SAVES %d   🥅 CONC %d   (%s)",
		matchStats.saves, matchStats.conceded, statsRateStr())

	local teamStr = stateInfo.team and (string.format("   🏟️ %s", stateInfo.team)) or ""
	local attackStr = stateInfo.attacker and (string.format("   ⚔️ %s", stateInfo.attacker)) or ""

	-- Roster: every player's style (★ = you), from the Values folder
	local rosterParts = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if #rosterParts < 8 then
			local nm = styleNameByPlayer[plr] or plr.Name
			if plr == LocalPlayer then
				rosterParts[#rosterParts + 1] = "★" .. string.upper(nm)
			else
				rosterParts[#rosterParts + 1] = string.upper(nm)
			end
		end
	end
	local rosterStr = #rosterParts > 0 and (table.concat(rosterParts, " · ")) or "—"
	local l3 = "👥 ROSTER   " .. rosterStr
	if hudRefs.line3.Text ~= l3 then hudRefs.line3.Text = l3 end

	if not stateInfo.active then
		local l1 = "⚽ Auto-Dive AI  —  " .. (cachedBall and "tracking ball" or "scanning for ball...")
		if hudRefs.line1.Text ~= l1 then hudRefs.line1.Text = l1 end
		local l2 = statsStr .. attackStr .. teamStr
		if hudRefs.line2.Text ~= l2 then hudRefs.line2.Text = l2 end
		hudRefs.line2.TextColor3 = Color3.fromRGB(170, 175, 185)
	else
		local ttiStr  = stateInfo.tti and (string.format("%.2fs", stateInfo.tti)) or "—"
		local lineStr = stateInfo.toLine and (string.format("   🥅 %4.1f to line", stateInfo.toLine)) or ""
		local pingMs  = math.floor(getNetworkPing() * 1000)
		local striker = (stateInfo.striker < 25) and (string.format("   🏃 %3.0f", stateInfo.striker)) or ""
		local possStr = stateInfo.poss and (string.format("   🎯 %s",
			stateInfo.poss == "own" and "OURS" or "THEIRS")) or ""
		local commitStr = (stateInfo.commit > 0) and (string.format("   📏@%d", stateInfo.commit)) or ""
		local bandStr = stateInfo.band and (string.format("[%s]", stateInfo.band)) or ""
		local l1 = string.format("⚽ %5.1f %s   🚀 %3d/s   ⏱ TTI %s   📶 %dms%s%s%s%s",
			stateInfo.dist, bandStr, stateInfo.speed, ttiStr, pingMs, lineStr, striker, possStr, commitStr)
		if hudRefs.line1.Text ~= l1 then hudRefs.line1.Text = l1 end
		local shotStr = ""
		if stateInfo.shoot then
			shotStr = string.format("   📈 %d%% ◀%d/▶%d 🏹%d",
				stateInfo.shoot, stateInfo.sideL, stateInfo.sideR, stateInfo.power)
		end
		local modeStr = stateInfo.mode and (string.format("   ⚙️ %s", stateInfo.mode)) or ""
		local chargeStr = stateInfo.charged and (string.format("   🎪 CHARGED: %s", string.upper(stateInfo.charged))) or ""
		local sideStr = stateInfo.side and (string.format("   🧭 DRIVING %s", string.upper(stateInfo.side))) or ""
		local l2 = stateInfo.label .. "   " .. attackStr .. teamStr .. "   |   " .. statsStr .. shotStr .. sideStr .. modeStr .. chargeStr
		if hudRefs.line2.Text ~= l2 then hudRefs.line2.Text = l2 end
		if hudRefs.line2.TextColor3 ~= stateInfo.color then
			hudRefs.line2.TextColor3 = stateInfo.color
		end
	end

	-- Big flash: SAVE!! / GOAL...
	if ST.pendingFlash and (t - ST.pendingFlash.t) < 1.4 then
		hudRefs.flash.Visible = true
		hudRefs.flash.Text = ST.pendingFlash.text
		hudRefs.flash.TextColor3 = ST.pendingFlash.color
	else
		hudRefs.flash.Visible = false
	end
end

